{"id":"rue-part1-0013","taskId":"rue-part1","title":"Drill set 13","text":null,"source":"drill","gaps":[{"answer":"deeply","accept":[],"options":["wide","deeply","strong","deep"],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ moved by the film that she cried.","hint":"very (adverb with moved)","explanation":"\u0027Deeply moved\u0027 \u2014 adverb modifying the participle."},{"answer":"expected","accept":[],"options":["supposed at","expected","hoped","waited"],"base":null,"keyword":null,"lead":null,"sentence":"The meeting is ___ to last two hours.","hint":"be expected to","explanation":"\u0027Be expected to\u0027 = people think it will; \u0027wait\u0027 is not used this way in the passive."},{"answer":"warmly","accept":[],"options":["warmly","warmth","warmed","warm"],"base":null,"keyword":null,"lead":null,"sentence":"The presenter spoke so ___ that everyone felt included.","hint":"in a friendly way (adverb)","explanation":"Adverb needed: spoke warmly."},{"answer":"impressed","accept":[],"options":["impression","impressing","impressed","impressive"],"base":null,"keyword":null,"lead":null,"sentence":"Her speech ___ everyone in the audience.","hint":"verb (past)","explanation":"A verb is needed: impressed. \u0027Impressive\u0027 is an adjective."},{"answer":"go through","accept":[],"options":["go through","go up","go out","go off"],"base":null,"keyword":null,"lead":null,"sentence":"The sale of the house should ___ this week.","hint":"be completed (a deal)","explanation":"\u0027Go through\u0027 = (a deal/agreement) be officially completed."},{"answer":"imagine","accept":[],"options":["consider","suppose about","think out","imagine"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t ___ what she sees in him.","hint":"understand by picturing","explanation":"\u0027I can\u0027t imagine\u2026\u0027 = I find it hard to believe/understand; \u0027consider\u0027 means think about deliberately."},{"answer":"informative","accept":[],"options":["informing","informative","informational of","informed"],"base":null,"keyword":null,"lead":null,"sentence":"The professor\u0027s lectures are always ___ and engaging.","hint":"full of useful facts","explanation":"\u0027Informative\u0027 = providing useful information; \u0027informed\u0027 = having knowledge."},{"answer":"hold","accept":[],"options":["occupy to","take up","hold","carry"],"base":null,"keyword":null,"lead":null,"sentence":"She managed to ___ his attention during the whole lecture.","hint":"keep attention","explanation":"\u0027Hold somebody\u0027s attention\u0027 = keep them interested."}]}