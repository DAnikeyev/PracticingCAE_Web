{"id":"rue-part1-0117","taskId":"rue-part1","title":"Drill set 117","text":null,"source":"drill","gaps":[{"answer":"impressed","accept":[],"options":["impressed","impressive","impression","impressing"],"base":null,"keyword":null,"lead":null,"sentence":"Her speech ___ everyone in the audience.","hint":"verb (past)","explanation":"A verb is needed: impressed. \u0027Impressive\u0027 is an adjective."},{"answer":"in","accept":[],"options":["in","with","by","on"],"base":null,"keyword":null,"lead":null,"sentence":"The audio guide comes ___ twelve languages.","hint":"available in (languages)","explanation":"\u0027Available/comes in twelve languages\u0027 \u2014 \u0027in\u0027 with languages."},{"answer":"doing","accept":[],"options":["doing","to do","he does","have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything illegal.","hint":"deny \u002B -ing","explanation":"deny \u002B -ing: denied doing (also denied having done)."},{"answer":"flop","accept":[],"options":["flop","float","flow","flame"],"base":null,"keyword":null,"lead":null,"sentence":"The play was a complete ___ \u2014 nobody came.","hint":"total failure","explanation":"\u0027A flop\u0027 = a complete failure (show, product)."},{"answer":"so","accept":[],"options":["so","such","too","very"],"base":null,"keyword":null,"lead":null,"sentence":"The lake is ___ deep that diving is forbidden.","hint":"so \u002B adj \u002B that","explanation":"\u0027so \u002B adjective \u002B that-clause\u0027: so deep that diving is forbidden."},{"answer":"deeply","accept":[],"options":["deeply","deep","wide","strong"],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ moved by the film that she cried.","hint":"very (adverb with moved)","explanation":"\u0027Deeply moved\u0027 \u2014 adverb modifying the participle."},{"answer":"differ","accept":[],"options":["differ","differentiate","distinguish","dissent"],"base":null,"keyword":null,"lead":null,"sentence":"The two accounts of the event ___ sharply.","hint":"be different (intransitive)","explanation":"\u0027Differ\u0027 = be different (intransitive); \u0027distinguish\u0027 needs an object."},{"answer":"was awarded","accept":[],"options":["was awarded","was rewarded","was prized","rewarded"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ the prize for best young novelist.","hint":"given a prize (passive)","explanation":"\u0027Be awarded a prize\u0027 = be given it formally; \u0027rewarded\u0027 implies payment for effort/behaviour."}]}