{"id":"rue-part1-0068","taskId":"rue-part1","title":"Drill set 68","text":null,"source":"drill","gaps":[{"answer":"deeply","accept":[],"options":["deep","deeply","wide","strong"],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ moved by the film that she cried.","hint":"very (adverb with moved)","explanation":"\u0027Deeply moved\u0027 \u2014 adverb modifying the participle."},{"answer":"fondly","accept":[],"options":["fondling","fond","fondly","fondness"],"base":null,"keyword":null,"lead":null,"sentence":"She spoke ___ of her years in the mountains.","hint":"with affection (adverb)","explanation":"\u0027Speak fondly of\u0027 \u2014 adverb needed: fondly."},{"answer":"agreed","accept":[],"options":["agreed","allowed","accepted to","agreed with"],"base":null,"keyword":null,"lead":null,"sentence":"The two companies have ___ a merger.","hint":"agree \u002B noun / agree to do","explanation":"\u0027Agree \u002B noun\u0027 (agreed a deal) or \u0027agree to a deal\u0027; the pattern here is agree \u002B object."},{"answer":"demolished","accept":[],"options":["demolished","sank","fell","collapsed"],"base":null,"keyword":null,"lead":null,"sentence":"The old bridge is due to be ___ next spring for safety reasons.","hint":"pull a building down","explanation":"\u0027Demolish a building\u0027 \u2014 collapse/sink/fall are intransitive."},{"answer":"followed","accept":[],"options":["followed","chased","persuaded","ran after"],"base":null,"keyword":null,"lead":null,"sentence":"He ___ the advice of his lawyer and stayed silent.","hint":"act as advised","explanation":"\u0027Follow advice\u0027 = act as advised; \u0027chase/run after\u0027 are literal pursuit."},{"answer":"constant","accept":[],"options":["constant","continuing to","instant","stationary"],"base":null,"keyword":null,"lead":null,"sentence":"The noise from the road is ___ , even with the windows shut.","hint":"never stopping","explanation":"\u0027Constant\u0027 = continuous, never stopping; \u0027instant\u0027 = immediate; \u0027stationary\u0027 = not moving."},{"answer":"introduced","accept":[],"options":["invited","insisted","invented","introduced"],"base":null,"keyword":null,"lead":null,"sentence":"The council has ___ new parking restrictions in the city centre.","hint":"bring in new rules","explanation":"\u0027Introduce restrictions/rules\u0027 = bring them into use."},{"answer":"turned down","accept":[],"options":["turned up","turned down","turned out","turned over"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid your application has been ___ .","hint":"rejected","explanation":"turn down = reject (an application, offer)."}]}