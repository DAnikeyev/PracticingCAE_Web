{"id":"verb-patterns-0092","taskId":"verb-patterns","title":"Drill set 92","text":null,"source":"drill","gaps":[{"answer":"seeing","accept":[],"options":["to seeing","seeing","see","to see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to learn","accept":[],"options":["learn","to learn","to learning","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to eat","accept":[],"options":["to eat","eat","eating","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"living","accept":[],"options":["living","to live","to living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"to inform","accept":[],"options":["to inform","to informing","inform","informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"knocking","accept":[],"options":["knock","knocking","to knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to stay","accept":[],"options":["stay","to stay","staying","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"to eat","accept":[],"options":["to eating","eat","eating","to eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"}]}