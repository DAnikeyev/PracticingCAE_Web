{"id":"verb-patterns-0092","taskId":"verb-patterns","title":"Drill set 92","text":null,"source":"drill","gaps":[{"answer":"tidy","accept":[],"options":["tidied","tidy","to tidy","tidying"],"base":null,"keyword":null,"lead":null,"sentence":"She made her son ___ his room before dinner.","hint":"make sb \u002B ?","explanation":"make \u002B object \u002B bare infinitive: made him tidy (passive takes to: was made to tidy)."},{"answer":"moving","accept":[],"options":["move","moving","to moving","to move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to know","accept":[],"options":["to knowing","knowing","to know","know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"to wait","accept":[],"options":["to wait","waited","waiting","wait"],"base":null,"keyword":null,"lead":null,"sentence":"I was made ___ the dustbin lorry at six in the morning.","hint":"passive: was made ___","explanation":"In the passive, make takes the to-infinitive: was made to wait."},{"answer":"to meet","accept":[],"options":["meet","to meeting","meeting","to meet"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"to learn","accept":[],"options":["to learn","learn","to learning","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to eat","accept":[],"options":["eating","to eating","eat","to eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"taking","accept":[],"options":["taking","to taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."}]}