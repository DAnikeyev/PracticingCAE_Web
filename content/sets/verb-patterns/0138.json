{"id":"verb-patterns-0138","taskId":"verb-patterns","title":"Drill set 138","text":null,"source":"drill","gaps":[{"answer":"to lift","accept":[],"options":["to lifting","lift","lifting","to lift"],"base":null,"keyword":null,"lead":null,"sentence":"I tried ___ the shelf up, but it was too heavy.","hint":"make an effort (and struggle)","explanation":"try \u002B to-infinitive = attempt, make an effort."},{"answer":"trying","accept":[],"options":["to trying","trying","to try","try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"to spend","accept":[],"options":["to spend","spent","spending","spend"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"complaining","accept":[],"options":["complained","complaining","complain","to complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"let","accept":[],"options":["make","let","permit","allow"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"struggling","accept":[],"options":["to struggle","struggling","to struggling","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"postponing","accept":[],"options":["to postpone","postponed","postpone","postponing"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"laughing","accept":[],"options":["to laughing","laughing","to laugh","laugh"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."}]}