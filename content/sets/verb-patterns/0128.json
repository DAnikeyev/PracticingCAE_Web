{"id":"verb-patterns-0128","taskId":"verb-patterns","title":"Drill set 128","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"to give","accept":[],"options":["given","give","to give","giving"],"base":null,"keyword":null,"lead":null,"sentence":"It was kind of them ___ us a lift to the station.","hint":"adjective \u002B to-infinitive","explanation":"\u0027It was kind of them to give \u2026\u0027 \u2014 to-infinitive after the adjective."},{"answer":"to learn","accept":[],"options":["learning","learn","to learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"asking","accept":[],"options":["ask","to ask","asked","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"getting","accept":[],"options":["to getting","to get","get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to meet","accept":[],"options":["meet","meeting","to meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"Do you want me ___ you at the station?","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want me to meet."},{"answer":"to lift","accept":[],"options":["lift","to lift","to lifting","lifting"],"base":null,"keyword":null,"lead":null,"sentence":"I tried ___ the shelf up, but it was too heavy.","hint":"make an effort (and struggle)","explanation":"try