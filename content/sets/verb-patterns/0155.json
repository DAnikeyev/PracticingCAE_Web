{"id":"verb-patterns-0155","taskId":"verb-patterns","title":"Drill set 155","text":null,"source":"drill","gaps":[{"answer":"read","accept":[],"options":["reading","have read","to read","read"],"base":null,"keyword":null,"lead":null,"sentence":"We had better ___ the terms carefully before signing anything.","hint":"had better \u002B bare infinitive","explanation":"\u0027Had better\u0027 is followed by the infinitive without \u0027to\u0027."},{"answer":"saying","accept":[],"options":["to say","saying","say","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"missing","accept":[],"options":["miss","missed","missing","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"taking","accept":[],"options":["taking","to take","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"having done","accept":[],"options":["having done","to have done","done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"revising","accept":[],"options":["to revising","revising","to revise","revise"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"to stay","accept":[],"options":["stayed","to staying","stay","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out tonight.","hint":"would prefer \u002B to-infinitive","explanation":"\u0027Would prefer to do \u2026 rather than do\u0027."},{"answer":"to have seen","accept":[],"options":["seeing","to have seen","have seen","to see"],"base":null,"keyword":null,"lead":null,"sentence":"The witness claims ___ the getaway car parked outside for an hour.","hint":"claim \u002B perfect infinitive","explanation":"\u0027Claims to have seen\u0027 \u2014 the perfect infinitive marks an earlier action."}]}