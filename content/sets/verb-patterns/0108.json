{"id":"verb-patterns-0108","taskId":"verb-patterns","title":"Drill set 108","text":null,"source":"drill","gaps":[{"answer":"selling","accept":[],"options":["selling","sold","to sell","sell"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"not to be","accept":[],"options":["not be","not being","to not be","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"did","accept":[],"options":["do","does","did","will do"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather she ___ the accounts this month, to be honest.","hint":"would rather \u002B subject \u002B past","explanation":"\u0027Would rather \u002B subject\u0027 takes the past form for an unreal present preference."},{"answer":"getting","accept":[],"options":["getting","to getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"repairing","accept":[],"options":["to repairing","repairing","repair","to repair"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"to get","accept":[],"options":["to getting","getting","to get","get"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t afford ___ her car repaired this month.","hint":"afford \u002B ?","explanation":"afford \u002B to-infinitive: can\u0027t afford to get."},{"answer":"moving","accept":[],"options":["move","to moving","to move","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"climb","accept":["climbing"],"options":["climb","to climb","climbed","climbing"],"base":null,"keyword":null,"lead":null,"sentence":"I saw him ___ the wall and disappear into the garden.","hint":"see sb do (complete action)","explanation":"see/hear \u002B object \u002B bare infinitive = the complete action; -ing = the action in progress. Both readings possible here; the bare infinitive is expected."}]}