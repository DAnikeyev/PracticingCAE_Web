{"id":"verb-patterns-0108","taskId":"verb-patterns","title":"Drill set 108","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"not to hear","accept":[],"options":["not hearing","to not hear","not to hear","not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"carry","accept":["to carry"],"options":["to carry","carrying","carry","carry to"],"base":null,"keyword":null,"lead":null,"sentence":"Could you help me ___ these boxes upstairs?","hint":"help \u002B (to) do","explanation":"help takes a bare infinitive or to-infinitive: help me (to) carry. Both accepted."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"apologise","accept":[],"options":["to apologise","apologising","apologise","apologised"],"base":null,"keyword":null,"lead":null,"sentence":"They made me ___ for the whole team\u0027s mistake.","hint":"made \u002B bare infinitive","explanation":"make \u002B object \u002B bare infinitive in active sentences: made me apologise."},{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."}]}