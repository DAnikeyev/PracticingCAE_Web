{"id":"verb-patterns-0033","taskId":"verb-patterns","title":"Drill set 33","text":null,"source":"drill","gaps":[{"answer":"losing","accept":[],"options":["to lose","losing","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"He refused ___ for the damage.","hint":"refuse \u002B ?","explanation":"refuse takes the to-infinitive: refused to pay."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"queueing","accept":["queuing"],"options":["to queue","queueing","queue","to queueing"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"to receive","accept":[],"options":["receiving","to receive","receive","to receiving"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"catching","accept":[],"options":["to catch","catching","catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to redecorate","accept":["on redecorating"],"options":["redecorating","to redecorate","redecorate","to redecorating"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."}]}