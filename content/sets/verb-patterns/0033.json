{"id":"verb-patterns-0033","taskId":"verb-patterns","title":"Drill set 33","text":null,"source":"drill","gaps":[{"answer":"to know","accept":[],"options":["to knowing","to know","know","knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"missing","accept":[],"options":["missing","miss","to miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"read","accept":[],"options":["reading","have read","to read","read"],"base":null,"keyword":null,"lead":null,"sentence":"We had better ___ the terms carefully before signing anything.","hint":"had better \u002B bare infinitive","explanation":"\u0027Had better\u0027 is followed by the infinitive without \u0027to\u0027."},{"answer":"to meet","accept":[],"options":["to meeting","to meet","meet","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"to learn","accept":[],"options":["to learn","learning","to learning","learn"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"talking","accept":[],"options":["talk","talking","to talking","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"complaining","accept":[],"options":["to complain","complained","complaining","complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"to meet","accept":[],"options":["meet","meeting","met","to meet"],"base":null,"keyword":null,"lead":null,"sentence":"Do you want me ___ you at the station?","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want me to meet."}]}