{"id":"verb-patterns-0094","taskId":"verb-patterns","title":"Drill set 94","text":null,"source":"drill","gaps":[{"answer":"to know","accept":[],"options":["knowing","to know","know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"to have","accept":[],"options":["having","to have","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."},{"answer":"meeting","accept":[],"options":["meet","to meet","meeting","met"],"base":null,"keyword":null,"lead":null,"sentence":"The children are looking forward to ___ Father Christmas.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: looking forward to meeting."},{"answer":"to stay","accept":[],"options":["staying","to stay","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"complaining","accept":[],"options":["to complain","complaining","complain","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"to need","accept":[],"options":["needing","to need","need","to needing"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjectiv