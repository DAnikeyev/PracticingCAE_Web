{"id":"verb-patterns-0159","taskId":"verb-patterns","title":"Drill set 159","text":null,"source":"drill","gaps":[{"answer":"to play","accept":[],"options":["to playing","to play","playing","play"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m learning ___ the guitar at the moment.","hint":"learn \u002B ?","explanation":"learn takes the to-infinitive (learn how to play)."},{"answer":"taking","accept":[],"options":["to take","take","to taking","taking"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"moving","accept":[],"options":["to moving","moving","move","to move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to lock","accept":[],"options":["locking","to lock","locked","lock"],"base":null,"keyword":null,"lead":null,"sentence":"Did you remember ___ the window before we left?","hint":"remember first, then do","explanation":"\u0027Remember to do\u0027 = not forget an obligation; \u0027remember locking\u0027 recalls a past action."},{"answer":"breaking","accept":[],"options":["breaking","to breaking","break","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"repairing","accept":[],"options":["to repairing","repair","to repair","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"arguing","accept":[],"options":["argued","arguing","argue","to argue"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"to water","accept":[],"options":["watering","water","to water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."}]}