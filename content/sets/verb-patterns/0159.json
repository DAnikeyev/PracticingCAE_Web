{"id":"verb-patterns-0159","taskId":"verb-patterns","title":"Drill set 159","text":null,"source":"drill","gaps":[{"answer":"saying","accept":[],"options":["to saying","say","saying","to say"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"to water","accept":[],"options":["watering","water","to water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"getting","accept":[],"options":["getting","get","to get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"having done","accept":[],"options":["done","to have done","having done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"stay","accept":[],"options":["staying","to staying","stay","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"talking","accept":[],"options":["talking","to talk","talk","talked"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the incident for weeks.","hint":"avoid \u002B -ing","explanation":"\u0027Avoid\u0027 is always followed by the -ing form."},{"answer":"not to be","accept":[],"options":["not be","not being","to not be","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"waiting","accept":["to wait"],"options":["to wait","wait","to waiting","waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."}]}