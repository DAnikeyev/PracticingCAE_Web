{"id":"verb-patterns-0013","taskId":"verb-patterns","title":"Drill set 13","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to be","be","being","been"],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude to the waiter.","hint":"preposition \u002B gerund","explanation":"\u0027Apologise for being\u0027 \u2014 \u0027for\u0027 is a preposition, so the gerund follows."},{"answer":"missing","accept":[],"options":["missed","miss","missing","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"drinking","accept":[],"options":["to drink","drinking","to drinking","drink"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"not to hear","accept":[],"options":["not hearing","not to hear","to not hear","not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"going","accept":["to go"],"options":["to go","to going","going","go"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"getting","accept":[],"options":["get","getting","to get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to see","accept":[],"options":["to see","seen","saw","see"],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the circus.","hint":"excited \u002B to-infinitive","explanation":"\u0027Excited to see\u0027 \u2014 the to-infinitive follows the adjective."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."}]}