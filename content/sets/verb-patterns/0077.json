{"id":"verb-patterns-0077","taskId":"verb-patterns","title":"Drill set 77","text":null,"source":"drill","gaps":[{"answer":"complaining","accept":[],"options":["complaining","to complaining","to complain","complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"taking","accept":[],"options":["take","to take","to taking","taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"having done","accept":[],"options":["to do","to have done","done","having done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to extend","accept":[],"options":["extended","to extend","extend","extending"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the deadline by a week.","hint":"agree \u002B to-infinitive","explanation":"\u0027Agree to do something\u0027 takes the to-infinitive."},{"answer":"crying","accept":[],"options":["cry","crying","to cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"to get","accept":[],"options":["getting","to get","get","got"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ something to eat at the motorway services.","hint":"stop in order to","explanation":"\u0027Stopped to get\u0027 = paused for the purpose; \u0027stopped getting\u0027 would mean quit eating."},{"answer":"missing","accept":[],"options":["miss","missed","to miss","missing"],"base":null,"keyword":null,"lead":null,"sentenc