{"id":"verb-patterns-0077","taskId":"verb-patterns","title":"Drill set 77","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["get","to get","getting","got"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"cleared","accept":[],"options":["clear","to clear","cleared","clearing"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"worrying","accept":[],"options":["to worry","worrying","worry","to worrying"],"base":null,"keyword":null,"lead":null,"sentence":"There\u