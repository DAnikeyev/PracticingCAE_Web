{"id":"verb-patterns-0001","taskId":"verb-patterns","title":"Drill set 1","text":null,"source":"drill","gaps":[{"answer":"revising","accept":[],"options":["to revise","to revising","revise","revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"allow","accept":[],"options":["make","have","allow","let"],"base":null,"keyword":null,"lead":null,"sentence":"The rules don\u0027t ___ visitors to touch the paintings.","hint":"verb \u002B object \u002B to touch","explanation":"allow \u002B object \u002B to-infinitive: allow visitors to touch. (let \u002B bare: let visitors touch.)"},{"answer":"having done","accept":["doing"],"options":["done","to do","having done","doing"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"handling","accept":[],"options":["handle","to handling","to handle","handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"getting","accept":[],"options":["to getting","get","getting","to get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"missing","accept":[],"options":["missed","miss","to miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"She admitted ___ the last train and had to take a taxi.","hint":"admit \u002B -ing","explanation":"\u0027Admit doing\u0027 \u2014 confess to a past action takes the gerund."},{"answer":"rewrite","accept":[],"options":["rewriting","rewrote","rewrite","to rewrite"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher made us ___ the whole essay again.","hint":"make \u002B bare infinitive","explanation":"\u0027Make someone do\u0027 \u2014 active \u0027make\u0027 takes the bare infinitive."},{"answer":"arguing","accept":[],"options":["to argue","argue","arguing","argued"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."}]}