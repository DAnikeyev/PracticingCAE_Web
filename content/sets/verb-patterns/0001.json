{"id":"verb-patterns-0001","taskId":"verb-patterns","title":"Drill set 1","text":null,"source":"drill","gaps":[{"answer":"struggling","accept":[],"options":["struggle","to struggle","struggling","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"opening","accept":[],"options":["opened","opening","to open","open"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"paying","accept":[],"options":["to pay","pay","to paying","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"to live","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"building","accept":[],"options":["build","to building","building","to build"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"trying","accept":[],"options":["to try","try","trying","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"catching","accept":[],"options":["to catching","catching","catch","to catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"talking","accept":[],"options":["to talk","talk","talking","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."}]}