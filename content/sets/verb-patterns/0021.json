{"id":"verb-patterns-0021","taskId":"verb-patterns","title":"Drill set 21","text":null,"source":"drill","gaps":[{"answer":"seeing","accept":[],"options":["seeing","to see","to seeing","see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to meet","accept":[],"options":["meeting","meet","to meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"breaking","accept":[],"options":["breaking","to breaking","break","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to check","accept":[],"options":["check","to check","checking","to checking"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"working","accept":["to work"],"options":["working","work","to work","to working"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"to need","accept":[],"options":["need","to need","to needing","needing"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjective \u002B enough \u002B to-infinitive: heavy enough to need."},{"answer":"to control","accept":[],"options":["control","controlling","to controlling","to control"],"base":null,"keyword":null,"l