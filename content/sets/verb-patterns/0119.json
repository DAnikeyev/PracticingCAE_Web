{"id":"verb-patterns-0119","taskId":"verb-patterns","title":"Drill set 119","text":null,"source":"drill","gaps":[{"answer":"to live","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"to receive","accept":[],"options":["to receiving","receiving","to receive","receive"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"seeing","accept":[],"options":["seeing","see","saw","to see"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."},{"answer":"handling","accept":[],"options":["to handling","handling","to handle","handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to show","accept":[],"options":["to show","showing","to showing","show"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t wait ___ you the photos.","hint":"can\u0027t wait \u002B ?","explanation":"can\u0027t wait \u002B to-infinitive: can\u0027t wait to show."},{"answer":"going","accept":["to go"],"options":["to go","go","going","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"stay","accept":[],"options":["to staying","stay","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"saying","accept":[],"options":["say","to saying","to say","saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."}]}