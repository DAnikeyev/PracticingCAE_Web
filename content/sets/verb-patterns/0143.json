{"id":"verb-patterns-0143","taskId":"verb-patterns","title":"Drill set 143","text":null,"source":"drill","gaps":[{"answer":"to need","accept":[],"options":["need","to needing","needing","to need"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjective \u002B enough \u002B to-infinitive: heavy enough to need."},{"answer":"not to hear","accept":[],"options":["not to hear","not hear","to not hear","not hearing"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"crying","accept":[],"options":["to crying","cry","crying","to cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"having done","accept":[],"options":["to do","having done","to have done","done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"arguing","accept":[],"options":["argued","to argue","arguing","argue"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"trying","accept":[],"options":["trying","to trying","try","to try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"going","accept":["to go"],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to eat","accept":[],"options":["eat","to eating","to eat","eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."}]}