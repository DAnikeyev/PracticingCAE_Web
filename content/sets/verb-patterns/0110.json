{"id":"verb-patterns-0110","taskId":"verb-patterns","title":"Drill set 110","text":null,"source":"drill","gaps":[{"answer":"taking","accept":[],"options":["take","to taking","to take","taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"postponing","accept":[],"options":["postponed","postpone","to postpone","postponing"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"waiting","accept":["to wait"],"options":["wait","waiting","to wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"arguing","accept":[],"options":["argue","arguing","argued","to argue"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"turning","accept":[],"options":["turn","to turn","to turning","turning"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"to have seen","accept":[],"options":["have seen","seeing","to have seen","to see"],"base":null,"keyword":null,"lead":null,"sentence":"The witness claims ___ the getaway car parked outside for an hour.","hint":"claim \u002B perfect infinitive","explanation":"\u0027Claims to have seen\u0027 \u2014 the perfect infinitive marks an earlier action."},{"answer":"not to be","accept":[],"options":["not being","not be","not to be","to not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"revising","accept":[],"options":["to revising","revising","revise","to revise"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."}]}