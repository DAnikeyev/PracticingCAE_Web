{"id":"verb-patterns-0097","taskId":"verb-patterns","title":"Drill set 97","text":null,"source":"drill","gaps":[{"answer":"to put","accept":[],"options":["putting","to put","put","to putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"working","accept":["to work"],"options":["to work","working","work","to working"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"cleared","accept":[],"options":["clear","to clear","cleared","clearing"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."},{"answer":"to know","accept":[],"options":["knowing","to know","know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"going","accept":["to go"],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"disturb","accept":[],"options":["to disturb","disturbing","disturb","disturbed"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."}]}