{"id":"verb-patterns-0170","taskId":"verb-patterns","title":"Drill set 170","text":null,"source":"drill","gaps":[{"answer":"to water","accept":[],"options":["watering","water","to water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"to describe","accept":[],"options":["to describing","describe","describing","to describe"],"base":null,"keyword":null,"lead":null,"sentence":"After introducing herself, she went on ___ the main findings.","hint":"move on to a new activity","explanation":"go on \u002B to-infinitive = do something after finishing something else."},{"answer":"driving","accept":[],"options":["drive","driving","to driving","to drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"getting","accept":[],"options":["getting","to get","to getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"postponing","accept":[],"options":["postponing","to postpone","postponed","postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"to eat","accept":[],"options":["eat","to eat","to eating","eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"breaking","accept":[],"options":["to break","breaking","break","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."}]}