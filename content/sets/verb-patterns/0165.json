{"id":"verb-patterns-0165","taskId":"verb-patterns","title":"Drill set 165","text":null,"source":"drill","gaps":[{"answer":"asking","accept":[],"options":["ask","asking","to ask","asked"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"going","accept":["to go"],"options":["to going","to go","go","going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"knocking","accept":[],"options":["knock","knocking","to knocking","to knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to rain","accept":["raining"],"options":["raining","rain","to raining","to rain"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"driving","accept":[],"options":["to drive","driving","drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"moving","accept":[],"options":["to moving","move","to move","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"living","accept":[],"options":["living","to live","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"hearing","accept":[],"options":["heard","hearing","to hear","hear"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re looking forward to ___ from you soon.","hint":"\u0027to\u0027 here is a preposition","explanation":"\u0027Look forward to \u002B -ing\u0027 \u2014 \u0027to\u0027 is a preposition, so the gerund follows."}]}