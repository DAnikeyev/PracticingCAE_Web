{"id":"verb-patterns-0087","taskId":"verb-patterns","title":"Drill set 87","text":null,"source":"drill","gaps":[{"answer":"to need","accept":[],"options":["need","to needing","to need","needing"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjective \u002B enough \u002B to-infinitive: heavy enough to need."},{"answer":"having done","accept":[],"options":["done","to have done","having done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to spend","accept":[],"options":["spend","to spend","spent","spending"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"to bring","accept":[],"options":["to bring","bring","to bringing","bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"being","accept":[],"options":["been","being","be","to be"],"base":null,"keyword":null,"lead":null,"sentence":"I resent ___ treated as an amateur when I have twenty years\u2019 experience.","hint":"resent \u002B passive gerund","explanation":"\u0027Resent\u0027 takes a gerund; the passive is \u0027being treated\u0027."},{"answer":"to turn","accept":[],"options":["to turning","turn","turning","to turn"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"to control","accept":[],"options":["control","controlling","to controlling","to control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"selling","accept":[],"options":["sold","to sell","sell","selling"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."}]}