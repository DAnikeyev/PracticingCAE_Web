{"id":"verb-patterns-0087","taskId":"verb-patterns","title":"Drill set 87","text":null,"source":"drill","gaps":[{"answer":"cleared","accept":[],"options":["to clear","clear","clearing","cleared"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."},{"answer":"quitting","accept":[],"options":["to quit","quitting","quit","to quitting"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"going","accept":[],"options":["to go","going","to going","go"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"},{"answer":"turning","accept":[],"options":["to turn","turn","turning","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"living","accept":[],"options":["living","live","to living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"seeing","accept":[],"options":["seeing","see","to seeing","to see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to spend","accept":[],"options":["to spend","spend","spending","spent"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u0