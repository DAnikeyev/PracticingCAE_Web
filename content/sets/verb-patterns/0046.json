{"id":"verb-patterns-0046","taskId":"verb-patterns","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"to eat","accept":[],"options":["eating","to eating","to eat","eat"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"stay","accept":[],"options":["to stay","staying","stay","stayed"],"base":null,"keyword":null,"lead":null,"sentence":"She would rather ___ at home tonight.","hint":"would rather \u002B base verb","explanation":"\u0027Would rather do\u0027 \u2014 the bare infinitive follows."},{"answer":"crying","accept":[],"options":["cry","to crying","crying","to cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"knocking","accept":[],"options":["knocking","to knock","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"having done","accept":["doing"],"options":["to do","doing","done","having done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"breaking","accept":[],"options":["breaking","break","to breaking","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"failing","accept":[],"options":["fail","to fail","failing","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"tidy","accept":[],"options":["tidy","tidying","to tidy","tidied"],"base":null,"keyword":null,"lead":null,"sentence":"She made her son ___ his room before dinner.","hint":"make sb \u002B ?","explanation":"make \u002B object \u002B bare infinitive: made him tidy (passive takes to: was made to tidy)."}]}