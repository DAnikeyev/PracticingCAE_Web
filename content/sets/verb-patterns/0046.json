{"id":"verb-patterns-0046","taskId":"verb-patterns","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"missing","accept":[],"options":["missing","to miss","missed","miss"],"base":null,"keyword":null,"lead":null,"sentence":"She admitted ___ the last train and had to take a taxi.","hint":"admit \u002B -ing","explanation":"\u0027Admit doing\u0027 \u2014 confess to a past action takes the gerund."},{"answer":"handling","accept":[],"options":["handling","handle","to handling","to handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"trying","accept":[],"options":["trying","to try","to trying","try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"driving","accept":[],"options":["driving","to drive","to driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"missing","accept":[],"options":["missed","missing","miss","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"to check","accept":[],"options":["check","to check","to checking","checking"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"being","accept":[],"options":["to be","be","being","been"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u