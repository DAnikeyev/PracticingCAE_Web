{"id":"verb-patterns-0133","taskId":"verb-patterns","title":"Drill set 133","text":null,"source":"drill","gaps":[{"answer":"to live","accept":[],"options":["to live","live","living","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"missing","accept":[],"options":["missed","missing","to miss","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"taking","accept":[],"options":["take","to take","taking","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"hearing","accept":[],"options":["heard","hear","to hear","hearing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"to mend","accept":[],"options":["mending","to mending","mend","to mend"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"to see","accept":[],"options":["seen","see","saw","to see"],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the circus.","hint":"excited \u002B to-infinitive","explanation":"\u0027Excited to see\u0027 \u2014 the to-infinitive follows the adjective."},{"answer":"having done","accept":[],"options":["to have done","to do","having done","done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to eat","accept":[],"options":["to eating","to eat","eat","eating"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"}]}