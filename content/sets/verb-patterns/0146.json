{"id":"verb-patterns-0146","taskId":"verb-patterns","title":"Drill set 146","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["getting","to get","to getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"not to be","accept":[],"options":["not to be","not being","not be","to not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"talking","accept":[],"options":["to talking","talking","to talk","talk"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"building","accept":[],"options":["build","building","to build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"trying","accept":[],"options":["tried","try","to try","trying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ to start the engine \u2014 the battery is completely flat.","hint":"it\u0027s no use \u002B -ing","explanation":"\u0027It\u0027s no use\u0027 is followed by a gerund."},{"answer":"seeing","accept":[],"options":["saw","to see","seeing","see"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."},{"answer":"going","accept":[],"options":["go","going","to going","to go"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"}]}