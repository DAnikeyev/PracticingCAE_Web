{"id":"verb-patterns-0059","taskId":"verb-patterns","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"crying","accept":[],"options":["to cry","crying","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"to turn","accept":[],"options":["turning","to turn","turn","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"waiting","accept":["to wait"],"options":["to wait","waiting","wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"apologise","accept":[],"options":["to apologise","apologising","apologise","apologised"],"base":null,"keyword":null,"lead":null,"sentence":"They made me ___ for the whole team\u0027s mistake.","hint":"made \u002B bare infinitive","explanation":"make \u002B object \u002B bare infinitive in active sentences: made me apologise."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"cleared","accept":[],"options":["clear","to clear","cleared","clearing"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."}]}