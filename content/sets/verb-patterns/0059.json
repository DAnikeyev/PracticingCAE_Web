{"id":"verb-patterns-0059","taskId":"verb-patterns","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"to undo","accept":[],"options":["undoing","to undoing","undo","to undo"],"base":null,"keyword":null,"lead":null,"sentence":"Do you have any idea how ___ this knot?","hint":"how \u002B ?","explanation":"question word \u002B to-infinitive: how to undo."},{"answer":"missing","accept":[],"options":["missing","to miss","to missing","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"photography","accept":["photographing"],"options":["photograph","photography","to photograph","photographing"],"base":null,"keyword":null,"lead":null,"sentence":"They don\u0027t allow ___ in the museum.","hint":"allow \u002B noun / allow sb to do","explanation":"allow \u002B noun/-ing (no personal object): they don\u0027t allow photography. With a person: allow visitors to photograph."},{"answer":"to attract","accept":["at attracting"],"options":["to attracting","attract","to attract","attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"not to be","accept":[],"options":["not to be","to not be","not be","not being"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"failing","accept":[],"options":["failing","to failing","to fail","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"taking","accept":[],"opti