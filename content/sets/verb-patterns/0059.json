{"id":"verb-patterns-0059","taskId":"verb-patterns","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"moving","accept":[],"options":["move","to move","to moving","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"getting","accept":[],"options":["getting","to getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to lock","accept":[],"options":["lock","to lock","locked","locking"],"base":null,"keyword":null,"lead":null,"sentence":"Did you remember ___ the window before we left?","hint":"remember first, then do","explanation":"\u0027Remember to do\u0027 = not forget an obligation; \u0027remember locking\u0027 recalls a past action."},{"answer":"turning","accept":[],"options":["to turn","turn","turning","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"taking","accept":[],"options":["taking","to taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He suggested ___ a taxi instead of walking.","hint":"suggest \u002B ?","explanation":"suggest \u002B -ing (no infinitive with a person: suggest that we take is also possible)."},{"answer":"to warn","accept":[],"options":["warn","warning","to warn","to warning"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"going","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"}]}