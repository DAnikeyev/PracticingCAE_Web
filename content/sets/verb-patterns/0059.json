{"id":"verb-patterns-0059","taskId":"verb-patterns","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"to receive","accept":[],"options":["receive","receiving","to receiving","to receive"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"to upgrade","accept":[],"options":["upgrade","to upgrading","to upgrade","upgrading"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"building","accept":[],"options":["to build","to building","building","build"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"seeing","accept":[],"options":["to seeing","to see","seeing","see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to warn","accept":[],"options":["to warn","warn","warning","to warning"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"stay","accept":[],"options":["to stay","staying","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"to climb","accept":[],"options":["climb","climbed","climbing","to climb"],"base":null,"keyword":null,"lead":null,"sentence":"She was the first woman ___ the peak in winter.","hint":"the first/last \u002B ?","explanation":"the first/second/last \u002B to-infinitive: the first woman to climb."},{"answer":"being","accept":[],"options":["to being","be","to be","being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."}]}