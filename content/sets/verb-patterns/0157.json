{"id":"verb-patterns-0157","taskId":"verb-patterns","title":"Drill set 157","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to getting","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to tell","accept":[],"options":["telling","to tell","told","tell"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"go","accept":[],"options":["to going","to go","going","go"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out that late.","hint":"let \u002B ?","explanation":"let takes the bare infinitive: let me go (no \u0027to\u0027)."},{"answer":"postponing","accept":[],"options":["postponing","postponed","postpone","to postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"having done","accept":[],"options":["to do","to have done","having done","done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"queueing","accept":["queuing"],"options":["to queue","queueing","to queueing","queue"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"hearing","accept":[],"options":["hearing","heard","hear","to hear"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the