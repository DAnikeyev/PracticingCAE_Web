{"id":"verb-patterns-0061","taskId":"verb-patterns","title":"Drill set 61","text":null,"source":"drill","gaps":[{"answer":"to accept","accept":[],"options":["accepting","to accept","accept","to accepting"],"base":null,"keyword":null,"lead":null,"sentence":"She decided ___ the job offer in Berlin.","hint":"decide \u002B ?","explanation":"decide takes the to-infinitive: decided to accept."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to put","accept":[],"options":["putting","to put","put","to putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"to operate","accept":[],"options":["operating","to operate","operate","to operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"to have","accept":[],"options":["having","to have","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"waiting","accept":["to wait"],"options":["to wait","waiting","wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."}]}