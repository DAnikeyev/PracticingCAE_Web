{"id":"verb-patterns-0061","taskId":"verb-patterns","title":"Drill set 61","text":null,"source":"drill","gaps":[{"answer":"to undo","accept":[],"options":["to undoing","undoing","to undo","undo"],"base":null,"keyword":null,"lead":null,"sentence":"Do you have any idea how ___ this knot?","hint":"how \u002B ?","explanation":"question word \u002B to-infinitive: how to undo."},{"answer":"not to hear","accept":[],"options":["to not hear","not to hear","not hear","not hearing"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"getting","accept":[],"options":["getting","got","to get","get"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."},{"answer":"driving","accept":[],"options":["drive","driving","to drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"quitting","accept":[],"options":["to quitting","quitting","to quit","quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"being","accept":[],"options":["be","to being","to be","being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"going","accept":["to go"],"options":["going","go","to go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to eat","accept":[],"options":["to eat","to eating","eat","eating"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"}]}