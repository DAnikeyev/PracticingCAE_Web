{"id":"verb-patterns-0191","taskId":"verb-patterns","title":"Drill set 191","text":null,"source":"drill","gaps":[{"answer":"complaining","accept":[],"options":["complain","complaining","to complaining","to complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"to play","accept":[],"options":["to play","playing","play","to playing"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m learning ___ the guitar at the moment.","hint":"learn \u002B ?","explanation":"learn takes the to-infinitive (learn how to play)."},{"answer":"living","accept":[],"options":["live","living","to live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"getting","accept":[],"options":["to get","got","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."},{"answer":"breaking","accept":[],"options":["to breaking","breaking","break","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"knocking","accept":[],"options":["knocking","to knocking","knock","to knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"asking","accept":[],"options":["to ask","asked","ask","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"cleared","accept":[],"options":["clearing","cleared","to clear","clear"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."}]}