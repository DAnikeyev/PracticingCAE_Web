{"id":"verb-patterns-0126","taskId":"verb-patterns","title":"Drill set 126","text":null,"source":"drill","gaps":[{"answer":"to eat","accept":[],"options":["eat","to eat","to eating","eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"paying","accept":[],"options":["paying","pay","to pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"working","accept":[],"options":["work","working","to work","worked"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"talking","accept":[],"options":["talk","talking","to talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"driving","accept":[],"options":["drive","driving","to drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"getting","accept":[],"options":["to get","getting","got","get"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."},{"answer":"taking","accept":[],"options":["to taking","taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"moving","accept":[],"options":["moving","to moving","to move","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."}]}