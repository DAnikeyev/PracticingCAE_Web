{"id":"verb-patterns-0032","taskId":"verb-patterns","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"complaining","accept":[],"options":["to complain","complaining","complain","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"losing","accept":[],"options":["to lose","losing","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"driving","accept":[],"options":["to drive","driving","drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"opening","accept":[],"options":["to open","opening","open","opened"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."},{"answer":"seeing","accept":[],"options":["to see","seeing","see","to seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."}]}