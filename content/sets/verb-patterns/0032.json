{"id":"verb-patterns-0032","taskId":"verb-patterns","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"to eat","accept":[],"options":["to eat","eating","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"living","accept":[],"options":["to living","living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"to have","accept":[],"options":["have","having","to having","to have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"crying","accept":[],"options":["to cry","cry","crying","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"having done","accept":[],"options":["having done","to do","done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to have","accept":[],"options":["to having","having","to have","have"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."},{"answer":"revising","accept":[],"options":["to revise","revise","revising","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"to extend","accept":[],"options":["extending","to extend","extend","extended"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the deadline by a week.","hint":"agree \u002B to-infinitive","explanation":"\u0027Agree to do something\u0027 takes the to-infinitive."}]}