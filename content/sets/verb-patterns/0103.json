{"id":"verb-patterns-0103","taskId":"verb-patterns","title":"Drill set 103","text":null,"source":"drill","gaps":[{"answer":"catching","accept":[],"options":["to catch","catching","catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to have","accept":[],"options":["having","to have","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."},{"answer":"to know","accept":[],"options":["knowing","to know","know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"I happen ___ her from university.","hint":"happen \u002B ? (chance)","explanation":"happen \u002B to-infinitive = do something by chance: happen to know."},{"answer":"to eat","accept":[],"options":["eating","to eat","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"tidy","accept":[],"options":["to tidy","tidying","tidy","tidied"],"base":null,"keyword":null,"lead":null,"sentence":"She made her son ___ his room before dinner.","hint":"make sb \u002B ?","explanation":"make \u002B object \u002B bare infinitive: made him tidy (passive takes to: was made to tidy)."},{"answer":"argue","accept":[],"options":["to argue","arguing","argue","argued"],"base":null,"keyword":null,"lead":null,"sentence":"Let\u0027s not ___ about it until we know more.","hint":"let\u0027s \u002B bare infinitive","explanation":"let\u0027s \u002B bare infinitive (negative: let\u0027s not argue)."}]}