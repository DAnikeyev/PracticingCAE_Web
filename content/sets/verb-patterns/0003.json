{"id":"verb-patterns-0003","taskId":"verb-patterns","title":"Drill set 3","text":null,"source":"drill","gaps":[{"answer":"missing","accept":[],"options":["to missing","to miss","missing","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"paying","accept":[],"options":["paying","to pay","to paying","pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"to inform","accept":[],"options":["inform","informing","to inform","to informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"talking","accept":[],"options":["to talk","to talking","talk","talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"didn\u0027t","accept":[],"options":["don\u0027t","didn\u0027t","won\u0027t","not"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"not to be","accept":[],"options":["to not be","not be","not being","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"quitting","accept":[],"options":["quitting","to quit","to quitting","quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"going","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"}]}