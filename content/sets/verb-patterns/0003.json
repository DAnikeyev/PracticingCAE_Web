{"id":"verb-patterns-0003","taskId":"verb-patterns","title":"Drill set 3","text":null,"source":"drill","gaps":[{"answer":"disturb","accept":[],"options":["to disturb","disturbing","disturb","disturbed"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."},{"answer":"to eat","accept":[],"options":["eating","to eat","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"going","accept":["to go"],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"quitting","accept":[],"options":["to quit","quitting","quit","to quitting"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"worrying","accept":[],"options":["to worry","worrying","worry","to worrying"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point ___ about it now.","hint":"no point \u002B ?","explanation":"there\u0027s no point \u002B -ing: no point worrying."}]}