{"id":"verb-patterns-0003","taskId":"verb-patterns","title":"Drill set 3","text":null,"source":"drill","gaps":[{"answer":"catching","accept":[],"options":["to catch","catch","catching","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"driving","accept":[],"options":["to drive","to driving","driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"carry","accept":["to carry"],"options":["carry","carrying","to carry","carry to"],"base":null,"keyword":null,"lead":null,"sentence":"Could you help me ___ these boxes upstairs?","hint":"help \u002B (to) do","explanation":"help takes a bare infinitive or to-infinitive: help me (to) carry. Both accepted."},{"answer":"moving","accept":[],"options":["to move","to moving","moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"drinking","accept":[],"options":["drink","drinking","to drinking","to drink"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"to go","accept":[],"options":["to go","go","to going","going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."},{"answer":"struggling","accept":[],"options":["to struggle","struggling","struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of _