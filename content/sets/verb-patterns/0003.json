{"id":"verb-patterns-0003","taskId":"verb-patterns","title":"Drill set 3","text":null,"source":"drill","gaps":[{"answer":"to learn","accept":[],"options":["learn","to learn","to learning","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"working","accept":["to work"],"options":["to working","working","to work","work"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"turning","accept":[],"options":["to turn","turning","to turning","turn"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"to get","accept":[],"options":["getting","to getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"It took me ages ___ used to the new keyboard.","hint":"it takes time \u002B ?","explanation":"it takes time \u002B to-infinitive: took me ages to get used to the keyboard."},{"answer":"drive","accept":[],"options":["drive","driven","to drive","driving"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"missing","accept":[],"options":["missing","to miss","missed","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"getting","accept":[],"options":["get","to getting","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"living","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."}]}