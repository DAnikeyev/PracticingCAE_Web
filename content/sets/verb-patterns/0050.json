{"id":"verb-patterns-0050","taskId":"verb-patterns","title":"Drill set 50","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"complaining","accept":[],"options":["to complain","complaining","complain","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"going","accept":["to go"],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to undo","accept":[],"options":["undoing","to undo","undo","to undoing"],"base":null,"keyword":null,"lead":null,"sentence":"Do you have any idea how ___ this knot?","hint":"how \u002B ?","explanation":"question word \u002B to-infinitive: how to undo."},{"answer":"to know","accept":[],"options":["knowing","to know","know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"meeting","accept":[],"options":["meet","to meet","meeting","met"],"base":null,"keyword":null,"lead":null,"sentence":"The children are looking forward to ___ Father Christmas.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: looking forward to meeting."},{"answer":"to water","accept":[],"options":["watering","to water","water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."}]}