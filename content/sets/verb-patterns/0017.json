{"id":"verb-patterns-0017","taskId":"verb-patterns","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"to extend","accept":[],"options":["extended","to extend","extend","extending"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the deadline by a week.","hint":"agree \u002B to-infinitive","explanation":"\u0027Agree to do something\u0027 takes the to-infinitive."},{"answer":"didn\u0027t","accept":[],"options":["didn\u0027t","not","won\u0027t","don\u0027t"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"breaking","accept":[],"options":["to break","break","breaking","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to bring","accept":[],"options":["bringing","to bringing","to bring","bring"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"going","accept":[],"options":["to go","going","to going","go"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"},{"answer":"postponing","accept":[],"options":["postponing","postponed","postpone","to postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"revising","accept":[],"options":["to revising","revise","revising","to revise"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"crying","accept":[],"options":["cry","to cry","crying","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."}]}