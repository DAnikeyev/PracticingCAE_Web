{"id":"verb-patterns-0017","taskId":"verb-patterns","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"to upgrade","accept":[],"options":["upgrading","to upgrade","upgrade","to upgrading"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"to water","accept":[],"options":["watering","to water","water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"He refused ___ for the damage.","hint":"refuse \u002B ?","explanation":"refuse takes the to-infinitive: refused to pay."},{"answer":"to inform","accept":[],"options":["informing","to inform","inform","to informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"to hear","accept":[],"options":["hearing","to hear","hear","to hearing"],"base":null,"keyword":null,"lead":null,"sentence":"We hope ___ from you soon.","hint":"hope \u002B ?","explanation":"hope takes the to-infinitive: hope to hear."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"failing","accept":[],"options":["to fail","failing","fail","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."}]}