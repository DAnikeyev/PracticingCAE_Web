{"id":"verb-patterns-0017","taskId":"verb-patterns","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"to learn","accept":[],"options":["learn","to learning","learning","to learn"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"living","accept":[],"options":["to living","living","to live","live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"not to hear","accept":[],"options":["not hear","to not hear","not to hear","not hearing"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"to eat","accept":[],"options":["to eating","to eat","eating","eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"moving","accept":[],"options":["move","to move","to moving","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to mend","accept":[],"options":["to mending","mend","mending","to mend"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"getting","accept":[],"options":["to getting","getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"stay","accept":[],"options":["to stay","to staying","stay","staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."}]}