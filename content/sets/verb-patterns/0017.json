{"id":"verb-patterns-0017","taskId":"verb-patterns","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"to meet","accept":[],"options":["meet","meeting","to meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"Do you want me ___ you at the station?","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want me to meet."},{"answer":"living","accept":[],"options":["to living","to live","live","living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"photography","accept":["photographing"],"options":["photography","photograph","to photograph","photographing"],"base":null,"keyword":null,"lead":null,"sentence":"They don\u0027t allow ___ in the museum.","hint":"allow \u002B noun / allow sb to do","explanation":"allow \u002B noun/-ing (no personal object): they don\u0027t allow photography. With a person: allow visitors to photograph."},{"answer":"to bring","accept":[],"options":["bring","to bring","bringing","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"crying","accept":[],"options":["to cry","to crying","crying","cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"asking","accept":[],"options":["ask","to ask","asked","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"stay","accept":[],"options":["stay","to staying","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"taking","accept":[],"options":["to take","taking","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."}]}