{"id":"verb-patterns-0115","taskId":"verb-patterns","title":"Drill set 115","text":null,"source":"drill","gaps":[{"answer":"to meet","accept":[],"options":["meet","meeting","to meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"not to be","accept":[],"options":["not to be","not being","to not be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"talking","accept":[],"options":["talk","to talk","talking","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"to get","accept":[],"options":["getting","to get","to getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t afford ___ her car repaired this month.","hint":"afford \u002B ?","explanation":"afford \u002B to-infinitive: can\u0027t afford to get."},{"answer":"carry","accept":["to carry"],"options":["carry","to carry","carrying","carry to"],"base":null,"keyword":null,"lead":null,"sentence":"Could you help me ___ these boxes upstairs?","hint":"help \u002B (to) do","explanation":"help takes a bare infinitive or to-infinitive: help me (to) carry. Both accepted."},{"answer":"complaining","accept":[],"options":["complain","complaining","to complain","complained"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"living","accept":[],"options":["living","live","to live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"meeting","accept":[],"options":["meet","meeting","to meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"The children are looking forward to ___ Father Christmas.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: looking forward to meeting."}]}