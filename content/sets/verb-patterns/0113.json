{"id":"verb-patterns-0113","taskId":"verb-patterns","title":"Drill set 113","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to getting","get","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"breaking","accept":[],"options":["to breaking","to break","breaking","break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to have","accept":[],"options":["to having","have","to have","having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."},{"answer":"to meet","accept":[],"options":["to meeting","meet","to meet","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"photography","accept":["photographing"],"options":["to photograph","photography","photograph","photographing"],"base":null,"keyword":null,"lead":null,"sentence":"They don\u0027t allow ___ in the museum.","hint":"allow \u002B noun / allow sb to do","explanation":"allow \u002B noun/-ing (no personal object): they don\u0027t allow photography. With a person: allow visitors to photograph."},{"answer":"missing","accept":[],"options":["missed","to miss","missing","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"crying","accept":[],"options":["to crying","to cry","cry","crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"read","accept":[],"options":["have read","read","to read","reading"],"base":null,"keyword":null,"lead":null,"sentence":"We had better ___ the terms carefully before signing anything.","hint":"had better \u002B bare infinitive","explanation":"\u0027Had better\u0027 is followed by the infinitive without \u0027to\u0027."}]}