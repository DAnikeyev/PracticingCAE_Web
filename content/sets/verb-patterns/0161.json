{"id":"verb-patterns-0161","taskId":"verb-patterns","title":"Drill set 161","text":null,"source":"drill","gaps":[{"answer":"selling","accept":[],"options":["sold","selling","to sell","sell"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"struggling","accept":[],"options":["struggle","to struggle","struggling","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"stay","accept":[],"options":["to stay","staying","to staying","stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"preparing","accept":[],"options":["preparing","prepare","prepared","to prepare"],"base":null,"keyword":null,"lead":null,"sentence":"He spent months ___ the application, only to be rejected in minutes.","hint":"spend time \u002B -ing","explanation":"\u0027Spend time doing something\u0027 takes the gerund."},{"answer":"to get","accept":[],"options":["get","getting","to get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t afford ___ her car repaired this month.","hint":"afford \u002B ?","explanation":"afford \u002B to-infinitive: can\u0027t afford to get."},{"answer":"driving","accept":[],"options":["to driving","to drive","drive","driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to spend","accept":[],"options":["spending","spend","spent","to spend"],"base":null,"keyword":null,"lead":null,