{"id":"verb-patterns-0149","taskId":"verb-patterns","title":"Drill set 149","text":null,"source":"drill","gaps":[{"answer":"to have","accept":[],"options":["to having","to have","have","having"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"missing","accept":[],"options":["missing","to miss","miss","missed"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"saying","accept":[],"options":["to saying","to say","say","saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"apologise","accept":[],"options":["apologised","apologising","apologise","to apologise"],"base":null,"keyword":null,"lead":null,"sentence":"They made me ___ for the whole team\u0027s mistake.","hint":"made \u002B bare infinitive","explanation":"make \u002B object \u002B bare infinitive in active sentences: made me apologise."},{"answer":"to warn","accept":[],"options":["warn","warning","to warning","to warn"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"handling","accept":[],"options":["to handling","handling","to handle","handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"breaking","accept":[],"options":["to break","to breaking","breaking","break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"losing","accept":[],"options":["losing","to lose","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."}]}