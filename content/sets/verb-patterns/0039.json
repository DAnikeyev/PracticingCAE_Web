{"id":"verb-patterns-0039","taskId":"verb-patterns","title":"Drill set 39","text":null,"source":"drill","gaps":[{"answer":"building","accept":[],"options":["build","building","to build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to operate","accept":[],"options":["operating","to operate","operate","to operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"quitting","accept":[],"options":["quit","quitting","to quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"catching","accept":[],"options":["catch","to catch","catching","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"selling","accept":[],"options":["selling","sell","sold","to sell"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"to have","accept":[],"options":["having","to having","have","to have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"knocking","accept":[],"options":["knocking","to knock","to knocking","knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"stay","accept":[],"options":["to stay","to staying","staying","stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."}]}