{"id":"verb-patterns-0089","taskId":"verb-patterns","title":"Drill set 89","text":null,"source":"drill","gaps":[{"answer":"going","accept":["to go"],"options":["go","to going","to go","going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"opening","accept":[],"options":["opened","to open","opening","open"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"asking","accept":[],"options":["to ask","ask","asked","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"moving","accept":[],"options":["to move","move","moving","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to get","accept":[],"options":["to get","get","got","getting"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ something to eat at the motorway services.","hint":"stop in order to","explanation":"\u0027Stopped to get\u0027 = paused for the purpose; \u0027stopped getting\u0027 would mean quit eating."},{"answer":"to learn","accept":[],"options":["to learning","to learn","learn","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to water","accept":[],"options":["water","watering","to watering","to water"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"talking","accept":[],"options":["to talking","talking","talk","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."}]}