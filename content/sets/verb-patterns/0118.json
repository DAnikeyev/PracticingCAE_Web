{"id":"verb-patterns-0118","taskId":"verb-patterns","title":"Drill set 118","text":null,"source":"drill","gaps":[{"answer":"argue","accept":[],"options":["to argue","argue","argued","arguing"],"base":null,"keyword":null,"lead":null,"sentence":"Let\u0027s not ___ about it until we know more.","hint":"let\u0027s \u002B bare infinitive","explanation":"let\u0027s \u002B bare infinitive (negative: let\u0027s not argue)."},{"answer":"being","accept":[],"options":["be","being","to be","been"],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude to the waiter.","hint":"preposition \u002B gerund","explanation":"\u0027Apologise for being\u0027 \u2014 \u0027for\u0027 is a preposition, so the gerund follows."},{"answer":"missing","accept":[],"options":["to miss","miss","missing","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"working","accept":["to work"],"options":["working","work","to work","to working"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"hearing","accept":[],"options":["heard","to hear","hearing","hear"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"paying","accept":[],"options":["pay","to pay","paying","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"having done","accept":["doing"],"options":["doing","done","to do","having done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"asking","accept":[],"options":["ask","asked","asking","to ask"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."}]}