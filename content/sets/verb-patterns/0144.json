{"id":"verb-patterns-0144","taskId":"verb-patterns","title":"Drill set 144","text":null,"source":"drill","gaps":[{"answer":"to eat","accept":[],"options":["eating","to eat","to eating","eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"to stay","accept":[],"options":["staying","to stay","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"moving","accept":[],"options":["moving","move","to moving","to move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"having done","accept":[],"options":["to have done","done","having done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to lock","accept":[],"options":["locked","lock","locking","to lock"],"base":null,"keyword":null,"lead":null,"sentence":"Did you remember ___ the window before we left?","hint":"remember first, then do","explanation":"\u0027Remember to do\u0027 = not forget an obligation; \u0027remember locking\u0027 recalls a past action."},{"answer":"to undo","accept":[],"options":["to undoing","to undo","undoing","undo"],"base":null,"keyword":null,"lead":null,"sentence":"Do you have any idea how ___ this knot?","hint":"how \u002B ?","explanation":"question word \u002B to-infinitive: how to undo."},{"answer":"drinking","accept":[],"options":["drank","drinking","drink","to drink"],"base":null,"keyword":null,"lead":null,"sentence":"He stopped ___ coffee before bed and now sleeps much better.","hint":"quit the habit","explanation":"\u0027Stop doing\u0027 = quit the activity; \u0027stop to drink\u0027 would mean pause in order to drink."},{"answer":"getting","accept":[],"options":["to getting","get","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."}]}