{"id":"verb-patterns-0144","taskId":"verb-patterns","title":"Drill set 144","text":null,"source":"drill","gaps":[{"answer":"handling","accept":[],"options":["to handling","to handle","handle","handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"being","accept":[],"options":["been","being","be","to be"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t stand ___ kept waiting when I have an appointment.","hint":"can\u0027t stand \u002B passive gerund","explanation":"\u0027Can\u0027t stand\u0027 takes a gerund; the passive gerund is \u0027being kept\u0027."},{"answer":"to learn","accept":[],"options":["learning","to learning","learn","to learn"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to upset","accept":[],"options":["to upset","to upsetting","upset","upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"living","accept":[],"options":["live","living","to live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"moving","accept":[],"options":["to move","to moving","move","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"selling","accept":[],"options":["sell","selling","to sell","sold"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"to have","accept":[],"options":["to have","have","having","to having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."}]}