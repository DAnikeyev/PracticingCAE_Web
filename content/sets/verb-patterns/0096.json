{"id":"verb-patterns-0096","taskId":"verb-patterns","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"breaking","accept":[],"options":["breaking","break","to breaking","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to eat","accept":[],"options":["eat","to eat","eating","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"catching","accept":[],"options":["to catching","catching","to catch","catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"taking","accept":[],"options":["taking","to taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to upgrade","accept":[],"options":["upgrading","upgrade","to upgrade","to upgrading"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"to warn","accept":[],"options":["warning","warn","to warn","to warning"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"to go","accept":[],"options":["to going","to go","go","going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":