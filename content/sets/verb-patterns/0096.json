{"id":"verb-patterns-0096","taskId":"verb-patterns","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"complaining","accept":[],"options":["to complain","complaining","complain","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"to bring","accept":[],"options":["bringing","to bring","bring","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"drinking","accept":[],"options":["to drink","drinking","drink","to drinking"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"meeting","accept":[],"options":["meet","to meet","meeting","met"],"base":null,"keyword":null,"lead":null,"sentence":"The children are looking forward to ___ Father Christmas.","hint":"look forward