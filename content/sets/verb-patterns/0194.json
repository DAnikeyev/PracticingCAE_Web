{"id":"verb-patterns-0194","taskId":"verb-patterns","title":"Drill set 194","text":null,"source":"drill","gaps":[{"answer":"laughing","accept":[],"options":["to laugh","to laughing","laugh","laughing"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"arguing","accept":[],"options":["arguing","to argue","argue","argued"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"missing","accept":[],"options":["miss","to miss","missing","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to mend","accept":[],"options":["to mend","to mending","mending","mend"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"living","accept":[],"options":["to living","living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"to put","accept":[],"options":["to put","to putting","put","putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"to spend","accept":[],"options":["spent","spend","to spend","spending"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"being","accept":[],"options":["to being","be","being","to be"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."}]}