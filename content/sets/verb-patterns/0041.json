{"id":"verb-patterns-0041","taskId":"verb-patterns","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"saying","accept":[],"options":["to say","saying","say","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"to have","accept":[],"options":["having","to have","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"stay","accept":[],"options":["to stay","staying","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"to meet","accept":[],"options":["meeting","to meet","meet","to meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"driving","accept":[],"options":["to drive","driving","drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to live","accept":[],"options":["living","to live","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"}]}