{"id":"verb-patterns-0041","taskId":"verb-patterns","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"catching","accept":[],"options":["catch","to catching","to catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to meet","accept":[],"options":["to meet","to meeting","meet","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"to pay","accept":[],"options":["paying","paid","pay","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"He was made ___ for the damage to the rental car.","hint":"passive of \u0022make\u0022 needs \u0022to\u0022","explanation":"In the passive, \u0027be made to do\u0027 takes the to-infinitive."},{"answer":"waiting","accept":["to wait"],"options":["to wait","waiting","to waiting","wait"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"taking","accept":[],"options":["take","to taking","to take","taking"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"to put","accept":[],"options":["to put","to putting","putting","put"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"not to hear","accept":[],"options":["not hearing","to not hear","not hear","not to hear"],"base":null,"keyword":null,"le