{"id":"verb-patterns-0082","taskId":"verb-patterns","title":"Drill set 82","text":null,"source":"drill","gaps":[{"answer":"failing","accept":[],"options":["to fail","failing","fail","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"to have","accept":[],"options":["to have","to having","have","having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."},{"answer":"catching","accept":[],"options":["catch","catching","to catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"stay","accept":[],"options":["stayed","stay","to stay","staying"],"base":null,"keyword":null,"lead":null,"sentence":"She would rather ___ at home tonight.","hint":"would rather \u002B base verb","explanation":"\u0027Would rather do\u0027 \u2014 the bare infinitive follows."},{"answer":"laughing","accept":[],"options":["to laugh","laugh","to laughing","laughing"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"asking","accept":[],"options":["ask","asked","to ask","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"saying","accept":[],"options":["to say","to saying","say","saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"hearing","accept":[],"options":["hearing","heard","hear","to hear"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."}]}