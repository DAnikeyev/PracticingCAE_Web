{"id":"verb-patterns-0182","taskId":"verb-patterns","title":"Drill set 182","text":null,"source":"drill","gaps":[{"answer":"turning","accept":[],"options":["turn","turning","to turning","to turn"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"paying","accept":[],"options":["pay","paying","to pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"to control","accept":[],"options":["control","controlling","to control","to controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"to show","accept":[],"options":["to show","showing","to showing","show"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t wait ___ you the photos.","hint":"can\u0027t wait \u002B ?","explanation":"can\u0027t wait \u002B to-infinitive: can\u0027t wait to show."},{"answer":"getting","accept":[],"options":["to getting","get","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to live","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"to attract","accept":["at attracting"],"options":["to attract","to attracting","attract","attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."}]}