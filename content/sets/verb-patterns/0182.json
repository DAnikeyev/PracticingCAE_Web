{"id":"verb-patterns-0182","taskId":"verb-patterns","title":"Drill set 182","text":null,"source":"drill","gaps":[{"answer":"to control","accept":[],"options":["to control","to controlling","control","controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"to wait","accept":[],"options":["waiting","wait","to wait","waited"],"base":null,"keyword":null,"lead":null,"sentence":"I was made ___ the dustbin lorry at six in the morning.","hint":"passive: was made ___","explanation":"In the passive, make takes the to-infinitive: was made to wait."},{"answer":"stay","accept":[],"options":["to staying","stay","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"disturb","accept":[],"options":["disturbed","disturb","disturbing","to disturb"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."},{"answer":"struggling","accept":[],"options":["struggling","struggle","to struggling","to struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"revising","accept":[],"options":["revise","revising","to revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"complaining","accept":[],"options":["to complain","complaining","complained","complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"to have","accept":[],"options":["have","to having","to have","having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."}]}