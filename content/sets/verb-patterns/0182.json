{"id":"verb-patterns-0182","taskId":"verb-patterns","title":"Drill set 182","text":null,"source":"drill","gaps":[{"answer":"going","accept":[],"options":["going","go","to go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"},{"answer":"paying","accept":[],"options":["pay","to paying","to pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"to tell","accept":[],"options":["told","tell","to tell","telling"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"losing","accept":[],"options":["to lose","losing","to losing","lose"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"living","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"being","accept":[],"options":["been","to be","being","be"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t stand ___ kept waiting when I have an appointment.","hint":"can\u0027t stand \u002B passive gerund","explanation":"\u0027Can\u0027t stand\u0027 takes a gerund; the passive gerund is \u0027being kept\u0027."},{"answer":"having done","accept":[],"options":["to have done","to do","done","having done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to upset","accept":[],"options":["to upset","upset","upsetting","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"}]}