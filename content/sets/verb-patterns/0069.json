{"id":"verb-patterns-0069","taskId":"verb-patterns","title":"Drill set 69","text":null,"source":"drill","gaps":[{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"drinking","accept":[],"options":["to drink","drinking","drink","to drinking"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"crying","accept":[],"options":["to cry","crying","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"tidy","accept":[],"options":["to tidy","tidying","tidy","tidied"],"base":null,"keyword":null,"lead":null,"sentence":"She made her son ___ his room before dinner.","hint":"make sb \u002B ?","explanation":"make \u002B object \u002B bare infinitive: made him tidy (passive takes to: was made to tidy)."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"didn\u0027t","accept":[],"options":["don\u0027t","didn\u0027t","not","won\u0027t"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."}]}