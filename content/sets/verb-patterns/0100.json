{"id":"verb-patterns-0100","taskId":"verb-patterns","title":"Drill set 100","text":null,"source":"drill","gaps":[{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"quitting","accept":[],"options":["to quit","quitting","quit","to quitting"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"to mend","accept":[],"options":["mending","to mend","mend","to mending"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"arguing","accept":[],"options":["to argue","arguing","argue","argued"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"m