{"id":"verb-patterns-0018","taskId":"verb-patterns","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"laughing","accept":[],"options":["to laughing","laugh","to laugh","laughing"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"having done","accept":[],"options":["to have done","having done","done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to learn","accept":[],"options":["learning","learn","to learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"talking","accept":[],"options":["talk","to talking","talking","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"He went on ___ even after the audience had left.","hint":"continue the same activity","explanation":"go on \u002B -ing = continue the same activity; go on to do = do something next."},{"answer":"to live","accept":[],"options":["living","live","to living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"being","accept":[],"options":["be","being","to being","to be"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"living","accept":[],"options":["live","living","to living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"being","accept":[],"options":["been","to be","being","be"],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude to the waiter.","hint":"preposition \u002B gerund","explanation":"\u0027Apologise for being\u0027 \u2014 \u0027for\u0027 is a preposition, so the gerund follows."}]}