{"id":"verb-patterns-0018","taskId":"verb-patterns","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"to control","accept":[],"options":["to control","controlling","to controlling","control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"go","accept":[],"options":["go","going","to go","went"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out past midnight.","hint":"let \u002B bare infinitive","explanation":"\u0027Let someone do\u0027 \u2014 \u0027let\u0027 takes the bare infinitive."},{"answer":"to turn","accept":[],"options":["turn","to turning","to turn","turning"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"repairing","accept":[],"options":["to repair","repair","to repairing","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"to check","accept":[],"options":["check","to check","to checking","checking"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"taking","accept":[],"options":["to take","taking","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"getting","accept":[],"options":["get","to get","to getting","getting"],"base":null,"key