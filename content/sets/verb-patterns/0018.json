{"id":"verb-patterns-0018","taskId":"verb-patterns","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"to wait","accept":[],"options":["waiting","to wait","wait","waited"],"base":null,"keyword":null,"lead":null,"sentence":"I was made ___ the dustbin lorry at six in the morning.","hint":"passive: was made ___","explanation":"In the passive, make takes the to-infinitive: was made to wait."},{"answer":"to check","accept":[],"options":["checking","to check","check","to checking"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"to upset","accept":[],"options":["upsetting","to upset","upset","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"to mend","accept":[],"options":["mending","to mend","mend","to mending"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to control","accept":[],"options":["controlling","to control","control","to controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."}]}