{"id":"verb-patterns-0014","taskId":"verb-patterns","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"let","accept":[],"options":["let","allow","make","permit"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"He went on ___ even after the audience had left.","hint":"continue the same activity","explanation":"go on \u002B -ing = continue the same activity; go on to do = do something next."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"argue","accept":[],"options":["to argue","arguing","argue","argued"],"base":null,"keyword":null,"lead":null,"sentence":"Let\u0027s not ___ about it until we know more.","hint":"let\u0027s \u002B bare infinitive","explanation":"let\u0027s \u002B bare infinitive (negative: let\u0027s not argue)."},{"answer":"to redecorate","accept":["on redecorating"],"options":["redecorating","to redecorate","redecorate","to redecorating"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"crying","accept":[],"options":["to cry","crying","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."}]}