{"id":"verb-patterns-0067","taskId":"verb-patterns","title":"Drill set 67","text":null,"source":"drill","gaps":[{"answer":"drive","accept":[],"options":["driven","to drive","driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"talking","accept":[],"options":["talk","to talk","talking","talked"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the incident for weeks.","hint":"avoid \u002B -ing","explanation":"\u0027Avoid\u0027 is always followed by the -ing form."},{"answer":"having done","accept":[],"options":["having done","to do","done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"paying","accept":[],"options":["to pay","pay","to paying","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"to know","accept":[],"options":["know","knowing","to knowing","to know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"going","accept":[],"options":["to going","go","going","to go"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"},{"answer":"missing","accept":[],"options":["miss","missing","to miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to put","accept":[],"options":["to putting","to put","putting","put"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."}]}