{"id":"verb-patterns-0067","taskId":"verb-patterns","title":"Drill set 67","text":null,"source":"drill","gaps":[{"answer":"failing","accept":[],"options":["to failing","to fail","failing","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"postponing","accept":[],"options":["postpone","to postpone","postponed","postponing"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"repairing","accept":[],"options":["to repairing","to repair","repair","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"to tell","accept":[],"options":["told","tell","telling","to tell"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"drive","accept":[],"options":["drive","to drive","driving","driven"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"seeing","accept":[],"options":["see","to seeing","to see","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to eat","accept":[],"options":["eating","to eat","to eating","eat"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"handling","accept":[],"options":["to handling","handling","to handle","handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."}]}