{"id":"verb-patterns-0075","taskId":"verb-patterns","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"worrying","accept":[],"options":["to worry","worrying","worry","to worrying"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point ___ about it now.","hint":"no point \u002B ?","explanation":"there\u0027s no point \u002B -ing: no point worrying."},{"answer":"sending","accept":[],"options":["to send","sending","send","to sending"],"base":null,"keyword":null,"lead":null,"sentence":"She forgot ___ the email, so she sent it twice.","hint":"she had already sent it","explanation":"forget \u002B -ing = lose the memory of a past action (she did send it)."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"catching","accept":[],"options":["to catch","catching","catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to have","accept":[],"options":["having","to have","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."}]}