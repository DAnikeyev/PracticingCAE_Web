{"id":"verb-patterns-0075","taskId":"verb-patterns","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"opening","accept":[],"options":["opening","opened","open","to open"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"going","accept":["to go"],"options":["going","go","to go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to upset","accept":[],"options":["to upsetting","to upset","upset","upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"to eat","accept":[],"options":["eating","to eat","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"to spend","accept":[],"options":["spend","spent","spending","to spend"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"seeing","accept":[],"options":["to seeing","to see","seeing","see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to stay","accept":[],"options":["staying","to stay","to staying","stay"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."}]}