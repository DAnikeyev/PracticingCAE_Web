{"id":"verb-patterns-0005","taskId":"verb-patterns","title":"Drill set 5","text":null,"source":"drill","gaps":[{"answer":"go","accept":[],"options":["going","to going","to go","go"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out that late.","hint":"let \u002B ?","explanation":"let takes the bare infinitive: let me go (no \u0027to\u0027)."},{"answer":"handling","accept":[],"options":["to handle","handle","to handling","handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"living","accept":[],"options":["living","to live","to living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"to describe","accept":[],"options":["to describing","to describe","describing","describe"],"base":null,"keyword":null,"lead":null,"sentence":"After introducing herself, she went on ___ the main findings.","hint":"move on to a new activity","explanation":"go on \u002B to-infinitive = do something after finishing something else."},{"answer":"being","accept":[],"options":["being","to be","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"to meet","accept":[],"options":["meeting","meet","to meet","to meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"living","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"failing","accept":[],"options":["to failing","failing","to fail","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."}]}