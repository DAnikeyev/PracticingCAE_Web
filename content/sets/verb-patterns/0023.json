{"id":"verb-patterns-0023","taskId":"verb-patterns","title":"Drill set 23","text":null,"source":"drill","gaps":[{"answer":"losing","accept":[],"options":["to losing","to lose","losing","lose"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"being","accept":[],"options":["being","to be","to being","be"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"to get","accept":[],"options":["getting","to get","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"It took me ages ___ used to the new keyboard.","hint":"it takes time \u002B ?","explanation":"it takes time \u002B to-infinitive: took me ages to get used to the keyboard."},{"answer":"trying","accept":[],"options":["to trying","trying","to try","try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"moving","accept":[],"options":["to move","to moving","moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to upgrade","accept":[],"options":["upgrade","upgrading","to upgrade","to upgrading"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"missing","accept":[],"options":["miss","missing","missed","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"She admitted ___ the last train and had to take a taxi.","hint":"admit \u002B -ing","explanation":"\u0027Admit doing\u0027 \u2014 confess to a past action takes the gerund."},{"answer":"rewrite","accept":[],"options":["to rewrite","rewrite","rewriting","rewrote"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher made us ___ the whole essay again.","hint":"make \u002B bare infinitive","explanation":"\u0027Make someone do\u0027 \u2014 active \u0027make\u0027 takes the bare infinitive."}]}