{"id":"verb-patterns-0023","taskId":"verb-patterns","title":"Drill set 23","text":null,"source":"drill","gaps":[{"answer":"turning","accept":[],"options":["to turning","to turn","turn","turning"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"opening","accept":[],"options":["open","to open","opened","opening"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"to spend","accept":[],"options":["to spend","spending","spend","spent"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"building","accept":[],"options":["to build","build","building","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to inform","accept":[],"options":["to informing","to inform","informing","inform"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"to control","accept":[],"options":["to control","to controlling","control","controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"queueing","accept":["queuing"],"options":["to queu