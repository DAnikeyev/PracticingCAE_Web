{"id":"verb-patterns-0104","taskId":"verb-patterns","title":"Drill set 104","text":null,"source":"drill","gaps":[{"answer":"to have seen","accept":[],"options":["seeing","to see","have seen","to have seen"],"base":null,"keyword":null,"lead":null,"sentence":"The witness claims ___ the getaway car parked outside for an hour.","hint":"claim \u002B perfect infinitive","explanation":"\u0027Claims to have seen\u0027 \u2014 the perfect infinitive marks an earlier action."},{"answer":"to pay","accept":[],"options":["paid","to pay","pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"He was made ___ for the damage to the rental car.","hint":"passive of \u0022make\u0022 needs \u0022to\u0022","explanation":"In the passive, \u0027be made to do\u0027 takes the to-infinitive."},{"answer":"knocking","accept":[],"options":["to knocking","to knock","knocking","knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"rewrite","accept":[],"options":["rewrote","rewrite","to rewrite","rewriting"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher made us ___ the whole essay again.","hint":"make \u002B bare infinitive","explanation":"\u0027Make someone do\u0027 \u2014 active \u0027make\u0027 takes the bare infinitive."},{"answer":"living","accept":[],"options":["living","to live","to living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"take","accept":[],"options":["took","to take","take","taking"],"base":null,"keyword":null,"lead":null,"sentence":"Rather than ___ the risk, the airline cancelled all flights.","hint":"rather than \u002B bare infinitive","explanation":"\u0027Rather than\u0027 is followed by the bare infinitive in this contrastive use."},{"answer":"handling","accept":[],"options":["to handling","handle","handling","to handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"not to hear","accept":[],"options":["not hear","not hearing","not to hear","to not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."}]}