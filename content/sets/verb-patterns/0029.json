{"id":"verb-patterns-0029","taskId":"verb-patterns","title":"Drill set 29","text":null,"source":"drill","gaps":[{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"to hear","accept":[],"options":["hearing","to hear","hear","to hearing"],"base":null,"keyword":null,"lead":null,"sentence":"We hope ___ from you soon.","hint":"hope \u002B ?","explanation":"hope takes the to-infinitive: hope to hear."},{"answer":"to tell","accept":[],"options":["tell","telling","to tell","told"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"losing","accept":[],"options":["to lose","losing","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"building","accept":[],"options":["to build","building","build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"having done","accept":["doing"],"options":["to do","doing","having done","done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to go","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."}]}