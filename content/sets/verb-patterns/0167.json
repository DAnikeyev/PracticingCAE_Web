{"id":"verb-patterns-0167","taskId":"verb-patterns","title":"Drill set 167","text":null,"source":"drill","gaps":[{"answer":"climb","accept":["climbing"],"options":["climb","climbing","climbed","to climb"],"base":null,"keyword":null,"lead":null,"sentence":"I saw him ___ the wall and disappear into the garden.","hint":"see sb do (complete action)","explanation":"see/hear \u002B object \u002B bare infinitive = the complete action; -ing = the action in progress. Both readings possible here; the bare infinitive is expected."},{"answer":"to know","accept":[],"options":["know","knowing","to know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"getting","accept":[],"options":["get","to getting","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to meet","accept":[],"options":["to meet","meeting","meet","met"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"to learn","accept":[],"options":["learn","learning","to learning","to learn"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to tell","accept":[],"options":["told","to tell","tell","telling"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"having done","accept":[],"options":["to do","to have done","done","having done"],"base":null,"keyword":null,"lead":nu