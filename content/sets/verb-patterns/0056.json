{"id":"verb-patterns-0056","taskId":"verb-patterns","title":"Drill set 56","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["talk","to talking","to talk","talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"crying","accept":[],"options":["cry","to crying","to cry","crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"postponing","accept":[],"options":["postponed","postponing","to postpone","postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"moving","accept":[],"options":["to move","to moving","moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"stay","accept":[],"options":["stay","staying","to stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"complaining","accept":[],"options":["complain","complaining","complained","to complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"to take","accept":[],"options":["taking","take","to take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"On the way to Rome we stopped ___ some photos.","hint":"stop in order to do sth","explanation":"stop to do = pause in order to do; stop doing = finish doing. Here they paused to take photos."},{"answer":"to have","accept":[],"options":["having","to having","have","to have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."}]}