{"id":"verb-patterns-0024","taskId":"verb-patterns","title":"Drill set 24","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"missing","accept":[],"options":["missing","miss","to miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to put","accept":[],"options":["put","to put","to putting","putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"to see","accept":[],"options":["saw","to see","seen","see"],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the circus.","hint":"excited \u002B to-infinitive","explanation":"\u0027Excited to see\u0027 \u2014 the to-infinitive follows the adjective."},{"answer":"to operate","accept":[],"options":["operating","operate","to operate","to operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"saying","accept":[],"options":["saying","to saying","to say","say"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: