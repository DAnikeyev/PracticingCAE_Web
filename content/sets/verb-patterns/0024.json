{"id":"verb-patterns-0024","taskId":"verb-patterns","title":"Drill set 24","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["talking","to talking","talk","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"waiting","accept":["to wait"],"options":["wait","to wait","waiting","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"trying","accept":[],"options":["to try","try","tried","trying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ to start the engine \u2014 the battery is completely flat.","hint":"it\u0027s no use \u002B -ing","explanation":"\u0027It\u0027s no use\u0027 is followed by a gerund."},{"answer":"knocking","accept":[],"options":["to knock","knock","to knocking","knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"seeing","accept":[],"options":["seeing","saw","to see","see"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."},{"answer":"opening","accept":[],"options":["open","to open","opening","opened"],"base":null,"keyword":null,"lead":null,"sentence":"Would you mind ___ the window? It\u0027s boiling in here.","hint":"mind \u002B ?","explanation":"mind is followed by -ing: Would you mind opening\u2026?"},{"answer":"breaking","accept":[],"options":["breaking","break","to breaking","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"missing","accept":[],"options":["miss","to missing","to miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."}]}