{"id":"verb-patterns-0045","taskId":"verb-patterns","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"to see","accept":[],"options":["see","to see","seen","saw"],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the circus.","hint":"excited \u002B to-infinitive","explanation":"\u0027Excited to see\u0027 \u2014 the to-infinitive follows the adjective."},{"answer":"having done","accept":[],"options":["done","to do","having done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to play","accept":[],"options":["playing","to play","to playing","play"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m learning ___ the guitar at the moment.","hint":"learn \u002B ?","explanation":"learn takes the to-infinitive (learn how to play)."},{"answer":"to reach","accept":[],"options":["to reach","reached","reaching","reach"],"base":null,"keyword":null,"lead":null,"sentence":"He was the first climber ___ the summit without oxygen.","hint":"the first \u002B to-infinitive","explanation":"After \u0027the first/last/only \u002B noun\u0027 a to-infinitive follows."},{"answer":"having done","accept":["doing"],"options":["doing","to do","done","having done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"revising","accept":[],"options":["to revise","to revising","revise","revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"to eat","accept":[],"options":["eat","eating","to eating","to eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"not to be","accept":[],"options":["not to be","not be","to not be","not being"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."}]}