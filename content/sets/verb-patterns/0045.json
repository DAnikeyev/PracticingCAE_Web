{"id":"verb-patterns-0045","taskId":"verb-patterns","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"breaking","accept":[],"options":["to break","breaking","break","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"cleared","accept":[],"options":["clear","to clear","cleared","clearing"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."},{"answer":"to receive","accept":[],"options":["receiving","to receive","receive","to receiving"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation"