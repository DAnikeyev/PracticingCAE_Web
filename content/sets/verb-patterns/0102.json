{"id":"verb-patterns-0102","taskId":"verb-patterns","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":["repair","repairing","to repair","to repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"to meet","accept":[],"options":["met","meet","meeting","to meet"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"to go","accept":[],"options":["to go","go","to going","going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."},{"answer":"to lock","accept":[],"options":["lock","locked","locking","to lock"],"base":null,"keyword":null,"lead":null,"sentence":"Did you remember ___ the window before we left?","hint":"remember first, then do","explanation":"\u0027Remember to do\u0027 = not forget an obligation; \u0027remember locking\u0027 recalls a past action."},{"answer":"to know","accept":[],"options":["knowing","know","to know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"having done","accept":["doing"],"options":["having done","to do","done","doing"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"to meet","accept":[],"options":["to meeting","meeting","to meet","meet"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"complaining","accept":[],"options":["complain","complained","to complain","complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."}]}