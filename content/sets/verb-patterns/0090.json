{"id":"verb-patterns-0090","taskId":"verb-patterns","title":"Drill set 90","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to get","to getting","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"to stay","accept":[],"options":["to staying","stay","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"taking","accept":[],"options":["to taking","to take","take","taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"hearing","accept":[],"options":["hearing","to hear","heard","hear"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re looking forward to ___ from you soon.","hint":"\u0027to\u0027 here is a preposition","explanation":"\u0027Look forward to \u002B -ing\u0027 \u2014 \u0027to\u0027 is a preposition, so the gerund follows."},{"answer":"having done","accept":[],"options":["having done","to do","done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to play","accept":[],"options":["to playing","playing","play","to play"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m learning ___ the guitar at the moment.","hint":"learn \u002B ?","explanation":"learn takes the to-infinitive (learn how to play)."},{"answer":"not to hear","accept":[],"options":["not hear","not hearing","to not hear","not to hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"seeing","accept":[],"options":["to see","see","to seeing","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."}]}