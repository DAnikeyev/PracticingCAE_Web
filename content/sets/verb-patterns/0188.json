{"id":"verb-patterns-0188","taskId":"verb-patterns","title":"Drill set 188","text":null,"source":"drill","gaps":[{"answer":"seeing","accept":[],"options":["to see","see","saw","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."},{"answer":"having done","accept":[],"options":["done","to have done","to do","having done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"postponing","accept":[],"options":["postpone","to postpone","postponing","postponed"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"not to be","accept":[],"options":["not to be","not being","not be","to not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"to spend","accept":[],"options":["spent","spending","to spend","spend"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"to tell","accept":[],"options":["to tell","tell","told","telling"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"queueing","accept":["queuing"],"options":["to queue","queue","to queueing","queueing"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"getting","accept":[],"options":["get","to get","getting","got"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."}]}