{"id":"verb-patterns-0034","taskId":"verb-patterns","title":"Drill set 34","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"catching","accept":[],"options":["to catch","catching","catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"carry","accept":["to carry"],"options":["to carry","carrying","carry","carry to"],"base":null,"keyword":null,"lead":null,"sentence":"Could you help me ___ these boxes upstairs?","hint":"help \u002B (to) do","explanation":"help takes a bare infinitive or to-infinitive: help me (to) carry. Both accepted."},{"answer":"queueing","accept":["queuing"],"options":["to queue","queueing","queue","to queueing"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"to rain","accept":["raining"],"options":["raining","to rain","rain","to raining"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"to know","accept":[],"options":["knowing","to know","know","to knowing"],"base":null,"keyword":null,"lead":null,"sentence":"I happen ___ her from university.","hint":"happen \u002B ? (chance)","explanation":"happen \u002B to-infinitive = do something by chance: happen to know."}]}