{"id":"verb-patterns-0116","taskId":"verb-patterns","title":"Drill set 116","text":null,"source":"drill","gaps":[{"answer":"to eat","accept":[],"options":["eat","to eat","to eating","eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"hearing","accept":[],"options":["hearing","to hear","heard","hear"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"talking","accept":[],"options":["to talking","to talk","talk","talking"],"base":null,"keyword":null,"lead":null,"sentence":"He went on ___ even after the audience had left.","hint":"continue the same activity","explanation":"go on \u002B -ing = continue the same activity; go on to do = do something next."},{"answer":"to spend","accept":[],"options":["spending","spent","spend","to spend"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"quitting","accept":[],"options":["to quitting","quit","quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"seeing","accept":[],"options":["see","to seeing","to see","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"getting","accept":[],"options":["to getting","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"carry","accept":["to carry"],"options":["carry to","carrying","to carry","carry"],"base":null,"keyword":null,"lead":null,"sentence":"Could you help me ___ these boxes upstairs?","hint":"help \u002B (to) do","explanation":"help takes a bare infinitive or to-infinitive: help me (to) carry. Both accepted."}]}