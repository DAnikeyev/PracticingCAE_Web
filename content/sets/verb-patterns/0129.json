{"id":"verb-patterns-0129","taskId":"verb-patterns","title":"Drill set 129","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":["repairing","to repairing","repair","to repair"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"to take","accept":[],"options":["take","taking","to taking","to take"],"base":null,"keyword":null,"lead":null,"sentence":"On the way to Rome we stopped ___ some photos.","hint":"stop in order to do sth","explanation":"stop to do = pause in order to do; stop doing = finish doing. Here they paused to take photos."},{"answer":"crying","accept":[],"options":["to crying","crying","cry","to cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"failing","accept":[],"options":["to failing","fail","to fail","failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"to receive","accept":[],"options":["to receive","receive","to receiving","receiving"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"having done","accept":[],"options":["to have done","having done","done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"to operate","accept":[],"options":["operate","to operating","to operate","operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"missing","accept":[],"options":["miss","missing","to miss","missed"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."}]}