{"id":"verb-patterns-0015","taskId":"verb-patterns","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"queueing","accept":["queuing"],"options":["to queue","queueing","queue","to queueing"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"getting","accept":[],"options":["get","to get","getting","got"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."},{"answer":"locking","accept":[],"options":["to lock","locking","lock","to locking"],"base":null,"keyword":null,"lead":null,"sentence":"I remembered ___ the door, so I went back to check.","hint":"memory of a past action","explanation":"remember \u002B -ing = recall a past action; remember to do = not forget a duty."},{"answer":"going","accept":["to go"],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to bring","accept":[],"options":["bringing","to bring","bring","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"not to hear","accept":[],"options":["not hearing","to not hear","not to hear","not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."}]}