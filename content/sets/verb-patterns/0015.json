{"id":"verb-patterns-0015","taskId":"verb-patterns","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"saying","accept":[],"options":["to saying","say","to say","saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"failing","accept":[],"options":["to fail","failing","to failing","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"to upset","accept":[],"options":["upset","to upset","to upsetting","upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"to climb","accept":[],"options":["to climb","climb","climbed","climbing"],"base":null,"keyword":null,"lead":null,"sentence":"She was the first woman ___ the peak in winter.","hint":"the first/last \u002B ?","explanation":"the first/second/last \u002B to-infinitive: the first woman to climb."},{"answer":"not to be","accept":[],"options":["not be","to not be","not being","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"struggling","accept":[],"options":["struggle","struggling","to struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"trying","accept":[],"options":["to trying","trying","try","to try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"handling","accept":[],"options":["handling","handle","to handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."}]}