{"id":"verb-patterns-0015","taskId":"verb-patterns","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"to put","accept":[],"options":["putting","to put","put","to putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"He refused ___ for the damage.","hint":"refuse \u002B ?","explanation":"refuse takes the to-infinitive: refused to pay."},{"answer":"losing","accept":[],"options":["to lose","losing","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"to rain","accept":["raining"],"options":["raining","to rain","rain","to raining"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"meeting","accept":[],"options":["meet","to meet","meeting","met"],"base":null,"keyword":null,"lead":null,"sentence":"The children are looking forward to ___ Father Christmas.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: looking forward to meeting."},{"answer":"building","accept":[],"options":["to build","building","build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."}]}