{"id":"verb-patterns-0109","taskId":"verb-patterns","title":"Drill set 109","text":null,"source":"drill","gaps":[{"answer":"to receive","accept":[],"options":["receive","receiving","to receiving","to receive"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"laughing","accept":[],"options":["laugh","to laughing","to laugh","laughing"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"being","accept":[],"options":["been","be","being","to be"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t stand ___ kept waiting when I have an appointment.","hint":"can\u0027t stand \u002B passive gerund","explanation":"\u0027Can\u0027t stand\u0027 takes a gerund; the passive gerund is \u0027being kept\u0027."},{"answer":"to learn","accept":[],"options":["to learn","to learning","learn","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"paying","accept":[],"options":["to paying","pay","to pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"trying","accept":[],"options":["to trying","try","to try","trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"to need","accept":[],"options":["to needing","need","to need","needing"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjective \u002B enough \u002B to-infinitive: heavy enough to need."},{"answer":"handling","accept":[],"options":["to handling","handling","to handle","handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."}]}