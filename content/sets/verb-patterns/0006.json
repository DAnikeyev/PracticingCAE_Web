{"id":"verb-patterns-0006","taskId":"verb-patterns","title":"Drill set 6","text":null,"source":"drill","gaps":[{"answer":"to climb","accept":[],"options":["climbed","to climb","climbing","climb"],"base":null,"keyword":null,"lead":null,"sentence":"She was the first woman ___ the peak in winter.","hint":"the first/last \u002B ?","explanation":"the first/second/last \u002B to-infinitive: the first woman to climb."},{"answer":"building","accept":[],"options":["building","build","to building","to build"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to rain","accept":["raining"],"options":["raining","rain","to raining","to rain"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"not to be","accept":[],"options":["not be","not being","to not be","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"waiting","accept":["to wait"],"options":["waiting","to waiting","to wait","wait"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"catching","accept":[],"options":["to catching","catch","to catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"failing","accept":[],"options":["fail","to fail","failing","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"stay","accept":[],"options":["staying","stay","to stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."}]}