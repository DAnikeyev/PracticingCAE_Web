{"id":"verb-patterns-0036","taskId":"verb-patterns","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"catching","accept":[],"options":["to catch","catch","to catching","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to operate","accept":[],"options":["operate","operating","to operate","to operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"to upset","accept":[],"options":["to upset","upsetting","upset","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"getting","accept":[],"options":["get","getting","to get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"breaking","accept":[],"options":["breaking","break","to break","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to have","accept":[],"options":["to have","having","have","to having"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"failing","accept":[],"options":["failing","to failing","to fail","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"to reach","accept":[],"options":["reach","to reach","reached","reaching"],"base":null,"keyword":null,"lead":null,"sentence":"He was the first climber ___ the summit without oxygen.","hint":"the first \u002B to-infinitive","explanation":"After \u0027the first/last/only \u002B noun\u0027 a to-infinitive follows."}]}