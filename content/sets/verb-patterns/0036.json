{"id":"verb-patterns-0036","taskId":"verb-patterns","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"to inform","accept":[],"options":["informing","to inform","inform","to informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"argue","accept":[],"options":["to argue","arguing","argue","argued"],"base":null,"keyword":null,"lead":null,"sentence":"Let\u0027s not ___ about it until we know more.","hint":"let\u0027s \u002B bare infinitive","explanation":"let\u0027s \u002B bare infinitive (negative: let\u0027s not argue)."},{"answer":"to upset","accept":[],"options":["upsetting","to upset","upset","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"to meet","accept":[],"options":["meeting","to meet","meet","to meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"not to be","accept":[],"options":["not being","to not be","not to be","not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."}]}