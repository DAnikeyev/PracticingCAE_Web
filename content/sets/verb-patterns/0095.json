{"id":"verb-patterns-0095","taskId":"verb-patterns","title":"Drill set 95","text":null,"source":"drill","gaps":[{"answer":"to receive","accept":[],"options":["to receiving","receiving","receive","to receive"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"working","accept":[],"options":["working","worked","work","to work"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"having done","accept":[],"options":["done","having done","to have done","to do"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"being","accept":[],"options":["to being","to be","be","being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"to operate","accept":[],"options":["to operate","to operating","operate","operating"],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ this machine?","hint":"know how \u002B ?","explanation":"know how/what/where \u002B to-infinitive: know how to operate."},{"answer":"moving","accept":[],"options":["move","to move","moving","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"building","accept":[],"options":["building","to building","to build","build"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to have","accept":[],"options":["to have","have","to having","having"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like ___ a word with you, please.","hint":"would like \u002B ?","explanation":"would like always takes the to-infinitive: I\u0027d like to have."}]}