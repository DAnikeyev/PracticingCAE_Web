{"id":"verb-patterns-0095","taskId":"verb-patterns","title":"Drill set 95","text":null,"source":"drill","gaps":[{"answer":"not to hear","accept":[],"options":["not hearing","to not hear","not to hear","not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"to hear","accept":[],"options":["hearing","to hear","hear","to hearing"],"base":null,"keyword":null,"lead":null,"sentence":"We hope ___ from you soon.","hint":"hope \u002B ?","explanation":"hope takes the to-infinitive: hope to hear."},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"to rain","accept":["raining"],"options":["raining","to rain","rain","to raining"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"to get","accept":[],"options":["getting","to get","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t afford ___ her car repaired this month.","hint":"afford \u002B ?","explanation":"afford \u002B to-infinitive: can\u0027t afford to get."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"struggling","accept":[],"options":["to struggle","struggling","struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask