{"id":"verb-patterns-0199","taskId":"verb-patterns","title":"Drill set 199","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["talking","to talk","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"paying","accept":[],"options":["to paying","paying","pay","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"driving","accept":[],"options":["to driving","driving","drive","to drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to tell","accept":[],"options":["told","to tell","telling","tell"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"crying","accept":[],"options":["crying","to cry","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"taking","accept":[],"options":["take","taking","to taking","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"postponing","accept":[],"options":["to postpone","postpone","postponing","postponed"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"having done","accept":["doing"],"options":["done","doing","to do","having done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."}]}