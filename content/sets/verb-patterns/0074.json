{"id":"verb-patterns-0074","taskId":"verb-patterns","title":"Drill set 74","text":null,"source":"drill","gaps":[{"answer":"hearing","accept":[],"options":["heard","hearing","hear","to hear"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"to receive","accept":[],"options":["to receive","receiving","receive","to receiving"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"to stay","accept":[],"options":["stay","to staying","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"not to hear","accept":[],"options":["not to hear","not hear","not hearing","to not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"not to be","accept":[],"options":["not be","not being","not to be","to not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"working","accept":[],"options":["worked","working","to work","work"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"paying","accept":[],"options":["pay","to paying","to pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"quitting","accept":[],"options":["quit","to quitting","quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."}]}