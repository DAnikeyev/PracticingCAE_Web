{"id":"verb-patterns-0123","taskId":"verb-patterns","title":"Drill set 123","text":null,"source":"drill","gaps":[{"answer":"to warn","accept":[],"options":["to warn","to warning","warning","warn"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"missing","accept":[],"options":["to miss","missed","miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"working","accept":[],"options":["work","worked","working","to work"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"go","accept":[],"options":["to go","to going","going","go"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out that late.","hint":"let \u002B ?","explanation":"let takes the bare infinitive: let me go (no \u0027to\u0027)."},{"answer":"moving","accept":[],"options":["move","moving","to moving","to move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"hearing","accept":[],"options":["hearing","to hear","hear","heard"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re looking forward to ___ from you soon.","hint":"\u0027to\u0027 here is a preposition","explanation":"\u0027Look forward to \u002B -ing\u0027 \u2014 \u0027to\u0027 is a preposition, so the gerund follows."},{"answer":"repairing","accept":[],"options":["to repair","repair","repairing","to repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"disturb","accept":[],"options":["to disturb","disturbed","disturbing","disturb"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."}]}