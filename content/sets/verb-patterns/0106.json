{"id":"verb-patterns-0106","taskId":"verb-patterns","title":"Drill set 106","text":null,"source":"drill","gaps":[{"answer":"trying","accept":[],"options":["try","to try","to trying","trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"let","accept":[],"options":["let","make","allow","permit"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"to lift","accept":[],"options":["lifting","to lift","to lifting","lift"],"base":null,"keyword":null,"lead":null,"sentence":"I tried ___ the shelf up, but it was too heavy.","hint":"make an effort (and struggle)","explanation":"try \u002B to-infinitive = attempt, make an effort."},{"answer":"taking","accept":[],"options":["taking","take","to taking","to take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"to have","accept":[],"options":["to having","have","having","to have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"go","accept":[],"options":["going","to going","go","to go"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out that late.","hint":"let \u002B ?","explanation":"let takes the bare infinitive: let me go (no \u0027to\u0027)."},{"answer":"handling","accept":[],"options":["handling","to handling","to handle","handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"missing","accept":[],"options":["missing","miss","missed","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."}]}