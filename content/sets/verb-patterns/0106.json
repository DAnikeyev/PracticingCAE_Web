{"id":"verb-patterns-0106","taskId":"verb-patterns","title":"Drill set 106","text":null,"source":"drill","gaps":[{"answer":"to attract","accept":["at attracting"],"options":["attract","attracting","to attracting","to attract"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"to inform","accept":[],"options":["inform","to informing","informing","to inform"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"taking","accept":[],"options":["taking","to take","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"to stay","accept":[],"options":["to staying","stay","stayed","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out tonight.","hint":"would prefer \u002B to-infinitive","explanation":"\u0027Would prefer to do \u2026 rather than do\u0027."},{"answer":"talking","accept":[],"options":["talking","talk","to talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"losing","accept":[],"options":["to losing","lose","to lose","losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"hearing","accept":[],"options":["heard","to hear","hear","hearing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"living","accept":[],"options":["live","living","to living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."}]}