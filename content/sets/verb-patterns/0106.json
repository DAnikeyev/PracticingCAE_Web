{"id":"verb-patterns-0106","taskId":"verb-patterns","title":"Drill set 106","text":null,"source":"drill","gaps":[{"answer":"quitting","accept":[],"options":["to quit","quitting","quit","to quitting"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"didn\u0027t","accept":[],"options":["don\u0027t","didn\u0027t","not","won\u0027t"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"repairing","accept":[],"options":["to repair","repairing","repair","to repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"waiting","accept":["to wait"],"options":["to wait","waiting","wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"to attract","accept":["at attracting"],"options":["attracting","to attract","attract","to attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."}]}