{"id":"verb-patterns-0027","taskId":"verb-patterns","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"missing","accept":[],"options":["to miss","missed","miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"She admitted ___ the last train and had to take a taxi.","hint":"admit \u002B -ing","explanation":"\u0027Admit doing\u0027 \u2014 confess to a past action takes the gerund."},{"answer":"saying","accept":[],"options":["saying","say","to say","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"missing","accept":[],"options":["miss","missing","missed","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"paying","accept":[],"options":["to pay","paying","to paying","pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"working","accept":["to work"],"options":["to working","working","work","to work"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"struggling","accept":[],"options":["to struggling","to struggle","struggling","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"having done","accept":["doing"],"options":["having done","doing","to do","done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"drive","accept":[],"options":["driving","driven","to drive","drive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."}]}