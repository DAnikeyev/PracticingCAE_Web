{"id":"verb-patterns-0027","taskId":"verb-patterns","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"paying","accept":[],"options":["to pay","paying","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"seeing","accept":[],"options":["to see","seeing","see","to seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"drinking","accept":[],"options":["to drink","drinking","drink","to drinking"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"to get","accept":[],"options":["getting","to get","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"It took me ages ___ used to the new keyboard.","hint":"it takes time \u002B ?","explanation":"it takes time \u002B to-infinitive: took me ages to get used to the keyboard."},{"answer":"building","accept":[],"options":["to build","building","build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"to stay","accept":[],"options":["staying","to stay","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"to go","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."}]}