{"id":"verb-patterns-0027","taskId":"verb-patterns","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"to upgrade","accept":[],"options":["upgrading","upgrade","to upgrading","to upgrade"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"getting","accept":[],"options":["to getting","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"building","accept":[],"options":["build","to build","building","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to describe","accept":[],"options":["to describe","describe","to describing","describing"],"base":null,"keyword":null,"lead":null,"sentence":"After introducing herself, she went on ___ the main findings.","hint":"move on to a new activity","explanation":"go on \u002B to-infinitive = do something after finishing something else."},{"answer":"working","accept":[],"options":["working","work","to work","worked"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"to meet","accept":[],"options":["to meeting","to meet","meeting","meet"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"stay","accept":[],"options":["to staying","staying","to stay","stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"crying","accept":[],"options":["cry","to cry","to crying","crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."}]}