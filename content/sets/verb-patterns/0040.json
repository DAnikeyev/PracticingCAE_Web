{"id":"verb-patterns-0040","taskId":"verb-patterns","title":"Drill set 40","text":null,"source":"drill","gaps":[{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to climb","accept":[],"options":["climbing","to climb","climb","climbed"],"base":null,"keyword":null,"lead":null,"sentence":"She was the first woman ___ the peak in winter.","hint":"the first/last \u002B ?","explanation":"the first/second/last \u002B to-infinitive: the first woman to climb."},{"answer":"to turn","accept":[],"options":["turning","to turn","turn","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"building","accept":[],"options":["to build","building","build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"losing","accept":[],"options":["to lose","losing","lose","to losing"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"cleared","accept":[],"options":["clear","to clear","cleared","clearing"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s high time we ___ this attic.","hint":"it\u0027s time \u002B past form","explanation":"it\u0027s (high) time \u002B subject \u002B past simple (unreal past): time we cleared."}]}