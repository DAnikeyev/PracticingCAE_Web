{"id":"verb-patterns-0040","taskId":"verb-patterns","title":"Drill set 40","text":null,"source":"drill","gaps":[{"answer":"to control","accept":[],"options":["to control","controlling","control","to controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"getting","accept":[],"options":["get","to get","getting","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"missing","accept":[],"options":["miss","missing","missed","to miss"],"base":null,"keyword":null,"lead":null,"sentence":"She admitted ___ the last train and had to take a taxi.","hint":"admit \u002B -ing","explanation":"\u0027Admit doing\u0027 \u2014 confess to a past action takes the gerund."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"let","accept":[],"options":["make","permit","allow","let"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"to turn","accept":[],"options":["turning","to turn","turn","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"hearing","accept":[],"options":["hearing","to hear","heard","hear"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"living","accept":[],"options":["to living","to live","living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."}]}