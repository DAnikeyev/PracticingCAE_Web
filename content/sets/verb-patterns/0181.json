{"id":"verb-patterns-0181","taskId":"verb-patterns","title":"Drill set 181","text":null,"source":"drill","gaps":[{"answer":"to attract","accept":["at attracting"],"options":["attract","to attract","attracting","to attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"to know","accept":[],"options":["to knowing","to know","knowing","know"],"base":null,"keyword":null,"lead":null,"sentence":"I happen ___ her from university.","hint":"happen \u002B ? (chance)","explanation":"happen \u002B to-infinitive = do something by chance: happen to know."},{"answer":"stay","accept":[],"options":["staying","to staying","stay","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"queueing","accept":["queuing"],"options":["to queueing","queueing","queue","to queue"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"seeing","accept":[],"options":["to see","see","to seeing","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"breaking","accept":[],"options":["break","to breaking","to break","breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to wait","accept":[],"options":["wait","waited","waiting","to wait"],"base":null,"keyword":null,"lead":null,"sentence":"I was made ___ the dustbin lorry at six in the morning.","hint":"passive: was made ___","explanation":"In the passive, make takes the to-infinitive: was made to wait."},{"answer":"getting","accept":[],"options":["to get","to getting","get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."}]}