{"id":"verb-patterns-0064","taskId":"verb-patterns","title":"Drill set 64","text":null,"source":"drill","gaps":[{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"to bring","accept":[],"options":["bringing","to bring","bring","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"apologise","accept":[],"options":["to apologise","apologising","apologise","apologised"],"base":null,"keyword":null,"lead":null,"sentence":"They made me ___ for the whole team\u0027s mistake.","hint":"made \u002B bare infinitive","explanation":"make \u002B object \u002B bare infinitive in active sentences: made me apologise."},{"answer":"crying","accept":[],"options":["to cry","crying","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"sending","accept":[],"options":["to send","sending","send","to sending"],"base":null,"keyword":null,"lead":null,"sentence":"She forgot ___ the email, so she sent it twice.","hint":"she had already sent it","explanation":"forget \u002B -ing = lose the memory of a past action (she did send it)."}]}