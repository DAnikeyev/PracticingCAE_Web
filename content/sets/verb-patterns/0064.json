{"id":"verb-patterns-0064","taskId":"verb-patterns","title":"Drill set 64","text":null,"source":"drill","gaps":[{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"laughing","accept":[],"options":["to laugh","laughing","laugh","to laughing"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"to meet","accept":[],"options":["meeting","to meet","meet","to meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to go","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."},{"answer":"knocking","accept":[],"options":["to knock","knocking","knock","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to live","accept":[],"options":["living","to live","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"to show","accept":[],"options":["showing","to show","show","to showing"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t wait ___ you the photos.","hint":"can\u0027t wait \u002B ?","explanation":"can\u0027t wait \u002B to-infinitive: can\u0027t wait to show."}]}