{"id":"verb-patterns-0064","taskId":"verb-patterns","title":"Drill set 64","text":null,"source":"drill","gaps":[{"answer":"struggling","accept":[],"options":["struggling","to struggling","to struggle","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"catching","accept":[],"options":["catch","catching","to catching","to catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"trying","accept":[],"options":["try","trying","to trying","to try"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"drinking","accept":[],"options":["drinking","to drinking","to drink","drink"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."},{"answer":"trying","accept":[],"options":["try","tried","to try","trying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ to start the engine \u2014 the battery is completely flat.","hint":"it\u0027s no use \u002B -ing","explanation":"\u0027It\u0027s no use\u0027 is followed by a gerund."},{"answer":"stay","accept":[],"options":["stayed","to stay","stay","staying"],"base":null,"keyword":null,"lead":null,"sentence":"She would rather ___ at home tonight.","hint":"would rather \u002B base verb","explanation":"\u0027Would rather do\u0027 \u2014 the bare infinitive follows."},{"answer":"to know","accept":[],"options":["knowing","to knowing","know","to know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"going","accept":[],"options":["to going","go","going","to go"],"base":null,"keyword":null,"lead":null,"sentence":"Do you fancy ___ to the cinema tonight?","hint":"fancy \u002B ? (informal)","explanation":"fancy \u002B -ing (informal British): Do you fancy going\u2026?"}]}