{"id":"verb-patterns-0064","taskId":"verb-patterns","title":"Drill set 64","text":null,"source":"drill","gaps":[{"answer":"struggling","accept":[],"options":["struggling","to struggling","to struggle","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"repairing","accept":[],"options":["to repairing","to repair","repairing","repair"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"going","accept":["to go"],"options":["to going","to go","go","going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"to turn","accept":[],"options":["turning","to turning","turn","to turn"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ off the lights when you leave.","hint":"future duty","explanation":"forget \u002B to-infinitive = fail to do a duty: forget to turn."},{"answer":"revising","accept":[],"options":["revising","to revising","revise","to revise"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"saying","accept":[],"options":["say","to say","saying","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"sending","accept":[],"options":["to send","to sending","send","sending"],"base":null,"keyword":null,"lead":null,"sentence":"She forgot ___ the email, so she sent it twice.","hint":"she had already sent it","explanation":"forget \u002B -ing = lose the memory of a past action (she did send it)."},{"answer":"to have seen","accept":[],"options":["have seen","seeing","to see","to have seen"],"base":null,"keyword":null,"lead":null,"sentence":"The witness claims ___ the getaway car parked outside for an hour.","hint":"claim \u002B perfect infinitive","explanation":"\u0027Claims to have seen\u0027 \u2014 the perfect infinitive marks an earlier action."}]}