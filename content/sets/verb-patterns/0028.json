{"id":"verb-patterns-0028","taskId":"verb-patterns","title":"Drill set 28","text":null,"source":"drill","gaps":[{"answer":"climb","accept":["climbing"],"options":["climb","to climb","climbed","climbing"],"base":null,"keyword":null,"lead":null,"sentence":"I saw him ___ the wall and disappear into the garden.","hint":"see sb do (complete action)","explanation":"see/hear \u002B object \u002B bare infinitive = the complete action; -ing = the action in progress. Both readings possible here; the bare infinitive is expected."},{"answer":"worrying","accept":[],"options":["worry","to worry","worrying","to worrying"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point ___ about it now.","hint":"no point \u002B ?","explanation":"there\u0027s no point \u002B -ing: no point worrying."},{"answer":"hearing","accept":[],"options":["to hear","heard","hear","hearing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to attract","accept":["at attracting"],"options":["to attract","attracting","attract","to attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"to warn","accept":[],"options":["warn","warning","to warning","to warn"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"catching","accept":[],"options":["catch","to catching","catching","to catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"going","accept":["to go"],"options":["going","to going","to go","go"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."}]}