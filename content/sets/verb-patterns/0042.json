{"id":"verb-patterns-0042","taskId":"verb-patterns","title":"Drill set 42","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["be","being","to being","to be"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"to warn","accept":[],"options":["warn","to warn","to warning","warning"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"not to hear","accept":[],"options":["to not hear","not hearing","not hear","not to hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"to redecorate","accept":["on redecorating"],"options":["to redecorating","redecorate","to redecorate","redecorating"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"to bring","accept":[],"options":["to bringing","bring","bringing","to bring"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"quitting","accept":[],"options":["quit","to quitting","quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"disturb","accept":[],"options":["disturbing","disturb","to disturb","disturbed"],"base":null,"keyw