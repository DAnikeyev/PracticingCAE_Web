{"id":"verb-patterns-0058","taskId":"verb-patterns","title":"Drill set 58","text":null,"source":"drill","gaps":[{"answer":"taking","accept":[],"options":["to taking","taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"to eat","accept":[],"options":["eating","to eat","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"to spend","accept":[],"options":["to spend","spent","spend","spending"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"waiting","accept":["to wait"],"options":["to wait","to waiting","wait","waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"to pay","accept":[],"options":["paid","paying","pay","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"He was made ___ for the damage to the rental car.","hint":"passive of \u0022make\u0022 needs \u0022to\u0022","explanation":"In the passive, \u0027be made to do\u0027 takes the to-infinitive."},{"answer":"living","accept":[],"options":["to live","live","to living","living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"stay","accept":[],"options":["stay","stayed","staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"She would rather ___ at home tonight.","hint":"would rather \u002B base verb","explanation":"\u0027Would rather do\u0027 \u2014 the bare infinitive follows."},{"answer":"selling","accept":[],"options":["sell","to sell","selling","sold"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."}]}