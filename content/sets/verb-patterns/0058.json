{"id":"verb-patterns-0058","taskId":"verb-patterns","title":"Drill set 58","text":null,"source":"drill","gaps":[{"answer":"to bring","accept":[],"options":["bringing","bring","to bring","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"handling","accept":[],"options":["handle","to handling","to handle","handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"knocking","accept":[],"options":["knocking","to knocking","knock","to knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"living","accept":[],"options":["living","to live","to living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"struggling","accept":[],"options":["struggle","to struggle","struggling","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"asking","accept":[],"options":["asked","to ask","ask","asking"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"saying","accept":[],"options":["to say","saying","say","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B