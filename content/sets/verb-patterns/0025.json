{"id":"verb-patterns-0025","taskId":"verb-patterns","title":"Drill set 25","text":null,"source":"drill","gaps":[{"answer":"getting","accept":[],"options":["to getting","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to meet","accept":[],"options":["to meeting","meeting","to meet","meet"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"to spend","accept":[],"options":["spending","spend","spent","to spend"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"knocking","accept":[],"options":["knocking","to knocking","knock","to knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to rain","accept":["raining"],"options":["to rain","raining","rain","to raining"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"trying","accept":[],"options":["trying","to try","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"rewrite","accept":[],"options":["rewrote","rewriting","rewrite","to rewrite"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher made us ___ the whole essay again.","hint":"make \u002B bare infinitive","explanation":"\u0027Make someone do\u0027 \u2014 active \u0027make\u0027 takes the bare infinitive."},{"answer":"to give","accept":[],"options":["given","giving","to give","give"],"base":null,"keyword":null,"lead":null,"sentence":"It was kind of them ___ us a lift to the station.","hint":"adjective \u002B to-infinitive","explanation":"\u0027It was kind of them to give \u2026\u0027 \u2014 to-infinitive after the adjective."}]}