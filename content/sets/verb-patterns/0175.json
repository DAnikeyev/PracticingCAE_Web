{"id":"verb-patterns-0175","taskId":"verb-patterns","title":"Drill set 175","text":null,"source":"drill","gaps":[{"answer":"to rain","accept":["raining"],"options":["to raining","rain","raining","to rain"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"not to hear","accept":[],"options":["not hear","to not hear","not to hear","not hearing"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"drive","accept":[],"options":["to drive","driven","driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"living","accept":[],"options":["to live","to living","living","live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"missing","accept":[],"options":["to miss","miss","missing","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to have","accept":[],"options":["to having","having","have","to have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"living","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"failing","accept":[],"options":["to failing","fail","to fail","failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."}]}