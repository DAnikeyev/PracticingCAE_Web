{"id":"verb-patterns-0132","taskId":"verb-patterns","title":"Drill set 132","text":null,"source":"drill","gaps":[{"answer":"to upset","accept":[],"options":["upset","to upset","upsetting","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"complaining","accept":[],"options":["complaining","to complain","complained","complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"disturb","accept":[],"options":["disturbing","disturb","to disturb","disturbed"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."},{"answer":"being","accept":[],"options":["be","being","to be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"moving","accept":[],"options":["to moving","to move","moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"complaining","accept":[],"options":["to complain","complaining","complain","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"taking","accept":[],"options":["to take","taking","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"missing","accept":[],"options":["missing","missed","to miss","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."}]}