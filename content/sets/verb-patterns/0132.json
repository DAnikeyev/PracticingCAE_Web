{"id":"verb-patterns-0132","taskId":"verb-patterns","title":"Drill set 132","text":null,"source":"drill","gaps":[{"answer":"missing","accept":[],"options":["miss","missed","to miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"breaking","accept":[],"options":["to break","break","breaking","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"go","accept":[],"options":["going","to go","go","went"],"base":null,"keyword":null,"lead":null,"sentence":"My parents wouldn\u0027t let me ___ out past midnight.","hint":"let \u002B bare infinitive","explanation":"\u0027Let someone do\u0027 \u2014 \u0027let\u0027 takes the bare infinitive."},{"answer":"taking","accept":[],"options":["to take","to taking","taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"seeing","accept":[],"options":["seeing","to see","to seeing","see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"take","accept":[],"options":["to take","to taking","take","taking"],"base":null,"keyword":null,"lead":null,"sentence":"You\u0027d better ___ a taxi or you\u0027ll miss the plane.","hint":"had better \u002B ?","explanation":"had better takes the bare infinitive: you\u0027d better take."},{"answer":"waiting","accept":["to wait"],"options":["to wait","wait","waiting","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"getting","accept":[],"options":["got","get","to get","getting"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not used to ___ so early.","hint":"be used to \u002B ?","explanation":"be used TO \u002B -ing: not used to getting (it\u0027s a habit he isn\u0027t accustomed to)."}]}