{"id":"verb-patterns-0124","taskId":"verb-patterns","title":"Drill set 124","text":null,"source":"drill","gaps":[{"answer":"to upset","accept":[],"options":["to upset","upset","to upsetting","upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"to stay","accept":[],"options":["stay","stayed","to staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out tonight.","hint":"would prefer \u002B to-infinitive","explanation":"\u0027Would prefer to do \u2026 rather than do\u0027."},{"answer":"taking","accept":[],"options":["to taking","taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to spend","accept":[],"options":["spend","spending","to spend","spent"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"not to hear","accept":[],"options":["not to hear","not hear","to not hear","not hearing"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"to need","accept":[],"options":["to need","to needing","needing","need"]