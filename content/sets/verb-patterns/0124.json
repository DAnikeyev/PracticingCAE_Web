{"id":"verb-patterns-0124","taskId":"verb-patterns","title":"Drill set 124","text":null,"source":"drill","gaps":[{"answer":"to know","accept":[],"options":["knowing","to know","to knowing","know"],"base":null,"keyword":null,"lead":null,"sentence":"I happen ___ her from university.","hint":"happen \u002B ? (chance)","explanation":"happen \u002B to-infinitive = do something by chance: happen to know."},{"answer":"moving","accept":[],"options":["to move","to moving","moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"having done","accept":[],"options":["having done","to do","done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"stay","accept":[],"options":["stay","to staying","to stay","staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"selling","accept":[],"options":["to sell","sold","selling","sell"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"to check","accept":[],"options":["to checking","to check","checking","check"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"hearing","accept":[],"options":["hear","to hear","heard","hearing"],"base":null,"keyword":null,"lead":null,"s