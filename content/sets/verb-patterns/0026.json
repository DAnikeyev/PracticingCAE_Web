{"id":"verb-patterns-0026","taskId":"verb-patterns","title":"Drill set 26","text":null,"source":"drill","gaps":[{"answer":"taking","accept":[],"options":["to taking","taking","to take","take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"catching","accept":[],"options":["catch","catching","to catching","to catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"handling","accept":[],"options":["to handle","to handling","handle","handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to know","accept":[],"options":["knowing","to knowing","know","to know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"missing","accept":[],"options":["to miss","miss","missing","missed"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"to eat","accept":[],"options":["eat","to eat","to eating","eating"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"to lock","accept":[],"options":["locking","to lock","lock","locked"],"base":null,"keyword":null,"lead":null,"sentence":"Did you remember ___ the window before we left?","hint":"remember first, then do","explanation":"\u0027Remember to do\u0027 = not forget an obligation; \u0027remember locking\u0027 recalls a past action."},{"answer":"going","accept":["to go"],"options":["to going","go","going","to go"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."}]}