{"id":"verb-patterns-0031","taskId":"verb-patterns","title":"Drill set 31","text":null,"source":"drill","gaps":[{"answer":"having done","accept":[],"options":["done","to have done","to do","having done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"postponing","accept":[],"options":["postponing","postpone","postponed","to postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"driving","accept":[],"options":["driving","to drive","to driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to lift","accept":[],"options":["to lift","lift","lifting","to lifting"],"base":null,"keyword":null,"lead":null,"sentence":"I tried ___ the shelf up, but it was too heavy.","hint":"make an effort (and struggle)","explanation":"try \u002B to-infinitive = attempt, make an effort."},{"answer":"getting","accept":[],"options":["getting","get","to get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"to live","accept":[],"options":["to living","to live","live","living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"stay","accept":[],"options":["to stay","staying","stayed","stay"],"base":null,"keyword":null,"lead":null,"sentence":"She would rather ___ at home tonight.","hint":"would rather \u002B base verb","explanation":"\u0027Would rather do\u0027 \u2014 the bare infinitive follows."},{"answer":"breaking","accept":[],"options":["break","to breaking","breaking","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."}]}