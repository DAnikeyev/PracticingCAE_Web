{"id":"verb-patterns-0031","taskId":"verb-patterns","title":"Drill set 31","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to being","to be","being","be"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"living","accept":[],"options":["to living","living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"repairing","accept":[],"options":["to repairing","repair","to repair","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"sending","accept":[],"options":["to send","to sending","send","sending"],"base":null,"keyword":null,"lead":null,"sentence":"She forgot ___ the email, so she sent it twice.","hint":"she had already sent it","explanation":"forget \u002B -ing = lose the memory of a past action (she did send it)."},{"answer":"postponing","accept":[],"options":["postponed","postponing","to postpone","postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"to control","accept":[],"options":["to controlling","to control","control","controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"to eat","accept":[],"options":["to eat","eat","to eating","eating"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"laughing","accept":[],"options":["laugh","to laughing","laughing","to laugh"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."}]}