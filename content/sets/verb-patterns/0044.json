{"id":"verb-patterns-0044","taskId":"verb-patterns","title":"Drill set 44","text":null,"source":"drill","gaps":[{"answer":"missing","accept":[],"options":["miss","to miss","missing","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"trying","accept":[],"options":["trying","try","tried","to try"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ to start the engine \u2014 the battery is completely flat.","hint":"it\u0027s no use \u002B -ing","explanation":"\u0027It\u0027s no use\u0027 is followed by a gerund."},{"answer":"living","accept":[],"options":["to living","live","living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"not to hear","accept":[],"options":["to not hear","not hearing","not to hear","not hear"],"base":null,"keyword":null,"lead":null,"sentence":"She pretended ___ the question.","hint":"pretend \u002B ? (negative)","explanation":"pretend \u002B to-infinitive; negative: not to hear."},{"answer":"taking","accept":[],"options":["to taking","take","taking","to take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"failing","accept":[],"options":["to failing","failing","to fail","fail"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"worrying","accept":[],"options":["worry","to worry","worrying","to worrying"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point ___ about it now.","hint":"no point \u002B ?","explanation":"there\u0027s