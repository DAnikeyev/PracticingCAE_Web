{"id":"verb-patterns-0044","taskId":"verb-patterns","title":"Drill set 44","text":null,"source":"drill","gaps":[{"answer":"laughing","accept":[],"options":["laughing","to laughing","laugh","to laugh"],"base":null,"keyword":null,"lead":null,"sentence":"They can\u0027t help ___ at his impression of the boss.","hint":"can\u0027t help \u002B ?","explanation":"can\u0027t help \u002B -ing = can\u0027t stop yourself: can\u0027t help laughing."},{"answer":"living","accept":[],"options":["live","to live","to living","living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"take","accept":[],"options":["taking","to taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"You\u0027d better ___ a taxi or you\u0027ll miss the plane.","hint":"had better \u002B ?","explanation":"had better takes the bare infinitive: you\u0027d better take."},{"answer":"missing","accept":[],"options":["to miss","missing","to missing","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to meet","accept":[],"options":["meet","to meet","meeting","met"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"to learn","accept":[],"options":["learn","to learning","to learn","learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"locking","accept":[],"options":["to locking","lock","to lock","locking"],"base":null,"keyword":null,"lead":null,"sentence":"I remembered ___ the door, so I went back to check.","hint":"me