{"id":"verb-patterns-0085","taskId":"verb-patterns","title":"Drill set 85","text":null,"source":"drill","gaps":[{"answer":"moving","accept":[],"options":["to move","moving","to moving","move"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"hearing","accept":[],"options":["hear","heard","hearing","to hear"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."},{"answer":"queueing","accept":["queuing"],"options":["queue","queueing","to queue","to queueing"],"base":null,"keyword":null,"lead":null,"sentence":"We spent the whole morning ___ for tickets.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent the morning queueing."},{"answer":"quitting","accept":[],"options":["quit","to quitting","quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"repairing","accept":[],"options":["repairing","to repair","repair","to repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"catching","accept":[],"options":["catch","to catching","to catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"missing","accept":[],"options":["to miss","missing","missed","miss"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"paying","accept":[],"options":["to paying","pay","to pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."}]}