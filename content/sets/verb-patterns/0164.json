{"id":"verb-patterns-0164","taskId":"verb-patterns","title":"Drill set 164","text":null,"source":"drill","gaps":[{"answer":"to stay","accept":[],"options":["to stay","stay","to staying","staying"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"seeing","accept":[],"options":["to seeing","seeing","to see","see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"to get","accept":[],"options":["got","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ something to eat at the motorway services.","hint":"stop in order to","explanation":"\u0027Stopped to get\u0027 = paused for the purpose; \u0027stopped getting\u0027 would mean quit eating."},{"answer":"getting","accept":[],"options":["to getting","to get","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"to redecorate","accept":["on redecorating"],"options":["redecorate","to redecorating","redecorating","to redecorate"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"catching","accept":[],"options":["catch","to catch","catching","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to inform","accept":[],"options":["inform","to inform","informing","to informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"revising","accept":[],"options":["revising","to revise","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."}]}