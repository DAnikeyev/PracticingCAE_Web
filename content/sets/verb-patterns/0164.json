{"id":"verb-patterns-0164","taskId":"verb-patterns","title":"Drill set 164","text":null,"source":"drill","gaps":[{"answer":"to bring","accept":[],"options":["to bring","to bringing","bring","bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"postponing","accept":[],"options":["postpone","postponed","to postpone","postponing"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"to pay","accept":[],"options":["pay","paid","to pay","paying"],"base":null,"keyword":null,"lead":null,"sentence":"He was made ___ for the damage to the rental car.","hint":"passive of \u0022make\u0022 needs \u0022to\u0022","explanation":"In the passive, \u0027be made to do\u0027 takes the to-infinitive."},{"answer":"failing","accept":[],"options":["to fail","to failing","fail","failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"allow","accept":[],"options":["allow","have","make","let"],"base":null,"keyword":null,"lead":null,"sentence":"The rules don\u0027t ___ visitors to touch the paintings.","hint":"verb \u002B object \u002B to touch","explanation":"allow \u002B object \u002B to-infinitive: allow visitors to touch. (let \u002B bare: let visitors touch.)"},{"answer":"stay","accept":[],"options":["to stay","staying","to staying","stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"waiting","accept":["to wait"],"options":["waiting","to wait","wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"having done","accept":[],"options":["done","to do","having done","to have done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."}]}