{"id":"verb-patterns-0072","taskId":"verb-patterns","title":"Drill set 72","text":null,"source":"drill","gaps":[{"answer":"turning","accept":[],"options":["turn","to turn","turning","to turning"],"base":null,"keyword":null,"lead":null,"sentence":"Try ___ the handle \u2014 sometimes it sticks.","hint":"experiment with this","explanation":"try \u002B -ing = experiment with a method; try to do = make an effort."},{"answer":"to need","accept":[],"options":["need","needing","to need","to needing"],"base":null,"keyword":null,"lead":null,"sentence":"The box was heavy enough ___ two people.","hint":"enough \u002B to-inf","explanation":"adjective \u002B enough \u002B to-infinitive: heavy enough to need."},{"answer":"waiting","accept":["to wait"],"options":["waiting","to waiting","wait","to wait"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"losing","accept":[],"options":["to lose","losing","to losing","lose"],"base":null,"keyword":null,"lead":null,"sentence":"You risk ___ your licence if you drink and drive.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk losing."},{"answer":"trying","accept":[],"options":["try","trying","to try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"revising","accept":[],"options":["revise","to revise","revising","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"to show","accept":[],"options":["show","showing","to show","to showing"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t wait ___ you the photos.","hint":"can\u0027t wait \u002B ?","explanation":"can\u0027t wait \u002B to-infinitive: can\u0027t wait to show."},{"answer":"saying","accept":[],"options":["say","to saying","saying","to say"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."}]}