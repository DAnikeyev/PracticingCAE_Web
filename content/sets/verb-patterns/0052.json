{"id":"verb-patterns-0052","taskId":"verb-patterns","title":"Drill set 52","text":null,"source":"drill","gaps":[{"answer":"to control","accept":[],"options":["to controlling","control","controlling","to control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"postponing","accept":[],"options":["postponing","postponed","to postpone","postpone"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"getting","accept":[],"options":["getting","to get","to getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"missing","accept":[],"options":["missing","to miss","miss","missed"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"hearing","accept":[],"options":["heard","hear","to hear","hearing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"stay","accept":[],"options":["stay","staying","to staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"seeing","accept":[],"options":["saw","seeing","to see","see"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."},{"answer":"saying","accept":[],"options":["to say","say","saying","to saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."}]}