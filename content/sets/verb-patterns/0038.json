{"id":"verb-patterns-0038","taskId":"verb-patterns","title":"Drill set 38","text":null,"source":"drill","gaps":[{"answer":"revising","accept":[],"options":["revise","revising","to revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"struggling","accept":[],"options":["to struggling","struggling","to struggle","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"to stay","accept":[],"options":["stayed","stay","to staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out tonight.","hint":"would prefer \u002B to-infinitive","explanation":"\u0027Would prefer to do \u2026 rather than do\u0027."},{"answer":"waiting","accept":["to wait"],"options":["waiting","wait","to waiting","to wait"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"selling","accept":[],"options":["selling","to sell","sold","sell"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"crying","accept":[],"options":["crying","cry","to crying","to cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"preparing","accept":[],"options":["to prepare","prepared","preparing","prepare"],"base":null,"keyword":null,"le