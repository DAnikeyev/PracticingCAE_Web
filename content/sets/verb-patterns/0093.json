{"id":"verb-patterns-0093","taskId":"verb-patterns","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"to rain","accept":["raining"],"options":["raining","to rain","rain","to raining"],"base":null,"keyword":null,"lead":null,"sentence":"It started ___ just as we left the house.","hint":"start: both forms OK","explanation":"start/begin take either -ing or to-infinitive; with continuous or states, \u0027to\u0027 is preferred. Both accepted."},{"answer":"to get","accept":[],"options":["getting","to get","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t afford ___ her car repaired this month.","hint":"afford \u002B ?","explanation":"afford \u002B to-infinitive: can\u0027t afford to get."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"struggling","accept":[],"options":["to struggle","struggling","struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"catching","accept":[],"options":["to catch","catching","catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"apologise","accept":[],"options":["to apologise","apologising","apologise","apologised"],"base":null,"keyword":null,"lead":null,"sentence":"They made me ___ for the whole team\u0027s mistake.","hint":"made \u002B bare infinitive","explanation":"make \u002B object \u002B bare infinitive in active sentences: made me apologise."},{"answer":"driving","accept":[],"options":["to drive","driving","drive","to driving"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."}]}