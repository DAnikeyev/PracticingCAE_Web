{"id":"verb-patterns-0093","taskId":"verb-patterns","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["talking","to talk","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"to upset","accept":[],"options":["upsetting","to upset","upset","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"let","accept":[],"options":["permit","make","allow","let"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"catching","accept":[],"options":["catch","to catching","to catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"to control","accept":[],"options":["controlling","to controlling","to control","control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"going","accept":["to go"],"options":["to go","go","going","to going"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t bother ___ \u2014 the shop\u0027s shut.","hint":"bother \u002B both, -ing common","explanation":"bother \u002B -ing (or to-infinitive): don\u0027t bother going. Both accepted."},{"answer":"not to be","accept":[],"options":["not being","not to be","not be","to not be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"drinking","accept":[],"options":["to drink","drinking","drink","to drinking"],"base":null,"keyword":null,"lead":null,"sentence":"You should stop ___ so much coffee late at night.","hint":"stop the activity itself","explanation":"stop \u002B -ing = end the activity: stop drinking coffee."}]}