{"id":"verb-patterns-0093","taskId":"verb-patterns","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"locking","accept":[],"options":["to locking","to lock","lock","locking"],"base":null,"keyword":null,"lead":null,"sentence":"I remembered ___ the door, so I went back to check.","hint":"memory of a past action","explanation":"remember \u002B -ing = recall a past action; remember to do = not forget a duty."},{"answer":"to go","accept":[],"options":["going","go","to go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."},{"answer":"taking","accept":[],"options":["to take","take","to taking","taking"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"to control","accept":[],"options":["to control","controlling","control","to controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"let","accept":[],"options":["allow","make","let","permit"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"quitting","accept":[],"options":["to quit","to quitting","quitting","quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."},{"answer":"to lift","accept":[],"options":["to lifting","to lift","lifting","lift"],"base":null,"keyword":null,"lead"