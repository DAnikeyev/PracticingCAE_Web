{"id":"verb-patterns-0163","taskId":"verb-patterns","title":"Drill set 163","text":null,"source":"drill","gaps":[{"answer":"allow","accept":[],"options":["make","allow","let","have"],"base":null,"keyword":null,"lead":null,"sentence":"The rules don\u0027t ___ visitors to touch the paintings.","hint":"verb \u002B object \u002B to touch","explanation":"allow \u002B object \u002B to-infinitive: allow visitors to touch. (let \u002B bare: let visitors touch.)"},{"answer":"saying","accept":[],"options":["saying","to say","to saying","say"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"taking","accept":[],"options":["take","to take","to taking","taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to eat","accept":[],"options":["eating","to eat","to eating","eat"],"base":null,"keyword":null,"lead":null,"sentence":"Would you like ___ now or later?","hint":"would like \u002B ?","explanation":"would like takes the to-infinitive: would like to eat."},{"answer":"living","accept":[],"options":["living","to live","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"to bring","accept":[],"options":["bringing","to bring","bring","to bringing"],"base":null,"keyword":null,"lead":null,"sentence":"Remember ___ your passport to the airport.","hint":"not forget a duty","explanation":"remember \u002B to-infinitive = not forget to do something."},{"answer":"paying","accept":[],"options":["paying","to paying","pay","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"being","accept":[],"options":["being","to be","be","been"],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude to the waiter.","hint":"preposition \u002B gerund","explanation":"\u0027Apologise for being\u0027 \u2014 \u0027for\u0027 is a preposition, so the gerund follows."}]}