{"id":"verb-patterns-0163","taskId":"verb-patterns","title":"Drill set 163","text":null,"source":"drill","gaps":[{"answer":"to go","accept":[],"options":["to going","go","to go","going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hint":"afford \u002B ?","explanation":"afford takes the to-infinitive: can\u0027t afford to go."},{"answer":"not to be","accept":[],"options":["not being","to not be","not be","not to be"],"base":null,"keyword":null,"lead":null,"sentence":"She promised ___ late again.","hint":"promise \u002B ? (negative)","explanation":"Negative infinitive: promised not to be late \u2014 \u0027not\u0027 goes before \u0027to\u0027."},{"answer":"knocking","accept":[],"options":["to knock","to knocking","knock","knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"did","accept":[],"options":["did","does","will do","do"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather she ___ the accounts this month, to be honest.","hint":"would rather \u002B subject \u002B past","explanation":"\u0027Would rather \u002B subject\u0027 takes the past form for an unreal present preference."},{"answer":"moving","accept":[],"options":["move","to moving","to move","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"sending","accept":[],"options":["sending","to send","to sending","send"],"base":null,"keyword":null,"lead":null,"sentence":"She forgot ___ the email, so she sent it twice.","hint":"she had already sent it","explanation":"forget \u002B -ing = lose the memory of a past action (she did send it)."},{"answer":"asking","accept":[],"options":["asked","asking","ask","to ask"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"catching","accept":[],"options":["catching","to catching","catch","to catch"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."}]}