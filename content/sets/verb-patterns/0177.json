{"id":"verb-patterns-0177","taskId":"verb-patterns","title":"Drill set 177","text":null,"source":"drill","gaps":[{"answer":"to redecorate","accept":["on redecorating"],"options":["to redecorating","redecorating","to redecorate","redecorate"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"climb","accept":["climbing"],"options":["to climb","climb","climbing","climbed"],"base":null,"keyword":null,"lead":null,"sentence":"I saw him ___ the wall and disappear into the garden.","hint":"see sb do (complete action)","explanation":"see/hear \u002B object \u002B bare infinitive = the complete action; -ing = the action in progress. Both readings possible here; the bare infinitive is expected."},{"answer":"to meet","accept":[],"options":["met","meeting","meet","to meet"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"catching","accept":[],"options":["catching","catch","to catch","to catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"struggling","accept":[],"options":["struggling","to struggle","struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"breaking","accept":[],"options":["break","to break","to breaking","breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"repairing","accept":[],"options":["to repair","repair","to repairing","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."}]}