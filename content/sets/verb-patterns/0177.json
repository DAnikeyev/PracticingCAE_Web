{"id":"verb-patterns-0177","taskId":"verb-patterns","title":"Drill set 177","text":null,"source":"drill","gaps":[{"answer":"to know","accept":[],"options":["to knowing","to know","knowing","know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"climbing","accept":[],"options":["to climb","climbed","climbing","climb"],"base":null,"keyword":null,"lead":null,"sentence":"The burglar admitted ___ through the kitchen window.","hint":"admit \u002B -ing","explanation":"\u0027Admit\u0027 is followed by a gerund: admitted climbing."},{"answer":"living","accept":[],"options":["living","to living","live","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"struggling","accept":[],"options":["to struggling","struggling","to struggle","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"crying","accept":[],"options":["to crying","crying","to cry","cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"read","accept":[],"options":["reading","have read","read","to read"],"base":null,"keyword":null,"lead":null,"sentence":"We had better ___ the terms carefully before signing anything.","hint":"had better \u002B bare infinitive","explanation":"\u0027Had better\u0027 is followed by the infinitive without \u0027to\u0027."},{"answer":"disturb","accept":[],"options":["disturbing","disturbed","to disturb","disturb"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."},{"answer":"quitting","accept":[],"options":["quitting","quit","to quitting","to quit"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s considering ___ his job and travelling for a year.","hint":"consider \u002B ?","explanation":"consider \u002B -ing: considering quitting."}]}