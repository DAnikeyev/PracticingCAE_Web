{"id":"verb-patterns-0177","taskId":"verb-patterns","title":"Drill set 177","text":null,"source":"drill","gaps":[{"answer":"to have","accept":[],"options":["having","to have","to having","have"],"base":null,"keyword":null,"lead":null,"sentence":"We stopped at a village ___ some lunch.","hint":"stop in order to","explanation":"stop to do = pause in order to do something: stopped to have lunch."},{"answer":"didn\u0027t","accept":[],"options":["not","didn\u0027t","don\u0027t","won\u0027t"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"to learn","accept":[],"options":["to learning","learning","to learn","learn"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"complaining","accept":[],"options":["to complain","complaining","complained","complain"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay \u2014 nothing will change.","hint":"worth \u002B -ing","explanation":"\u0027Not worth doing\u0027 \u2014 the gerund follows \u0027worth\u0027."},{"answer":"to upset","accept":[],"options":["to upset","to upsetting","upset","upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"having done","accept":["doing"],"options":["having done","doing","to do","done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"asking","accept":[],"options":["to ask","ask","asking","asked"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"taking","accept":[],"options":["take","to taking","taking","to take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."}]}