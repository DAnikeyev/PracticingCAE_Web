{"id":"verb-patterns-0183","taskId":"verb-patterns","title":"Drill set 183","text":null,"source":"drill","gaps":[{"answer":"struggling","accept":[],"options":["to struggle","struggling","struggle","to struggling"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"to have seen","accept":[],"options":["to have seen","to see","have seen","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"The witness claims ___ the getaway car parked outside for an hour.","hint":"claim \u002B perfect infinitive","explanation":"\u0027Claims to have seen\u0027 \u2014 the perfect infinitive marks an earlier action."},{"answer":"let","accept":[],"options":["let","permit","allow","make"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"seeing","accept":[],"options":["seeing","to seeing","see","to see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"handling","accept":[],"options":["handle","handling","to handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to receive","accept":[],"options":["to receive","receiving","receive","to receiving"],"base":null,"keyword":null,"lead":null,"sentence":"We expect ___ the results by Friday.","hint":"expect \u002B ?","explanation":"expect takes the to-infinitive: expect to receive."},{"answer":"climbing","accept":[],"options":["climbed","to climb","climb","climbing"],"base":null,"keyword":null,"lead":null,"sentence":"The burglar admitted ___ through the kitchen window.","hint":"admit \u002B -ing","explanation":"\u0027Admit\u0027 is followed by a gerund: admitted climbing."},{"answer":"to spend","accept":[],"options":["spending","spend","to spend","spent"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."}]}