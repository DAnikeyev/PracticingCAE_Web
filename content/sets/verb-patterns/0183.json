{"id":"verb-patterns-0183","taskId":"verb-patterns","title":"Drill set 183","text":null,"source":"drill","gaps":[{"answer":"living","accept":[],"options":["to living","live","living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"handling","accept":[],"options":["handle","to handle","handling","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"driving","accept":[],"options":["driving","to drive","to driving","drive"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re thinking of ___ to the coast for the weekend.","hint":"think of \u002B ?","explanation":"think of/about \u002B -ing: thinking of driving."},{"answer":"to eat","accept":[],"options":["eat","eating","to eating","to eat"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"to reach","accept":[],"options":["to reach","reaching","reached","reach"],"base":null,"keyword":null,"lead":null,"sentence":"He was the first climber ___ the summit without oxygen.","hint":"the first \u002B to-infinitive","explanation":"After \u0027the first/last/only \u002B noun\u0027 a to-infinitive follows."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"to redecorate","accept":["on redecorating"],"options":["to redecorating","to redecorate","redecorating","redecorate"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"tidy","accept":[],"options":["tidied","to tidy","tidying","tidy"],"base":null,"keyword":null,"lead":null,"sentence":"She made her son ___ his room before dinner.","hint":"make sb \u002B ?","explanation":"make \u002B object \u002B bare infinitive: made him tidy (passive takes to: was made to tidy)."}]}