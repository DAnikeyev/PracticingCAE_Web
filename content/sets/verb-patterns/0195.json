{"id":"verb-patterns-0195","taskId":"verb-patterns","title":"Drill set 195","text":null,"source":"drill","gaps":[{"answer":"moving","accept":[],"options":["move","moving","to move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"building","accept":[],"options":["to building","to build","build","building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"catching","accept":[],"options":["to catch","to catching","catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"handling","accept":[],"options":["to handling","handle","handling","to handle"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"to put","accept":[],"options":["to putting","put","to put","putting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the fire before it spread.","hint":"manage \u002B ? (succeed)","explanation":"manage takes the to-infinitive: managed to put out."},{"answer":"let","accept":[],"options":["allow","make","let","permit"],"base":null,"keyword":null,"lead":null,"sentence":"My boss won\u0027t ___ me take Friday off.","hint":"verb \u002B me \u002B take (bare)","explanation":"let \u002B object \u002B bare infinitive: won\u0027t let me take. (allow/permit take to: allow me to take.)"},{"answer":"to attract","accept":["at attracting"],"options":["attracting","attract","to attract","to attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"taking","accept":[],"options":["take","to take","taking","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"He suggested ___ a taxi instead of walking.","hint":"suggest \u002B ?","explanation":"suggest \u002B -ing (no infinitive with a person: suggest that we take is also possible)."}]}