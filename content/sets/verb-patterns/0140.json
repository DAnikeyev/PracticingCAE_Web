{"id":"verb-patterns-0140","taskId":"verb-patterns","title":"Drill set 140","text":null,"source":"drill","gaps":[{"answer":"to stay","accept":[],"options":["to stay","stayed","stay","to staying"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out tonight.","hint":"would prefer \u002B to-infinitive","explanation":"\u0027Would prefer to do \u2026 rather than do\u0027."},{"answer":"to meet","accept":[],"options":["to meeting","meet","to meet","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"knocking","accept":[],"options":["to knocking","to knock","knocking","knock"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"to undo","accept":[],"options":["undo","undoing","to undoing","to undo"],"base":null,"keyword":null,"lead":null,"sentence":"Do you have any idea how ___ this knot?","hint":"how \u002B ?","explanation":"question word \u002B to-infinitive: how to undo."},{"answer":"drive","accept":[],"options":["driven","driving","drive","to drive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"postponing","accept":[],"options":["postponed","to postpone","postpone","postponing"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"building","accept":[],"options":["to build","building","to building","build"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"seeing","accept":[],"options":["saw","seeing","to see","see"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ you at the reunion.","hint":"look forward to \u002B -ing","explanation":"\u0027To\u0027 is a preposition here, so the gerund follows."}]}