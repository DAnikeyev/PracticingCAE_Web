{"id":"verb-patterns-0140","taskId":"verb-patterns","title":"Drill set 140","text":null,"source":"drill","gaps":[{"answer":"waiting","accept":["to wait"],"options":["to waiting","to wait","wait","waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"stay","accept":[],"options":["staying","stay","to staying","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B ?","explanation":"would rather takes the bare infinitive: I\u0027d rather stay."},{"answer":"to warn","accept":[],"options":["to warn","warning","to warning","warn"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"getting","accept":[],"options":["to getting","getting","to get","get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"repairing","accept":[],"options":["to repairing","to repair","repair","repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"arguing","accept":[],"options":["arguing","to argue","argued","argue"],"base":null,"keyword":null,"lead":null,"sentence":"I could hear the neighbours ___ again last night.","hint":"hear sb do \u2014 in progress","explanation":"hear \u002B object \u002B -ing = hear an action in progress: hear them arguing."},{"answer":"rewrite","accept":[],"options":["rewrote","rewrite","to rewrite","rewriting"],"base":null,"keywo