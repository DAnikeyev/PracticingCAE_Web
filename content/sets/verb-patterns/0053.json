{"id":"verb-patterns-0053","taskId":"verb-patterns","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"asking","accept":[],"options":["to ask","ask","asking","asked"],"base":null,"keyword":null,"lead":null,"sentence":"She keeps ___ about the exam results.","hint":"keep \u002B -ing","explanation":"\u0027Keep doing something\u0027 = repeat an action."},{"answer":"to control","accept":[],"options":["to control","controlling","to controlling","control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"paying","accept":[],"options":["paying","pay","to paying","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."},{"answer":"drive","accept":[],"options":["driving","to drive","driven","drive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d sooner ___ than ask for directions.","hint":"would sooner \u002B ?","explanation":"would sooner \u002B bare infinitive (like would rather): sooner drive."},{"answer":"postponing","accept":[],"options":["postpone","postponing","to postpone","postponed"],"base":null,"keyword":null,"lead":null,"sentence":"She suggested ___ the meeting until Monday.","hint":"suggest \u002B -ing","explanation":"\u0027Suggest doing something\u0027 \u2014 never \u0027suggest to do\u0027."},{"answer":"to attract","accept":["at attracting"],"options":["to attract","attracting","to attracting","attract"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"being","accept":[],"options":["be","to be","been","being"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t stand ___ kept waiting when I have an appointment.","hint":"can\u0027t stand \u002B passive gerund","explanation":"\u0027Can\u0027t stand\u0027 takes a gerund; the passive gerund is \u0027being kept\u0027."},{"answer":"getting","accept":[],"options":["to get","to getting","getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."}]}