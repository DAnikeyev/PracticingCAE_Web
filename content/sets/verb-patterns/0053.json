{"id":"verb-patterns-0053","taskId":"verb-patterns","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"locking","accept":[],"options":["to lock","locking","lock","to locking"],"base":null,"keyword":null,"lead":null,"sentence":"I remembered ___ the door, so I went back to check.","hint":"memory of a past action","explanation":"remember \u002B -ing = recall a past action; remember to do = not forget a duty."},{"answer":"to climb","accept":[],"options":["climbing","to climb","climb","climbed"],"base":null,"keyword":null,"lead":null,"sentence":"She was the first woman ___ the peak in winter.","hint":"the first/last \u002B ?","explanation":"the first/second/last \u002B to-infinitive: the first woman to climb."},{"answer":"trying","accept":[],"options":["to try","trying","try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"He suggested ___ a taxi instead of walking.","hint":"suggest \u002B ?","explanation":"suggest \u002B -ing (no infinitive with a person: suggest that we take is also possible)."},{"answer":"to hear","accept":[],"options":["hearing","to hear","hear","to hearing"],"base":null,"keyword":null,"lead":null,"sentence":"We hope ___ from you soon.","hint":"hope \u002B ?","explanation":"hope takes the to-infinitive: hope to hear."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."}]}