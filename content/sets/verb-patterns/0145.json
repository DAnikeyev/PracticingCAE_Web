{"id":"verb-patterns-0145","taskId":"verb-patterns","title":"Drill set 145","text":null,"source":"drill","gaps":[{"answer":"to inform","accept":[],"options":["informing","inform","to inform","to informing"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ you that the flight has been cancelled.","hint":"formal bad news","explanation":"regret \u002B to-infinitive (formal announcements); regret \u002B -ing = be sorry about the past."},{"answer":"breaking","accept":[],"options":["break","breaking","to break","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"crying","accept":[],"options":["to crying","crying","to cry","cry"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"being","accept":[],"options":["be","to be","being","been"],"base":null,"keyword":null,"lead":null,"sentence":"I resent ___ treated as an amateur when I have twenty years\u2019 experience.","hint":"resent \u002B passive gerund","explanation":"\u0027Resent\u0027 takes a gerund; the passive is \u0027being treated\u0027."},{"answer":"getting","accept":[],"options":["getting","to getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"missing","accept":[],"options":["miss","missed","to miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"apologise","accept":[],"options":["apologised","to apologise","apologising","apologise"],"base":null,"keyword":null,"lead":null,"sentence":"They