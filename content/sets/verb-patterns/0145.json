{"id":"verb-patterns-0145","taskId":"verb-patterns","title":"Drill set 145","text":null,"source":"drill","gaps":[{"answer":"having done","accept":["doing"],"options":["to do","done","doing","having done"],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ anything wrong.","hint":"deny \u002B ?/having \u002B ?","explanation":"deny \u002B -ing or having \u002B past participle: denied doing/having done. Both accepted."},{"answer":"to control","accept":[],"options":["controlling","control","to controlling","to control"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"crying","accept":[],"options":["to cry","cry","to crying","crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"to meet","accept":[],"options":["meet","to meet","met","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"didn\u0027t","accept":[],"options":["didn\u0027t","don\u0027t","won\u0027t","not"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"breaking","accept":[],"options":["break","to breaking","breaking","to break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"being","accept":[],"options":["be","to be","being","been"],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for