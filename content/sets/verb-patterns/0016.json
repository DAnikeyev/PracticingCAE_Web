{"id":"verb-patterns-0016","taskId":"verb-patterns","title":"Drill set 16","text":null,"source":"drill","gaps":[{"answer":"to warn","accept":[],"options":["warning","to warn","warn","to warning"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"to attract","accept":["at attracting"],"options":["attracting","to attract","attract","to attracting"],"base":null,"keyword":null,"lead":null,"sentence":"The scheme aims ___ younger visitors to the museum.","hint":"aim \u002B ?","explanation":"aim \u002B to-infinitive: aims to attract (aim at \u002B -ing is also possible in BrE)."},{"answer":"breaking","accept":[],"options":["to break","breaking","break","to breaking"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"to redecorate","accept":["on redecorating"],"options":["redecorating","to redecorate","redecorate","to redecorating"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re planning ___ the flat before selling it.","hint":"plan \u002B ?","explanation":"plan \u002B to-infinitive (plan on \u002B -ing also occurs informally): planning to redecorate."},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"revising","accept":[],"options":["to revise","revising","revise","to revising"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s busy ___ for her exams.","hint":"busy \u002B ?","explanation":"busy \u002B -ing: busy revising."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null