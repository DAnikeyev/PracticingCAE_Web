{"id":"verb-patterns-0055","taskId":"verb-patterns","title":"Drill set 55","text":null,"source":"drill","gaps":[{"answer":"breaking","accept":[],"options":["to breaking","breaking","to break","break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"seeing","accept":[],"options":["to seeing","see","to see","seeing"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"struggling","accept":[],"options":["to struggle","to struggling","struggling","struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"complaining","accept":[],"options":["to complain","complain","complaining","to complaining"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s no use ___ about the weather.","hint":"it\u0027s no use \u002B ?","explanation":"it\u0027s no use \u002B -ing: no use complaining."},{"answer":"to water","accept":[],"options":["to watering","watering","water","to water"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"talking","accept":[],"options":["talk","talking","to talking","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"He went on ___ even after the audience had left.","hint":"continue the same activity","explanation":"go on \u002B -ing = continue the same activity; go on to do = do something next."},{"answer":"handling","accept":[],"options":["handle","handling","to handle","to handling"],"base":null,"keyword":null,"lead":null