{"id":"verb-patterns-0011","taskId":"verb-patterns","title":"Drill set 11","text":null,"source":"drill","gaps":[{"answer":"to stay","accept":[],"options":["staying","to staying","stay","to stay"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s too young ___ home alone.","hint":"too \u002B adjective \u002B ?","explanation":"too \u002B adjective \u002B to-infinitive: too young to stay."},{"answer":"to show","accept":[],"options":["to show","show","showing","to showing"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t wait ___ you the photos.","hint":"can\u0027t wait \u002B ?","explanation":"can\u0027t wait \u002B to-infinitive: can\u0027t wait to show."},{"answer":"hearing","accept":[],"options":["hear","hearing","heard","to hear"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re looking forward to ___ from you soon.","hint":"\u0027to\u0027 here is a preposition","explanation":"\u0027Look forward to \u002B -ing\u0027 \u2014 \u0027to\u0027 is a preposition, so the gerund follows."},{"answer":"taking","accept":[],"options":["to take","take","taking","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"getting","accept":[],"options":["getting","to getting","get","to get"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"breaking","accept":[],"options":["to breaking","to break","breaking","break"],"base":null,"keyword":null,"lead":null,"sentence":"They accused me of ___ the rules.","hint":"accuse of \u002B ?","explanation":"preposition \u002B -ing: accused of breaking."},{"answer":"working","accept":[],"options":["worked","working","work","to work"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"hearing","accept":[],"options":["heard","to hear","hear","hearing"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."}]}