{"id":"verb-patterns-0105","taskId":"verb-patterns","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"to tell","accept":[],"options":["tell","to tell","told","telling"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"to upgrade","accept":[],"options":["to upgrade","upgrading","upgrade","to upgrading"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel offered ___ our room free of charge.","hint":"offer \u002B ?","explanation":"offer takes the to-infinitive: offered to upgrade."},{"answer":"drinking","accept":[],"options":["to drink","drink","drank","drinking"],"base":null,"keyword":null,"lead":null,"sentence":"He stopped ___ coffee before bed and now sleeps much better.","hint":"quit the habit","explanation":"\u0027Stop doing\u0027 = quit the activity; \u0027stop to drink\u0027 would mean pause in order to drink."},{"answer":"to meet","accept":[],"options":["to meet","to meeting","meet","meeting"],"base":null,"keyword":null,"lead":null,"sentence":"The team failed ___ the deadline.","hint":"fail \u002B ?","explanation":"fail takes the to-infinitive: failed to meet."},{"answer":"seeing","accept":[],"options":["see","to seeing","seeing","to see"],"base":null,"keyword":null,"lead":null,"sentence":"We mustn\u0027t miss ___ this exhibition \u2014 it ends on Sunday.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss seeing."},{"answer":"having done","accept":[],"options":["to have done","to do","having done","done"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ anything wrong.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing/having done something\u0027 \u2014 gerund pattern."},{"answer":"complaining","accept":[],"options":["complaining","complain","to complain","complained"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth