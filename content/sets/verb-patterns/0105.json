{"id":"verb-patterns-0105","taskId":"verb-patterns","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."},{"answer":"building","accept":[],"options":["to build","building","build","to building"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve postponed ___ the new bridge until spring.","hint":"postpone \u002B ?","explanation":"postpone \u002B -ing (like delay): postponed building."},{"answer":"to eat","accept":[],"options":["eating","to eat","eat","to eating"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d prefer ___ at home rather than go out.","hint":"would prefer \u002B ?","explanation":"would prefer \u002B to-infinitive: I\u0027d prefer to eat. (prefer \u002B -ing for general likes.)"},{"answer":"to upset","accept":[],"options":["upsetting","to upset","upset","to upsetting"],"base":null,"keyword":null,"lead":null,"sentence":"I didn\u0027t mean ___ you \u2014 it was a joke.","hint":"mean (intend) \u002B ?","explanation":"mean (= intend) takes the to-infinitive: didn\u0027t mean to upset. (mean \u002B -ing = involve.)"},{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"I regret ___ so rude to her at the party.","hint":"be sorry about the past","explanation":"regret \u002B -ing = feel sorry about something you did."},{"answer":"failing","accept":[],"options":["to fail","failing","fail","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"handling","accept":[],"options":["to handle","handling","handle","to handling"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant at ___ difficult customers.","hint":"good at \u002B ?","explanation":"preposition \u002B -ing: good at handling."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."}]}