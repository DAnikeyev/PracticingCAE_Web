{"id":"verb-patterns-0105","taskId":"verb-patterns","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":["to be","being","be","to being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"to water","accept":[],"options":["watering","to water","water","to watering"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t forget ___ the plants while we\u0027re away.","hint":"a duty, not yet done","explanation":"forget \u002B to-infinitive = fail to do something you should do."},{"answer":"to control","accept":[],"options":["controlling","to control","control","to controlling"],"base":null,"keyword":null,"lead":null,"sentence":"She appears ___ the situation completely.","hint":"appear \u002B ?","explanation":"appear/seem \u002B to-infinitive: appears to control."},{"answer":"to tell","accept":[],"options":["tell","telling","to tell","told"],"base":null,"keyword":null,"lead":null,"sentence":"I want you ___ the truth, whatever it is.","hint":"want sb \u002B ?","explanation":"want \u002B object \u002B to-infinitive: want you to tell."},{"answer":"to learn","accept":[],"options":["learning","to learn","learn","to learning"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve always wanted ___ how to sail.","hint":"want \u002B ?","explanation":"want \u002B to-infinitive: wanted to learn."},{"answer":"taking","accept":[],"options":["to take","taking","take","to taking"],"base":null,"keyword":null,"lead":null,"sentence":"She couldn\u0027t resist ___ the last biscuit.","hint":"can\u0027t resist \u002B ?","explanation":"can\u0027t resist \u002B -ing: couldn\u0027t resist taking."},{"answer":"to go","accept":[],"options":["to go","going","go","to going"],"base":null,"keyword":null,"lead":null,"sentence":"I really can\u0027t afford ___ on holiday this year.","hin