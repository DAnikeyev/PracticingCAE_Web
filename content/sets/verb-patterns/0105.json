{"id":"verb-patterns-0105","taskId":"verb-patterns","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"talking","accept":[],"options":["to talking","talk","talking","to talk"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"to get","accept":[],"options":["to get","getting","to getting","get"],"base":null,"keyword":null,"lead":null,"sentence":"It took me ages ___ used to the new keyboard.","hint":"it takes time \u002B ?","explanation":"it takes time \u002B to-infinitive: took me ages to get used to the keyboard."},{"answer":"working","accept":[],"options":["work","worked","working","to work"],"base":null,"keyword":null,"lead":null,"sentence":"If you keep ___ like this, you\u0027ll exhaust yourself.","hint":"keep \u002B ?","explanation":"keep (\u002B on) is followed by -ing: keep working."},{"answer":"failing","accept":[],"options":["to fail","failing","fail","to failing"],"base":null,"keyword":null,"lead":null,"sentence":"Despite ___ three times, he didn\u0027t give up.","hint":"despite \u002B ?","explanation":"despite \u002B -ing: despite failing."},{"answer":"being","accept":[],"options":["be","to be","to being","being"],"base":null,"keyword":null,"lead":null,"sentence":"He apologized for ___ so abrupt in the meeting.","hint":"apologize for \u002B ?","explanation":"preposition \u002B -ing: apologised for being."},{"answer":"taking","accept":[],"options":["taking","to taking","take","to take"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sorry for ___ so long to reply.","hint":"sorry for \u002B ?","explanation":"preposition \u002B -ing: sorry for taking."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","paid"],"base":null,"keyword":null,"lead":null,"sentence":"He was made ___ for the damage to the rental car.","hint":"passive of \u0022make\u0022 needs \u0022to\u0022","explanation":"In the passive, \u0027be made to do\u0027 takes the to-infinitive."},{"answer":"paying","accept":[],"options":["paying","to paying","pay","to pay"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted on ___ for the meal herself.","hint":"insist on \u002B ?","explanation":"insist ON \u002B -ing: insisted on paying."}]}