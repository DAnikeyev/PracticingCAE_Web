{"id":"verb-patterns-0086","taskId":"verb-patterns","title":"Drill set 86","text":null,"source":"drill","gaps":[{"answer":"disturb","accept":[],"options":["to disturb","disturbing","disturb","disturbed"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better not ___ the neighbours again.","hint":"had better not \u002B ?","explanation":"had better \u002B bare infinitive (not comes after better): better not disturb."},{"answer":"living","accept":[],"options":["to live","living","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t imagine ___ in a tiny village again.","hint":"imagine \u002B ?","explanation":"imagine \u002B -ing: imagine living."},{"answer":"moving","accept":[],"options":["to move","moving","move","to moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I look forward to ___ your suggestions at the meeting.","hint":"look forward to \u002B ?","explanation":"look forward TO \u002B -ing: to hearing."},{"answer":"repairing","accept":[],"options":["to repair","repairing","repair","to repairing"],"base":null,"keyword":null,"lead":null,"sentence":"Is it worth ___ the engine or should we buy a new car?","hint":"worth \u002B ?","explanation":"be worth \u002B -ing: worth repairing."},{"answer":"missing","accept":[],"options":["to miss","missing","miss","to missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the connection flight.","hint":"risk \u002B ?","explanation":"risk \u002B -ing: risk missing."},{"answer":"to get","accept":[],"options":["getting","to get","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"It took me ages ___ used to the new keyboard.","hint":"it takes time \u002B ?","explanation":"it takes time \u002B to-infinitive: took me ages to get used to the keyboard."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"He refused ___ for the damage.","hint":"refuse \u002B ?","explanation":"refuse takes the to-infinitive: refused to pay."}]}