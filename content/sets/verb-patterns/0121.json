{"id":"verb-patterns-0121","taskId":"verb-patterns","title":"Drill set 121","text":null,"source":"drill","gaps":[{"answer":"knocking","accept":[],"options":["knock","to knock","knocking","to knocking"],"base":null,"keyword":null,"lead":null,"sentence":"Renovating the kitchen involved ___ a wall.","hint":"involve \u002B ?","explanation":"involve \u002B -ing: involved knocking down."},{"answer":"struggling","accept":[],"options":["to struggling","struggling","struggle","to struggle"],"base":null,"keyword":null,"lead":null,"sentence":"Instead of ___ , why don\u0027t you ask for help?","hint":"instead of \u002B ?","explanation":"preposition \u002B -ing: instead of struggling."},{"answer":"to see","accept":[],"options":["seen","to see","saw","see"],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the circus.","hint":"excited \u002B to-infinitive","explanation":"\u0027Excited to see\u0027 \u2014 the to-infinitive follows the adjective."},{"answer":"to know","accept":[],"options":["know","to know","to knowing","knowing"],"base":null,"keyword":null,"lead":null,"sentence":"I happen ___ her from university.","hint":"happen \u002B ? (chance)","explanation":"happen \u002B to-infinitive = do something by chance: happen to know."},{"answer":"selling","accept":[],"options":["selling","to sell","sell","sold"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s considering ___ the flat and moving to the coast.","hint":"consider \u002B -ing","explanation":"\u0027Consider\u0027 takes a gerund: considering selling."},{"answer":"waiting","accept":["to wait"],"options":["waiting","wait","to wait","to waiting"],"base":null,"keyword":null,"lead":null,"sentence":"She can\u0027t stand ___ in queues.","hint":"can\u0027t stand \u002B both, prefer -ing","explanation":"can\u0027t stand \u002B -ing (also to-infinitive in AmE): can\u0027t stand waiting. -ing accepted as standard."},{"answer":"missing","accept":[],"options":["missed","to miss","miss","missing"],"base":null,"keyword":null,"lead":null,"sentence":"We can\u0027t risk ___ the deadline again.","hint":"risk \u002B -ing","explanation":"\u0027Risk doing something\u0027 takes the gerund."},{"answer":"read","accept":[],"options":["have read","read","reading","to read"],"base":null,"keyword":null,"lead":null,"sentence":"We had better ___ the terms carefully before signing anything.","hint":"had better \u002B bare infinitive","explanation":"\u0027Had better\u0027 is followed by the infinitive without \u0027to\u0027."}]}