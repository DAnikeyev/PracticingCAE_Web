{"id":"verb-patterns-0048","taskId":"verb-patterns","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"to spend","accept":[],"options":["to spend","spent","spend","spending"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t afford ___ another month abroad.","hint":"afford \u002B to-infinitive","explanation":"\u0027Afford to do\u0027 \u2014 the to-infinitive follows \u0027afford\u0027."},{"answer":"to meet","accept":[],"options":["meeting","to meet","met","meet"],"base":null,"keyword":null,"lead":null,"sentence":"They managed ___ the deadline despite the strike.","hint":"manage \u002B to-infinitive","explanation":"\u0027Manage to do\u0027 = succeed in doing."},{"answer":"climb","accept":["climbing"],"options":["climb","to climb","climbing","climbed"],"base":null,"keyword":null,"lead":null,"sentence":"I saw him ___ the wall and disappear into the garden.","hint":"see sb do (complete action)","explanation":"see/hear \u002B object \u002B bare infinitive = the complete action; -ing = the action in progress. Both readings possible here; the bare infinitive is expected."},{"answer":"hearing","accept":[],"options":["hear","to hear","hearing","heard"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ from you.","hint":"look forward to \u002B ?","explanation":"\u0027to\u0027 is a preposition in look forward to, so -ing follows: hearing."},{"answer":"saying","accept":[],"options":["to saying","to say","say","saying"],"base":null,"keyword":null,"lead":null,"sentence":"She left the room without ___ goodbye.","hint":"without \u002B ?","explanation":"preposition \u002B -ing: without saying."},{"answer":"talking","accept":[],"options":["to talking","to talk","talk","talking"],"base":null,"keyword":null,"lead":null,"sentence":"He went on ___ even after the audience had left.","hint":"continue the same activity","explanation":"go on \u002B -ing = continue the same activity; go on to do = do something next."},{"answer":"to warn","accept":[],"options":["to warn","to warning","warning","warn"],"base":null,"keyword":null,"lead":null,"sentence":"We managed ___ everyone before the storm hit.","hint":"manage \u002B ?","explanation":"manage \u002B to-infinitive: managed to warn."},{"answer":"living","accept":[],"options":["live","living","to living","to live"],"base":null,"keyword":null,"lead":null,"sentence":"I miss ___ by the sea.","hint":"miss \u002B ?","explanation":"miss \u002B -ing: miss living."}]}