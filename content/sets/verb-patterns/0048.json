{"id":"verb-patterns-0048","taskId":"verb-patterns","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"moving","accept":[],"options":["to move","to moving","move","moving"],"base":null,"keyword":null,"lead":null,"sentence":"Have you ever considered ___ abroad?","hint":"consider \u002B ?","explanation":"consider \u002B -ing: consider moving."},{"answer":"to check","accept":[],"options":["to checking","check","to check","checking"],"base":null,"keyword":null,"lead":null,"sentence":"The teacher advised us ___ the essay twice.","hint":"advise sb \u002B ?","explanation":"advise \u002B object \u002B to-infinitive: advised us to check. (advise \u002B -ing is possible without object: advise checking.)"},{"answer":"catching","accept":[],"options":["to catch","to catching","catch","catching"],"base":null,"keyword":null,"lead":null,"sentence":"This new timetable will mean ___ earlier trains.","hint":"mean (involve) \u002B ?","explanation":"mean \u002B -ing = involve: will mean catching."},{"answer":"taking","accept":[],"options":["to take","taking","to taking","take"],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the money, but nobody believed him.","hint":"deny \u002B ?","explanation":"deny \u002B -ing: deny taking."},{"answer":"working","accept":["to work"],"options":["to working","work","to work","working"],"base":null,"keyword":null,"lead":null,"sentence":"He continued ___ as if nothing had happened.","hint":"continue \u002B both OK","explanation":"continue takes -ing or to-infinitive. Both accepted."},{"answer":"to know","accept":[],"options":["to knowing","to know","knowing","know"],"base":null,"keyword":null,"lead":null,"sentence":"He seems ___ the news already.","hint":"seem \u002B ?","explanation":"seem/appear take the to-infinitive: seems to know."},{"answer":"to wait","accept":[],"options":["waiting","wait","waited","to wait"],"base":null,"keyword":null,"lead":null,"sentence":"I was made ___ the dustbin lorry at six in the morning.","hint":"passive: was made ___","explanation":"In the passive, make takes the to-infinitive: was made to wait."},{"answer":"trying","accept":[],"options":["try","trying","to try","to trying"],"base":null,"keyword":null,"lead":null,"sentence":"He spent hours ___ to fix the printer.","hint":"spend time \u002B ?","explanation":"spend time \u002B -ing: spent hours trying."}]}