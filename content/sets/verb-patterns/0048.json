{"id":"verb-patterns-0048","taskId":"verb-patterns","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"to mend","accept":[],"options":["mending","to mend","mend","to mending"],"base":null,"keyword":null,"lead":null,"sentence":"They agreed ___ the fence between the two gardens.","hint":"agree \u002B ?","explanation":"agree takes the to-infinitive: agreed to mend."},{"answer":"to live","accept":[],"options":["living","to live","live","to living"],"base":null,"keyword":null,"lead":null,"sentence":"When I was a student, I used ___ in shared flats.","hint":"past habit: used ___ live","explanation":"used TO \u002B infinitive = past habit/state: used to live. (Compare: be used to living.)"},{"answer":"crying","accept":[],"options":["to cry","crying","cry","to crying"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ over spilt milk.","hint":"not worth \u002B ?","explanation":"be worth \u002B -ing: not worth crying."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s thinking about ___ a puppy.","hint":"think about \u002B ?","explanation":"think about \u002B -ing: thinking about getting."},{"answer":"didn\u0027t","accept":[],"options":["don\u0027t","didn\u0027t","not","won\u0027t"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"would rather \u002B somebody \u002B past simple: I\u0027d rather you didn\u0027t smoke."},{"answer":"getting","accept":[],"options":["to get","getting","get","to getting"],"base":null,"keyword":null,"lead":null,"sentence":"I like ___ up early in summer.","hint":"like \u002B both, but for enjoyment\u2026","explanation":"With \u0027like\u0027 meaning enjoy, -ing is preferred: like getting up. \u0027Would like\u0027 takes to: I\u0027d like to get up."},{"answer":"talking","accept":[],"options":["to talk","talking","talk","to talking"],"base":null,"keyword":null,"lead":null,"sentence":"She avoided ___ about the accident.","hint":"avoid \u002B ?","explanation":"avoid is followed by -ing: avoid talking."},{"answer":"to pay","accept":[],"options":["paying","to pay","pay","to paying"],"base":null,"keyword":null,"lead":null,"sentence":"He refused ___ for the damage.","hint":"refuse \u002B ?","explanation":"refuse takes the to-infinitive: refused to pay."}]}