{"id":"rue-part3-0203","taskId":"rue-part3","title":"Drill set 203","text":null,"source":"drill","gaps":[{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Last night\u0027s ___ (PERFORM) ended with a standing ovation.","hint":"noun: the show","explanation":"\u0027Last night\u0027s performance\u0027 \u2014 the noun for the event."}]}