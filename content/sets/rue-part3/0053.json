{"id":"rue-part3-0053","taskId":"rue-part3","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"visionary","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We owe our success to her ___ (VISION) leadership.","hint":"adjective: showing imagination","explanation":"\u0027Visionary leadership\u0027 \u2014 showing imagination and foresight."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"deliberation","accept":[],"options":[],"base":null,"key