{"id":"rue-part3-0053","taskId":"rue-part3","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"shortage","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (SHORT) of funds forced him to abandon the trip.","hint":"noun: not having enough","explanation":"\u0027Shortage of funds\u0027 \u2014 the noun for an insufficient amount."},{"answer":"threaten","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Rising sea levels ___ (THREAT) the very existence of the island.","hint":"verb: put in danger","explanation":"A main verb is needed after the plural subject: threaten."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."}]}