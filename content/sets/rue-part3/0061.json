{"id":"rue-part3-0061","taskId":"rue-part3","title":"Drill set 61","text":null,"source":"drill","gaps":[{"answer":"visible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle is ___ (SIGHT) for miles in every direction.","hint":"adjective: able to be seen","explanation":"\u0027Be visible\u0027 = can be seen; \u0027visibility\u0027 is the noun for how far you can see."},{"answer":"permission","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You will need written ___ (PERMIT) to enter the site.","hint":"noun: official agreement","explanation":"\u0027Written permission\u0027 \u2014 the noun you can be given in writing."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"independence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"India gained ___ (DEPEND) from Britain in 1947.","hint":"noun: the state of being free from rule","explanation":"\u0027Gain independence\u0027 = become self-governing; the noun form follows the verb."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."}]}