{"id":"rue-part3-0193","taskId":"rue-part3","title":"Drill set 193","text":null,"source":"drill","gaps":[{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"cheating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law was introduced to stop ___ (CHEAT) by companies.","hint":"gerund after \u0027stop\u0027","explanation":"\u0027Stop \u002B -ing\u0027: stop cheating."},{"answer":"widened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The mountain road has been ___ (WIDE) to cope with coach traffic.","hint":"passive verb: made wider","explanation":"Passive \u0027has been widened\u0027 \u2014 the verb form meaning made wider."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The document is of great ___ (IMPORTANT) to the case.","hint":"noun after of great","explanation":"\u0027Of great importance\u0027 \u2014 the noun form."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"comparison","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"A side-by-side ___ (COMPARE) of the two plans reveals clear differences.","hint":"noun after an adjective","explanation":"\u0027A comparison of X and Y\u0027 \u2014 the noun form follows the article and adjective."}]}