{"id":"rue-part3-0136","taskId":"rue-part3","title":"Drill set 136","text":null,"source":"drill","gaps":[{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"damaged","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The parcel arrived ___ (DAMAGE).","hint":"participle: in a damaged state","explanation":"\u0027Arrived damaged\u0027 \u2014 participle describing the state of the parcel."},{"answer":"criticised","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister was ___ (CRITIC) for her handling of the flooding crisis.","hint":"passive verb: attacked in words","explanation":"\u0027Be criticised for\u0027 = be attacked verbally; the verb form is needed in the passive."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"anxiously","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She waited ___ (ANXIOUS) by the phone for news.","hint":"adverb: in a worried way","explanation":"The verb \u0027waited\u0027 needs the adverb \u0027anxiously\u0027."},{"answer":"Persistent","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ (PERSIST) rain ruined the first two days of the festival.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027rain\u0027: persistent; \u0027persistence\u0027 is the noun."}]}