{"id":"rue-part3-0117","taskId":"rue-part3","title":"Drill set 117","text":null,"source":"drill","gaps":[{"answer":"difficult","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DIFFICULT) terrain slowed the rescue team.","hint":"adjective before noun","explanation":"\u0027Difficult terrain\u0027 \u2014 adjective needed; \u0027difficulty\u0027 is the noun."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She showed great ___ (WISE) in avoiding the deal.","hint":"noun: quality of being wise","explanation":"\u0027Wisdom\u0027 \u2014 the quality noun from wise (spelling: wise \u2192 wisdom)."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"shortage","accept":[],"options":[],"base":null,"keyword":null,"lead":n