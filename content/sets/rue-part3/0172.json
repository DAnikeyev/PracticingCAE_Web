{"id":"rue-part3-0172","taskId":"rue-part3","title":"Drill set 172","text":null,"source":"drill","gaps":[{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"advice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He gave me some very useful ___ (ADVISE).","hint":"uncountable noun","explanation":"\u0027Advice\u0027 is uncountable \u2014 never \u0027advices\u0027; \u0027advise\u0027 is the verb."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a moving ___ (PERFORM) of the sonata.","hint":"noun after \u0027moving\u0027","explanation":"\u0027A performance of the sonata\u0027 \u2014 the act of performing."},{"answer":"championship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"analysis","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (ANALYSE) of the data took three weeks.","hint":"noun: detailed examination","explanation":"\u0027Analysis\u0027 is the noun for a detailed examination; an \u0027analyst\u0027 is a person."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."}]}