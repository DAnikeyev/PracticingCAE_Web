{"id":"rue-part3-0089","taskId":"rue-part3","title":"Drill set 89","text":null,"source":"drill","gaps":[{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The test measures your ___ (STRONG) in each skill.","hint":"noun form","explanation":"\u0027Strength\u0027 is the noun; \u0027strengthen\u0027 is the verb \u0027to make stronger\u0027."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"mixture","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup is a ___ (MIX) of herbs and spices.","hint":"noun: things combined","explanation":"\u0027A mixture of\u0027 \u2014 the noun for a blend."},{"answer":"suspicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His alibi was highly ___ (SUSPECT).","hint":"adjective: seeming guilty","explanation":"\u0027Highly suspicious\u0027 \u2014 the adjective for something that looks wrong."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"competitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She beat three hundred ___ (COMPETE) for the title.","hint":"plural noun: the people she beat","explanation":"\u0027Three hundred competitors\u0027 \u2014 plural noun for the people taking part."},{"answer":"botany","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s studying ___ (BOTANY) at Cambridge.","hint":"the subject field","explanation":"The subject is \u0027botany\u0027; a specialist is a \u0027botanist\u0027."},{"answer":"environmental","