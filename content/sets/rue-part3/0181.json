{"id":"rue-part3-0181","taskId":"rue-part3","title":"Drill set 181","text":null,"source":"drill","gaps":[{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He speaks French ___ (FLUENT).","hint":"adverb for \u0027speaks\u0027","explanation":"Adverb needed: fluently."},{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"confidently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spoke ___ (CONFIDENT) in front of the camera.","hint":"adverb for \u0027spoke\u0027","explanation":"Adverb needed to modify \u0027spoke\u0027: confidently."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (INTRODUCE) of the euro changed European trade.","hint":"noun: bringing something in","explanation":"\u0027The introduction of\u0027 \u2014 the noun for starting something new."},{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."}]}