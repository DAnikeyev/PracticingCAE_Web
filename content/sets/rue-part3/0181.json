{"id":"rue-part3-0181","taskId":"rue-part3","title":"Drill set 181","text":null,"source":"drill","gaps":[{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"explanation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The leaflet gives a clear ___ (EXPLAIN) of the rules.","hint":"noun after clear","explanation":"\u0027A clear explanation\u0027 \u2014 the noun."},{"answer":"poor visibility","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The road was closed because of ___ (VISIBLE) conditions.","hint":"noun phrase: how far you can see","explanation":"\u0027Visibility\u0027 = the distance you can see; paired with \u0027poor\u0027."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"confidently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spoke ___ (CONFIDENT) in front of the camera.","hint":"adverb for \u0027spoke\u0027","explanation":"Adverb needed to modify \u0027spoke\u0027: confidently."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The test measures your ___ (STRONG) in each skill.","hint":"noun form","explanation":"\u0027Strength\u0027 is the noun; \u0027strengthen\u0027 is the verb \u0027to make stronger\u0027."}]}