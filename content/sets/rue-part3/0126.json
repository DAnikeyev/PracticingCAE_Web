{"id":"rue-part3-0126","taskId":"rue-part3","title":"Drill set 126","text":null,"source":"drill","gaps":[{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"famous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The city is ___ (FAME) for its architecture.","hint":"adjective \u002B for","explanation":"\u0027Famous for\u0027 \u2014 \u0027infamous\u0027 means notorious (famous for bad things)."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"tendency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a ___ (TEND) to exaggerate.","hint":"noun after \u0027a\u0027","explanation":"\u0027A tendency to do something\u0027 \u2014 noun from tend."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (