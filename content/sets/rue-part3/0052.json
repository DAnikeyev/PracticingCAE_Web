{"id":"rue-part3-0052","taskId":"rue-part3","title":"Drill set 52","text":null,"source":"drill","gaps":[{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"bravery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was praised for his ___ (BRAVE) during the fire.","hint":"noun after possessive","explanation":"\u0027His bravery\u0027 \u2014 quality noun; \u0027braveness\u0027 exists but is rare; \u0027bravery\u0027 is standard."}]}