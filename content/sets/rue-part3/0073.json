{"id":"rue-part3-0073","taskId":"rue-part3","title":"Drill set 73","text":null,"source":"drill","gaps":[{"answer":"investments","accept":[],"options":["investments","investing","investors","investment\u0027s"],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"performance","accept":[],"options":["performance","performing","performed","performer"],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"application","accept":[],"options":["application","appliance","applicant","applying"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"agreement","accept":[],"options":["agreement","agreeing","agreeable","agreance"],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"introduction","accept":[],"options":["introduction","introducing","introductory","introducer"],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"trustworthy","accept":["trusted"],"options":["trustworthy","trusted","trusting","trust"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"extensive","accept":[],"options":["extensive","extension","extensively","extent"],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"correctly","accept":[],"options":["correctly","correct","correctness","correction"],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."}]}