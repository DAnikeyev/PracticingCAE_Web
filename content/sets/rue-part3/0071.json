{"id":"rue-part3-0071","taskId":"rue-part3","title":"Drill set 71","text":null,"source":"drill","gaps":[{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"commitment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager praised the team for its ___ (COMMIT) to quality.","hint":"noun: promise to do something","explanation":"The noun from COMMIT is \u0027commitment\u0027 \u2014 a dedication to a course of action."}]}