{"id":"rue-part3-0033","taskId":"rue-part3","title":"Drill set 33","text":null,"source":"drill","gaps":[{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"accuracy","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The model predicts the weather with remarkable ___ (ACCURATE).","hint":"noun after remarkable","explanation":"\u0027With remarkable accuracy\u0027 \u2014 the noun."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."},{"answer":"production","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory has doubled its ___ (PRODUCE) of electric batteries.","hint":"noun after a possessive","explanation":"\u0027Its production\u0027 \u2014 the noun for the amount manufactured follows the possessive."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITIC) of the new scheme.","hint":"adjective: finding fault","explanation":"\u0027Highly critical of\u0027 \u2014 the adjective describing a judgement."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They settled the dispute after a long ___ (ARGUE).","hint":"noun: disagreement","explanation":"\u0027A long argument\u0027 \u2014 the noun."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."}]}