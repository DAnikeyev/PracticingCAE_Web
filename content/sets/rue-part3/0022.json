{"id":"rue-part3-0022","taskId":"rue-part3","title":"Drill set 22","text":null,"source":"drill","gaps":[{"answer":"master","accept":[],"options":["master","masterly","mastery","mastered"],"base":null,"keyword":null,"lead":null,"sentence":"The sculpture is a ___ (MASTER) piece of the Renaissance.","hint":"compound noun","explanation":"\u0027Masterpiece\u0027 = master \u002B piece, written as one word here split by the gap: master\u2026 piece."},{"answer":"investments","accept":[],"options":["investments","investing","investors","investment\u0027s"],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"impressive","accept":[],"options":["impressive","impressed","impression","impressively"],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"successful","accept":[],"options":["successful","success","succeed","successfully"],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"decision","accept":[],"options":["decision","deciding","decisive","decisively"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"fictional","accept":[],"options":["fictional","fiction","fictionally","fictitious of"],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"hopeful","accept":[],"options":["hopeful","hope","hoped","hopefully"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"operating","accept":[],"options":["operating","to operate","operation","operator"],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."}]}