{"id":"rue-part3-0201","taskId":"rue-part3","title":"Drill set 201","text":null,"source":"drill","gaps":[{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"deliberation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee reached its verdict after lengthy ___ (DELIBERATE).","hint":"noun: long discussion","explanation":"\u0027After lengthy deliberation\u0027 \u2014 the noun for careful discussion."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The document is of great ___ (IMPORTANT) to the case.","hint":"noun after of great","explanation":"\u0027Of great importance\u0027 \u2014 the noun form."},{"answer":"education","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The programme aims at the ___ (EDUCATE) of young farmers.","hint":"noun after the","explanation":"\u0027The education of\u0027 \u2014 the noun."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":nu