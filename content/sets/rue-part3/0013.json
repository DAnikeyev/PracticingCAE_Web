{"id":"rue-part3-0013","taskId":"rue-part3","title":"Drill set 13","text":null,"source":"drill","gaps":[{"answer":"mixture","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup is a ___ (MIX) of herbs and spices.","hint":"noun: things combined","explanation":"\u0027A mixture of\u0027 \u2014 the noun for a blend."},{"answer":"education","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The programme aims at the ___ (EDUCATE) of young farmers.","hint":"noun after the","explanation":"\u0027The education of\u0027 \u2014 the noun."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"extensive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"damaged","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The parcel arrived ___ (DAMAGE).","hint":"participle: in a damaged state","explanation":"\u0027Arrived damaged\u0027 \u2014 participle describing the state of the parcel."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."}]}