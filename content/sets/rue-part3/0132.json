{"id":"rue-part3-0132","taskId":"rue-part3","title":"Drill set 132","text":null,"source":"drill","gaps":[{"answer":"government","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new ___ (GOVERN) takes office in May.","hint":"noun: ruling body","explanation":"\u0027The new government\u0027 \u2014 the noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"preparation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"With careful ___ (PREPARE), the trek is perfectly safe.","hint":"noun after careful","explanation":"\u0027Careful preparation\u0027 \u2014 the noun."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The test measures your ___ (STRONG) in each skill.","hint":"noun form","explanation":"\u0027Strength\u0027 is the noun; \u0027strengthen\u0027 is the verb \u0027to make stronger\u0027."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"costly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The delays have made the project far more ___ (COST) than planned.","hint":"adjective: expensive","explanation":"\u0027Far more costly\u0027 \u2014 the comparative adjective is needed after \u0027more\u0027."}]}