{"id":"rue-part3-0074","taskId":"rue-part3","title":"Drill set 74","text":null,"source":"drill","gaps":[{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"weight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge has a maximum ___ (WEIGH) of ten tonnes.","hint":"noun: how heavy","explanation":"\u0027A maximum weight\u0027 \u2014 the noun."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"impressive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATIS