{"id":"rue-part3-0198","taskId":"rue-part3","title":"Drill set 198","text":null,"source":"drill","gaps":[{"answer":"admiration","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gazed at the mural in silent ___ (ADMIRE).","hint":"noun: respect felt","explanation":"\u0027In silent admiration\u0027 \u2014 the noun for the feeling."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the delegation was delayed by the storm.","hint":"noun: coming","explanation":"The noun from ARRIVE is \u0027arrival\u0027."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."}]}