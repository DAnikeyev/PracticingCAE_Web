{"id":"rue-part3-0084","taskId":"rue-part3","title":"Drill set 84","text":null,"source":"drill","gaps":[{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy shows signs of ___ (RECOVER) after the recession.","hint":"noun: getting better","explanation":"The noun from RECOVER is \u0027recovery\u0027."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"historic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The signing of the armistice was a ___ (HISTORY) moment for the region.","hint":"adjective: momentous in history","explanation":"\u0027Historic\u0027 = momentous, making history; \u0027historical\u0027 merely means related to the past."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"unable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (ABLE) to attend because of illness.","hint":"negative adjective","explanation":"\u0027Unable to attend\u0027 \u2014 negative of able is unable."}]}