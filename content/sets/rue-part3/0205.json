{"id":"rue-part3-0205","taskId":"rue-part3","title":"Drill set 205","text":null,"source":"drill","gaps":[{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"historic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The signing of the armistice was a ___ (HISTORY) moment for the region.","hint":"adjective: momentous in history","explanation":"\u0027Historic\u0027 = momentous, making history; \u0027historical\u0027 merely means related to the past."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"botany","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s studying ___ (BOTANY) at Cambridge.","hint":"the subject field","explanation":"The subject is \u0027botany\u0027; a specialist is a \u0027botanist\u0027."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"behaviour","accept":["behavior"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."}]}