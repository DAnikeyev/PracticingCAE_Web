{"id":"rue-part3-0111","taskId":"rue-part3","title":"Drill set 111","text":null,"source":"drill","gaps":[{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"deliberation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee reached its verdict after lengthy ___ (DELIBERATE).","hint":"noun: long discussion","explanation":"\u0027After lengthy deliberation\u0027 \u2014 the noun for careful discussion."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."},{"answer":"shortage","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (SHORT) of funds forced him to abandon the trip.","hint":"noun: not having enough","explanation":"\u0027Shortage of funds\u0027 \u2014 the noun for an insufficient amount."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."}]}