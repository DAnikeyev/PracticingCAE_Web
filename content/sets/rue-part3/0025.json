{"id":"rue-part3-0025","taskId":"rue-part3","title":"Drill set 25","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"commitment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager praised the team for its ___ (COMMIT) to quality.","hint":"noun: promise to do something","explanation":"The noun from COMMIT is \u0027commitment\u0027 \u2014 a dedication to a course of action."},{"answer":"famous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The city is ___ (FAME) for its architecture.","hint":"adjective \u002B for","explanation":"\u0027Famous for\u0027 \u2014 \u0027infamous\u0027 means notorious (famous for bad things)."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."}]}