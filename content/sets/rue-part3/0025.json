{"id":"rue-part3-0025","taskId":"rue-part3","title":"Drill set 25","text":null,"source":"drill","gaps":[{"answer":"qualified","accept":[],"options":["qualified","qualifying","qualification","qualifier"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"sleeplessness","accept":[],"options":["sleeplessness","sleepless","sleeplessly","asleep"],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"modernise","accept":["modernize"],"options":["modernise","modern","modernly","modernness"],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"harmful","accept":[],"options":["harmful","harmless","harm","harmed"],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"hopeful","accept":[],"options":["hopeful","hope","hoped","hopefully"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"length","accept":[],"options":["length","long","longly","longness"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (LONG) of the film is 145 minutes.","hint":"noun from long","explanation":"\u0027The length\u0027 \u2014 noun from long (spelling change: long \u2192 length)."},{"answer":"owner","accept":[],"options":["owner","ownership","owning","own"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (OWN) of the car park charges by the hour.","hint":"person noun","explanation":"\u0027The owner\u0027 \u2014 the person who owns it; \u0027ownership\u0027 is the state."},{"answer":"introduction","accept":[],"options":["introduction","introducing","introductory","introducer"],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."}]}