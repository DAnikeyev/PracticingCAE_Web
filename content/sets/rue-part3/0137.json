{"id":"rue-part3-0137","taskId":"rue-part3","title":"Drill set 137","text":null,"source":"drill","gaps":[{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"cheating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law was introduced to stop ___ (CHEAT) by companies.","hint":"gerund after \u0027stop\u0027","explanation":"\u0027Stop \u002B -ing\u0027: stop cheating."},{"answer":"impressive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"anxiously","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She waited ___ (ANXIOUS) by the phone for news.","hint":"adverb: in a worried way","explanation":"The verb \u0027waited\u0027 needs the adverb \u0027anxiously\u0027."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."},{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":nul