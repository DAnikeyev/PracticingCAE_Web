{"id":"rue-part3-0137","taskId":"rue-part3","title":"Drill set 137","text":null,"source":"drill","gaps":[{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."},{"answer":"loss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team\u0027s ___ (LOSE) came as a shock to the fans.","hint":"noun: being defeated","explanation":"\u0027Their loss\u0027 \u2014 the noun for a defeat or disappearance."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"visionary","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We owe our success to her ___ (VISION) leadership.","hint":"adjective: showing imagination","explanation":"\u0027Visionary leadership\u0027 \u2014 showing imagination and foresight."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"suspicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His alibi was highly ___ (SUSPECT).","hint":"adjective: seeming guilty","explanation":"\u0027Highly suspicious\u0027 \u2014 the adjective for something that looks wrong."},{"answer":"damaged","accept":[],"option