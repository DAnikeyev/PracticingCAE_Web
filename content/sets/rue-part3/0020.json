{"id":"rue-part3-0020","taskId":"rue-part3","title":"Drill set 20","text":null,"source":"drill","gaps":[{"answer":"visionary","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We owe our success to her ___ (VISION) leadership.","hint":"adjective: showing imagination","explanation":"\u0027Visionary leadership\u0027 \u2014 showing imagination and foresight."},{"answer":"cheating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law was introduced to stop ___ (CHEAT) by companies.","hint":"gerund after \u0027stop\u0027","explanation":"\u0027Stop \u002B -ing\u0027: stop cheating."},{"answer":"suspicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His alibi was highly ___ (SUSPECT).","hint":"adjective: seeming guilty","explanation":"\u0027Highly suspicious\u0027 \u2014 the adjective for something that looks wrong."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"commitment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager praised the team for its ___ (COMMIT) to quality.","hint":"noun: promise to do something","explanation":"The noun from COMMIT is \u0027commitment\u0027 \u2014 a dedication to a course of action."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a moving ___ (PERFORM) of the sonata.","hint":"noun after \u0027moving\u0027","explanation":"\u0027A performance of the sonata\u0027 \u2014 the act of performing."},{"answer":"e