{"id":"rue-part3-0101","taskId":"rue-part3","title":"Drill set 101","text":null,"source":"drill","gaps":[{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"friendship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Their ___ (FRIEND) goes back to their university days.","hint":"noun: the relationship","explanation":"\u0027Friendship\u0027 is the relationship between friends; \u0027friendliness\u0027 is a manner."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."}]}