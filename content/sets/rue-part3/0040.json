{"id":"rue-part3-0040","taskId":"rue-part3","title":"Drill set 40","text":null,"source":"drill","gaps":[{"answer":"bravery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was praised for his ___ (BRAVE) during the fire.","hint":"noun after possessive","explanation":"\u0027His bravery\u0027 \u2014 quality noun; \u0027braveness\u0027 exists but is rare; \u0027bravery\u0027 is standard."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"death","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"confusing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."}]}