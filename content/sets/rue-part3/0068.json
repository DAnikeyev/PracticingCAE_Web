{"id":"rue-part3-0068","taskId":"rue-part3","title":"Drill set 68","text":null,"source":"drill","gaps":[{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the delegation was delayed by the storm.","hint":"noun: coming","explanation":"The noun from ARRIVE is \u0027arrival\u0027."},{"answer":"behaviour","accept":["behavior"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"anxiously","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She waited ___ (ANXIOUS) by the phone for news.","hint":"adverb: in a worried way","explanation":"The verb \u0027waited\u0027 needs the adverb \u0027anxiously\u0027."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITIC) of the new scheme.","hint":"adjective: finding fault","explanation":"\u0027Highly critical of\u0027 \u2014 the adjective describing a judgement."},{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"disappointed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"written","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions were ___ (WRITE) in six languages.","hint":"past participle (passive)","explanation":"Passive voice: were written \u2014 irregular participle of write."},{"answer":"extensive","accept":[],"options":[],"base":nu