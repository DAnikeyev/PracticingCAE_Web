{"id":"rue-part3-0088","taskId":"rue-part3","title":"Drill set 88","text":null,"source":"drill","gaps":[{"answer":"independence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"India gained ___ (DEPEND) from Britain in 1947.","hint":"noun: the state of being free from rule","explanation":"\u0027Gain independence\u0027 = become self-governing; the noun form follows the verb."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a moving ___ (PERFORM) of the sonata.","hint":"noun after \u0027moving\u0027","explanation":"\u0027A performance of the sonata\u0027 \u2014 the act of performing."},{"answer":"revision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law needs complete ___ (REVISE) before it can work.","hint":"noun: thorough change","explanation":"The noun from REVISE is \u0027revision\u0027."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."}]}