{"id":"rue-part3-0093","taskId":"rue-part3","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"commitment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager praised the team for its ___ (COMMIT) to quality.","hint":"noun: promise to do something","explanation":"The noun from COMMIT is \u0027commitment\u0027 \u2014 a dedication to a course of action."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"undeniable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It is ___ (DENY) that the policy has failed.","hint":"adjective: impossible to deny","explanation":"\u0027It is undeniable that \u2026\u0027 \u2014 adjective meaning cannot be denied."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"surprising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"successful","accept":[]