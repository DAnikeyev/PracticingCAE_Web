{"id":"rue-part3-0041","taskId":"rue-part3","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"extensive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"calm","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The police appealed for ___ (CALM).","hint":"noun after \u0027for\u0027","explanation":"\u0027Appealed for calm\u0027 \u2014 the set phrase uses \u0027calm\u0027 as noun."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."}]}