{"id":"rue-part3-0070","taskId":"rue-part3","title":"Drill set 70","text":null,"source":"drill","gaps":[{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"exhibition","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum\u0027s ___ (EXHIBIT) of Egyptian art opens on Friday.","hint":"noun: a public show","explanation":"\u0027An exhibition\u0027 = a public display of art; \u0027an exhibit\u0027 is a single item."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"cheating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law was introduced to stop ___ (CHEAT) by companies.","hint":"gerund after \u0027stop\u0027","explanation":"\u0027Stop \u002B -ing\u0027: stop cheating."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."}]}