{"id":"rue-part3-0017","taskId":"rue-part3","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."}]}