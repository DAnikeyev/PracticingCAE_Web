{"id":"rue-part3-0080","taskId":"rue-part3","title":"Drill set 80","text":null,"source":"drill","gaps":[{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"accuracy","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The model predicts the weather with remarkable ___ (ACCURATE).","hint":"noun after remarkable","explanation":"\u0027With remarkable accuracy\u0027 \u2014 the noun."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"unemployed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The closure of the mine will leave four hundred workers ___ (EMPLOY).","hint":"negative adjective: without a job","explanation":"\u0027Leave somebody unemployed\u0027 \u2014 the negative adjective describes the workers."},{"answer":"revision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law needs complete ___ (REVISE) before it can work.","hint":"noun: thorough change","explanation":"The noun from REVISE is \u0027revision\u0027."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The test measures your ___ (STRONG) in each skill.","hint":"noun form","explanation":"\u0027Strength\u0027 is the noun; \u0027strengthen\u0027 is the verb \u0027to make stronger\u0027."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"senten