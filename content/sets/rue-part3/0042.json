{"id":"rue-part3-0042","taskId":"rue-part3","title":"Drill set 42","text":null,"source":"drill","gaps":[{"answer":"fictional","accept":[],"options":["fictional","fiction","fictionally","fictitious of"],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"widely","accept":[],"options":["widely","wide","width","widen"],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"management","accept":[],"options":["management","managing","manageable","manager"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"awareness","accept":[],"options":["awareness","aware","awaring","awarely"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"introduction","accept":[],"options":["introduction","introducing","introductory","introducer"],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"disappointed","accept":[],"options":["disappointed","unappointed","misappointed","deappointed"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"successful","accept":[],"options":["successful","success","succeed","successfully"],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"selection","accept":[],"options":["selection","select","selective","selectively"],"base":null,"keyword":null,"lead":null,"sentence":"This shop offers a wide ___ (SELECT) of cheeses.","hint":"noun: a range","explanation":"\u0027A selection of\u0027 = a range of items to choose from."}]}