{"id":"rue-part3-0045","taskId":"rue-part3","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"written","accept":[],"options":["written","wrote","writting","writable"],"base":null,"keyword":null,"lead":null,"sentence":"The instructions were ___ (WRITE) in six languages.","hint":"past participle (passive)","explanation":"Passive voice: were written \u2014 irregular participle of write."},{"answer":"commercial","accept":[],"options":["commercial","commerce","commercially","commercialise"],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"illegal","accept":[],"options":["illegal","unlegal","nonlegal","dislegal"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"trustworthy","accept":["trusted"],"options":["trustworthy","trusted","trusting","trust"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"harmful","accept":[],"options":["harmful","harmless","harm","harmed"],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"tiring","accept":[],"options":["tiring","tired","tire","tiresome of"],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 mean