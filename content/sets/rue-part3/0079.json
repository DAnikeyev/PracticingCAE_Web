{"id":"rue-part3-0079","taskId":"rue-part3","title":"Drill set 79","text":null,"source":"drill","gaps":[{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"poor visibility","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The road was closed because of ___ (VISIBLE) conditions.","hint":"noun phrase: how far you can see","explanation":"\u0027Visibility\u0027 = the distance you can see; paired with \u0027poor\u0027."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"surprising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."}]}