{"id":"rue-part3-0113","taskId":"rue-part3","title":"Drill set 113","text":null,"source":"drill","gaps":[{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"weight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge has a maximum ___ (WEIGH) of ten tonnes.","hint":"noun: how heavy","explanation":"\u0027A maximum weight\u0027 \u2014 the noun."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"systematically","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They searched the area ___ (SYSTEM) for clues.","hint":"adverb for \u0027searched\u0027","explanation":"Adverb needed: systematically (method by method)."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He speaks French ___ (FLUENT).","hint":"adverb for \u0027speaks\u0027","explanation":"Adverb needed: fluently."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"production","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory has doubled its ___ (PRODUCE) of electric batteries.","hint":"noun after a possessive","explanation":"\u0027Its production\u0027 \u2014 the noun for the amount manufactured follows the possessive."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."}]}