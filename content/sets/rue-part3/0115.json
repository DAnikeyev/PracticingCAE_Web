{"id":"rue-part3-0115","taskId":"rue-part3","title":"Drill set 115","text":null,"source":"drill","gaps":[{"answer":"famous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The city is ___ (FAME) for its architecture.","hint":"adjective \u002B for","explanation":"\u0027Famous for\u0027 \u2014 \u0027infamous\u0027 means notorious (famous for bad things)."},{"answer":"behaviour","accept":["behavior"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"protection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The vaccine gives ___ (PROTECT) against three strains.","hint":"noun after gives","explanation":"\u0027Gives protection against\u0027 \u2014 the noun is required."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null