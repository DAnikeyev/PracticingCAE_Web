{"id":"rue-part3-0029","taskId":"rue-part3","title":"Drill set 29","text":null,"source":"drill","gaps":[{"answer":"production","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory has doubled its ___ (PRODUCE) of electric batteries.","hint":"noun after a possessive","explanation":"\u0027Its production\u0027 \u2014 the noun for the amount manufactured follows the possessive."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"explanation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The leaflet gives a clear ___ (EXPLAIN) of the rules.","hint":"noun after clear","explanation":"\u0027A clear explanation\u0027 \u2014 the noun."},{"answer":"unbelievably","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"enables","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new software ___ (ABLE) staff to work securely from anywhere.","hint":"verb: make possible","explanation":"\u0027Enable somebody to do something\u0027 \u2014 the present-tense verb fits the singular subject."},{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"proof","accept":[],"options":[],"ba