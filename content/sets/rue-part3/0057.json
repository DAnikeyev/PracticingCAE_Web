{"id":"rue-part3-0057","taskId":"rue-part3","title":"Drill set 57","text":null,"source":"drill","gaps":[{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"advice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He gave me some very useful ___ (ADVISE).","hint":"uncountable noun","explanation":"\u0027Advice\u0027 is uncountable \u2014 never \u0027advices\u0027; \u0027advise\u0027 is the verb."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a moving ___ (PERFORM) of the sonata.","hint":"noun after \u0027moving\u0027","explanation":"\u0027A performance of the sonata\u0027 \u2014 the act of performing."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"exhibition","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum\u0027s ___ (EXHIBIT) of Egyptian art opens on Friday.","hint":"noun: a public show","explanation":"\u0027An exhibition\u0027 = a public display of art; \u0027an exhibit\u0027 is a single item."}]}