{"id":"rue-part3-0059","taskId":"rue-part3","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"awareness","accept":[],"options":["awareness","aware","awaring","awarely"],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"disappointed","accept":[],"options":["disappointed","unappointed","misappointed","deappointed"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"recovery","accept":[],"options":["recovery","recover","recovering","recoverer"],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."},{"answer":"advice","accept":[],"options":["advice","advices","advising","advise"],"base":null,"keyword":null,"lead":null,"sentence":"He gave me some very useful ___ (ADVISE).","hint":"uncountable noun","explanation":"\u0027Advice\u0027 is uncountable \u2014 never \u0027advices\u0027; \u0027advise\u0027 is the verb."},{"answer":"damaged","accept":[],"options":["damaged","damage","damaging","damagely"],"base":null,"keyword":null,"lead":null,"sentence":"The parcel arrived ___ (DAMAGE).","hint":"participle: in a damaged state","explanation":"\u0027Arrived damaged\u0027 \u2014 participle describing the state of the parcel."},{"answer":"strength","accept":[],"options":["strength","strong","strongly","strengthen"],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"exhibition","accept":[],"options":["exhibition","exhibit","exhibiting","exhibitor"],"base":null,"keyword":null,"lead":null,"sentence":"The museum\u0027s ___ (EXHIBIT) of Egyptian art opens on Friday.","hint":"noun: a public show","explanation":"\u0027An exhibition\u0027 = a public display of art; \u0027an exhibit\u0027 is a single item."},{"answer":"widely","accept":[],"options":["widely","wide","width","widen"],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."}]}