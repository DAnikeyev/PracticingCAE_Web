{"id":"rue-part3-0059","taskId":"rue-part3","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"poor visibility","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The road was closed because of ___ (VISIBLE) conditions.","hint":"noun phrase: how far you can see","explanation":"\u0027Visibility\u0027 = the distance you can see; paired with \u0027poor\u0027."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"comfortable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The trainers were ___ (COMFORT) for long walks.","hint":"adjective after \u0027were\u0027","explanation":"\u0027Were comfortable\u0027 \u2014 adjective; note the spelling: -able, not -ible."}]}