{"id":"rue-part3-0091","taskId":"rue-part3","title":"Drill set 91","text":null,"source":"drill","gaps":[{"answer":"suspected","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SUSPECT) of fraud last year.","hint":"passive participle","explanation":"\u0027Was suspected of\u0027 \u2014 passive; \u0027suspicious\u0027 describes a person who suspects."},{"answer":"behaviour","accept":["behavior"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."}]}