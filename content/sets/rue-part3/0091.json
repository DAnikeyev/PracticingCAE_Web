{"id":"rue-part3-0091","taskId":"rue-part3","title":"Drill set 91","text":null,"source":"drill","gaps":[{"answer":"comparison","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"A side-by-side ___ (COMPARE) of the two plans reveals clear differences.","hint":"noun after an adjective","explanation":"\u0027A comparison of X and Y\u0027 \u2014 the noun form follows the article and adjective."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."},{"answer":"innovative","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"applicat