{"id":"rue-part3-0186","taskId":"rue-part3","title":"Drill set 186","text":null,"source":"drill","gaps":[{"answer":"resignation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His sudden ___ (RESIGN) surprised everyone in the department.","hint":"noun: act of leaving a job","explanation":"The noun from RESIGN is \u0027resignation\u0027."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"accuracy","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The model predicts the weather with remarkable ___ (ACCURATE).","hint":"noun after remarkable","explanation":"\u0027With remarkable accuracy\u0027 \u2014 the noun."},{"answer":"confidently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spoke ___ (CONFIDENT) in front of the camera.","hint":"adverb for \u0027spoke\u0027","explanation":"Adverb needed to modify \u0027spoke\u0027: confidently."},{"answer":"deliberation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee reached its verdict after lengthy ___ (DELIBERATE).","hint":"noun: long discussion","explanation":"\u0027After lengthy deliberation\u0027 \u2014 the noun for careful discussion."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."}]}