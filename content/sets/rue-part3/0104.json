{"id":"rue-part3-0104","taskId":"rue-part3","title":"Drill set 104","text":null,"source":"drill","gaps":[{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"explanation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The leaflet gives a clear ___ (EXPLAIN) of the rules.","hint":"noun after clear","explanation":"\u0027A clear explanation\u0027 \u2014 the noun."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"protection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The vaccine gives ___ (PROTECT) against three strains.","hint":"noun after gives","explanation":"\u0027Gives protection against\u0027 \u2014 the noun is required."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"disappointed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."}]}