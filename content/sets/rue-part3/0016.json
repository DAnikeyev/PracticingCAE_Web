{"id":"rue-part3-0016","taskId":"rue-part3","title":"Drill set 16","text":null,"source":"drill","gaps":[{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."}]}