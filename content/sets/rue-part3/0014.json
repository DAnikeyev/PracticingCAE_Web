{"id":"rue-part3-0014","taskId":"rue-part3","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"death","accept":[],"options":["death","deathly","dead","dying"],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"extensive","accept":[],"options":["extensive","extension","extensively","extent"],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"confusing","accept":[],"options":["confusing","confused","confusion","confusingly"],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"contributor","accept":[],"options":["contributor","contribution","contributing","contributive"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"qualified","accept":[],"options":["qualified","qualifying","qualification","qualifier"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"impressive","accept":[],"options":["impressive","impressed","impression","impressively"],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"management","accept":[],"options":["management","managing","manageable","manager"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"championship","accept":[],"options":["championship","champion","championing","champion\u0027s"],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."}]}