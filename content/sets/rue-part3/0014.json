{"id":"rue-part3-0014","taskId":"rue-part3","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"death","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."}]}