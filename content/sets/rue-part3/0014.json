{"id":"rue-part3-0014","taskId":"rue-part3","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sen