{"id":"rue-part3-0199","taskId":"rue-part3","title":"Drill set 199","text":null,"source":"drill","gaps":[{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."},{"answer":"confusing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."}]}