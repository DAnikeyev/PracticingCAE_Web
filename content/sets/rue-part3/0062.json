{"id":"rue-part3-0062","taskId":"rue-part3","title":"Drill set 62","text":null,"source":"drill","gaps":[{"answer":"death","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"preparation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"With careful ___ (PREPARE), the trek is perfectly safe.","hint":"noun after careful","explanation":"\u0027Careful preparation\u0027 \u2014 the noun."},{"answer":"visionary","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We owe our success to her ___ (VISION) leadership.","hint":"adjective: showing imagination","explanation":"\u0027Visionary leadership\u0027 \u2014 showing imagination and foresight."},{"answer":"disappointed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"simply","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The problem was ___ (SIMPLE) a matter of bad timing.","hint":"adverb: merely","explanation":"\u0027Simply a matter of\u0027 = only a matter of."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."},{"answer":"weight","accept":[],"options":[],"base":null,"key