{"id":"rue-part3-0135","taskId":"rue-part3","title":"Drill set 135","text":null,"source":"drill","gaps":[{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."},{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."},{"answer":"simply","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The problem was ___ (SIMPLE) a matter of bad timing.","hint":"adverb: merely","explanation":"\u0027Simply a matter of\u0027 = only a matter of."},{"answer":"education","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The programme aims at the ___ (EDUCATE) of young farmers.","hint":"noun after the","explanation":"\u0027The education of\u0027 \u2014 the noun."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"unbelievably","accept":[],"options"