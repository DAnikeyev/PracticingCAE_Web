{"id":"rue-part3-0153","taskId":"rue-part3","title":"Drill set 153","text":null,"source":"drill","gaps":[{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITICISE) of the ministry.","hint":"adjective: finding fault","explanation":"\u0027Be critical of\u0027 \u2014 adjective; \u0027criticism\u0027 is the noun."},{"answer":"tendency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a ___ (TEND) to exaggerate.","hint":"noun after \u0027a\u0027","explanation":"\u0027A tendency to do something\u0027 \u2014 noun from tend."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"strengthened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The wind ___ (STRONG) during the night.","hint":"verb: became stronger","explanation":"\u0027The wind strengthened\u0027 \u2014 the verb from STRONG."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."}]}