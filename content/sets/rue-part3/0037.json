{"id":"rue-part3-0037","taskId":"rue-part3","title":"Drill set 37","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"deliberation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee reached its verdict after lengthy ___ (DELIBERATE).","hint":"noun: long discussion","explanation":"\u0027After lengthy deliberation\u0027 \u2014 the noun for careful discussion."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"safety","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."}]}