{"id":"rue-part3-0141","taskId":"rue-part3","title":"Drill set 141","text":null,"source":"drill","gaps":[{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"solution","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated a quick ___ (SOLVE) to the crisis.","hint":"noun: the answer","explanation":"\u0027A solution to the crisis\u0027 \u2014 the noun."},{"answer":"friendship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Their ___ (FRIEND) goes back to their university days.","hint":"noun: the relationship","explanation":"\u0027Friendship\u0027 is the relationship between friends; \u0027friendliness\u0027 is a manner."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"discipline","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The coach criticised the team\u0027s lack of ___ (DISCIPLINE).","hint":"noun: ordered behaviour","explanation":"\u0027Lack of discipline\u0027 \u2014 the noun is required after \u0027lack of\u0027."}]}