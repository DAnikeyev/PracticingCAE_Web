{"id":"rue-part3-0175","taskId":"rue-part3","title":"Drill set 175","text":null,"source":"drill","gaps":[{"answer":"government","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new ___ (GOVERN) takes office in May.","hint":"noun: ruling body","explanation":"\u0027The new government\u0027 \u2014 the noun."},{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"widespread","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (WIDE) damage along the coast.","hint":"adjective: affecting many places","explanation":"\u0027Widespread damage\u0027 = damage across a large area."},{"answer":"tendency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a ___ (TEND) to exaggerate.","hint":"noun after \u0027a\u0027","explanation":"\u0027A tendency to do something\u0027 \u2014 noun from tend."},{"answer":"safety","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."}]}