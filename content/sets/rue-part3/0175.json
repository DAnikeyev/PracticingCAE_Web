{"id":"rue-part3-0175","taskId":"rue-part3","title":"Drill set 175","text":null,"source":"drill","gaps":[{"answer":"conveniently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The hotel is ___ (CONVENIENT) situated near the station.","hint":"adverb before the participle","explanation":"\u0027Conveniently situated\u0027 \u2014 the adverb modifies the participle."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the delegation was delayed by the storm.","hint":"noun: coming","explanation":"The noun from ARRIVE is \u0027arrival\u0027."},{"answer":"simply","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The problem was ___ (SIMPLE) a matter of bad timing.","hint":"adverb: merely","explanation":"\u0027Simply a matter of\u0027 = only a matter of."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."}]}