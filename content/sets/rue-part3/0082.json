{"id":"rue-part3-0082","taskId":"rue-part3","title":"Drill set 82","text":null,"source":"drill","gaps":[{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."}]}