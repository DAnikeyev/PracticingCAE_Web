{"id":"rue-part3-0082","taskId":"rue-part3","title":"Drill set 82","text":null,"source":"drill","gaps":[{"answer":"difficult","accept":[],"options":["difficult","difficulty","difficultly","difficultness"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DIFFICULT) terrain slowed the rescue team.","hint":"adjective before noun","explanation":"\u0027Difficult terrain\u0027 \u2014 adjective needed; \u0027difficulty\u0027 is the noun."},{"answer":"operating","accept":[],"options":["operating","to operate","operation","operator"],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"repairing","accept":[],"options":["repairing","to repair","repair","repairable"],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"successful","accept":[],"options":["successful","success","succeed","successfully"],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"arrested","accept":[],"options":["arrested","arresting","arrest","arrestment"],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"scientist","accept":[],"options":["scientist","science","scientific","scientifically"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"revising","accept":[],"options":["revising","to revise","revision","revised"],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"modernise","accept":["modernize"],"options":["modernise","modern","modernly","modernness"],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."}]}