{"id":"rue-part3-0082","taskId":"rue-part3","title":"Drill set 82","text":null,"source":"drill","gaps":[{"answer":"owner","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (OWN) of the car park charges by the hour.","hint":"person noun","explanation":"\u0027The owner\u0027 \u2014 the person who owns it; \u0027ownership\u0027 is the state."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"criticised","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister was ___ (CRITIC) for her handling of the flooding crisis.","hint":"passive verb: attacked in words","explanation":"\u0027Be criticised for\u0027 = be attacked verbally; the verb form is needed in the passive."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"simplified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions have been ___ (SIMPLE) so that children can follow them.","hint":"passive verb: made simpler","explanation":"Passive \u0027have been simplified\u0027 \u2014 the verb form meaning made simpler."}]}