{"id":"rue-part3-0124","taskId":"rue-part3","title":"Drill set 124","text":null,"source":"drill","gaps":[{"answer":"comfortable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The trainers were ___ (COMFORT) for long walks.","hint":"adjective after \u0027were\u0027","explanation":"\u0027Were comfortable\u0027 \u2014 adjective; note the spelling: -able, not -ible."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"analysis","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (ANALYSE) of the data took three weeks.","hint":"noun: detailed examination","explanation":"\u0027Analysis\u0027 is the noun for a detailed examination; an \u0027analyst\u0027 is a person."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u