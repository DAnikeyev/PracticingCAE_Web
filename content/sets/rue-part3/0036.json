{"id":"rue-part3-0036","taskId":"rue-part3","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"protection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The vaccine gives ___ (PROTECT) against three strains.","hint":"noun after gives","explanation":"\u0027Gives protection against\u0027 \u2014 the noun is required."},{"answer":"preparation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"With careful ___ (PREPARE), the trek is perfectly safe.","hint":"noun after careful","explanation":"\u0027Careful preparation\u0027 \u2014 the noun."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"resignation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His sudden ___ (RESIGN) surprised everyone in the department.","hint":"noun: act of leaving a job","explanation":"The noun from RESIGN is \u0027resignation\u0027."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."}]}