{"id":"rue-part3-0189","taskId":"rue-part3","title":"Drill set 189","text":null,"source":"drill","gaps":[{"answer":"suspicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His alibi was highly ___ (SUSPECT).","hint":"adjective: seeming guilty","explanation":"\u0027Highly suspicious\u0027 \u2014 the adjective for something that looks wrong."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"disappointed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"undeniable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It is ___ (DENY) that the policy has failed.","hint":"adjective: impossible to deny","explanation":"\u0027It is undeniable that \u2026\u0027 \u2014 adjective meaning cannot be denied."},{"answer":"protection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The vaccine gives ___ (PROTECT) against three strains.","hint":"noun after gives","explanation":"\u0027Gives protection against\u0027 \u2014 the noun is required."},{"answer":"behaviour","accept":["behavior"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."}]}