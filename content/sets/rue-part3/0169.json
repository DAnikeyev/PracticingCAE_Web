{"id":"rue-part3-0169","taskId":"rue-part3","title":"Drill set 169","text":null,"source":"drill","gaps":[{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"mixture","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup is a ___ (MIX) of herbs and spices.","hint":"noun: things combined","explanation":"\u0027A mixture of\u0027 \u2014 the noun for a blend."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"accuracy","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The model predicts the weather with remarkable ___ (ACCURATE).","hint":"noun after remarkable","explanation":"\u0027With remarkable accuracy\u0027 \u2014 the noun."},{"answer":"unemployed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence