{"id":"rue-part3-0060","taskId":"rue-part3","title":"Drill set 60","text":null,"source":"drill","gaps":[{"answer":"impressive","accept":[],"options":["impressive","impressed","impression","impressively"],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"behaviour","accept":["behavior"],"options":["behaviour","behaved","behavioural","behave"],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (BEHAVE) at school has improved.","hint":"noun: conduct","explanation":"\u0027His behaviour\u0027 \u2014 noun from behave (BrE spelling -our)."},{"answer":"commercial","accept":[],"options":["commercial","commerce","commercially","commercialise"],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"visitors","accept":[],"options":["visitors","visit","visiting","visitant"],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"sleeplessness","accept":[],"options":["sleeplessness","sleepless","sleeplessly","asleep"],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"unbelievably","accept":[],"options":["unbelievably","unbelievable","unbelief","believing"],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"arrival","accept":[],"options":["arrival","arrive","arriving","arrivance"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"trustworthy","accept":["trusted"],"options":["trustworthy","trusted","trusting","trust"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."}]}