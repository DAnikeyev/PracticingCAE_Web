{"id":"rue-part3-0188","taskId":"rue-part3","title":"Drill set 188","text":null,"source":"drill","gaps":[{"answer":"donations","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The charity relies entirely on voluntary ___ (DONATE).","hint":"plural noun: gifts of money","explanation":"\u0027Voluntary donations\u0027 \u2014 gifts of money given willingly."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"strengthened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The wind ___ (STRONG) during the night.","hint":"verb: became stronger","explanation":"\u0027The wind strengthened\u0027 \u2014 the verb from STRONG."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They settled the dispute after a long ___ (ARGUE).","hint":"noun: disagreement","explanation":"\u0027A long argument\u0027 \u2014 the noun."},{"answer":"employ","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory will ___ (EMPLOY) fifty more workers next year.","hint":"verb after will","explanation":"The bare verb follows \u0027will\u0027: will employ."}]}