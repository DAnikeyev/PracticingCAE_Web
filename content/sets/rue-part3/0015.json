{"id":"rue-part3-0015","taskId":"rue-part3","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITICISE) of the ministry.","hint":"adjective: finding fault","explanation":"\u0027Be critical of\u0027 \u2014 adjective; \u0027criticism\u0027 is the noun."}]}