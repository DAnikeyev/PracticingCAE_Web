{"id":"rue-part3-0149","taskId":"rue-part3","title":"Drill set 149","text":null,"source":"drill","gaps":[{"answer":"competitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She beat three hundred ___ (COMPETE) for the title.","hint":"plural noun: the people she beat","explanation":"\u0027Three hundred competitors\u0027 \u2014 plural noun for the people taking part."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."},{"answer":"modernise","accept":["modernize"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company needs to ___ (MODERN) its factories.","hint":"verb: make modern","explanation":"\u0027Modernise\u0027 (BrE) / \u0027modernize\u0027 \u2014 verb with -ise."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"donations","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The charity relies entirely on voluntary ___ (DONATE).","hint":"plural noun: gifts of money","explanation":"\u0027Voluntary donations\u0027 \u2014 gifts of money given wil