{"id":"rue-part3-0051","taskId":"rue-part3","title":"Drill set 51","text":null,"source":"drill","gaps":[{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"resignation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His sudden ___ (RESIGN) surprised everyone in the department.","hint":"noun: act of leaving a job","explanation":"The noun from RESIGN is \u0027resignation\u0027."},{"answer":"weight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge has a maximum ___ (WEIGH) of ten tonnes.","hint":"noun: how heavy","explanation":"\u0027A maximum weight\u0027 \u2014 the noun."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"contradictory","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two statements are directly ___ (CONTRADICT).","hint":"adjective: mutually opposed","explanation":"\u0027Directly contradictory\u0027 \u2014 the adjective meaning they cannot both be true."},{"answer":"loss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team\u0027s ___ (LOSE) came as a shock to the fans.","hint":"noun: being defeated","explanation":"\u0027Their loss\u0027 \u2014 the noun for a defeat or disappearance."},{"answer":"strength","accept":[],"options":[],"base":null,"keyw