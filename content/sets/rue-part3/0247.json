{"id":"rue-part3-0247","taskId":"rue-part3","title":"Drill set 247","text":null,"source":"drill","gaps":[{"answer":"carefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Drive ___ (CARE) \u2014 the mountain road has hairpin bends.","hint":"adverb modifying a verb","explanation":"An adverb is needed to modify \u0027drive\u0027: carefully."},{"answer":"production","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory has doubled its ___ (PRODUCE) of electric batteries.","hint":"noun after a possessive","explanation":"\u0027Its production\u0027 \u2014 the noun for the amount manufactured follows the possessive."},{"answer":"strengthened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The wind ___ (STRONG) during the night.","hint":"verb: became stronger","explanation":"\u0027The wind strengthened\u0027 \u2014 the verb from STRONG."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"innovative","accept":[],"opti