{"id":"rue-part3-0018","taskId":"rue-part3","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"safety","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"selection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This shop offers a wide ___ (SELECT) of cheeses.","hint":"noun: a range","explanation":"\u0027A selection of\u0027 = a range of items to choose from."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE)