{"id":"rue-part3-0018","taskId":"rue-part3","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She showed great ___ (WISE) in avoiding the deal.","hint":"noun: quality of being wise","explanation":"\u0027Wisdom\u0027 \u2014 the quality noun from wise (spelling: wise \u2192 wisdom)."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"botany","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s studying ___ (BOTANY) at Cambridge.","hint":"the subject field","explanation":"The subject is \u0027botany\u0027; a specialist is a \u0027botanist\u0027."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITICISE) of the ministry.","hint":"adjective: finding fault","explanation":"\u0027Be critical of\u0027 \u2014 adjective;