{"id":"rue-part3-0109","taskId":"rue-part3","title":"Drill set 109","text":null,"source":"drill","gaps":[{"answer":"trustworthy","accept":["trusted"],"options":["trustworthy","trusted","trusting","trust"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"comfortable","accept":[],"options":["comfortable","comfort","comfortably","comforted"],"base":null,"keyword":null,"lead":null,"sentence":"The trainers were ___ (COMFORT) for long walks.","hint":"adjective after \u0027were\u0027","explanation":"\u0027Were comfortable\u0027 \u2014 adjective; note the spelling: -able, not -ible."},{"answer":"death","accept":[],"options":["death","deathly","dead","dying"],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"sleeplessness","accept":[],"options":["sleeplessness","sleepless","sleeplessly","asleep"],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"disappointed","accept":[],"options":["disappointed","unappointed","misappointed","deappointed"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"disgusting","accept":[],"options":["disgusting","disgusted","disgust","disgustingly"],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"accessible","accept":[],"options":["accessible","access","accessing","accessibly"],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"suspected","accept":[],"options":["suspected","suspicious","suspicion","suspensively"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SUSPECT) of fraud last year.","hint":"passive participle","explanation":"\u0027Was suspected of\u0027 \u2014 passive; \u0027suspicious\u0027 describes a person who suspects."}]}