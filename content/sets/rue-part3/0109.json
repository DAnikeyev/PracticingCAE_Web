{"id":"rue-part3-0109","taskId":"rue-part3","title":"Drill set 109","text":null,"source":"drill","gaps":[{"answer":"innovative","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."},{"answer":"confusing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"Fortunately","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ (FORTUNE), the package had already been delivered.","hint":"adverb: luckily","explanation":"The sentence adverb is \u0027Fortunately\u0027 \u2014 luckily for us."},{"answer":"invisible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bacteria are ___ (SEE) to the naked eye.","hint":"negative adjective: cannot be seen","explanation":"\u0027Invisible\u0027 = impossible to see \u2014 the negative adjective from VISIBLE/SEE."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"calm","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The police appealed for ___ (CALM).","hint":"noun after \u0027for\u0027","explanation":"\u0027Appealed for calm\u0027 \u2014 the set phrase uses \u0027calm\u0027 as noun."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."}]}