{"id":"rue-part3-0197","taskId":"rue-part3","title":"Drill set 197","text":null,"source":"drill","gaps":[{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"extensive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"commitment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager praised the team for its ___ (COMMIT) to quality.","hint":"noun: promise to do something","explanation":"The noun from COMMIT is \u0027commitment\u0027 \u2014 a dedication to a course of action."},{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"championship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."},{"answer":"weakness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy showed further ___ (WEAK) in the third quarter.","hint":"noun after an adjective","explanation":"\u0027Further weakness\u0027 \u2014 the noun form follows the adjective \u0027further\u0027."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."}]}