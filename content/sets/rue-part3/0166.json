{"id":"rue-part3-0166","taskId":"rue-part3","title":"Drill set 166","text":null,"source":"drill","gaps":[{"answer":"donations","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The charity relies entirely on voluntary ___ (DONATE).","hint":"plural noun: gifts of money","explanation":"\u0027Voluntary donations\u0027 \u2014 gifts of money given willingly."},{"answer":"undeniable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It is ___ (DENY) that the policy has failed.","hint":"adjective: impossible to deny","explanation":"\u0027It is undeniable that \u2026\u0027 \u2014 adjective meaning cannot be denied."},{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"admiration","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gazed at the mural in silent ___ (ADMIRE).","hint":"noun: respect felt","explanation":"\u0027In silent admiration\u0027 \u2014 the noun for the feeling."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"written","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions were ___ (WRITE) in six languages.","hint":"past participle (passive)","explanation":"Passive voice: were written \u2014 irregular participle of write."},{"answer":"