{"id":"rue-part3-0058","taskId":"rue-part3","title":"Drill set 58","text":null,"source":"drill","gaps":[{"answer":"exhibition","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum\u0027s ___ (EXHIBIT) of Egyptian art opens on Friday.","hint":"noun: a public show","explanation":"\u0027An exhibition\u0027 = a public display of art; \u0027an exhibit\u0027 is a single item."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"unable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (ABLE) to attend because of illness.","hint":"negative adjective","explanation":"\u0027Unable to attend\u0027 \u2014 negative of able is unable."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."}]}