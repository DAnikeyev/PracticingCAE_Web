{"id":"rue-part3-0108","taskId":"rue-part3","title":"Drill set 108","text":null,"source":"drill","gaps":[{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"systematically","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They searched the area ___ (SYSTEM) for clues.","hint":"adverb for \u0027searched\u0027","explanation":"Adverb needed: systematically (method by method)."},{"answer":"accuracy","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The model predicts the weather with remarkable ___ (ACCURATE).","hint":"noun after remarkable","explanation":"\u0027With remarkable accuracy\u0027 \u2014 the noun."},{"answer":"historic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The signing of the armistice was a ___ (HISTORY) moment for the region.","hint":"adjective: momentous in history","explanation":"\u0027Historic\u0027 = momentous, making history; \u0027historical\u0027 merely means related to the past."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"pressure","accept":[],"options":