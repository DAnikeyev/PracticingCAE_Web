{"id":"rue-part3-0190","taskId":"rue-part3","title":"Drill set 190","text":null,"source":"drill","gaps":[{"answer":"widened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The mountain road has been ___ (WIDE) to cope with coach traffic.","hint":"passive verb: made wider","explanation":"Passive \u0027has been widened\u0027 \u2014 the verb form meaning made wider."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy shows signs of ___ (RECOVER) after the recession.","hint":"noun: getting better","explanation":"The noun from RECOVER is \u0027recovery\u0027."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He lost his ___ (CONFIDENT) after the failure.","hint":"noun after possessive","explanation":"\u0027Lost his confidence\u0027 \u2014 the noun form."},{"answer":"weight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge has a maximum ___ (WEIGH) of ten tonnes.","hint":"noun: how heavy","explanation":"\u0027A maximum weight\u0027 \u2014 the noun."},{"answer":"preparation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"With careful ___ (PREPARE), the trek is perfectly safe.","hint":"noun after careful","explanation":"\u0027Careful preparation\u0027 \u2014 the noun."}]}