{"id":"rue-part3-0190","taskId":"rue-part3","title":"Drill set 190","text":null,"source":"drill","gaps":[{"answer":"hopeful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (HOPE) that the talks will resume.","hint":"adjective: feeling hope","explanation":"\u0027Be hopeful that\u2026\u0027 = feeling hope; \u0027hopefully\u0027 is the adverb."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He lost his ___ (CONFIDENT) after the failure.","hint":"noun after possessive","explanation":"\u0027Lost his confidence\u0027 \u2014 the noun form."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"employ","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The factory will ___ (EMPLOY) fifty more workers next year.","hint":"verb after will","explanation":"The bare verb follows \u0027will\u0027: will employ."},{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."},{"answer":"government","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new ___ (GOVERN) takes office in May.","hint":"noun: ruling body","explanation":"\u0027The new government\u0027 \u2014 the noun."},{"answer":"appointment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (APPOINT) as captain surprised no one.","hint":"noun: being given the role","explanation":"\u0027Her appointment as captain\u0027 \u2014 the event of being appointed."}]}