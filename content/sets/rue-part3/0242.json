{"id":"rue-part3-0242","taskId":"rue-part3","title":"Drill set 242","text":null,"source":"drill","gaps":[{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"costly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The delays have made the project far more ___ (COST) than planned.","hint":"adjective: expensive","explanation":"\u0027Far more costly\u0027 \u2014 the comparative adjective is needed after \u0027more\u0027."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The test measures your ___ (STRONG) in each skill.","hint":"noun form","explanation":"\u0027Strength\u0027 is the noun; \u0027strengthen\u0027 is the verb \u0027to make stronger\u0027."},{"answer":"unable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (ABLE) to attend because of illness.","hint":"negative adjective","explanation":"\u0027Unable to attend\u0027 \u2014 negative of able is unable."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."}]}