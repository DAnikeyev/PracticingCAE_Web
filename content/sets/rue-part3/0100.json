{"id":"rue-part3-0100","taskId":"rue-part3","title":"Drill set 100","text":null,"source":"drill","gaps":[{"answer":"confusing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He speaks French ___ (FLUENT).","hint":"adverb for \u0027speaks\u0027","explanation":"Adverb needed: fluently."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to cooperate stalled the negotiations.","hint":"noun: saying no","explanation":"The noun from REFUSE is \u0027refusal\u0027."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"appointment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (APPOINT) as captain surprised no one.","hint":"noun: being given the role","explanation":"\u0027Her appointment as captain\u0027 \u2014 the event of being appointed."},{"answer":"written","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions were ___ (WRITE) in six languages.","hint":"past participle (passive)","explanation":"Passive voice: were written \u2014 irregular participle of write."}]}