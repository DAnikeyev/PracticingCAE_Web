{"id":"rue-part3-0102","taskId":"rue-part3","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"poor visibility","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The road was closed because of ___ (VISIBLE) conditions.","hint":"noun phrase: how far you can see","explanation":"\u0027Visibility\u0027 = the distance you can see; paired with \u0027poor\u0027."},{"answer":"botany","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s studying ___ (BOTANY) at Cambridge.","hint":"the subject field","explanation":"The subject is \u0027botany\u0027; a specialist is a \u0027botanist\u0027."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He speaks French ___ (FLUENT).","hint":"adverb for \u0027speaks\u0027","explanation":"Adverb needed: fluently."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"argument","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"safety","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sen