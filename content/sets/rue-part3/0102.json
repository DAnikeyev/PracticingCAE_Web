{"id":"rue-part3-0102","taskId":"rue-part3","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"confidently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spoke ___ (CONFIDENT) in front of the camera.","hint":"adverb for \u0027spoke\u0027","explanation":"Adverb needed to modify \u0027spoke\u0027: confidently."},{"answer":"preparation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"With careful ___ (PREPARE), the trek is perfectly safe.","hint":"noun after careful","explanation":"\u0027Careful preparation\u0027 \u2014 the noun."},{"answer":"correctly","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She answered all the questions ___ (CORRECT).","hint":"adverb for \u0027answered\u0027","explanation":"Adverb needed: correctly."},{"answer":"deliberation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee reached its verdict after lengthy ___ (DELIBERATE).","hint":"noun: long discussion","explanation":"\u0027After lengthy deliberation\u0027 \u2014 the noun for careful discussion."},{"answer":"difficult","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DIFFICULT) terrain slowed the rescue team.","hint":"adjective before noun","explanation":"\u0027Difficult terrain\u0027 \u2014 adjective needed; \u0027difficulty\u0027 is the noun."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."}]}