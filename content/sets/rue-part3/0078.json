{"id":"rue-part3-0078","taskId":"rue-part3","title":"Drill set 78","text":null,"source":"drill","gaps":[{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"tendency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a ___ (TEND) to exaggerate.","hint":"noun after \u0027a\u0027","explanation":"\u0027A tendency to do something\u0027 \u2014 noun from tend."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"length","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (LONG) of the film is 145 minutes.","hint":"noun from long","explanation":"\u0027The length\u0027 \u2014 noun from long (spelling change: long \u2192 length)."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Last night\u0027s ___ (PERFORM) ended with a standing ovation.","hint":"noun: the show","explanation":"\u0027Last night\u0027s performance\u0027 \u2014 the noun for the event."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a