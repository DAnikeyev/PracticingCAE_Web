{"id":"rue-part3-0063","taskId":"rue-part3","title":"Drill set 63","text":null,"source":"drill","gaps":[{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to cooperate stalled the negotiations.","hint":"noun: saying no","explanation":"The noun from REFUSE is \u0027refusal\u0027."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITIC) of the new scheme.","hint":"adjective: finding fault","explanation":"\u0027Highly critical of\u0027 \u2014 the adjective describing a judgement."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"donations","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The charity relies entirely on voluntary ___ (DONATE).","hint":"plural noun: gifts of money","explanation":"\u0027Voluntary donations\u0027 \u2014 gifts of money given willingly."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Last night\u0027s ___ (PERFORM) ended with a standing ovation.","hint":"noun: the show","explanation":"\u0027Last night\u0027s performance\u0027 \u2014 the noun for the event."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"fictional","accept":[],"options":[]