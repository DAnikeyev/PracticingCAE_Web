{"id":"rue-part3-0026","taskId":"rue-part3","title":"Drill set 26","text":null,"source":"drill","gaps":[{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."}]}