{"id":"rue-part3-0043","taskId":"rue-part3","title":"Drill set 43","text":null,"source":"drill","gaps":[{"answer":"master","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The sculpture is a ___ (MASTER) piece of the Renaissance.","hint":"compound noun","explanation":"\u0027Masterpiece\u0027 = master \u002B piece, written as one word here split by the gap: master\u2026 piece."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He lost his ___ (CONFIDENT) after the failure.","hint":"noun after possessive","explanation":"\u0027Lost his confidence\u0027 \u2014 the noun form."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"discipline",