{"id":"rue-part3-0043","taskId":"rue-part3","title":"Drill set 43","text":null,"source":"drill","gaps":[{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The chairman gave a brief ___ (INTRODUCE).","hint":"noun: opening remarks","explanation":"\u0027A brief introduction\u0027 \u2014 the noun from introduce."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"simply","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The problem was ___ (SIMPLE) a matter of bad timing.","hint":"adverb: merely","explanation":"\u0027Simply a matter of\u0027 = only a matter of."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"damaged","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The parcel arrived ___ (DAMAGE).","hint":"participle: in a damaged state","explanation":"\u0027Arrived damaged\u0027 \u2014 participle describing the state of the parcel."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."},{"answer":"unable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (ABLE) to attend because of illness.","hint":"negative adjective","explanation":"\u0027Unable to attend\u0027 \u2014 negative of able is unable."}]}