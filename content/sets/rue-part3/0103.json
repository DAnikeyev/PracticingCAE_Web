{"id":"rue-part3-0103","taskId":"rue-part3","title":"Drill set 103","text":null,"source":"drill","gaps":[{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."},{"answer":"Fortunately","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ (FORTUNE), the package had already been delivered.","hint":"adverb: luckily","explanation":"The sentence adverb is \u0027Fortunately\u0027 \u2014 luckily for us."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s studying ___ (MANAGE) at university.","hint":"subject field (noun)","explanation":"\u0027Studying management\u0027 \u2014 the field is called management."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."},{"answer":"simplified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions have been ___ (SIMPLE) so that children can follow them.","hint":"passive verb: made simpler","explanation":"Passive \u0027have been simplified\u0027 \u2014 the verb form meaning made simpler."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"historic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The signing of the armistice was a ___ (HISTORY) moment for the region.","hint":"adjective: momentous in history","explanation":"\u0027Historic\u0027 = momentous, making history; \u0027historical\u0027 merely means related to the past."}]}