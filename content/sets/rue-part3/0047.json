{"id":"rue-part3-0047","taskId":"rue-part3","title":"Drill set 47","text":null,"source":"drill","gaps":[{"answer":"confusing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"calm","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The police appealed for ___ (CALM).","hint":"noun after \u0027for\u0027","explanation":"\u0027Appealed for calm\u0027 \u2014 the set phrase uses \u0027calm\u0027 as noun."},{"answer":"bravery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was praised for his ___ (BRAVE) during the fire.","hint":"noun after possessive","explanation":"\u0027His bravery\u0027 \u2014 quality noun; \u0027braveness\u0027 exists but is rare; \u0027bravery\u0027 is standard."},{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."}]}