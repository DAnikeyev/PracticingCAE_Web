{"id":"rue-part3-0077","taskId":"rue-part3","title":"Drill set 77","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He lost his ___ (CONFIDENT) after the failure.","hint":"noun after possessive","explanation":"\u0027Lost his confidence\u0027 \u2014 the noun form."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"environmental","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an expert in ___ (ENVIRONMENT) law.","hint":"adjective before \u0027law\u0027","explanation":"\u0027Environmental law\u0027 \u2014 adjective from environment."}]}