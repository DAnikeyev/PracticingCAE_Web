{"id":"rue-part3-0077","taskId":"rue-part3","title":"Drill set 77","text":null,"source":"drill","gaps":[{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"government","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new ___ (GOVERN) takes office in May.","hint":"noun: ruling body","explanation":"\u0027The new government\u0027 \u2014 the noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"discipline","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The coach criticised the team\u0027s lack of ___ (DISCIPLINE).","hint":"noun: ordered behaviour","explanation":"\u0027Lack of discipline\u0027 \u2014 the noun is required after \u0027lack of\u0027."},{"answer":"analysis","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (ANALYSE) of the data took three weeks.","hint":"noun: detailed examination","explanation":"\u0027Analysis\u0027 is the noun for a detailed examination; an \u0027analyst\u0027 is a person."},{"answer":"patiently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She explained the process ___ (PATIENT) to each visitor.","hint":"adverb for \u0027explained\u0027","explanation":"Adverb needed: patiently (with patience)."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."}]}