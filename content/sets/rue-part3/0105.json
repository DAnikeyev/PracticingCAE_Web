{"id":"rue-part3-0105","taskId":"rue-part3","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She showed great ___ (WISE) in avoiding the deal.","hint":"noun: quality of being wise","explanation":"\u0027Wisdom\u0027 \u2014 the quality noun from wise (spelling: wise \u2192 wisdom)."},{"answer":"unbelievably","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"written","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The instructions were ___ (WRITE) in six languages.","hint":"past participle (passive)","explanation":"Passive voice: were written \u2014 irregular participle of write."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"innovative","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."}]}