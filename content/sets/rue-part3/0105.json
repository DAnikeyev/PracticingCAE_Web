{"id":"rue-part3-0105","taskId":"rue-part3","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"safety","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."},{"answer":"loss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team\u0027s ___ (LOSE) came as a shock to the fans.","hint":"noun: being defeated","explanation":"\u0027Their loss\u0027 \u2014 the noun for a defeat or disappearance."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"visionary","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We owe our success to her ___ (VISION) leadership.","hint":"adjective: showing imagination","explanation":"\u0027Visionary leadership\u0027 \u2014 showing imagination and foresight."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITIC) of the new scheme.","hint":"adjective: finding fault","explanation":"\u0027Highly critical of\u0027 \u2014 the adjective describing a judgement."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."}]}