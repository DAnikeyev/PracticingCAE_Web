{"id":"rue-part3-0090","taskId":"rue-part3","title":"Drill set 90","text":null,"source":"drill","gaps":[{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"resignation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His sudden ___ (RESIGN) surprised everyone in the department.","hint":"noun: act of leaving a job","explanation":"The noun from RESIGN is \u0027resignation\u0027."},{"answer":"anxiously","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She waited ___ (ANXIOUS) by the phone for news.","hint":"adverb: in a worried way","explanation":"The verb \u0027waited\u0027 needs the adverb \u0027anxiously\u0027."},{"answer":"advice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He gave me some very useful ___ (ADVISE).","hint":"uncountable noun","explanation":"\u0027Advice\u0027 is uncountable \u2014 never \u0027advices\u0027; \u0027advise\u0027 is the verb."},{"answer":"failure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project\u0027s ___ (FAIL) was due to poor planning.","hint":"noun: lack of success","explanation":"The noun from FAIL is \u0027failure\u0027."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to help surprised everyone.","hint":"noun from refuse","explanation":"\u0027His refusal\u0027 \u2014 noun from refuse (-al suffix)."}]}