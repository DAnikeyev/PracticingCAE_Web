{"id":"rue-part3-0090","taskId":"rue-part3","title":"Drill set 90","text":null,"source":"drill","gaps":[{"answer":"criticised","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister was ___ (CRITIC) for her handling of the flooding crisis.","hint":"passive verb: attacked in words","explanation":"\u0027Be criticised for\u0027 = be attacked verbally; the verb form is needed in the passive."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"sleeplessness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"comfortable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The trainers were ___ (COMFORT) for long walks.","hint":"adjective after \u0027were\u0027","explanation":"\u0027Were comfortable\u0027 \u2014 adjective; note the spelling: -able, not -ible."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"arrested","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief was ___ (ARREST) at the border.","hint":"passive past participle","explanation":"Passive: was arrested."},{"answer":"invisible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bacteria are ___ (SEE) to the naked eye.","hint":"negative adjective: cannot be seen","explanation":"\u0027Invisible\u0027 = impossible to see \u2014 the negative adjective from VISIBLE/SEE."}]}