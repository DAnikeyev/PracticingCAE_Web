{"id":"rue-part3-0090","taskId":"rue-part3","title":"Drill set 90","text":null,"source":"drill","gaps":[{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"invisible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bacteria are ___ (SEE) to the naked eye.","hint":"negative adjective: cannot be seen","explanation":"\u0027Invisible\u0027 = impossible to see \u2014 the negative adjective from VISIBLE/SEE."},{"answer":"unbelievably","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"extensive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (EXTENSIVE) damage.","hint":"adjective before \u0027damage\u0027","explanation":"\u0027Extensive damage\u0027 \u2014 adjective meaning widespread."},{"answer":"introduction","accept":[],"options":[],"base":null,"keyword":null,"lead":n