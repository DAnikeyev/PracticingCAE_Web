{"id":"rue-part3-0120","taskId":"rue-part3","title":"Drill set 120","text":null,"source":"drill","gaps":[{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the delegation was delayed by the storm.","hint":"noun: coming","explanation":"The noun from ARRIVE is \u0027arrival\u0027."},{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"grateful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."}]}