{"id":"rue-part3-0099","taskId":"rue-part3","title":"Drill set 99","text":null,"source":"drill","gaps":[{"answer":"government","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new ___ (GOVERN) takes office in May.","hint":"noun: ruling body","explanation":"\u0027The new government\u0027 \u2014 the noun."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"difficult","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DIFFICULT) terrain slowed the rescue team.","hint":"adjective before noun","explanation":"\u0027Difficult terrain\u0027 \u2014 adjective needed; \u0027difficulty\u0027 is the noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"illegal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s ___ (LEGAL) to drive without insurance.","hint":"negative of legal","explanation":"Negative prefix for \u0027legal\u0027 is \u0027il-\u0027 before l: illegal."},{"answer":"death","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her sudden ___ (DIE) shocked the whole village.","hint":"noun needed","explanation":"\u0027Her sudden death\u0027 \u2014 \u0027die\u0027 is the verb, \u0027death\u0027 the noun."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."}]}