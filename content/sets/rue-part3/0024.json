{"id":"rue-part3-0024","taskId":"rue-part3","title":"Drill set 24","text":null,"source":"drill","gaps":[{"answer":"suspected","accept":[],"options":["suspected","suspicious","suspicion","suspensively"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SUSPECT) of fraud last year.","hint":"passive participle","explanation":"\u0027Was suspected of\u0027 \u2014 passive; \u0027suspicious\u0027 describes a person who suspects."},{"answer":"enthusiastic","accept":[],"options":["enthusiastic","enthusiasm","enthusiastically","enthused"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"prescription","accept":[],"options":["prescription","prescribing","prescriptive","prescribed"],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"successful","accept":[],"options":["successful","success","successfully","succeeding"],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"confusing","accept":[],"options":["confusing","confused","confusion","confusingly"],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"arrival","accept":[],"options":["arrival","arrive","arriving","arrivance"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"championship","accept":[],"options":["championship","champion","championing","champion\u0027s"],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."},{"answer":"discovery","accept":[],"options":["discovery","discovering","discoverer","discoverable"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."}]}