{"id":"rue-part3-0024","taskId":"rue-part3","title":"Drill set 24","text":null,"source":"drill","gaps":[{"answer":"qualified","accept":[],"options":["qualified","qualifying","qualification","qualifier"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"development","accept":[],"options":["development","developing","developer","developed"],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"grateful","accept":[],"options":["grateful","greatful","gratefully","gratified"],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ (GRATE) for all their support.","hint":"adjective: thankful","explanation":"\u0027Grateful\u0027 \u2014 beware the common misspelling \u0027greatful\u0027."},{"answer":"satisfied","accept":[],"options":["satisfied","satisfying","satisfaction","satisfactory"],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"tiring","accept":[],"options":["tiring","tired","tire","tiresome of"],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"sleeplessness","accept":[],"options":["sleeplessness","sleepless","sleeplessly","asleep"],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"safety","accept":[],"options":["safety","safe","safely","safeness"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (SAFE) of passengers is our priority.","hint":"noun from safe","explanation":"\u0027Safety\u0027 \u2014 the quality noun from safe (safe \u2192 safety)."},{"answer":"successful","accept":[],"options":["successful","success","successfully","succeeding"],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."}]}