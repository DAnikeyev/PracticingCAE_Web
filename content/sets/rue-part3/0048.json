{"id":"rue-part3-0048","taskId":"rue-part3","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"mixture","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup is a ___ (MIX) of herbs and spices.","hint":"noun: things combined","explanation":"\u0027A mixture of\u0027 \u2014 the noun for a blend."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITICISE) of the ministry.","hint":"adjective: finding fault","explanation":"\u0027Be critical of\u0027 \u2014 adjective; \u0027criticism\u0027 is the noun."},{"answer":"optimistic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ (OPTIMISM) about the future.","hint":"adjective after \u0027are\u0027","explanation":"\u0027Optimistic\u0027 is the adjective; \u0027optimism\u0027 is the noun."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."},{"answe