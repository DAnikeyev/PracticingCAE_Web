{"id":"rue-part3-0048","taskId":"rue-part3","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy shows signs of ___ (RECOVER) after the recession.","hint":"noun: getting better","explanation":"The noun from RECOVER is \u0027recovery\u0027."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"revision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law needs complete ___ (REVISE) before it can work.","hint":"noun: thorough change","explanation":"The noun from REVISE is \u0027revision\u0027."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She gave a moving ___ (PERFORM) of the sonata.","hint":"noun after \u0027moving\u0027","explanation":"\u0027A performance of the sonata\u0027 \u2014 the act of performing."},{"answer":"tiring","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journey was ___ (TIRE) but rewarding.","hint":"adjective: causing tiredness","explanation":"The journey causes tiredness: tiring. \u0027Tiresome\u0027 means annoying."},{"answer":"championship","accept":[],"options":[],"base":null,"keyword":null,