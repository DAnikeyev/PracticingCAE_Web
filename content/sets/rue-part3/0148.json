{"id":"rue-part3-0148","taskId":"rue-part3","title":"Drill set 148","text":null,"source":"drill","gaps":[{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"innovative","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."},{"answer":"invisible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bacteria are ___ (SEE) to the naked eye.","hint":"negative adjective: cannot be seen","explanation":"\u0027Invisible\u0027 = impossible to see \u2014 the negative adjective from VISIBLE/SEE."},{"answer":"master","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The sculpture is a ___ (MASTER) piece of the Renaissance.","hint":"compound noun","explanation":"\u0027Masterpiece\u0027 = master \u002B piece, written as one word here split by the gap: master\u2026 piece."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The document is of great ___ (IMPORTANT) to the case.","hint":"noun after of great","explanation":"\u0027Of great importance\u0027 \u2014 the noun form."},{"answer":"education","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The programme aims at the ___ (EDUCATE) of young farmers.","hint":"noun after the","explanation":"\u0027The education of\u0027 \u2014 the noun."}]}