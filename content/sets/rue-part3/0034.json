{"id":"rue-part3-0034","taskId":"rue-part3","title":"Drill set 34","text":null,"source":"drill","gaps":[{"answer":"suspected","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SUSPECT) of fraud last year.","hint":"passive participle","explanation":"\u0027Was suspected of\u0027 \u2014 passive; \u0027suspicious\u0027 describes a person who suspects."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"shortage","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (SHORT) of funds forced him to abandon the trip.","hint":"noun: not having enough","explanation":"\u0027Shortage of funds\u0027 \u2014 the noun for an insufficient amount."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"revision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law needs complete ___ (REVISE) before it can work.","hint":"noun: thorough change","explanation":"The noun from REVISE is \u0027revisi