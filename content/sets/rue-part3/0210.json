{"id":"rue-part3-0210","taskId":"rue-part3","title":"Drill set 210","text":null,"source":"drill","gaps":[{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"burglaries","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were three ___ (BURGLE) on our street last month.","hint":"plural noun: the crimes","explanation":"\u0027Three burglaries\u0027 \u2014 plural noun for the crime; burglars are people."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"systematically","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They searched the area ___ (SYSTEM) for clues.","hint":"adverb for \u0027searched\u0027","explanation":"Adverb needed: systematically (method by method)."},{"answer":"analysis","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (ANALYSE) of the data took three weeks.","hint":"noun: detailed examination","explanation":"\u0027Analysis\u0027 is the noun for a detailed examination; an \u0027analyst\u0027 is a person."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."}]}