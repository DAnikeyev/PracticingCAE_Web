{"id":"rue-part3-0168","taskId":"rue-part3","title":"Drill set 168","text":null,"source":"drill","gaps":[{"answer":"discipline","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The coach criticised the team\u0027s lack of ___ (DISCIPLINE).","hint":"noun: ordered behaviour","explanation":"\u0027Lack of discipline\u0027 \u2014 the noun is required after \u0027lack of\u0027."},{"answer":"widespread","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (WIDE) damage along the coast.","hint":"adjective: affecting many places","explanation":"\u0027Widespread damage\u0027 = damage across a large area."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."},{"answer":"financial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project was abandoned for ___ (FINANCE) reasons.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027reasons\u0027: financial."},{"answer":"unbelievably","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"freedom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees celebrated their ___ (FREE) at last.","hint":"noun: being free","explanation":"\u0027Their freedom\u0027 \u2014 the noun."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"explanation","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The leaflet gives a clear ___ (EXPLAIN) of the rules.","hint":"noun after clear","explanation":"\u0027A clear explanation\u0027 \u2014 the noun."}]}