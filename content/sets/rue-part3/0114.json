{"id":"rue-part3-0114","taskId":"rue-part3","title":"Drill set 114","text":null,"source":"drill","gaps":[{"answer":"championship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."},{"answer":"Persistent","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ (PERSIST) rain ruined the first two days of the festival.","hint":"adjective before a noun","explanation":"An adjective is needed before \u0027rain\u0027: persistent; \u0027persistence\u0027 is the noun."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy shows signs of ___ (RECOVER) after the recession.","hint":"noun: getting better","explanation":"The noun from RECOVER is \u0027recovery\u0027."},{"answer":"unbelievably","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The twins were ___ (BELIEVE) similar.","hint":"adverb for \u0027similar\u0027","explanation":"Adverb needed: unbelievably similar."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"systematica