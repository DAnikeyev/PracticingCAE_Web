{"id":"rue-part3-0114","taskId":"rue-part3","title":"Drill set 114","text":null,"source":"drill","gaps":[{"answer":"conveniently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The hotel is ___ (CONVENIENT) situated near the station.","hint":"adverb before the participle","explanation":"\u0027Conveniently situated\u0027 \u2014 the adverb modifies the participle."},{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"mixture","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup is a ___ (MIX) of herbs and spices.","hint":"noun: things combined","explanation":"\u0027A mixture of\u0027 \u2014 the noun for a blend."},{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."}]}