{"id":"rue-part3-0046","taskId":"rue-part3","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"encouragement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her coach\u0027s ___ (ENCOURAGE) kept her racing.","hint":"noun: supportive words","explanation":"\u0027Her coach\u0027s encouragement\u0027 \u2014 the noun."},{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"championship","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated their ___ (CHAMPION) victory.","hint":"noun: the contest/title","explanation":"\u0027Championship victory\u0027 \u2014 the title/contest, not the person."},{"answer":"solution","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team celebrated a quick ___ (SOLVE) to the crisis.","hint":"noun: the answer","explanation":"\u0027A solution to the crisis\u0027 \u2014 the noun."},{"answer":"courageous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (COURAGE) enough to speak first.","hint":"adjective: full of courage","explanation":"\u0027Courageous\u0027 \u2014 adjective from courage (-ous suffix)."},{"answer":"investments","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has made huge ___ (INVEST) in training.","hint":"plural noun after \u0027huge\u0027","explanation":"\u0027Huge investments in\u2026\u0027 \u2014 plural countable noun."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Send your ___ (APPLY) to the address below.","hint":"singular noun: the form","explanation":"\u0027Your application\u0027 \u2014 the document you send; an applicant is a person."},{"answer":"performance","accept":[],"option