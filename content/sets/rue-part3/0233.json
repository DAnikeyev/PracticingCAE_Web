{"id":"rue-part3-0233","taskId":"rue-part3","title":"Drill set 233","text":null,"source":"drill","gaps":[{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"depth","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DEEP) of the lake is unknown.","hint":"noun from deep","explanation":"\u0027Depth\u0027 \u2014 noun from deep (spelling change: deep \u2192 depth)."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane made a hard but ___ (SUCCESS) landing.","hint":"adjective before \u0027landing\u0027","explanation":"\u0027Successful landing\u0027 \u2014 adjective needed."},{"answer":"influential","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (INFLUENCE) thinkers of the decade.","hint":"adjective: having great influence","explanation":"\u0027Influential\u0027 describes a person who influences others."},{"answer":"disgusting","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was absolutely ___ (DISGUST).","hint":"adjective: causing disgust","explanation":"The smell causes disgust: disgusting."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."}]}