{"id":"rue-part3-0233","taskId":"rue-part3","title":"Drill set 233","text":null,"source":"drill","gaps":[{"answer":"pressure","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s under ___ (PRESS) to resign.","hint":"noun after \u0027under\u0027","explanation":"\u0027Under pressure\u0027 \u2014 fixed noun phrase."},{"answer":"critical","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report was highly ___ (CRITICISE) of the ministry.","hint":"adjective: finding fault","explanation":"\u0027Be critical of\u0027 \u2014 adjective; \u0027criticism\u0027 is the noun."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"analysis","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (ANALYSE) of the data took three weeks.","hint":"noun: detailed examination","explanation":"\u0027Analysis\u0027 is the noun for a detailed examination; an \u0027analyst\u0027 is a person."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"arrival","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARRIVE) of the Queen caused a stir.","hint":"noun: act of arriving","explanation":"\u0027The arrival\u0027 \u2014 noun form of arrive."},{"answer":"visitors","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The palace is open to ___ (VISIT) all year.","hint":"people noun (plural)","explanation":"\u0027Open to visitors\u0027 \u2014 plural person noun."},{"answer":"comparison","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"A side-by-side ___ (COMPARE) of the two plans reveals clear differences.","hint":"noun after an adjective","explanation":"\u0027A comparison of X and Y\u0027 \u2014 the noun form follows the article and adjective."}]}