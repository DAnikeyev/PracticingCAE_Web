{"id":"rue-part3-0228","taskId":"rue-part3","title":"Drill set 228","text":null,"source":"drill","gaps":[{"answer":"surprising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."},{"answer":"innovative","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"criticised","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister was ___ (CRITIC) for her handling of the flooding crisis.","hint":"passive verb: attacked in words","explanation":"\u0027Be criticised for\u0027 = be attacked verbally; the verb form is needed in the passive."},{"answer":"revising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ (REVISE) before submission.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027Needs revising\u0027 = needs to be revised \u2014 need \u002B -ing."},{"answer":"confidently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spoke ___ (CONFIDENT) in front of the camera.","hint":"adverb for \u0027spoke\u0027","explanation":"Adverb needed to modify \u0027spoke\u0027: confidently."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u