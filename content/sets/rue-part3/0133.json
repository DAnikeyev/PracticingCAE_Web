{"id":"rue-part3-0133","taskId":"rue-part3","title":"Drill set 133","text":null,"source":"drill","gaps":[{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"recovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He made a full ___ (RECOVER) after six months.","hint":"noun after \u0027full\u0027","explanation":"\u0027A full recovery\u0027 \u2014 noun from recover."},{"answer":"disappointed","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (APPOINT) at the election result.","hint":"negative feeling adjective","explanation":"\u0027Disappointed\u0027 \u2014 prefix dis- with appoint."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"trustworthy","accept":["trusted"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s our most ___ (TRUST) colleague.","hint":"adjective: can be trusted","explanation":"\u0027Trustworthy\u0027 = deserving trust; \u0027trusted\u0027 also works but \u0027trustworthy\u0027 is the quality."},{"answer":"weight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge has a maximum ___ (WEIGH) of ten tonnes.","hint":"noun: how heavy","explanation":"\u0027A maximum weight\u0027 \u2014 the noun."}]}