{"id":"rue-part3-0092","taskId":"rue-part3","title":"Drill set 92","text":null,"source":"drill","gaps":[{"answer":"discovery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DISCOVER) of penicillin changed medicine.","hint":"noun: act of finding","explanation":"\u0027The discovery of\u2026\u0027 \u2014 noun from discover (y-ending)."},{"answer":"influential","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (INFLUENCE) thinkers of the decade.","hint":"adjective: having great influence","explanation":"\u0027Influential\u0027 describes a person who influences others."},{"answer":"applause","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The audience gave a huge ___ (APPLAUD).","hint":"noun: clapping","explanation":"\u0027Applause\u0027 is the noun; \u0027applaud\u0027 is the verb."},{"answer":"weakness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The economy showed further ___ (WEAK) in the third quarter.","hint":"noun after an adjective","explanation":"\u0027Further weakness\u0027 \u2014 the noun form follows the adjective \u0027further\u0027."},{"answer":"repairing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house needs ___ (REPAIR) urgently.","hint":"need \u002B -ing","explanation":"\u0027Needs repairing\u0027 = needs to be repaired."},{"answer":"Fortunately","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ (FORTUNE), the package had already been delivered.","hint":"adverb: luckily","explanation":"The sentence adverb is \u0027Fortunately\u0027 \u2014 luckily for us."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She spoke with great ___ (WISE) about the risks.","hint":"noun: deep understanding","explanation":"The noun from WISE is \u0027wisdom\u0027."},{"answer":"education","accept":[],"options":[],"bas