{"id":"rue-part3-0092","taskId":"rue-part3","title":"Drill set 92","text":null,"source":"drill","gaps":[{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"accessible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is ___ (ACCESS) only by boat.","hint":"adjective: can be reached","explanation":"\u0027Accessible\u0027 = easy to reach; the -ible spelling follows \u0027access\u0027."},{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"calm","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The police appealed for ___ (CALM).","hint":"noun after \u0027for\u0027","explanation":"\u0027Appealed for calm\u0027 \u2014 the set phrase uses \u0027calm\u0027 as noun."},{"answer":"invisible","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bacteria are ___ (SEE) to the naked eye.","hint":"negative adjective: cannot be seen","explanation":"\u0027Invisible\u0027 = impossible to see \u2014 the negative adjective from VISIBLE/SEE."},{"answer":"successful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He is one of the most ___ (SUCCESS) businessmen in the region.","hint":"adjective after \u0027most\u0027","explanation":"Superlative needs an adjective: successful."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"surprising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."}]}