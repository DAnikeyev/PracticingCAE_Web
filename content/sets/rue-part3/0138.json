{"id":"rue-part3-0138","taskId":"rue-part3","title":"Drill set 138","text":null,"source":"drill","gaps":[{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"anxiously","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She waited ___ (ANXIOUS) by the phone for news.","hint":"adverb: in a worried way","explanation":"The verb \u0027waited\u0027 needs the adverb \u0027anxiously\u0027."},{"answer":"disappointment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Much to everyone\u2019s ___ (APPOINT), the open-air concert was cancelled.","hint":"noun after a possessive","explanation":"\u0027To somebody\u2019s disappointment\u0027 \u2014 the feeling noun follows the possessive."},{"answer":"management","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The shop is under new ___ (MANAGE) from Monday.","hint":"noun: those who run it","explanation":"\u0027Under new management\u0027 \u2014 the fixed phrase."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"botany","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s studying ___ (BOTANY) at Cambridge.","hint":"the subject field","explanation":"The subject is \u0027botany\u0027; a specialist is a \u0027botanist\u0027."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (CONFIDENT) grew after each concert.","hint":"noun after possessive","explanation":"\u0027Her confidence\u0027 \u2014 the noun; \u0027confident\u0027 is the adjective."},{"answer":"owner","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (OWN) of the car park charges by the hour.","hint":"person noun","explanation":"\u0027The owner\u0027 \u2014 the person who owns it; \u0027ownership\u0027 is the state."}]}