{"id":"rue-part3-0138","taskId":"rue-part3","title":"Drill set 138","text":null,"source":"drill","gaps":[{"answer":"gratefully","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (IMPORTANT) of sleep is often ignored.","hint":"noun after \u0027the\u0027","explanation":"\u0027The importance of\u2026\u0027 \u2014 noun from important."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"famous","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The city is ___ (FAME) for its architecture.","hint":"adjective \u002B for","explanation":"\u0027Famous for\u0027 \u2014 \u0027infamous\u0027 means notorious (famous for bad things)."},{"answer":"persistence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (PERSIST) finally paid off.","hint":"noun after possessive","explanation":"\u0027Her persistence\u0027 \u2014 the quality noun from persistent."},{"answer":"bravery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was praised for his ___ (BRAVE) during the fire.","hint":"noun after possessive","explanation":"\u0027His bravery\u0027 \u2014 quality noun; \u0027braveness\u0027 exists but is rare; \u0027bravery\u0027 is standard."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."}]}