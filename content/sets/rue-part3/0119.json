{"id":"rue-part3-0119","taskId":"rue-part3","title":"Drill set 119","text":null,"source":"drill","gaps":[{"answer":"impressive","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is an ___ (IMPRESS) piece of engineering.","hint":"adjective: inspires admiration","explanation":"The bridge impresses people: it is impressive."},{"answer":"fluently","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He speaks French ___ (FLUENT).","hint":"adverb for \u0027speaks\u0027","explanation":"Adverb needed: fluently."},{"answer":"education","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The programme aims at the ___ (EDUCATE) of young farmers.","hint":"noun after the","explanation":"\u0027The education of\u0027 \u2014 the noun."},{"answer":"scientist","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a leading ___ (SCIENCE) in climate research.","hint":"person noun (-ist)","explanation":"\u0027A scientist\u0027 \u2014 person who does science."},{"answer":"comfortable","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The trainers were ___ (COMFORT) for long walks.","hint":"adjective after \u0027were\u0027","explanation":"\u0027Were comfortable\u0027 \u2014 adjective; note the spelling: -able, not -ible."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The engine has a ___ (PERFORM) problem.","hint":"noun modifying \u0027problem\u0027","explanation":"\u0027Performance problem\u0027 \u2014 noun used attributively."},{"answer":"criticised","accept":[],"options":[],"base":null,"keyword":null,"lead":nu