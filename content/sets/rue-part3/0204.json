{"id":"rue-part3-0204","taskId":"rue-part3","title":"Drill set 204","text":null,"source":"drill","gaps":[{"answer":"revision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The law needs complete ___ (REVISE) before it can work.","hint":"noun: thorough change","explanation":"The noun from REVISE is \u0027revision\u0027."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"contributor","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s a regular ___ (CONTRIBUTE) to the magazine.","hint":"person noun (-or)","explanation":"\u0027A contributor\u0027 = a person who contributes."},{"answer":"simply","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The problem was ___ (SIMPLE) a matter of bad timing.","hint":"adverb: merely","explanation":"\u0027Simply a matter of\u0027 = only a matter of."},{"answer":"fictional","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel is a ___ (FICTION) account of real events.","hint":"adjective before \u0027account\u0027","explanation":"\u0027Fictional account\u0027 \u2014 adjective; \u0027fictitious\u0027 implies deliberate falsehood."},{"answer":"activates","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The switch ___ (ACTIVE) the alarm.","hint":"verb (present)","explanation":"\u0027Activates\u0027 \u2014 verb from active (-ate suffix)."},{"answer":"widespread","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (WIDE) damage along the coast.","hint":"adjective: affecting many places","explanation":"\u0027Widespread damage\u0027 = damage across a large area."},{"answer":"sleepiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEP), so avoid driving.","hint":"noun: the state of wanting to sleep","explanation":"\u0027Cause sleepiness\u0027 \u2014 the noun for the drowsy state."}]}