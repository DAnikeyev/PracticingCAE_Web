{"id":"rue-part3-0180","taskId":"rue-part3","title":"Drill set 180","text":null,"source":"drill","gaps":[{"answer":"operating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The doctor advised ___ (OPERATE) immediately.","hint":"advise \u002B -ing (no object)","explanation":"\u0027Advise \u002B -ing\u0027 (without a personal object): advised operating."},{"answer":"burglaries","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were three ___ (BURGLE) on our street last month.","hint":"plural noun: the crimes","explanation":"\u0027Three burglaries\u0027 \u2014 plural noun for the crime; burglars are people."},{"answer":"widened","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The mountain road has been ___ (WIDE) to cope with coach traffic.","hint":"passive verb: made wider","explanation":"Passive \u0027has been widened\u0027 \u2014 the verb form meaning made wider."},{"answer":"protection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The vaccine gives ___ (PROTECT) against three strains.","hint":"noun after gives","explanation":"\u0027Gives protection against\u0027 \u2014 the noun is required."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee\u0027s ___ (DECIDE) was announced this morning.","hint":"noun: what they chose","explanation":"The noun from DECIDE is \u0027decision\u0027."},{"answer":"decision","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (DECIDE) to close the factory was announced yesterday.","hint":"noun after \u0027the\u0027","explanation":"\u0027The decision\u0027 \u2014 noun form of decide."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun