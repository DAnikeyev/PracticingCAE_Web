{"id":"rue-part3-0075","taskId":"rue-part3","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0027 \u2014 noun from strong (spelling change)."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"satisfied","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was ___ (SATISFY) with the settlement.","hint":"how he felt","explanation":"People are satisfied; things are satisfying or satisfactory."},{"answer":"bravery","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was praised for his ___ (BRAVE) during the fire.","hint":"noun after possessive","explanation":"\u0027His bravery\u0027 \u2014 quality noun; \u0027braveness\u0027 exists but is rare; \u0027bravery\u0027 is standard."},{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She showed great ___ (WISE) in avoiding the deal.","hint":"noun: quality of being wise","explanation":"\u0027Wisdom\u0027 \u2014 the quality noun from wise (spelling: wise \u2192 wisdom)."},{"answer":"agreement","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two sides failed to reach an ___ (AGREE).","hint":"noun: a settled deal","explanation":"\u0027Reach an agreement\u0027 \u2014 the noun form."},{"answer":"selection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This shop offers a wide ___ (SELECT) of cheeses.","hint":"noun: a range","explanation":"\u0027A selection of\u0027 = a range of items to choose from."},{"answer":"optimistic","accept":[],"options":[]