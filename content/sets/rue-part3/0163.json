{"id":"rue-part3-0163","taskId":"rue-part3","title":"Drill set 163","text":null,"source":"drill","gaps":[{"answer":"harmful","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Smoking is ___ (HARM) to your health.","hint":"adjective: causes harm","explanation":"\u0027Harmful\u0027 = causing harm; \u0027harmless\u0027 is the opposite."},{"answer":"proof","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no ___ (PROVE) that he was anywhere near the bank.","hint":"noun: evidence","explanation":"\u0027No proof that \u2026\u0027 \u2014 the noun for evidence."},{"answer":"knowledge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He has a wide ___ (KNOW) of local history.","hint":"noun: what you know","explanation":"\u0027A wide knowledge of\u0027 \u2014 the noun."},{"answer":"drowsiness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine may cause ___ (SLEEPY).","hint":"noun: state of feeling sleepy","explanation":"\u0027Cause drowsiness\u0027 \u2014 the quality noun from drowsy."},{"answer":"enthusiastic","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s an ___ (ENTHUSIASM) supporter of the team.","hint":"adjective before \u0027supporter\u0027","explanation":"\u0027Enthusiastic supporter\u0027 \u2014 adjective from enthusiasm."},{"answer":"application","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (APPLY) for the visa took three weeks.","hint":"noun: the process/form","explanation":"\u0027The application\u0027 = the act or form of applying; \u0027applicant\u0027 = the person."},{"answer":"widely","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new rules were ___ (WIDE) criticised.","hint":"adverb for \u0027criticised\u0027","explanation":"\u0027Widely criticised\u0027 = by many people \u2014 adverb."},{"answer":"mixture","accept":[],"options"