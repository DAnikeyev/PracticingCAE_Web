{"id":"rue-part3-0087","taskId":"rue-part3","title":"Drill set 87","text":null,"source":"drill","gaps":[{"answer":"sleeplessness","accept":[],"options":["sleeplessness","sleepless","sleeplessly","asleep"],"base":null,"keyword":null,"lead":null,"sentence":"He suffers from ___ (SLEEP) since the accident.","hint":"noun: inability to sleep","explanation":"\u0027Suffer from sleeplessness/insomnia\u0027 \u2014 noun needed after \u0027from\u0027."},{"answer":"gratefully","accept":[],"options":["gratefully","grateful","gratefulness","gratified"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ (GRATEFUL) acknowledged in the preface.","hint":"adverb for \u0027acknowledged\u0027","explanation":"Adverb needed: gratefully acknowledged."},{"answer":"argument","accept":[],"options":["argument","arguing","arguable","arguer"],"base":null,"keyword":null,"lead":null,"sentence":"The ___ (ARGUE) went on for hours.","hint":"noun: a quarrel","explanation":"\u0027Argument\u0027 \u2014 note the e is dropped from argue."},{"answer":"exhibition","accept":[],"options":["exhibition","exhibit","exhibiting","exhibitor"],"base":null,"keyword":null,"lead":null,"sentence":"The museum\u0027s ___ (EXHIBIT) of Egyptian art opens on Friday.","hint":"noun: a public show","explanation":"\u0027An exhibition\u0027 = a public display of art; \u0027an exhibit\u0027 is a single item."},{"answer":"confusing","accept":[],"options":["confusing","confused","confusion","confusingly"],"base":null,"keyword":null,"lead":null,"sentence":"She gave a very ___ (CONFUSE) explanation of the rules.","hint":"adjective: causing confusion","explanation":"\u0027Confusing\u0027 describes something that causes confusion; \u0027confused\u0027 describes the person affected."},{"answer":"innovative","accept":[],"options":["innovative","innovation","innovator","innovativeness"],"base":null,"keyword":null,"lead":null,"sentence":"The company is famous for its ___ (INNOVATE) designs.","hint":"adjective before \u0027designs\u0027","explanation":"\u0027Innovative designs\u0027 \u2014 adjective from innovate."},{"answer":"surprising","accept":[],"options":["surprising","surprised","surprisingly","surprise"],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."},{"answer":"poor visibility","accept":[],"options":["poor visibility","poor visible","poor vision","poor visibly"],"base":null,"keyword":null,"lead":null,"sentence":"The road was closed because of ___ (VISIBLE) conditions.","hint":"noun phrase: how far you can see","explanation":"\u0027Visibility\u0027 = the distance you can see; paired with \u0027poor\u0027."}]}