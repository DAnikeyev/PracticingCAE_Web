{"id":"rue-part3-0009","taskId":"rue-part3","title":"Drill set 9","text":null,"source":"drill","gaps":[{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to cooperate stalled the negotiations.","hint":"noun: saying no","explanation":"The noun from REFUSE is \u0027refusal\u0027."},{"answer":"request","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve received your ___ (REQUEST) for a refund.","hint":"noun after \u0027your\u0027","explanation":"\u0027Your request\u0027 \u2014 the noun from request."},{"answer":"appointment","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her ___ (APPOINT) as captain surprised no one.","hint":"noun: being given the role","explanation":"\u0027Her appointment as captain\u0027 \u2014 the event of being appointed."},{"answer":"confidence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He lost his ___ (CONFIDENT) after the failure.","hint":"noun after possessive","explanation":"\u0027Lost his confidence\u0027 \u2014 the noun form."},{"answer":"prescription","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without ___ (PRESCRIBE).","hint":"noun: doctor\u0027s order","explanation":"\u0027Without prescription\u0027 \u2014 noun; also \u0027over the counter\u0027."},{"answer":"loss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team\u0027s ___ (LOSE) came as a shock to the fans.","hint":"noun: being defeated","explanation":"\u0027Their loss\u0027 \u2014 the noun for a defeat or disappearance."},{"answer":"importance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The document is of great ___ (IMPORTANT) to the case.","hint":"noun after of great","explanation":"\u0027Of great importance\u0027 \u2014 the noun form."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."}]}