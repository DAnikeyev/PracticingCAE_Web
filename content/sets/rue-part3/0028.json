{"id":"rue-part3-0028","taskId":"rue-part3","title":"Drill set 28","text":null,"source":"drill","gaps":[{"answer":"wisdom","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She showed great ___ (WISE) in avoiding the deal.","hint":"noun: quality of being wise","explanation":"\u0027Wisdom\u0027 \u2014 the quality noun from wise (spelling: wise \u2192 wisdom)."},{"answer":"commercial","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film was a critical and ___ (COMMERCE) success.","hint":"adjective before \u0027success\u0027","explanation":"\u0027Commercial success\u0027 \u2014 adjective from commerce."},{"answer":"development","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The council rejected plans for a new ___ (DEVELOP).","hint":"noun: a building project","explanation":"\u0027A development\u0027 = a building project; \u0027developer\u0027 = the company."},{"answer":"emergency","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The pilot made an ___ (EMERGENCY) landing.","hint":"noun as modifier","explanation":"\u0027Emergency landing\u0027 \u2014 noun used attributively."},{"answer":"calm","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The police appealed for ___ (CALM).","hint":"noun after \u0027for\u0027","explanation":"\u0027Appealed for calm\u0027 \u2014 the set phrase uses \u0027calm\u0027 as noun."},{"answer":"widespread","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The storm caused ___ (WIDE) damage along the coast.","hint":"adjective: affecting many places","explanation":"\u0027Widespread damage\u0027 = damage across a large area."},{"answer":"awareness","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a growing ___ (AWARE) of mental health issues.","hint":"noun after \u0027growing\u0027","explanation":"\u0027Awareness\u0027 \u2014 noun from aware (-ness suffix)."},{"answer":"refusal","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (REFUSE) to cooperate stalled the negotiations.","hint":"noun: saying no","explanation":"The noun from REFUSE is \u0027refusal\u0027."}]}