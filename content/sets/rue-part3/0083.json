{"id":"rue-part3-0083","taskId":"rue-part3","title":"Drill set 83","text":null,"source":"drill","gaps":[{"answer":"independence","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"India gained ___ (DEPEND) from Britain in 1947.","hint":"noun: the state of being free from rule","explanation":"\u0027Gain independence\u0027 = become self-governing; the noun form follows the verb."},{"answer":"impatient","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do not be ___ (PATIENT) with the trainees \u2014 everyone learns at a different pace.","hint":"negative adjective: not tolerant","explanation":"\u0027Do not be impatient\u0027 \u2014 the negative adjective fits the advice against frustration."},{"answer":"qualified","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s a highly ___ (QUALIFY) engineer.","hint":"participle adjective","explanation":"\u0027Highly qualified\u0027 \u2014 participle used as adjective."},{"answer":"performance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The band\u0027s ___ (PERFORM) was unforgettable.","hint":"noun after possessive","explanation":"\u0027The band\u0027s performance\u0027 \u2014 noun from perform."},{"answer":"coverage","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The journal gave full ___ (COVER) to the election.","hint":"noun: reporting in the media","explanation":"\u0027Media coverage\u0027 \u2014 the noun for how much something is reported."},{"answer":"surprising","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results of the survey were highly ___ (SURPRISE).","hint":"adjective: causing surprise","explanation":"The results cause surprise: surprising."},{"answer":"strength","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The job requires ___ (STRONG) and stamina.","hint":"noun from strong","explanation":"\u0027Strength\u0