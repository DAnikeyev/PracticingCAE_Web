{"id":"rue-part4-0105","taskId":"rue-part4","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"are strictly forbidden to feed","accept":[],"options":[],"base":null,"keyword":"FORBIDDEN","lead":"Visitors may not feed the animals.","sentence":"Visitors ___ the animals.","hint":"be forbidden to do","explanation":"may not = are (strictly) forbidden to."},{"answer":"unless you hurry","accept":[],"options":[],"base":null,"keyword":"HURRY","lead":"If you don\u0027t hurry, you\u0027ll miss the bus.","sentence":"You\u0027ll miss the bus ___.","hint":"unless = if \u2026 not","explanation":"\u0027Unless you hurry\u0027 = \u0027if you don\u0027t hurry\u0027."},{"answer":"is claimed to cure","accept":[],"options":[],"base":null,"keyword":"CLAIMED","lead":"People claim that this herbal tea cures colds.","sentence":"This herbal tea ___ colds.","hint":"passive reporting","explanation":"X is claimed to \u002B infinitive = people claim X does."},{"answer":"must never be used","accept":[],"options":[],"base":null,"keyword":"USED","lead":"The exam regulations forbid the use of mobile phones.","sentence":"Mobile phones ___ in the exam.","hint":"modal passive, prohibition","explanation":"forbid = must never \u002B be \u002B participle (passive)."},{"answer":"far too impatient to","accept":[],"options":[],"base":null,"keyword":"PATIENT","lead":"He is so impatient that he refuses to read instructions.","sentence":"He is ___ read instructions.","hint":"too \u002B adjective \u002B to-infinitive","explanation":"so impatient that he refuses = far too impatient to."},{"answer":"speak French as well as","accept":[],"options":[],"base":null,"keyword":"WELL","lead":"She speaks French better than her brother does.","sentence":"Her brother doesn\u0027t ___ she does.","hint":"comparison with as \u2026 as","explanation":"\u0027Doesn\u0027t speak French as well as\u0027 reverses the comparison."}]}