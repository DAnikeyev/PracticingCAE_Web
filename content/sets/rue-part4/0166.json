{"id":"rue-part4-0166","taskId":"rue-part4","title":"Drill set 166","text":null,"source":"drill","gaps":[{"answer":"don\u0027t have to book","accept":[],"options":[],"base":null,"keyword":"HAVE","lead":"It isn\u0027t necessary to book in advance.","sentence":"You ___ in advance.","hint":"absence of obligation","explanation":"\u0027Don\u0027t have to\u0027 = it is not necessary."},{"answer":"twice as fast as","accept":[],"options":[],"base":null,"keyword":"TWICE","lead":"The plane takes one hour; the train takes two.","sentence":"The plane is ___ the train.","hint":"twice as \u2026 as","explanation":"half the time = twice as fast as."},{"answer":"unless you hurry","accept":[],"options":[],"base":null,"keyword":"HURRY","lead":"If you don\u0027t hurry, you\u0027ll miss the bus.","sentence":"You\u0027ll miss the bus ___.","hint":"unless = if \u2026 not","explanation":"\u0027Unless you hurry\u0027 = \u0027if you don\u0027t hurry\u0027."},{"answer":"unless you revise properly","accept":[],"options":[],"base":null,"keyword":"REVISE","lead":"You\u0027ll fail your exam if you don\u0027t revise.","sentence":"You\u0027ll fail your exam ___ .","hint":"unless = if \u2026 not","explanation":"unless \u002B present simple = if you don\u0027t."},{"answer":"are strictly forbidden to feed","accept":[],"options":[],"base":null,"keyword":"FORBIDDEN","lead":"Visitors may not feed the animals.","sentence":"Visitors ___ the animals.","hint":"be forbidden to do","explanation":"may not = are (strictly) forbidden to."},{"answer":"though his salary is low","accept":[],"options":[],"base":null,"keyword":"THOUGH","lead":"He enjoys his work despite his low salary.","sentence":"He enjoys his work, ___ .","hint":"final \u0027though\u0027 as concession","explanation":"\u0027though\u0027 can close a sentence as a soft \u0027however\u0027."}]}