{"id":"rue-part4-0008","taskId":"rue-part4","title":"Drill set 8","text":null,"source":"drill","gaps":[{"answer":"won\u0027t be allowed","accept":[],"options":[],"base":null,"keyword":"ALLOWED","lead":"They won\u0027t let you in without a ticket.","sentence":"You ___ in without a ticket.","hint":"passive of let/allow","explanation":"let somebody do \u2192 be allowed to do: won\u0027t be allowed in."},{"answer":"looking forward to starting","accept":[],"options":[],"base":null,"keyword":"FORWARD","lead":"I can\u0027t wait for the holidays to start.","sentence":"I\u0027m really ___ the holidays.","hint":"look forward to \u002B -ing","explanation":"look forward TO \u002B -ing: the \u0027to\u0027 is a preposition."},{"answer":"constantly being interrupted","accept":[],"options":[],"base":null,"keyword":"INTERRUPTED","lead":"She hates it when people interrupt her.","sentence":"She hates ___ .","hint":"hate \u002B being \u002B participle","explanation":"hate \u002B being \u002B past participle (passive gerund)."},{"answer":"In spite of his injury","accept":[],"options":[],"base":null,"keyword":"SPITE","lead":"Despite his serious injury, he finished the marathon.","sentence":"___ , he finished the marathon.","hint":"in spite of \u002B noun","explanation":"in spite of \u002B noun/-ing = despite."},{"answer":"must never be used","accept":[],"options":[],"base":null,"keyword":"USED","lead":"The exam regulations forbid the use of mobile phones.","sentence":"Mobile phones ___ in the exam.","hint":"modal passive, prohibition","explanation":"forbid = must never \u002B be \u002B participle (passive)."},{"answer":"such a tiring journey","accept":[],"options":[],"base":null,"keyword":"JOURNEY","lead":"The journey was so tiring that we slept all day.","sentence":"It was ___ that we slept all day.","hint":"such \u002B a \u002B adjective \u002B noun","explanation":"so tiring (a journey) \u2192 such a tiring journey."}]}