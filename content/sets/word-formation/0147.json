{"id":"word-formation-0147","taskId":"word-formation","title":"Drill set 147","text":null,"source":"drill","gaps":[{"answer":"boring","accept":[],"options":["boredom","boringly","boring","bored"],"base":null,"keyword":null,"lead":null,"sentence":"The audience found the lecture extremely ___ (BORE).","hint":"the lecture causes the boredom (-ing)","explanation":"The lecture causes boredom, so it is boring; the audience would be bored."},{"answer":"Honesty","accept":[],"options":["Honest","Honestness","Honestly","Honesty"],"base":null,"keyword":null,"lead":null,"sentence":"___ is the best policy (HONEST).","hint":"subject of the sentence: noun needed (-ness becomes -ty here)","explanation":"The subject must be a noun: Honesty. The spelling changes -ness to -ty; \u0027honestness\u0027 is not a word."},{"answer":"recognition","accept":[],"options":["recognised","recognisable","recognition","recognising"],"base":null,"keyword":null,"lead":null,"sentence":"The village has changed beyond ___ (RECOGNISE).","hint":"noun needed after \u0027beyond\u0027 (-tion)","explanation":"\u0027Beyond recognition\u0027 is the fixed phrase; after \u0027beyond\u0027 a noun is needed."},{"answer":"thicken","accept":[],"options":["thicken","thickness","thick","thickly"],"base":null,"keyword":null,"lead":null,"sentence":"Add flour to ___ the sauce (THICK).","hint":"verb needed after \u0027to\u0027 (-en)","explanation":"The suffix -en forms verbs from adjectives: thicken. A base verb follows \u0027to\u0027."},{"answer":"prescription","accept":[],"options":["prescription","prescribed","prescriptive","prescribing"],"base":null,"keyword":null,"lead":null,"sentence":"The medicine is available without a ___ (PRESCRIBE).","hint":"noun: doctor\u2019s written order","explanation":"\u0027Without a prescription\u0027 \u2014 the noun."},{"answer":"solidify","accept":[],"options":["solid","solidity","solidly","solidify"],"base":null,"keyword":null,"lead":null,"sentence":"The mixture will ___ as it cools (SOLID).","hint":"verb needed after \u0027will\u0027 (-ify)","explanation":"The suffix -ify forms the verb: solidify means to become solid. A base verb follows \u0027will\u0027."},{"answer":"inflation","accept":[],"options":["inflation","inflated","inflatable","inflationary"],"base":null,"keyword":null,"lead":null,"sentence":"The risk of ___ (INFLATE) remains low.","hint":"noun: rising prices","explanation":"The noun from INFLATE is \u0027inflation\u0027."},{"answer":"confidence","accept":[],"options":["confidence","confident","confidently","confidential"],"base":null,"keyword":null,"lead":null,"sentence":"His ___ (CONFIDENT) was shaken by the failure.","hint":"noun: self-belief","explanation":"The noun from CONFIDENT is \u0027confidence\u0027."}]}