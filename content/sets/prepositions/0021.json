{"id":"prepositions-0021","taskId":"prepositions","title":"Drill set 21","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"to","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They were grateful ___ the firefighters for their quick response.","hint":"grateful ___ sb ___ sth (first gap)","explanation":"grateful TO somebody FOR something. Only the first gap is checked here."}]}