{"id":"prepositions-0103","taskId":"prepositions","title":"Drill set 103","text":null,"source":"drill","gaps":[{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spends far too much ___ computer games.","hint":"spend money/time ___ sth","explanation":"spend money/time ON something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results differ sharply ___ last year\u0027s.","hint":"differ ___ sth","explanation":"differ FROM something (one thing differs from another); differ WITH = disagree."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Millions suffer ___ hay fever every summer.","hint":"suffer ___ sth","explanation":"suffer FROM an illness/problem."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."}]}