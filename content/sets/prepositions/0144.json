{"id":"prepositions-0144","taskId":"prepositions","title":"Drill set 144","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":["by","of","with","from"],"base":null,"keyword":null,"lead":null,"sentence":"She suffered ___ migraines for years before the surgery.","hint":"suffer ___ an illness","explanation":"\u0027Suffer from\u0027 an illness or condition."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She soon got tired ___ answering the same questions.","hint":"tired ___ sth (bored)","explanation":"tired OF something = bored/annoyed by it; tired FROM = physically exhausted."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Be kind ___ your little brother.","hint":"kind ___ sb","explanation":"kind TO somebody."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project failed through a lack ___ funding.","hint":"lack ___ sth","explanation":"a lack OF something."},{"answer":"with","accept":[],"options":["with","by","of","for"],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ driving without insurance.","hint":"charge somebody ___ something","explanation":"\u0027Charge somebody with an offence\u0027 \u2014 legal collocation."}]}