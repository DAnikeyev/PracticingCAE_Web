{"id":"prepositions-0035","taskId":"prepositions","title":"Drill set 35","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She apologised ___ being so late.","hint":"apologise ___ sth","explanation":"apologise FOR something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m going to apply ___ that job in Rotterdam.","hint":"apply ___ a job","explanation":"apply FOR a job; apply TO a company/university."},{"answer":"after","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Could you look ___ my plants while I\u0027m away?","hint":"look ___ = take care of","explanation":"look AFTER somebody/something = take care of them."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"on","accept":[],"options":["on","in","at","by"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"on","accept":[],"options":["with","of","on","from"],"base":null,"keyword":null,"lead":null,"sentence":"The outcome depends ___ the weather, as always.","hint":"depend ___","explanation":"\u0027Depend on/upon\u0027 \u2014 never \u0027depend of\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hopefully we\u0027ll find a solution ___ the problem soon.","hint":"solution ___ sth","explanation":"a solution TO a problem (also: answer/key/reply TO)."}]}