{"id":"prepositions-0098","taskId":"prepositions","title":"Drill set 98","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Detectives are still searching ___ the missing painting.","hint":"search ___ sth (look for)","explanation":"search FOR something you want to find; search a place = look through it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She apologised ___ being so late.","hint":"apologise ___ sth","explanation":"apologise FOR something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They arrived ___ Rome at dawn.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive IN towns, cities and countries; AT for buildings/points."}]}