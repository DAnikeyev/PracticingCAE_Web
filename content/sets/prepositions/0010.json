{"id":"prepositions-0010","taskId":"prepositions","title":"Drill set 10","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["with","to","for","of"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s responsible ___ training the new staff.","hint":"responsible ___ doing something","explanation":"\u0027Responsible for\u0027 = in charge of."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"on","accept":[],"options":["in","on","at","to"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"to","accept":[],"options":["for","to","under","at"],"base":null,"keyword":null,"lead":null,"sentence":"The dispute was referred ___ arbitration at the request of both unions.","hint":"refer sth ___ arbitration","explanation":"\u0027Refer something to arbitration\u0027 = send it to an independent body to be settled."},{"answer":"of","accept":[],"options":["about","to","with","of"],"base":null,"keyword":null,"lead":null,"sentence":"This perfume always reminds me ___ my grandmother.","hint":"remind somebody ___ something","explanation":"\u0027Remind somebody of something\u0027 = make them think of it."}]}