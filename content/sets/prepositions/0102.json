{"id":"prepositions-0102","taskId":"prepositions","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Is there any excuse ___ being so rude?","hint":"excuse ___ sth","explanation":"an excuse FOR something/doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ashamed ___ their behaviour at the match.","hint":"ashamed ___ sth","explanation":"ashamed OF something/doing something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t argue ___ your brother about silly things.","hint":"argue ___ sb about sth","explanation":"argue WITH a person ABOUT a topic. \u0027With\u0027 also accepted after argue for a point."}]}