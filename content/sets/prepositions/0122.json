{"id":"prepositions-0122","taskId":"prepositions","title":"Drill set 122","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["by","in","on","at"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"with","accept":[],"options":["by","of","with","for"],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ driving without insurance.","hint":"charge somebody ___ something","explanation":"\u0027Charge somebody with an offence\u0027 \u2014 legal collocation."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Detectives are still searching ___ the missing painting.","hint":"search ___ sth (look for)","explanation":"search FOR something you want to find; search a place = look through it."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"with","accept":[],"options":["to","with","at","from"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not familiar ___ this software yet.","hint":"familiar ___ something","explanation":"\u0027Familiar with\u0027 = knowing something well."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"with","accept":["between"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She has a good relationship ___ her students.","hint":"relationship ___ sb","explanation":"a relationship WITH somebody (BETWEEN two parties)."}]}