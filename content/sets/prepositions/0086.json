{"id":"prepositions-0086","taskId":"prepositions","title":"Drill set 86","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hopefully we\u0027ll find a solution ___ the problem soon.","hint":"solution ___ sth","explanation":"a solution TO a problem (also: answer/key/reply TO)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project failed through a lack ___ funding.","hint":"lack ___ sth","explanation":"a lack OF something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is dealing ___ this customer\u0027s complaint?","hint":"deal ___ sth (handle)","explanation":"deal WITH = handle, manage; deal IN = trade in goods."}]}