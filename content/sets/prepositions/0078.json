{"id":"prepositions-0078","taskId":"prepositions","title":"Drill set 78","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They provided us ___ everything we needed.","hint":"provide sb ___ sth","explanation":"provide somebody WITH something, or provide something FOR somebody."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Water consists ___ two hydrogen atoms and one oxygen atom.","hint":"consist ___ (be made of)","explanation":"consist OF = be made of. Compare \u0027consist in\u0027 (= have as its essence), rare."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."}]}