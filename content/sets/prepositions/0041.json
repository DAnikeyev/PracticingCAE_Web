{"id":"prepositions-0041","taskId":"prepositions","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["for","by","as","with"],"base":null,"keyword":null,"lead":null,"sentence":"I mistook him ___ one of the technicians \u2014 he was actually the new director.","hint":"mistake A ___ B","explanation":"\u0027Mistake somebody for somebody else\u0027 = wrongly believe they are that person."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"off","accept":[],"options":["down","up","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"The village was cut ___ by the floods for three days.","hint":"cut ___ = isolated","explanation":"\u0027Cut off\u0027 = unable to reach or be reached."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pl