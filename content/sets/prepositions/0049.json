{"id":"prepositions-0049","taskId":"prepositions","title":"Drill set 49","text":null,"source":"drill","gaps":[{"answer":"in","accept":["with"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She had no difficulty ___ finding the station.","hint":"difficulty ___ doing","explanation":"have difficulty (IN) doing something \u2014 \u0027in\u0027 is often omitted, but is the expected preposition."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Look ___ those clouds \u2014 it\u0027s going to rain.","hint":"look ___ sth (see)","explanation":"look AT = direct your eyes; look after = take care of; look for = search."}]}