{"id":"prepositions-0161","taskId":"prepositions","title":"Drill set 161","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["for","on","to","at"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal herself.","hint":"insist ___ \u002B -ing","explanation":"\u0027Insist on doing something\u0027 \u2014 fixed preposition."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Is there any excuse ___ being so rude?","hint":"excuse ___ sth","explanation":"an excuse FOR something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spends far too much ___ computer games.","hint":"spend money/time ___ sth","explanation":"spend money/time ON something."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s always cared deeply ___ animal welfare.","hint":"care ___ sth (be concerned)","explanation":"care ABOUT = think it matters; care FOR = look after or like."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."}]}