{"id":"prepositions-0043","taskId":"prepositions","title":"Drill set 43","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She blamed the delay ___ the courier company.","hint":"blame sth ___ sb","explanation":"blame something ON somebody = blame somebody FOR something."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel was translated ___ twelve languages.","hint":"translate ___ a language","explanation":"translate FROM one language INTO another."},{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Residents complained ___ the noise every night.","hint":"complain ___ sth","explanation":"complain ABOUT something (or complain TO somebody ABOUT it)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."}]}