{"id":"prepositions-0181","taskId":"prepositions","title":"Drill set 181","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Millions suffer ___ hay fever every summer.","hint":"suffer ___ sth","explanation":"suffer FROM an illness/problem."},{"answer":"from","accept":[],"options":["by","of","with","from"],"base":null,"keyword":null,"lead":null,"sentence":"She suffered ___ migraines for years before the surgery.","hint":"suffer ___ an illness","explanation":"\u0027Suffer from\u0027 an illness or condition."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hopefully we\u0027ll find a solution ___ the problem soon.","hint":"solution ___ sth","explanation":"a solution TO a problem (also: answer/key/reply TO)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."}]}