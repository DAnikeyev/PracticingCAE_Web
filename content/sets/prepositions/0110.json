{"id":"prepositions-0110","taskId":"prepositions","title":"Drill set 110","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Have you paid ___ the tickets yet?","hint":"pay ___ sth (goods)","explanation":"pay FOR goods/services; pay a bill (no preposition)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"on","accept":[],"options":["on","to","at","in"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."}]}