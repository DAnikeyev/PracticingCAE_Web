{"id":"prepositions-0110","taskId":"prepositions","title":"Drill set 110","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Water consists ___ two hydrogen atoms and one oxygen atom.","hint":"consist ___ (be made of)","explanation":"consist OF = be made of. Compare \u0027consist in\u0027 (= have as its essence), rare."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government imposed new restrictions ___ water use.","hint":"restrictions ___ sth","explanation":"restrictions ON something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They arrived ___ Rome at dawn.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive IN towns, cities and countries; AT for buildings/points."}]}