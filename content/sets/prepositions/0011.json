{"id":"prepositions-0011","taskId":"prepositions","title":"Drill set 11","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The kids are crazy ___ the new video game.","hint":"crazy ___ sth (love)","explanation":"crazy ABOUT something = love it enthusiastically."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."}]}