{"id":"prepositions-0179","taskId":"prepositions","title":"Drill set 179","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Over two hundred athletes participated ___ the marathon.","hint":"participate ___ sth","explanation":"participate IN an event (also: take part in)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"with","accept":[],"options":["of","for","by","with"],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ driving without insurance.","hint":"charge somebody ___ something","explanation":"\u0027Charge somebody with an offence\u0027 \u2014 legal collocation."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."}]}