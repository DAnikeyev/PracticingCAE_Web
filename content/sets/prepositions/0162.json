{"id":"prepositions-0162","taskId":"prepositions","title":"Drill set 162","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":["up","for","to","with"],"base":null,"keyword":null,"lead":null,"sentence":"His account of the accident tallies ___ the CCTV footage.","hint":"tally ___ = match","explanation":"\u0027Tally with\u0027 = correspond exactly to something else."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spends far too much ___ computer games.","hint":"spend money/time ___ sth","explanation":"spend money/time ON something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"with","accept":[],"options":["at","to","with","from"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not familiar ___ this software yet.","hint":"familiar ___ something","explanation":"\u0027Familiar with\u0027 = knowing something well."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s always cared deeply ___ animal welfare.","hint":"care ___ sth (be concerned)","explanation":"care ABOUT = think it matters; care FOR = look after or like."}]}