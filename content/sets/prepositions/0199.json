{"id":"prepositions-0199","taskId":"prepositions","title":"Drill set 199","text":null,"source":"drill","gaps":[{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Is there any excuse ___ being so rude?","hint":"excuse ___ sth","explanation":"an excuse FOR something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government imposed new restrictions ___ water use.","hint":"restrictions ___ sth","explanation":"restrictions ON something."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."}]}