{"id":"prepositions-0019","taskId":"prepositions","title":"Drill set 19","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She apologised ___ being so late.","hint":"apologise ___ sth","explanation":"apologise FOR something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."}]}