{"id":"prepositions-0151","taskId":"prepositions","title":"Drill set 151","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Millions suffer ___ hay fever every summer.","hint":"suffer ___ sth","explanation":"suffer FROM an illness/problem."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She apologised ___ being so late.","hint":"apologise ___ sth","explanation":"apologise FOR something/doing something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Be kind ___ your little brother.","hint":"kind ___ sb","explanation":"kind TO somebody."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."}]}