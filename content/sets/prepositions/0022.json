{"id":"prepositions-0022","taskId":"prepositions","title":"Drill set 22","text":null,"source":"drill","gaps":[{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Is there any excuse ___ being so rude?","hint":"excuse ___ sth","explanation":"an excuse FOR something/doing something."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel was translated ___ twelve languages.","hint":"translate ___ a language","explanation":"translate FROM one language INTO another."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s always cared deeply ___ animal welfare.","hint":"care ___ sth (be concerned)","explanation":"care ABOUT = think it matters; care FOR = look after or like."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Critics attacked the film ___ its slow pace.","hint":"criticise sth ___ sth","explanation":"criticise/criticize something FOR a reason."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."}]}