{"id":"prepositions-0076","taskId":"prepositions","title":"Drill set 76","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They provided us ___ everything we needed.","hint":"provide sb ___ sth","explanation":"provide somebody WITH something, or provide something FOR somebody."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She apologised ___ being so late.","hint":"apologise ___ sth","explanation":"apologise FOR something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"What\u0027s the difference ___ these two phones?","hint":"difference ___ two things","explanation":"difference BETWEEN two things (difference IN price/size for the respect in which)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The kids are crazy ___ the new video game.","hint":"crazy ___ sth (love)","explanation":"crazy ABOUT something = love it enthusiastically."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."}]}