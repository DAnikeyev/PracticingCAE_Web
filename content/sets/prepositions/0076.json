{"id":"prepositions-0076","taskId":"prepositions","title":"Drill set 76","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Over two hundred athletes participated ___ the marathon.","hint":"participate ___ sth","explanation":"participate IN an event (also: take part in)."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She glanced ___ her watch and stood up.","hint":"glance ___ sth","explanation":"glance AT = look quickly at."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You should concentrate ___ one task at a time.","hint":"concentrate ___ sth","explanation":"concentrate ON something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."}]}