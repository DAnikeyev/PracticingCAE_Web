{"id":"prepositions-0027","taskId":"prepositions","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The high wall prevents outsiders ___ entering the garden.","hint":"prevent sb ___ doing","explanation":"prevent/stop somebody FROM doing something (\u0027from\u0027 is optional after stop)."},{"answer":"from","accept":["against"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Sunscreen protects the skin ___ UV rays.","hint":"protect ___ sth harmful","explanation":"protect somebody/something FROM (or AGAINST) harm."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The song reminds me ___ my first holiday abroad.","hint":"remind sb ___ sth","explanation":"remind somebody OF something = make them remember; remind somebody ABOUT = tell them not to forget."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."}]}