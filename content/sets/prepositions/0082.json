{"id":"prepositions-0082","taskId":"prepositions","title":"Drill set 82","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."},{"answer":"to","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They were grateful ___ the firefighters for their quick response.","hint":"grateful ___ sb ___ sth (first gap)","explanation":"grateful TO somebody FOR something. Only the first gap is checked here."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."}]}