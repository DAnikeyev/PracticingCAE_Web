{"id":"prepositions-0008","taskId":"prepositions","title":"Drill set 8","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"with","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m getting bored ___ watching the same series.","hint":"bored ___ sth","explanation":"bored WITH (or BY) something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"at","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Viewers were shocked ___ the violence in the film.","hint":"shocked ___ sth","explanation":"shocked AT/BY something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."}]}