{"id":"prepositions-0032","taskId":"prepositions","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"to","accept":["towards"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His attitude ___ work has really improved.","hint":"attitude ___ sth","explanation":"attitude TO (or TOWARDS) something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Two prisoners escaped ___ the high-security wing.","hint":"escape ___ a place","explanation":"escape FROM a place (American English also allows a bare object)."}]}