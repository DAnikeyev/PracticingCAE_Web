{"id":"prepositions-0032","taskId":"prepositions","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":["by","with","of","from"],"base":null,"keyword":null,"lead":null,"sentence":"She suffered ___ migraines for years before the surgery.","hint":"suffer ___ an illness","explanation":"\u0027Suffer from\u0027 an illness or condition."},{"answer":"for","accept":[],"options":["as","by","with","for"],"base":null,"keyword":null,"lead":null,"sentence":"I mistook him ___ one of the technicians \u2014 he was actually the new director.","hint":"mistake A ___ B","explanation":"\u0027Mistake somebody for somebody else\u0027 = wrongly believe they are that person."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"with","accept":[],"options":["at","to","with","on"],"base":null,"keyword":null,"lead":null,"sentence":"The manager had no option but to concur ___ the decision.","hint":"concur ___ = agree with","explanation":"\u0027Concur with\u0027 is the formal equivalent of \u0027agree with\u0027."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."}]}