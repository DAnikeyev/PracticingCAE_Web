{"id":"prepositions-0028","taskId":"prepositions","title":"Drill set 28","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government imposed new restrictions ___ water use.","hint":"restrictions ___ sth","explanation":"restrictions ON something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Listen ___ me carefully: this is important.","hint":"listen ___ sb","explanation":"listen TO somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The surgeon operated ___ the patient for four hours.","hint":"operate ___ sb","explanation":"operate ON a patient (for a condition)."}]}