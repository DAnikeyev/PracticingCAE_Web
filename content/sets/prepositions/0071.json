{"id":"prepositions-0071","taskId":"prepositions","title":"Drill set 71","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["on","of","from","with"],"base":null,"keyword":null,"lead":null,"sentence":"The outcome depends ___ the weather, as always.","hint":"depend ___","explanation":"\u0027Depend on/upon\u0027 \u2014 never \u0027depend of\u0027."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Critics attacked the film ___ its slow pace.","hint":"criticise sth ___ sth","explanation":"criticise/criticize something FOR a reason."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee does not approve ___ the changes.","hint":"approve ___ sth (verb)","explanation":"Verb: approve OF something (noun \u0027approval\u0027 has no preposition)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"from","accept":[],"options":["on","with","from","at"],"base":null,"keyword":null,"lead":null,"sentence":"Local traders have benefited enormously ___ the new footfall.","hint":"benefit ___ an advantage","explanation":"\u0027Benefit from\u0027 = gain an advantage from something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They arrived ___ Rome at dawn.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive