{"id":"prepositions-0178","taskId":"prepositions","title":"Drill set 178","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"to","accept":[],"options":["to","for","with","about"],"base":null,"keyword":null,"lead":null,"sentence":"She was completely oblivious ___ the commotion outside.","hint":"oblivious ___ = unaware of","explanation":"\u0027Oblivious to\u0027 is the standard collocation meaning unaware of."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Staff must always be polite ___ customers.","hint":"polite ___ sb","explanation":"polite TO somebody."},{"answer":"on","accept":[],"options":["on","at","in","to"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."},{"answer":"to","accept":[],"options":["under","at","for","to"],"base":null,"keyword":null,"lead":null,"sentence":"The dispute was referred ___ arbitration at the request of both unions.","hint":"refer sth ___ arbitration","explanation":"\u0027Refer something to arbitration\u0027 = send it to an independent body to be settled."}]}