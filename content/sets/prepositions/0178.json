{"id":"prepositions-0178","taskId":"prepositions","title":"Drill set 178","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["at","on","in","by"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"on","accept":[],"options":["of","with","from","on"],"base":null,"keyword":null,"lead":null,"sentence":"The outcome depends ___ the weather, as always.","hint":"depend ___","explanation":"\u0027Depend on/upon\u0027 \u2014 never \u0027depend of\u0027."},{"answer":"with","accept":[],"options":["to","with","for","up"],"base":null,"keyword":null,"lead":null,"sentence":"His account of the accident tallies ___ the CCTV footage.","hint":"tally ___ = match","explanation":"\u0027Tally with\u0027 = correspond exactly to something else."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You should concentrate ___ one task at a time.","hint":"concentrate ___ sth","explanation":"concentrate ON something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results differ sharply ___ last year\u0027s.","hint":"differ ___ sth","explanation":"differ FROM something (one thing differs from another); differ WITH = disagree."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"on","accept":[],"options":["in","to","on","at"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027