{"id":"prepositions-0045","taskId":"prepositions","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"at","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Viewers were shocked ___ the violence in the film.","hint":"shocked ___ sth","explanation":"shocked AT/BY something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government imposed new restrictions ___ water use.","hint":"restrictions ___ sth","explanation":"restrictions ON something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Water consists ___ two hydrogen atoms and one oxygen atom.","hint":"consist ___ (be made of)","explanation":"consist OF = be made of. Compare \u0027consist in\u0027 (= have as its essence), rare."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sick ___ hearing that song on the radio.","hint":"sick ___ sth (annoyed)","explanation":"sick OF something = fed up with it."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."}]}