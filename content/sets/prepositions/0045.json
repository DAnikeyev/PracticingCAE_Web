{"id":"prepositions-0045","taskId":"prepositions","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"from","accept":["against"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Sunscreen protects the skin ___ UV rays.","hint":"protect ___ sth harmful","explanation":"protect somebody/something FROM (or AGAINST) harm."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The surgeon operated ___ the patient for four hours.","hint":"operate ___ sb","explanation":"operate ON a patient (for a condition)."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is dealing ___ this customer\u0027s complaint?","hint":"deal ___ sth (handle)","explanation":"deal WITH = handle, manage; deal IN = trade in goods."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t argue ___ your brother about silly things.","hint":"argue ___ sb about sth","explanation":"argue WITH a person ABOUT a topic. \u0027With\u0027 also accepted after argue for a point."}]}