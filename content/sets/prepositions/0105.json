{"id":"prepositions-0105","taskId":"prepositions","title":"Drill set 105","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."},{"answer":"for","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m so sorry ___ the confusion I caused.","hint":"sorry ___ sth done","explanation":"sorry FOR/ABOUT something you did; sorry FOR somebody = pity them."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Look ___ those clouds \u2014 it\u0027s going to rain.","hint":"look ___ sth (see)","explanation":"look AT = direct your eyes; look after = take care of; look for = search."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."}]}