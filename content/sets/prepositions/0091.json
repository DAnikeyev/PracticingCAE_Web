{"id":"prepositions-0091","taskId":"prepositions","title":"Drill set 91","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you believe ___ ghosts?","hint":"believe ___ sth (existence)","explanation":"believe IN something = think it exists/is right; believe somebody = trust their word."},{"answer":"from","accept":["against"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Sunscreen protects the skin ___ UV rays.","hint":"protect ___ sth harmful","explanation":"protect somebody/something FROM (or AGAINST) harm."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results differ sharply ___ last year\u0027s.","hint":"differ ___ sth","explanation":"differ FROM something (one thing differs from another); differ WITH = disagree."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Bamboo is a classic example ___ fast-growing plant.","hint":"example ___ sth","explanation":"an example OF something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hopefully we\u0027ll find a solution ___ the problem soon.","hint":"solution ___ sth","explanation":"a solution TO a problem (also: answer/key/reply TO)."}]