{"id":"prepositions-0091","taskId":"prepositions","title":"Drill set 91","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"at","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Viewers were shocked ___ the violence in the film.","hint":"shocked ___ sth","explanation":"shocked AT/BY something."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ashamed ___ their behaviour at the match.","hint":"ashamed ___ sth","explanation":"ashamed OF something/doing something."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not very friendly ___ his new colleagues.","hint":"friendly ___ sb","explanation":"friendly WITH somebody = on good terms; a friendly person is friendly TO others."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."}]}