{"id":"prepositions-0024","taskId":"prepositions","title":"Drill set 24","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"to","accept":["towards"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His attitude ___ work has really improved.","hint":"attitude ___ sth","explanation":"attitude TO (or TOWARDS) something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Residents complained ___ the noise every night.","hint":"complain ___ sth","explanation":"complain ABOUT something (or complain TO somebody ABOUT it)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Several parents objected ___ the new timetable.","hint":"object ___ sth","explanation":"object TO something."}]}