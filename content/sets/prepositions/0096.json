{"id":"prepositions-0096","taskId":"prepositions","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"with","accept":[],"options":["with","at","to","from"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not familiar ___ this software yet.","hint":"familiar ___ something","explanation":"\u0027Familiar with\u0027 = knowing something well."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"on","accept":[],"options":["on","at","to","in"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"at","accept":[],"options":["at","for","on","in"],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s brilliant ___ solving all kinds of puzzles.","hint":"good/bad/brilliant ___","explanation":"Adjectives of skill take \u0027at\u0027: brilliant at something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."}]}