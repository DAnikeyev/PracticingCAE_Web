{"id":"prepositions-0096","taskId":"prepositions","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is dealing ___ this customer\u0027s complaint?","hint":"deal ___ sth (handle)","explanation":"deal WITH = handle, manage; deal IN = trade in goods."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."},{"answer":"with","accept":["among"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This app is very popular ___ teenagers.","hint":"popular ___ sb","explanation":"popular WITH (or AMONG) a group."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."}]}