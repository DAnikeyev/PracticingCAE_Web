{"id":"prepositions-0096","taskId":"prepositions","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re really looking forward ___ the trip.","hint":"look forward ___","explanation":"look forward TO \u2014 \u0027to\u0027 is a preposition here, so it is followed by -ing: looking forward to seeing you."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"What\u0027s the difference ___ these two phones?","hint":"difference ___ two things","explanation":"difference BETWEEN two things (difference IN price/size for the respect in which)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."}]}