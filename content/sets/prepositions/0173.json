{"id":"prepositions-0173","taskId":"prepositions","title":"Drill set 173","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Several parents objected ___ the new timetable.","hint":"object ___ sth","explanation":"object TO something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results differ sharply ___ last year\u0027s.","hint":"differ ___ sth","explanation":"differ FROM something (one thing differs from another); differ WITH = disagree."},{"answer":"with","accept":["between"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She has a good relationship ___ her students.","hint":"relationship ___ sb","explanation":"a relationship WITH somebody (BETWEEN two parties)."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She glanced ___ her watch and stood up.","hint":"glance ___ sth","explanation":"glance AT = look quickly at."},{"answer":"on","accept":[],"options":["in","on","at","to"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."}]}