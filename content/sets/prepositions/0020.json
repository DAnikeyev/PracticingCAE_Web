{"id":"prepositions-0020","taskId":"prepositions","title":"Drill set 20","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They warned us ___ the icy roads.","hint":"warn sb ___ sth","explanation":"warn somebody ABOUT/OF a danger; warn somebody AGAINST doing."},{"answer":"of","accept":["from"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He died ___ pneumonia in 1947.","hint":"die ___ an illness","explanation":"die OF (or FROM) an illness/cause."},{"answer":"at","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Viewers were shocked ___ the violence in the film.","hint":"shocked ___ sth","explanation":"shocked AT/BY something."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Residents complained ___ the noise every night.","hint":"complain ___ sth","explanation":"complain ABOUT something (or complain TO somebody ABOUT it)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."}]}