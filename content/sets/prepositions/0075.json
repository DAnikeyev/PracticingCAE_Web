{"id":"prepositions-0075","taskId":"prepositions","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Bamboo is a classic example ___ fast-growing plant.","hint":"example ___ sth","explanation":"an example OF something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re excited ___ our trip to Peru.","hint":"excited ___ sth","explanation":"excited ABOUT something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you believe ___ ghosts?","hint":"believe ___ sth (existence)","explanation":"believe IN something = think it exists/is right; believe somebody = trust their word."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"with","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m getting bored ___ watching the same series.","hint":"bored ___ sth","explanation":"bored WITH (or BY) something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."}]}