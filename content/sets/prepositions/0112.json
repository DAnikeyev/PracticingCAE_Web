{"id":"prepositions-0112","taskId":"prepositions","title":"Drill set 112","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Staff must always be polite ___ customers.","hint":"polite ___ sb","explanation":"polite TO somebody."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sick ___ hearing that song on the radio.","hint":"sick ___ sth (annoyed)","explanation":"sick OF something = fed up with it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."}]}