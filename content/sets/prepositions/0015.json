{"id":"prepositions-0015","taskId":"prepositions","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"off","accept":[],"options":["up","out","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"The village was cut ___ by the floods for three days.","hint":"cut ___ = isolated","explanation":"\u0027Cut off\u0027 = unable to reach or be reached."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"with","accept":[],"options":["of","with","for","by"],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ driving without insurance.","hint":"charge somebody ___ something","explanation":"\u0027Charge somebody with an offence\u0027 \u2014 legal collocation."}]}