{"id":"prepositions-0057","taskId":"prepositions","title":"Drill set 57","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"with","accept":[],"options":["to","with","on","at"],"base":null,"keyword":null,"lead":null,"sentence":"The manager had no option but to concur ___ the decision.","hint":"concur ___ = agree with","explanation":"\u0027Concur with\u0027 is the formal equivalent of \u0027agree with\u0027."},{"answer":"for","accept":[],"options":["of","for","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s responsible ___ training the new staff.","hint":"responsible ___ doing something","explanation":"\u0027Responsible for\u0027 = in charge of."},{"answer":"to","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They were grateful ___ the firefighters for their quick response.","hint":"grateful ___ sb ___ sth (first gap)","explanation":"grateful TO somebody FOR something. Only the first gap is checked here."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not very friendly ___ his new colleagues.","hint":"friendly ___ sb","explanation":"friendly WITH somebody = on good terms; a friendly person is friendly TO others."}]}