{"id":"prepositions-0016","taskId":"prepositions","title":"Drill set 16","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is dealing ___ this customer\u0027s complaint?","hint":"deal ___ sth (handle)","explanation":"deal WITH = handle, manage; deal IN = trade in goods."},{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"to","accept":["towards"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His attitude ___ work has really improved.","hint":"attitude ___ sth","explanation":"attitude TO (or TOWARDS) something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."}]}