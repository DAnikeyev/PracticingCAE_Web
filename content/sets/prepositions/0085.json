{"id":"prepositions-0085","taskId":"prepositions","title":"Drill set 85","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Listen ___ me carefully: this is important.","hint":"listen ___ sb","explanation":"listen TO somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sick ___ hearing that song on the radio.","hint":"sick ___ sth (annoyed)","explanation":"sick OF something = fed up with it."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."}]}