{"id":"prepositions-0127","taskId":"prepositions","title":"Drill set 127","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Several parents objected ___ the new timetable.","hint":"object ___ sth","explanation":"object TO something."},{"answer":"with","accept":["among"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This app is very popular ___ teenagers.","hint":"popular ___ sb","explanation":"popular WITH (or AMONG) a group."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"to","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They were grateful ___ the firefighters for their quick response.","hint":"grateful ___ sb ___ sth (first gap)","explanation":"grateful TO somebody FOR something. Only the first gap is checked here."}]}