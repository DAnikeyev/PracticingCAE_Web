{"id":"prepositions-0004","taskId":"prepositions","title":"Drill set 4","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Have you paid ___ the tickets yet?","hint":"pay ___ sth (goods)","explanation":"pay FOR goods/services; pay a bill (no preposition)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It took her weeks to recover ___ the operation.","hint":"recover ___ sth","explanation":"recover FROM an illness/experience."},{"answer":"in","accept":["with"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She had no difficulty ___ finding the station.","hint":"difficulty ___ doing","explanation":"have difficulty (IN) doing something \u2014 \u0027in\u0027 is often omitted, but is the expected preposition."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You should concentrate ___ one task at a time.","hint":"concentrate ___ sth","explanation":"concentrate ON something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project failed through a lack ___ funding.","hint":"lack ___ sth","explanation":"a lack OF something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you believe ___ ghosts?","hint":"believe ___ sth (existence)","explanation":"believe IN something = think it exists/is right; believe somebody = trust their word."}]}