{"id":"prepositions-0004","taskId":"prepositions","title":"Drill set 4","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It never occurred ___ me to check the address.","hint":"occur ___ sb (come to mind)","explanation":"it occurred TO somebody = they thought of it."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re really looking forward ___ the trip.","hint":"look forward ___","explanation":"look forward TO \u2014 \u0027to\u0027 is a preposition here, so it is followed by -ing: looking forward to seeing you."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."}]}