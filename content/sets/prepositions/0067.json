{"id":"prepositions-0067","taskId":"prepositions","title":"Drill set 67","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They provided us ___ everything we needed.","hint":"provide sb ___ sth","explanation":"provide somebody WITH something, or provide something FOR somebody."},{"answer":"from","accept":[],"options":["by","from","of","with"],"base":null,"keyword":null,"lead":null,"sentence":"She suffered ___ migraines for years before the surgery.","hint":"suffer ___ an illness","explanation":"\u0027Suffer from\u0027 an illness or condition."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Millions suffer ___ hay fever every summer.","hint":"suffer ___ sth","explanation":"suffer FROM an illness/problem."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hopefully we\u0027ll find a solution ___ the problem soon.","hint":"solution ___ sth","explanation":"a solution TO a problem (also: answer/key/reply TO)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."}]}