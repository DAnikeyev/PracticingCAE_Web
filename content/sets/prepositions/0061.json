{"id":"prepositions-0061","taskId":"prepositions","title":"Drill set 61","text":null,"source":"drill","gaps":[{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Further research ___ the disease is needed.","hint":"research ___ sth","explanation":"research INTO a subject (less commonly \u0027on\u0027)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Over two hundred athletes participated ___ the marathon.","hint":"participate ___ sth","explanation":"participate IN an event (also: take part in)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Several parents objected ___ the new timetable.","hint":"object ___ sth","explanation":"object TO something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"What\u0027s the difference ___ these two phones?","hint":"difference ___ two things","explanation":"difference BETWEEN two things (difference IN price/size for the respect in which)."}]}