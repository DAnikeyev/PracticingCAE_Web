{"id":"prepositions-0099","taskId":"prepositions","title":"Drill set 99","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It never occurred ___ me to check the address.","hint":"occur ___ sb (come to mind)","explanation":"it occurred TO somebody = they thought of it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Can I borrow a pen ___ you?","hint":"borrow ___ / lend ___","explanation":"borrow FROM (take), lend TO (give)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"with","accept":[],"options":["up","for","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"His account of the accident tallies ___ the CCTV footage.","hint":"tally ___ = match","explanation":"\u0027Tally with\u0027 = correspond exactly to something else."},{"answer":"on","accept":[],"options":["on","at","to","in"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."}]}