{"id":"prepositions-0050","taskId":"prepositions","title":"Drill set 50","text":null,"source":"drill","gaps":[{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Detectives are still searching ___ the missing painting.","hint":"search ___ sth (look for)","explanation":"search FOR something you want to find; search a place = look through it."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."}]}