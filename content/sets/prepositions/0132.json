{"id":"prepositions-0132","taskId":"prepositions","title":"Drill set 132","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["on","at","to","for"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal herself.","hint":"insist ___ \u002B -ing","explanation":"\u0027Insist on doing something\u0027 \u2014 fixed preposition."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Have you paid ___ the tickets yet?","hint":"pay ___ sth (goods)","explanation":"pay FOR goods/services; pay a bill (no preposition)."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Residents complained ___ the noise every night.","hint":"complain ___ sth","explanation":"complain ABOUT something (or complain TO somebody ABOUT it)."},{"answer":"to","accept":[],"options":["with","about","for","to"],"base":null,"keyword":null,"lead":null,"sentence":"She was completely oblivious ___ the commotion outside.","hint":"oblivious ___ = unaware of","explanation":"\u0027Oblivious to\u0027 is the standard collocation meaning unaware of."},{"answer":"on","accept":[],"options":["with","on","from","of"],"base":null,"keyword":null,"lead":null,"sentence":"The outcome depends ___ the weather, as always.","hint":"depend ___","explanation":"\u0027Depend on/upon\u0027 \u2014 never \u0027depend of\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."}]}