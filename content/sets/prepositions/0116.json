{"id":"prepositions-0116","taskId":"prepositions","title":"Drill set 116","text":null,"source":"drill","gaps":[{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She glanced ___ her watch and stood up.","hint":"glance ___ sth","explanation":"glance AT = look quickly at."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ashamed ___ their behaviour at the match.","hint":"ashamed ___ sth","explanation":"ashamed OF something/doing something."},{"answer":"with","accept":[],"options":["up","with","to","for"],"base":null,"keyword":null,"lead":null,"sentence":"His account of the accident tallies ___ the CCTV footage.","hint":"tally ___ = match","explanation":"\u0027Tally with\u0027 = correspond exactly to something else."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Critics attacked the film ___ its slow pace.","hint":"criticise sth ___ sth","explanation":"criticise/criticize something FOR a reason."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel was translated ___ twelve languages.","hint":"translate ___ a language","explanation":"translate FROM one language INTO another."}]}