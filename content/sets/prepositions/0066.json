{"id":"prepositions-0066","taskId":"prepositions","title":"Drill set 66","text":null,"source":"drill","gaps":[{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Have you paid ___ the tickets yet?","hint":"pay ___ sth (goods)","explanation":"pay FOR goods/services; pay a bill (no preposition)."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Be kind ___ your little brother.","hint":"kind ___ sb","explanation":"kind TO somebody."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Further research ___ the disease is needed.","hint":"research ___ sth","explanation":"research INTO a subject (less commonly \u0027on\u0027)."}]}