{"id":"prepositions-0107","taskId":"prepositions","title":"Drill set 107","text":null,"source":"drill","gaps":[{"answer":"of","accept":["from"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He died ___ pneumonia in 1947.","hint":"die ___ an illness","explanation":"die OF (or FROM) an illness/cause."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She soon got tired ___ answering the same questions.","hint":"tired ___ sth (bored)","explanation":"tired OF something = bored/annoyed by it; tired FROM = physically exhausted."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government imposed new restrictions ___ water use.","hint":"restrictions ___ sth","explanation":"restrictions ON something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."}]}