{"id":"prepositions-0036","taskId":"prepositions","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Over two hundred athletes participated ___ the marathon.","hint":"participate ___ sth","explanation":"participate IN an event (also: take part in)."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s keen ___ joining the photography club.","hint":"keen ___ sth/doing","explanation":"keen ON something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The only reason ___ the delay was the storm.","hint":"reason ___ sth","explanation":"the reason FOR something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Staff must always be polite ___ customers.","hint":"polite ___ sb","explanation":"polite TO somebody."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They provided us ___ everything we needed.","hint":"provide sb ___ sth","explanation":"provide somebody WITH something, or provide something FOR somebody."},{"answer":"with","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m getting bored ___ watching the same series.","hint":"bored ___ sth","explanation":"bored WITH (or BY) something."}]}