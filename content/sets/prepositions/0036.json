{"id":"prepositions-0036","taskId":"prepositions","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not very friendly ___ his new colleagues.","hint":"friendly ___ sb","explanation":"friendly WITH somebody = on good terms; a friendly person is friendly TO others."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m fed up ___ listening to excuses.","hint":"fed up ___","explanation":"fed up WITH something/doing something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"from","accept":["against"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Sunscreen protects the skin ___ UV rays.","hint":"protect ___ sth harmful","explanation":"protect somebody/something FROM (or AGAINST) harm."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She blamed the delay ___ the courier company.","hint":"blame sth ___ sb","explanation":"blame something ON somebody = blame somebody FOR something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."}]}