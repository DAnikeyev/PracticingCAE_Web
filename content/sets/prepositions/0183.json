{"id":"prepositions-0183","taskId":"prepositions","title":"Drill set 183","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"on","accept":[],"options":["at","to","on","for"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal herself.","hint":"insist ___ \u002B -ing","explanation":"\u0027Insist on doing something\u0027 \u2014 fixed preposition."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The surgeon operated ___ the patient for four hours.","hint":"operate ___ sb","explanation":"operate ON a patient (for a condition)."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I haven\u0027t heard ___ my cousin since Christmas.","hint":"hear ___ sb (news)","explanation":"hear FROM somebody = get a letter/message from them."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a huge rise ___ online shopping.","hint":"rise ___ sth (noun)","explanation":"a rise IN a quantity or activity."}]}