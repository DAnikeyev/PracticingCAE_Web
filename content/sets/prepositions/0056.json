{"id":"prepositions-0056","taskId":"prepositions","title":"Drill set 56","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spends far too much ___ computer games.","hint":"spend money/time ___ sth","explanation":"spend money/time ON something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This textbook is boring compared ___ the last one.","hint":"compared ___","explanation":"compare WITH (or TO) \u2014 \u0027with\u0027 is preferred for comparing similarities/differences; \u0027to\u0027 for \u0027liken\u0027."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Critics attacked the film ___ its slow pace.","hint":"criticise sth ___ sth","explanation":"criticise/criticize something FOR a reason."}]}