{"id":"prepositions-0056","taskId":"prepositions","title":"Drill set 56","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["for","with","to","of"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s responsible ___ training the new staff.","hint":"responsible ___ doing something","explanation":"\u0027Responsible for\u0027 = in charge of."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"from","accept":[],"options":["at","with","on","from"],"base":null,"keyword":null,"lead":null,"sentence":"Local traders have benefited enormously ___ the new footfall.","hint":"benefit ___ an advantage","explanation":"\u0027Benefit from\u0027 = gain an advantage from something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not very friendly ___ his new colleagues.","hint":"friendly ___ sb","explanation":"friendly WITH somebody = on good terms; a friendly person is friendly TO others."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."}]}