{"id":"prepositions-0039","taskId":"prepositions","title":"Drill set 39","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Staff must always be polite ___ customers.","hint":"polite ___ sb","explanation":"polite TO somebody."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Residents complained ___ the noise every night.","hint":"complain ___ sth","explanation":"complain ABOUT something (or complain TO somebody ABOUT it)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you believe ___ ghosts?","hint":"believe ___ sth (existence)","explanation":"believe IN something = think it exists/is right; believe somebody = trust their word."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press joked ___ the politician\u0027s hat.","hint":"joke ___ sth","explanation":"joke ABOUT something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He spends far too much ___ computer games.","hint":"spend money/time ___ sth","explanation":"spend money/time ON something."}]}