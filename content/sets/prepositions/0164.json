{"id":"prepositions-0164","taskId":"prepositions","title":"Drill set 164","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s fiercely proud ___ her origins.","hint":"proud ___ sth","explanation":"proud OF something/somebody."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a huge rise ___ online shopping.","hint":"rise ___ sth (noun)","explanation":"a rise IN a quantity or activity."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s something wrong ___ this printer.","hint":"wrong ___ sth","explanation":"something wrong WITH something."},{"answer":"for","accept":[],"options":["of","for","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s responsible ___ training the new staff.","hint":"responsible ___ doing something","explanation":"\u0027Responsible for\u0027 = in charge of."},{"answer":"from","accept":[],"options":["from","at","with","on"],"base":null,"keyword":null,"lead":null,"sentence":"Local traders have benefited enormously ___ the new footfall.","hint":"benefit ___ an advantage","explanation":"\u0027Benefit from\u0027 = gain an advantage from something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ashamed ___ their behaviour at the match.","hint":"ashamed ___ sth","explanation":"ashamed OF something/doing something."}]}