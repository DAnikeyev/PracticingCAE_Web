{"id":"prepositions-0164","taskId":"prepositions","title":"Drill set 164","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re really looking forward ___ the trip.","hint":"look forward ___","explanation":"look forward TO \u2014 \u0027to\u0027 is a preposition here, so it is followed by -ing: looking forward to seeing you."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She smiled ___ the waiter and ordered tea.","hint":"smile ___ sb","explanation":"smile AT somebody."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She blamed the delay ___ the courier company.","hint":"blame sth ___ sb","explanation":"blame something ON somebody = blame somebody FOR something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."}]}