{"id":"prepositions-0093","taskId":"prepositions","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m still waiting for a reply ___ my complaint.","hint":"reply ___ sth","explanation":"a reply TO a letter/complaint/question."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s not very friendly ___ his new colleagues.","hint":"friendly ___ sb","explanation":"friendly WITH somebody = on good terms; a friendly person is friendly TO others."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press joked ___ the politician\u0027s hat.","hint":"joke ___ sth","explanation":"joke ABOUT something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."}]}