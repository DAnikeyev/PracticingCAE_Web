{"id":"prepositions-0093","taskId":"prepositions","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please forgive me ___ interrupting.","hint":"forgive sb ___ sth","explanation":"forgive somebody FOR something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"with","accept":[],"options":["on","at","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"The manager had no option but to concur ___ the decision.","hint":"concur ___ = agree with","explanation":"\u0027Concur with\u0027 is the formal equivalent of \u0027agree with\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I haven\u0027t heard ___ my cousin since Christmas.","hint":"hear ___ sb (news)","explanation":"hear FROM somebody = get a letter/message from them."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."}]}