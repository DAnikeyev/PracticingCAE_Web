{"id":"prepositions-0093","taskId":"prepositions","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":["with","for","of","from"],"base":null,"keyword":null,"lead":null,"sentence":"The judge acquitted her ___ all charges.","hint":"acquit somebody ___ charges","explanation":"\u0027Acquit somebody of a charge\u0027 is the fixed legal pattern."},{"answer":"with","accept":[],"options":["to","with","at","on"],"base":null,"keyword":null,"lead":null,"sentence":"The manager had no option but to concur ___ the decision.","hint":"concur ___ = agree with","explanation":"\u0027Concur with\u0027 is the formal equivalent of \u0027agree with\u0027."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."}]}