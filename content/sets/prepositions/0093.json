{"id":"prepositions-0093","taskId":"prepositions","title":"Drill set 93","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"with","accept":[],"options":["by","for","to","with"],"base":null,"keyword":null,"lead":null,"sentence":"The sales team is under pressure to comply ___ the new regulations.","hint":"comply ___ rules","explanation":"\u0027Comply with\u0027 = act in accordance with rules or standards."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press joked ___ the politician\u0027s hat.","hint":"joke ___ sth","explanation":"joke ABOUT something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ashamed ___ their behaviour at the match.","hint":"ashamed ___ sth","explanation":"ashamed OF something/doing something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s always cared deeply ___ animal welfare.","hint":"care ___ sth (be concerned)","explanation":"care ABOUT = think it matters; care FOR = look after or like."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Detectives are still searching ___ the missing painting.","hint":"search ___ sth (look for)","explanation":"search FOR something you want to find; search a place = look through it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Be kind ___ your little brother.","hint":"kind ___ sb","explanation":"kind TO somebody."}]}