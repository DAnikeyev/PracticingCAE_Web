{"id":"prepositions-0159","taskId":"prepositions","title":"Drill set 159","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You should concentrate ___ one task at a time.","hint":"concentrate ___ sth","explanation":"concentrate ON something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The government raised the tax ___ cigarettes again.","hint":"tax ___ sth","explanation":"a tax ON something."},{"answer":"with","accept":[],"options":["with","from","by","of"],"base":null,"keyword":null,"lead":null,"sentence":"The lake teems ___ trout in early summer.","hint":"teem ___ = be full of","explanation":"\u0027Teem with\u0027 = be full of living things moving about."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press joked ___ the politician\u0027s hat.","hint":"joke ___ sth","explanation":"joke ABOUT something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"with","accept":[],"options":["for","by","with","of"],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ driving without insurance.","hint":"charge somebody ___ something","explanation":"\u0027Charge somebody with an offence\u0027 \u2014 legal collocation."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Bamboo is a classic example ___ fast-growing plant.","hint":"example ___ sth","explanation":"an example OF something."}]}