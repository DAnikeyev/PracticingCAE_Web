{"id":"prepositions-0159","taskId":"prepositions","title":"Drill set 159","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":["at","from","to","with"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not familiar ___ this software yet.","hint":"familiar ___ something","explanation":"\u0027Familiar with\u0027 = knowing something well."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."},{"answer":"on","accept":[],"options":["on","to","at","for"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal herself.","hint":"insist ___ \u002B -ing","explanation":"\u0027Insist on doing something\u0027 \u2014 fixed preposition."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m going to apply ___ that job in Rotterdam.","hint":"apply ___ a job","explanation":"apply FOR a job; apply TO a company/university."},{"answer":"with","accept":[],"options":["from","of","by","with"],"base":null,"keyword":null,"lead":null,"sentence":"The lake teems ___ trout in early summer.","hint":"teem ___ = be full of","explanation":"\u0027Teem with\u0027 = be full of living things moving about."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s perfectly capable ___ managing the project alone.","hint":"capable ___ doing","explanation":"capable OF doing something."}]}