{"id":"prepositions-0109","taskId":"prepositions","title":"Drill set 109","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["in","at","on","to"],"base":null,"keyword":null,"lead":null,"sentence":"The whole project hinges ___ council approval.","hint":"hinge ___ = depend on","explanation":"\u0027Hinge on\u0027 = depend entirely on something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project failed through a lack ___ funding.","hint":"lack ___ sth","explanation":"a lack OF something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"for","accept":[],"options":["of","for","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s responsible ___ training the new staff.","hint":"responsible ___ doing something","explanation":"\u0027Responsible for\u0027 = in charge of."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m going to apply ___ that job in Rotterdam.","hint":"apply ___ a job","explanation":"apply FOR a job; apply TO a company/university."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Our picnic depends ___ the weather.","hint":"depend ___","explanation":"depend ON (upon in formal style)."},{"answer":"on","accept":[],"options":["at","on","by","in"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."}]}