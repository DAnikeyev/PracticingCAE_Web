{"id":"prepositions-0101","taskId":"prepositions","title":"Drill set 101","text":null,"source":"drill","gaps":[{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Critics attacked the film ___ its slow pace.","hint":"criticise sth ___ sth","explanation":"criticise/criticize something FOR a reason."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Two prisoners escaped ___ the high-security wing.","hint":"escape ___ a place","explanation":"escape FROM a place (American English also allows a bare object)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."}]}