{"id":"prepositions-0046","taskId":"prepositions","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"of","accept":[],"options":["with","to","about","of"],"base":null,"keyword":null,"lead":null,"sentence":"This perfume always reminds me ___ my grandmother.","hint":"remind somebody ___ something","explanation":"\u0027Remind somebody of something\u0027 = make them think of it."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re really looking forward ___ the trip.","hint":"look forward ___","explanation":"look forward TO \u2014 \u0027to\u0027 is a preposition here, so it is followed by -ing: looking forward to seeing you."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"on","accept":[],"options":["from","with","of","on"],"base":null,"keyword":null,"lead":null,"sentence":"The outcome depends ___ the weather, as always.","hint":"depend ___","explanation":"\u0027Depend on/upon\u0027 \u2014 never \u0027depend of\u0027."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s completely serious ___ becoming a chef.","hint":"serious ___ sth","explanation":"serious ABOUT something/doing something."}]}