{"id":"prepositions-0079","taskId":"prepositions","title":"Drill set 79","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They grew suspicious ___ his constant absences.","hint":"suspicious ___ sth/sb","explanation":"suspicious OF somebody/something."},{"answer":"of","accept":["from"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He died ___ pneumonia in 1947.","hint":"die ___ an illness","explanation":"die OF (or FROM) an illness/cause."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Further research ___ the disease is needed.","hint":"research ___ sth","explanation":"research INTO a subject (less commonly \u0027on\u0027)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m sick ___ hearing that song on the radio.","hint":"sick ___ sth (annoyed)","explanation":"sick OF something = fed up with it."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Bamboo is a classic example ___ fast-growing plant.","hint":"example ___ sth","explanation":"an example OF something."}]}