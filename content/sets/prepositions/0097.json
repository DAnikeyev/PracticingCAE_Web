{"id":"prepositions-0097","taskId":"prepositions","title":"Drill set 97","text":null,"source":"drill","gaps":[{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel was translated ___ twelve languages.","hint":"translate ___ a language","explanation":"translate FROM one language INTO another."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"about","accept":["of"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Have you heard ___ the artist who paints with coffee?","hint":"hear ___ (be told)","explanation":"hear ABOUT = be told about; hear OF = know of the existence; hear FROM = receive news from."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"on","accept":[],"options":["at","on","by","in"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The surgeon operated ___ the patient for four hours.","hint":"operate ___ sb","explanation":"operate ON a patient (for a condition)."}]}