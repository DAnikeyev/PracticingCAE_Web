{"id":"prepositions-0097","taskId":"prepositions","title":"Drill set 97","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everyone laughed ___ his impression of the headmaster.","hint":"laugh ___ sth","explanation":"laugh AT something/somebody."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Further research ___ the disease is needed.","hint":"research ___ sth","explanation":"research INTO a subject (less commonly \u0027on\u0027)."},{"answer":"with","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m getting bored ___ watching the same series.","hint":"bored ___ sth","explanation":"bored WITH (or BY) something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m nervous ___ speaking in public.","hint":"nervous ___ sth","explanation":"nervous ABOUT something/doing something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Two prisoners escaped ___ the high-security wing.","hint":"escape ___ a place","explanation":"escape FROM a place (American English also allows a bare object)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Staff must always be polite ___ customers.","hint":"polite ___ sb","explanation":"polite TO somebody."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She glanced ___ her watch and stood up.","hint":"glance ___ sth","explanation":"glance AT = look quickly at."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Fast charging is a big advantage ___ this model.","hint":"advantage ___ sth","explanation":"the advantage OF something (for somebody)."}]}