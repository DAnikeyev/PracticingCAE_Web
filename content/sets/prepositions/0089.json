{"id":"prepositions-0089","taskId":"prepositions","title":"Drill set 89","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Doctors say stress is a major cause ___ insomnia.","hint":"cause ___ sth","explanation":"the cause OF something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking ___ my keys \u2014 have you seen them?","hint":"look ___ = search","explanation":"look FOR = try to find."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project failed through a lack ___ funding.","hint":"lack ___ sth","explanation":"a lack OF something."}]}