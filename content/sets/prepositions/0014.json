{"id":"prepositions-0014","taskId":"prepositions","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She glanced ___ her watch and stood up.","hint":"glance ___ sth","explanation":"glance AT = look quickly at."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I strongly disapprove ___ smoking indoors.","hint":"disapprove ___ sth","explanation":"disapprove OF something (opposite: approve of)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It never occurred ___ me to check the address.","hint":"occur ___ sb (come to mind)","explanation":"it occurred TO somebody = they thought of it."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The high wall prevents outsiders ___ entering the garden.","hint":"prevent sb ___ doing","explanation":"prevent/stop somebody FROM doing something (\u0027from\u0027 is optional after stop)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They congratulated her ___ passing her driving test.","hint":"congratulate sb ___ sth","explanation":"congratulate somebody ON an achievement."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The region is famous ___ its cheese.","hint":"famous ___ sth","explanation":"famous FOR something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal.","hint":"insist ___ \u002B -ing","explanation":"insist ON something/doing something."}]}