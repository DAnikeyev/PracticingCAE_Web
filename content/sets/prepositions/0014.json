{"id":"prepositions-0014","taskId":"prepositions","title":"Drill set 14","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her style is similar ___ her sister\u0027s.","hint":"similar ___ sth","explanation":"similar TO something (never \u0027than\u0027)."},{"answer":"after","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Could you look ___ my plants while I\u0027m away?","hint":"look ___ = take care of","explanation":"look AFTER somebody/something = take care of them."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Plastic waste is a serious threat ___ marine life.","hint":"threat ___ sth/sb","explanation":"a threat TO somebody/something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"to","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They were grateful ___ the firefighters for their quick response.","hint":"grateful ___ sb ___ sth (first gap)","explanation":"grateful TO somebody FOR something. Only the first gap is checked here."},{"answer":"of","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She often dreams ___ running her own caf\u00E9.","hint":"dream ___ (imagine)","explanation":"dream OF/ABOUT something you would love to happen."},{"answer":"about","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was upset ___ losing his keys.","hint":"upset ___ sth","explanation":"upset ABOUT something (BY also possible)."}]}