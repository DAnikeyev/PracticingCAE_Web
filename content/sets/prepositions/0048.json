{"id":"prepositions-0048","taskId":"prepositions","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"in","accept":["with"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She had no difficulty ___ finding the station.","hint":"difficulty ___ doing","explanation":"have difficulty (IN) doing something \u2014 \u0027in\u0027 is often omitted, but is the expected preposition."},{"answer":"at","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Viewers were shocked ___ the violence in the film.","hint":"shocked ___ sth","explanation":"shocked AT/BY something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Who is responsible ___ locking up?","hint":"responsible ___ sth","explanation":"responsible FOR something/doing something."},{"answer":"from","accept":["against"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Sunscreen protects the skin ___ UV rays.","hint":"protect ___ sth harmful","explanation":"protect somebody/something FROM (or AGAINST) harm."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"with","accept":["among"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This app is very popular ___ teenagers.","hint":"popular ___ sb","explanation":"popular WITH (or AMONG) a group."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re really looking forward ___ the trip.","hint":"look forward ___","explanation":"look forward TO \u2014 \u0027to\u0027 is a preposition here, so it is followed by -ing: looking forward to seeing you."}]}