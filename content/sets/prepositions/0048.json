{"id":"prepositions-0048","taskId":"prepositions","title":"Drill set 48","text":null,"source":"drill","gaps":[{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"of","accept":["from"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He died ___ pneumonia in 1947.","hint":"die ___ an illness","explanation":"die OF (or FROM) an illness/cause."},{"answer":"of","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She often dreams ___ running her own caf\u00E9.","hint":"dream ___ (imagine)","explanation":"dream OF/ABOUT something you would love to happen."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I much prefer coffee ___ tea.","hint":"prefer A ___ B","explanation":"prefer A TO B (never \u0027than\u0027)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m going to apply ___ that job in Rotterdam.","hint":"apply ___ a job","explanation":"apply FOR a job; apply TO a company/university."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It never occurred ___ me to check the address.","hint":"occur ___ sb (come to mind)","explanation":"it occurred TO somebody = they thought of it."}]}