{"id":"prepositions-0059","taskId":"prepositions","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["at","on","in","by"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The puppies were scared ___ fireworks.","hint":"scared ___ sth","explanation":"scared OF something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The minister refused to comment ___ the scandal.","hint":"comment ___ sth","explanation":"comment ON a topic."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"with","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This textbook is boring compared ___ the last one.","hint":"compared ___","explanation":"compare WITH (or TO) \u2014 \u0027with\u0027 is preferred for comparing similarities/differences; \u0027to\u0027 for \u0027liken\u0027."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The novel was translated ___ twelve languages.","hint":"translate ___ a language","explanation":"translate FROM one language INTO another."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"with","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m getting bored ___ watching the same series.","hint":"bored ___ sth","explanation":"bored WITH (or BY) something."}]}