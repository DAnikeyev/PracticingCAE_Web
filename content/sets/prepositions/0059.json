{"id":"prepositions-0059","taskId":"prepositions","title":"Drill set 59","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s terrified ___ spiders.","hint":"terrified ___","explanation":"terrified OF something."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The results differ sharply ___ last year\u0027s.","hint":"differ ___ sth","explanation":"differ FROM something (one thing differs from another); differ WITH = disagree."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry ___ the exam \u2014 you\u0027re well prepared.","hint":"worry ___ sth","explanation":"worry ABOUT somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"for","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m so sorry ___ the confusion I caused.","hint":"sorry ___ sth done","explanation":"sorry FOR/ABOUT something you did; sorry FOR somebody = pity them."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We rely ___ public transport to get to work.","hint":"rely ___ sb/sth","explanation":"rely ON (upon) somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re excited ___ our trip to Peru.","hint":"excited ___ sth","explanation":"excited ABOUT something."}]}