{"id":"prepositions-0081","taskId":"prepositions","title":"Drill set 81","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s very good ___ solving puzzles.","hint":"good ___ doing","explanation":"good/bad/brilliant AT an activity."},{"answer":"on","accept":[],"options":["to","at","on","for"],"base":null,"keyword":null,"lead":null,"sentence":"She insisted ___ paying for the meal herself.","hint":"insist ___ \u002B -ing","explanation":"\u0027Insist on doing something\u0027 \u2014 fixed preposition."},{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"to","accept":[],"options":["for","at","to","with"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m really looking forward ___ the holiday.","hint":"look forward ___","explanation":"\u0027Look forward to\u0027 \u2014 \u0027to\u0027 is a preposition here."},{"answer":"about","accept":["about"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m a bit anxious ___ the results.","hint":"anxious ___ sth (worried)","explanation":"anxious ABOUT something = worried about it."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"to","accept":[],"options":["with","about","for","to"],"base":null,"keyword":null,"lead":null,"sentence":"She was completely oblivious ___ the commotion outside.","hint":"oblivious ___ = unaware of","explanation":"\u0027Oblivious to\u0027 is the standard collocation meaning unaware of."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Please don\u0027t shout ___ the children.","hint":"shout ___ sb (angrily)","explanation":"shout AT somebody = be aggressive; shout TO = call so they hear."}]}