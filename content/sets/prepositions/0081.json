{"id":"prepositions-0081","taskId":"prepositions","title":"Drill set 81","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manager was pleased ___ our progress.","hint":"pleased ___ sth/sb","explanation":"pleased WITH somebody/something."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ the airport two hours early.","hint":"arrive ___ (place), ___ (city)","explanation":"arrive AT a point (airport, hotel), IN a city/country."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Advertising has a huge influence ___ children.","hint":"influence ___ sb","explanation":"have an influence ON somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Water consists ___ two hydrogen atoms and one oxygen atom.","hint":"consist ___ (be made of)","explanation":"consist OF = be made of. Compare \u0027consist in\u0027 (= have as its essence), rare."},{"answer":"of","accept":["from"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He died ___ pneumonia in 1947.","hint":"die ___ an illness","explanation":"die OF (or FROM) an illness/cause."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re not entirely satisfied ___ the service.","hint":"satisfied ___ sth","explanation":"satisfied WITH something."}]}