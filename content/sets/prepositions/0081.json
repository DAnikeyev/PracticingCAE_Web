{"id":"prepositions-0081","taskId":"prepositions","title":"Drill set 81","text":null,"source":"drill","gaps":[{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Is there any excuse ___ being so rude?","hint":"excuse ___ sth","explanation":"an excuse FOR something/doing something."},{"answer":"on","accept":[],"options":["on","in","by","at"],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"based ___","explanation":"\u0027Based on\u0027 = developed from."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum donated the paintings ___ a local school.","hint":"donate sth ___ sb","explanation":"donate something TO a person/organisation."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Over two hundred athletes participated ___ the marathon.","hint":"participate ___ sth","explanation":"participate IN an event (also: take part in)."},{"answer":"from","accept":[],"options":["with","from","at","on"],"base":null,"keyword":null,"lead":null,"sentence":"Local traders have benefited enormously ___ the new footfall.","hint":"benefit ___ an advantage","explanation":"\u0027Benefit from\u0027 = gain an advantage from something."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve invited us ___ their wedding in May.","hint":"invite sb ___ sth","explanation":"invite somebody TO an event."}]}