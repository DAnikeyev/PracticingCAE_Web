{"id":"prepositions-0146","taskId":"prepositions","title":"Drill set 146","text":null,"source":"drill","gaps":[{"answer":"between","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s a direct connection ___ diet and mood.","hint":"connection ___ A and B","explanation":"a connection/link BETWEEN two things."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Three workers were involved ___ the accident.","hint":"involved ___ sth","explanation":"be involved IN an activity/accident."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Police suspect him ___ faking the documents.","hint":"suspect sb ___ sth","explanation":"suspect somebody OF something/doing something."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The press launched an attack ___ the minister\u0027s record.","hint":"attack ___ sb/sth (noun)","explanation":"an attack ON somebody/something."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They provided us ___ everything we needed.","hint":"provide sb ___ sth","explanation":"provide somebody WITH something, or provide something FOR somebody."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Were you aware ___ the change of plan?","hint":"aware ___ sth","explanation":"aware OF something."},{"answer":"from","accept":[],"options":["with","by","of","from"],"base":null,"keyword":null,"lead":null,"sentence":"She suffered ___ migraines for years before the surgery.","hint":"suffer ___ an illness","explanation":"\u0027Suffer from\u0027 an illness or condition."}]}