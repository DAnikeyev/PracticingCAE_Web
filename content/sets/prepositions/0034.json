{"id":"prepositions-0034","taskId":"prepositions","title":"Drill set 34","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Several parents objected ___ the new timetable.","hint":"object ___ sth","explanation":"object TO something."},{"answer":"to","accept":["towards"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"His attitude ___ work has really improved.","hint":"attitude ___ sth","explanation":"attitude TO (or TOWARDS) something."},{"answer":"with","accept":["about","at"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was disappointed ___ his exam results.","hint":"disappointed ___ sth/sb","explanation":"disappointed WITH somebody, WITH/ABOUT something."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The kids are crazy ___ the new video game.","hint":"crazy ___ sth (love)","explanation":"crazy ABOUT something = love it enthusiastically."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re hoping ___ the best results this season.","hint":"hope ___ sth (want)","explanation":"hope FOR something = want and expect it."},{"answer":"at","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He pointed ___ the tallest tower in the skyline.","hint":"point ___ sth","explanation":"point AT/TO something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film had an immediate effect ___ audiences.","hint":"effect ___ sth","explanation":"have an effect ON somebody/something."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very fond ___ her nieces.","hint":"fond ___ sb/sth","explanation":"fond OF somebody/something."}]}