{"id":"prepositions-0034","taskId":"prepositions","title":"Drill set 34","text":null,"source":"drill","gaps":[{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lorry crashed ___ the back of the bus.","hint":"crash ___ sth","explanation":"crash INTO something solid (hit it)."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was found guilty ___ fraud.","hint":"guilty ___ sth","explanation":"guilty OF a crime."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Be kind ___ your little brother.","hint":"kind ___ sb","explanation":"kind TO somebody."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve been waiting ___ the bus for half an hour.","hint":"wait ___ sb/sth","explanation":"wait FOR somebody/something."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s been a sharp increase ___ energy prices.","hint":"increase ___ sth (noun)","explanation":"an increase IN a quantity (verb: increase BY an amount)."},{"answer":"with","accept":[],"options":["up","for","to","with"],"base":null,"keyword":null,"lead":null,"sentence":"His account of the accident tallies ___ the CCTV footage.","hint":"tally ___ = match","explanation":"\u0027Tally with\u0027 = correspond exactly to something else."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They accused him ___ lying to the committee.","hint":"accuse sb ___ sth","explanation":"accuse somebody OF something/doing something."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You should concentrate ___ one task at a time.","hint":"concentrate ___ sth","explanation":"concentrate ON something."}]}