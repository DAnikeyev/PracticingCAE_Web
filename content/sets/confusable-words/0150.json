{"id":"confusable-words-0150","taskId":"confusable-words","title":"Drill set 150","text":null,"source":"drill","gaps":[{"answer":"than","accept":[],"options":["then","than","there","that"],"base":null,"keyword":null,"lead":null,"sentence":"It costs more ___ I expected.","hint":"used for comparisons","explanation":"\u0027Than\u0027 is used in comparisons; \u0027then\u0027 refers to time or consequence."},{"answer":"remember","accept":[],"options":["reminder","remember","memorable","remind"],"base":null,"keyword":null,"lead":null,"sentence":"I ___ seeing that man somewhere before.","hint":"recall a memory","explanation":"\u0027Remember doing\u0027 = recall; \u0027remind\u0027 needs an object."},{"answer":"Who\u0027s","accept":[],"options":["Whom","Whose","Who","Who\u0027s"],"base":null,"keyword":null,"lead":null,"sentence":"___ coming to the party tonight?","hint":"short for \u0027Who is\u0027","explanation":"\u0027Who\u0027s\u0027 is short for \u0027who is\u0027; \u0027whose\u0027 asks about possession."},{"answer":"complimented","accept":[],"options":["complemented","complimented","complement","complimentary"],"base":null,"keyword":null,"lead":null,"sentence":"He ___ her on her presentation and her handling of questions.","hint":"verb: praised","explanation":"\u0027Compliment someone on something\u0027 = praise them."},{"answer":"loose","accept":[],"options":["lose","loose","loosened","loss"],"base":null,"keyword":null,"lead":null,"sentence":"One of the screws on the bracket has come ___.","hint":"adjective: not tight","explanation":"\u0027Come loose\u0027 = become not tight."},{"answer":"work","accept":[],"options":["work","occupation","career","job"],"base":null,"keyword":null,"lead":null,"sentence":"After graduating he struggled to find ___ for several months.","hint":"uncountable noun needed after \u0027find\u0027 here","explanation":"\u0027Work\u0027 is uncountable, so it fits after \u0027find\u0027 with no article; \u0027job\u0027 would need \u0027a job\u0027."},{"answer":"valuable","accept":[],"options":["invaluable","valuable","valued","evaluating"],"base":null,"keyword":null,"lead":null,"sentence":"The stolen painting was extremely ___.","hint":"worth a lot of money","explanation":"\u0027Valuable\u0027 means worth a lot of money; \u0027valued\u0027 means appreciated; \u0027invaluable\u0027 already means priceless, so it is not graded."},{"answer":"nearly","accept":[],"options":["near","nearly","nearby","close"],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ midnight when we finally arrived.","hint":"adverb of degree meaning almost","explanation":"\u0027Nearly\u0027 means almost; \u0027near\u0027 as a preposition needs a place object and cannot modify \u0027midnight\u0027."}]}