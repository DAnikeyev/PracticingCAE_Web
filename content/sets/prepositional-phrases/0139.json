{"id":"prepositional-phrases-0139","taskId":"prepositional-phrases","title":"Drill set 139","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manuscript came ___ light during the clearance of the archive.","hint":"come ___ light = be discovered","explanation":"\u0027Come to light\u0027 = become known or be discovered."},{"answer":"end","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme paid off in the ___ \u2014 we recouped every euro.","hint":"finally","explanation":"\u0027In the end\u0027 = eventually, after everything."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Given the budget, a new stadium is ___ of the question.","hint":"___ of the question = impossible","explanation":"\u0027Out of the question\u0027 = not even worth considering.\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."}]}