{"id":"prepositional-phrases-0080","taskId":"prepositional-phrases","title":"Drill set 80","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme was abandoned ___ lack of interest.","hint":"because of (formal)","explanation":"\u0027for lack of\u0027 = because there was none."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded ___ of all expectations.","hint":"further than expected","explanation":"\u0027beyond all expectations\u0027 = better than anyone predicted."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The proposal was rejected ___ a single vote.","hint":"margin of defeat","explanation":"\u0027by a single vote / by two goals\u0027 \u2014 the margin takes \u0027by\u0027."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."}]}