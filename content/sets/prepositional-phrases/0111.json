{"id":"prepositional-phrases-0111","taskId":"prepositional-phrases","title":"Drill set 111","text":null,"source":"drill","gaps":[{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They kept the negotiation ___ wraps until the deal was signed.","hint":"___ wraps = secret","explanation":"\u0027keep something under wraps\u0027 = keep it secret."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"end","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme paid off in the ___ \u2014 we recouped every euro.","hint":"finally","explanation":"\u0027In the end\u0027 = eventually, after everything."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The missing files are still ___ investigation.","hint":"being examined","explanation":"\u0027Under investigation\u0027 = being officially examined."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."}]}