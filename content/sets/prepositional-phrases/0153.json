{"id":"prepositional-phrases-0153","taskId":"prepositional-phrases","title":"Drill set 153","text":null,"source":"drill","gaps":[{"answer":"over","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The matter went completely ___ my head \u2014 I cannot recall a thing.","hint":"too difficult to understand","explanation":"\u0027Over one\u0027s head\u0027 = too complicated to understand."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ all appearances, the house had stood empty for years.","hint":"___ all appearances = judging by looks","explanation":"\u0027To all appearances\u0027 = as far as one can tell from looking."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"under","accept":[],"opt