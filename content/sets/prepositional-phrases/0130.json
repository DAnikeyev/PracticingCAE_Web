{"id":"prepositional-phrases-0130","taskId":"prepositional-phrases","title":"Drill set 130","text":null,"source":"drill","gaps":[{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"short","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The venue was changed at ___ notice, just two days before.","hint":"at ___ notice = with little warning","explanation":"\u0027At short notice\u0027 = only a short time before."},{"answer":"owing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme was abandoned ___ to a total lack of funds.","hint":"___ to = because of","explanation":"\u0027Owing to a lack of funds\u0027 = because of the lack.\u0027"},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soldiers were ___ of danger once they had crossed the river.","hint":"___ of danger = safe","explanation":"\u0027Out of danger\u0027 = no longer at risk."}]}