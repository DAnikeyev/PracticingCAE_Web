{"id":"prepositional-phrases-0160","taskId":"prepositional-phrases","title":"Drill set 160","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They kept the negotiation ___ wraps until the deal was signed.","hint":"___ wraps = secret","explanation":"\u0027keep something under wraps\u0027 = keep it secret."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ his credit, he apologised immediately.","hint":"to his credit = in his favour","explanation":"\u0027to somebody\u0027s credit\u0027 \u2014 something in their favour."}]}