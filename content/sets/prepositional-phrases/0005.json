{"id":"prepositional-phrases-0005","taskId":"prepositional-phrases","title":"Drill set 5","text":null,"source":"drill","gaps":[{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The proposal was rejected ___ a single vote.","hint":"margin of defeat","explanation":"\u0027by a single vote / by two goals\u0027 \u2014 the margin takes \u0027by\u0027."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."}]}