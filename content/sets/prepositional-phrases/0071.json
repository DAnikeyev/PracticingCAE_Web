{"id":"prepositional-phrases-0071","taskId":"prepositional-phrases","title":"Drill set 71","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The negotiations broke down ___ the very brink of success.","hint":"___ the brink of","explanation":"\u0027on the brink of\u0027 = on the point of."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The decision was taken ___ my behalf while I was away.","hint":"for someone, in their place","explanation":"\u0027on somebody\u0027s behalf\u0027 = in their interest or place."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded ___ of all expectations.","hint":"further than expected","explanation":"\u0027beyond all expectations\u0027 = better than anyone predicted."}]}