{"id":"prepositional-phrases-0071","taskId":"prepositional-phrases","title":"Drill set 71","text":null,"source":"drill","gaps":[{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first glance, the deal looks generous.","hint":"on quick inspection","explanation":"\u0027At first glance\u0027 = when first looked at quickly."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"practice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team is out of ___ after the long break.","hint":"rusty from not doing it","explanation":"\u0027Out of practice\u0027 = having lost skill through lack of use."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."}]}