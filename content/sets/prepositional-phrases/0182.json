{"id":"prepositional-phrases-0182","taskId":"prepositional-phrases","title":"Drill set 182","text":null,"source":"drill","gaps":[{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"practice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team is out of ___ after the long break.","hint":"rusty from not doing it","explanation":"\u0027Out of practice\u0027 = having lost skill through lack of use."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ the phone all morning with suppliers.","hint":"using the phone","explanation":"\u0027On the phone\u0027 = using it for a call."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"hurry","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m in no ___ \u2014 take your time deciding.","hint":"in no ___ = not rushed","explanation":"\u0027In no hurry\u0027 = willing to wait."}]}