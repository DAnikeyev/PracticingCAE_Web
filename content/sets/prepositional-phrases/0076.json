{"id":"prepositional-phrases-0076","taskId":"prepositional-phrases","title":"Drill set 76","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She resigned ___ the grounds of ill health.","hint":"___ the grounds of = because of","explanation":"\u0027on the grounds of\u0027 = for the reason of."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."}]}