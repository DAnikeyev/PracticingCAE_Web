{"id":"prepositional-phrases-0083","taskId":"prepositional-phrases","title":"Drill set 83","text":null,"source":"drill","gaps":[{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first glance, the deal looks generous.","hint":"on quick inspection","explanation":"\u0027At first glance\u0027 = when first looked at quickly."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."}]}