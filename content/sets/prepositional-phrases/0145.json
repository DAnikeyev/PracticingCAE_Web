{"id":"prepositional-phrases-0145","taskId":"prepositional-phrases","title":"Drill set 145","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"respects","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two versions differ in several ___ ; the ending is the biggest.","hint":"in several ___ = in several ways","explanation":"\u0027In several respects\u0027 = in several aspects."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Given the budget, a new stadium is ___ of the question.","hint":"___ of the question = impossible","explanation":"\u0027Out of the question\u0027 = not even worth considering.\u0027"},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"short","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The venue was changed at ___ notice, just two days before.","hint":"at ___ notice = with little warning","explanation":"\u0027At short notice\u0027 = only a short time before."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"}]}