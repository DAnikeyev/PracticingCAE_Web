{"id":"prepositional-phrases-0120","taskId":"prepositional-phrases","title":"Drill set 120","text":null,"source":"drill","gaps":[{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees were admitted ___ the country on humanitarian grounds.","hint":"admitted ___ a place","explanation":"admitted INTO a place/country."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."}]}