{"id":"prepositional-phrases-0120","taskId":"prepositional-phrases","title":"Drill set 120","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I did it ___ my own initiative \u2014 nobody asked me.","hint":"___ one\u0027s own initiative","explanation":"\u0027of one\u0027s own initiative\u0027 = without being asked."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The album went straight ___ number one in the charts.","hint":"straight ___ number one","explanation":"\u0027Go straight to number one\u0027 = reach the top position immediately."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"},{"answer":"charge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s in ___ of the marketing team of twelve.","hint":"responsible for","explanation":"\u0027In charge of\u0027 = responsible for controlling."},{"answer":"Through","accept":["By"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ good fortune, nobody was hurt in the collapse.","hint":"thanks to / because of (chance)","explanation":"\u0027through good fortune\u0027 = by means of luck."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"senten