{"id":"prepositional-phrases-0168","taskId":"prepositional-phrases","title":"Drill set 168","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee met ___ private before making its announcement.","hint":"___ private = not publicly","explanation":"\u0027In private\u0027 = without the public present.\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The evidence establishes guilt ___ reasonable doubt.","hint":"past a limit","explanation":"\u0027Beyond reasonable doubt\u0027 \u2014 the legal standard of proof."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first, the plan sounded ridiculous \u2014 then it grew on us.","hint":"___ first = initially","explanation":"\u0027At first\u0027 = in the beginning (contrast with \u0027first\u0027 = before anything else)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She resigned ___ the grounds of ill health.","hint":"___ the grounds of = because of","explanation":"\u0027on the grounds of\u0027 = for the reason of."}]}