{"id":"prepositional-phrases-0023","taskId":"prepositional-phrases","title":"Drill set 23","text":null,"source":"drill","gaps":[{"answer":"accordance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The decisions were taken in ___ with company policy.","hint":"in ___ with = following the rules","explanation":"\u0027In accordance with\u0027 = in agreement with a rule or request."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ theory the plan is sound; in practice it fails.","hint":"in principle","explanation":"\u0027In theory\u0027 contrasts the idea with reality."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first, the plan sounded ridiculous \u2014 then it grew on us.","hint":"___ first = initially","explanation":"\u0027At first\u0027 = in the beginning (contrast with \u0027first\u0027 = before anything else)."}]}