{"id":"prepositional-phrases-0068","taskId":"prepositional-phrases","title":"Drill set 68","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She resigned ___ the grounds of ill health.","hint":"___ the grounds of = because of","explanation":"\u0027on the grounds of\u0027 = for the reason of."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The proposal was rejected ___ a single vote.","hint":"margin of defeat","explanation":"\u0027by a single vote / by two goals\u0027 \u2014 the margin takes \u0027by\u0027."}]}