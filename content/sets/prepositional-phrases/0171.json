{"id":"prepositional-phrases-0171","taskId":"prepositional-phrases","title":"Drill set 171","text":null,"source":"drill","gaps":[{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ all appearances, the house had stood empty for years.","hint":"___ all appearances = judging by looks","explanation":"\u0027To all appearances\u0027 = as far as one can tell from looking."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"accounts","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By all ___ , the festival was a triumph this year.","hint":"by all ___ = everyone says","explanation":"\u0027By all accounts\u0027 = according to what people say."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They kept the negotiation ___ wraps until the deal was signed.","hint":"___ wraps = secret","explanation":"\u0027keep something under wraps\u0027 = keep it secret."}]}