{"id":"prepositional-phrases-0002","taskId":"prepositional-phrases","title":"Drill set 2","text":null,"source":"drill","gaps":[{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded ___ of all expectations.","hint":"further than expected","explanation":"\u0027beyond all expectations\u0027 = better than anyone predicted."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re ___ the impression that the offer had expired.","hint":"___ the impression = believing","explanation":"\u0027under the impression that\u2026\u0027 = believing, often wrongly."},{"answer":"Through","accept":["By"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ good fortune, nobody was hurt in the collapse.","hint":"thanks to / because of (chance)","explanation":"\u0027through good fortune\u0027 = by means of luck."}]}