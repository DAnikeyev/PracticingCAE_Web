{"id":"prepositional-phrases-0157","taskId":"prepositional-phrases","title":"Drill set 157","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no harm ___ trying once more.","hint":"no harm ___ doing","explanation":"\u0027No harm in trying\u0027 = it costs nothing to try.\u0027"},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The original manuscript is ___ permanent display in Vienna.","hint":"___ display","explanation":"\u0027on display\u0027 = being shown to the public."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"}]}