{"id":"prepositional-phrases-0141","taskId":"prepositional-phrases","title":"Drill set 141","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"},{"answer":"With","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the exception of the organ, every instrument in the chapel is original.","hint":"fixed phrase: ___ the exception of","explanation":"\u0027With the exception of\u0027 = apart from."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new hall is ___ far the largest building on campus.","hint":"___ far = definitely","explanation":"\u0027By far\u0027 strengthens a superlative: by far the largest."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ any rate, we still have enough time.","hint":"in any case","explanation":"\u0027At any rate\u0027 = whatever else is true."}]}