{"id":"prepositional-phrases-0007","taskId":"prepositional-phrases","title":"Drill set 7","text":null,"source":"drill","gaps":[{"answer":"event","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"In the ___ of a fire, use the stairs, not the lift.","hint":"in the ___ of = if it happens","explanation":"\u0027In the event of\u0027 = if a particular thing happens."},{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"hurry","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m in no ___ \u2014 take your time deciding.","hint":"in no ___ = not rushed","explanation":"\u0027In no hurry\u0027 = willing to wait."},{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The neighbours complained ___ the noise until dawn.","hint":"complain ___ sth (first gap)","explanation":"complain ABOUT something; \u0027in the small hours\u0027 = after midnight. Only the first gap is checked."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."}]}