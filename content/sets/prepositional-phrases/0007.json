{"id":"prepositional-phrases-0007","taskId":"prepositional-phrases","title":"Drill set 7","text":null,"source":"drill","gaps":[{"answer":"hurry","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m in no ___ \u2014 take your time deciding.","hint":"in no ___ = not rushed","explanation":"\u0027In no hurry\u0027 = willing to wait."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The manuscript came ___ light during the clearance of the archive.","hint":"come ___ light = be discovered","explanation":"\u0027Come to light\u0027 = become known or be discovered."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The surgeons operated ___ the light of head-torches when the power failed.","hint":"___ the light of","explanation":"\u0027By the light of\u0027 = using the light from something."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."}]}