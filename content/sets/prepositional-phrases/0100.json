{"id":"prepositional-phrases-0100","taskId":"prepositional-phrases","title":"Drill set 100","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The tickets sold out ___ a matter of hours.","hint":"within a short period","explanation":"\u0027in a matter of hours\u0027 = within only a few hours."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her latest novel is ___ far her best.","hint":"___ far = by a large margin","explanation":"\u0027by far\u0027 = by a big margin, with superlatives."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ his credit, he apologised immediately.","hint":"to his credit = in his favour","explanation":"\u0027to somebody\u0027s credit\u0027 \u2014 something in their favour."}]}