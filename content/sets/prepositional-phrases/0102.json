{"id":"prepositional-phrases-0102","taskId":"prepositional-phrases","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They kept the negotiation ___ wraps until the deal was signed.","hint":"___ wraps = secret","explanation":"\u0027keep something under wraps\u0027 = keep it secret."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The negotiations broke down ___ the very brink of success.","hint":"___ the brink of","explanation":"\u0027on the brink of\u0027 = on the point of."}]}