{"id":"prepositional-phrases-0102","taskId":"prepositional-phrases","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company collapsed ___ a pile of debts.","hint":"crushed by weight (figurative)","explanation":"\u0027under a pile/mountain of debt\u0027 \u2014 \u0027under\u0027 for crushing weight, literal or figurative."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I did it ___ my own initiative \u2014 nobody asked me.","hint":"___ one\u0027s own initiative","explanation":"\u0027of one\u0027s own initiative\u0027 = without being asked."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null