{"id":"prepositional-phrases-0143","taskId":"prepositional-phrases","title":"Drill set 143","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I did it ___ my own initiative \u2014 nobody asked me.","hint":"___ one\u0027s own initiative","explanation":"\u0027of one\u0027s own initiative\u0027 = without being asked."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees were admitted ___ the country on humanitarian grounds.","hint":"admitted ___ a place","explanation":"admitted INTO a place/country."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The proposal was rejected ___ a single vote.","hint":"margin of defeat","explanation":"\u0027by a single vote / by two goals\u0027 \u2014 the margin takes \u0027by\u0027."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The missing files are still ___ investigation.","hint":"being examined","explanation":"\u0027Under investigation\u0027 = being officially examined."}]}