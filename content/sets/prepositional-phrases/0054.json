{"id":"prepositional-phrases-0054","taskId":"prepositional-phrases","title":"Drill set 54","text":null,"source":"drill","gaps":[{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was left ___ the care of the neighbours.","hint":"entrusted to","explanation":"\u0027in the care of\u0027 = looked after by."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The negotiations broke down ___ the very brink of success.","hint":"___ the brink of","explanation":"\u0027on the brink of\u0027 = on the point of."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."}]}