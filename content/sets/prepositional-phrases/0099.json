{"id":"prepositional-phrases-0099","taskId":"prepositional-phrases","title":"Drill set 99","text":null,"source":"drill","gaps":[{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"With","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the exception of the organ, every instrument in the chapel is original.","hint":"fixed phrase: ___ the exception of","explanation":"\u0027With the exception of\u0027 = apart from."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She signed the confession ___ duress, according to her lawyers.","hint":"___ duress = forced by threats","explanation":"\u0027Under duress\u0027 = as a result of pressure or threats."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ any rate, we still have enough time.","hint":"in any case","explanation":"\u0027At any rate\u0027 = whatever else is true."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."}]}