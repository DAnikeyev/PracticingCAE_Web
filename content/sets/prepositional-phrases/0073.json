{"id":"prepositional-phrases-0073","taskId":"prepositional-phrases","title":"Drill set 73","text":null,"source":"drill","gaps":[{"answer":"accounts","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By all ___ , the festival was a triumph this year.","hint":"by all ___ = everyone says","explanation":"\u0027By all accounts\u0027 = according to what people say."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ the phone all morning with suppliers.","hint":"using the phone","explanation":"\u0027On the phone\u0027 = using it for a call."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The missing files are still ___ investigation.","hint":"being examined","explanation":"\u0027Under investigation\u0027 = being officially examined."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company collapsed ___ a pile of debts.","hint":"crushed by weight (figurative)","explanation":"\u0027under a pile/mountain of debt\u0027 \u2014 \u0027under\u0027 for crushing weight, literal or figurative."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"}]}