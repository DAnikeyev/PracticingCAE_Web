{"id":"prepositional-phrases-0134","taskId":"prepositional-phrases","title":"Drill set 134","text":null,"source":"drill","gaps":[{"answer":"respects","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two versions differ in several ___ ; the ending is the biggest.","hint":"in several ___ = in several ways","explanation":"\u0027In several respects\u0027 = in several aspects."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The album went straight ___ number one in the charts.","hint":"straight ___ number one","explanation":"\u0027Go straight to number one\u0027 = reach the top position immediately."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"With","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the exception of the organ, every instrument in the chapel is original.","hint":"fixed phrase: ___ the exception of","explanation":"\u0027With the exception of\u0027 = apart from."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new hall is ___ far the largest building on campus.","hint":"___ far = definitely","explanation":"\u0027By far\u0027 strengthens a superlative: by far the largest."}]}