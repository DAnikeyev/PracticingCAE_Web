{"id":"prepositional-phrases-0134","taskId":"prepositional-phrases","title":"Drill set 134","text":null,"source":"drill","gaps":[{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the meantime, please finish the paperwork.","hint":"while waiting","explanation":"\u0027In the meantime\u0027 = during the time before something happens."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There is no harm ___ trying once more.","hint":"no harm ___ doing","explanation":"\u0027No harm in trying\u0027 = it costs nothing to try.\u0027"},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The evidence establishes guilt ___ reasonable doubt.","hint":"past a limit","explanation":"\u0027Beyond reasonable doubt\u0027 \u2014 the legal standard of proof."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."}]}