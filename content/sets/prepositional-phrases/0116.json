{"id":"prepositional-phrases-0116","taskId":"prepositional-phrases","title":"Drill set 116","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ all appearances, the house had stood empty for years.","hint":"___ all appearances = judging by looks","explanation":"\u0027To all appearances\u0027 = as far as one can tell from looking."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees were admitted ___ the country on humanitarian grounds.","hint":"admitted ___ a place","explanation":"admitted INTO a place/country."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ return for her help, he offered her a share of the business.","hint":"as a reward","explanation":"\u0027In return for\u0027 = as an exchange for something given.\u0027"},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."}]}