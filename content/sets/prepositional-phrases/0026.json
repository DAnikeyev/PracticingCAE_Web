{"id":"prepositional-phrases-0026","taskId":"prepositional-phrases","title":"Drill set 26","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll be there ___ ten minutes at the latest.","hint":"after a period from now","explanation":"\u0027in ten minutes\u0027 = after ten minutes have passed."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The village is accessible only ___ foot.","hint":"travel mode: ___ foot","explanation":"\u0027on foot\u0027 = walking (never \u0027by foot\u0027 in careful usage)."},{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded ___ of all expectations.","hint":"further than expected","explanation":"\u0027beyond all expectations\u0027 = better than anyone predicted."}]}