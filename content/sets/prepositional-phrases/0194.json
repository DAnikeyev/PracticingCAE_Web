{"id":"prepositional-phrases-0194","taskId":"prepositional-phrases","title":"Drill set 194","text":null,"source":"drill","gaps":[{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"end","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme paid off in the ___ \u2014 we recouped every euro.","hint":"finally","explanation":"\u0027In the end\u0027 = eventually, after everything."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The firm was put ___ liquidation by the end of March.","hint":"formal insolvency phrase","explanation":"\u0027Put into liquidation\u0027 \u2014 the formal process of closing a company.\u0027"},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"