{"id":"prepositional-phrases-0021","taskId":"prepositional-phrases","title":"Drill set 21","text":null,"source":"drill","gaps":[{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ his credit, he apologised immediately.","hint":"to his credit = in his favour","explanation":"\u0027to somebody\u0027s credit\u0027 \u2014 something in their favour."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was left ___ the care of the neighbours.","hint":"entrusted to","explanation":"\u0027in the care of\u0027 = looked after by."}]}