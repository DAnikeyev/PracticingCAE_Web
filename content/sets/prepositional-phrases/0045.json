{"id":"prepositional-phrases-0045","taskId":"prepositional-phrases","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"charge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s in ___ of the marketing team of twelve.","hint":"responsible for","explanation":"\u0027In charge of\u0027 = responsible for controlling."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"short","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The venue was changed at ___ notice, just two days before.","hint":"at ___ notice = with little warning","explanation":"\u0027At short notice\u0027 = only a short time before."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, let us drive instead of taking the train.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having changed one\u0027s mind."}]}