{"id":"prepositional-phrases-0004","taskId":"prepositional-phrases","title":"Drill set 4","text":null,"source":"drill","gaps":[{"answer":"respects","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two versions differ in several ___ ; the ending is the biggest.","hint":"in several ___ = in several ways","explanation":"\u0027In several respects\u0027 = in several aspects."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"practice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The team is out of ___ after the long break.","hint":"rusty from not doing it","explanation":"\u0027Out of practice\u0027 = having lost skill through lack of use."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ his credit, he apologised immediately.","hint":"to his credit = in his favour","explanation":"\u0027to somebody\u0027s credit\u0027 \u2014 something in their favour."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new hall is ___ far the largest building on campus.","hint":"___ far = definitely","explanation":"\u0027By far\u0027 strengthens a superlative: by far the largest."}]}