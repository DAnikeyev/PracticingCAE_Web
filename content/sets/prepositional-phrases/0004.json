{"id":"prepositional-phrases-0004","taskId":"prepositional-phrases","title":"Drill set 4","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company collapsed ___ a pile of debts.","hint":"crushed by weight (figurative)","explanation":"\u0027under a pile/mountain of debt\u0027 \u2014 \u0027under\u0027 for crushing weight, literal or figurative."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme was abandoned ___ lack of interest.","hint":"because of (formal)","explanation":"\u0027for lack of\u0027 = because there was none."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."}]}