{"id":"prepositional-phrases-0004","taskId":"prepositional-phrases","title":"Drill set 4","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project is ___ way to completion ahead of schedule.","hint":"___ way = in progress","explanation":"\u0027under way\u0027 = already in progress (two words)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company collapsed ___ a pile of debts.","hint":"crushed by weight (figurative)","explanation":"\u0027under a pile/mountain of debt\u0027 \u2014 \u0027under\u0027 for crushing weight, literal or figurative."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new policy was introduced ___ response to rising demand.","hint":"___ response to","explanation":"\u0027in response to\u0027 = as a reaction to."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."}]}