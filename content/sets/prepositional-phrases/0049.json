{"id":"prepositional-phrases-0049","taskId":"prepositional-phrases","title":"Drill set 49","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"through","accept":["by"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She learnt Russian ___ watching films alone.","hint":"by means of","explanation":"\u0027through \u002B -ing/noun\u0027 = by means of."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."}]}