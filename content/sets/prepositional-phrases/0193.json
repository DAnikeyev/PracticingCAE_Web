{"id":"prepositional-phrases-0193","taskId":"prepositional-phrases","title":"Drill set 193","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"last","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is at ___ open to traffic after three years of works.","hint":"finally","explanation":"\u0027At last\u0027 = after a long wait."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was left ___ the care of the neighbours.","hint":"entrusted to","explanation":"\u0027in the care of\u0027 = looked after by."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"owing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme was abandoned ___ to a total lack of funds.","hint":"___ to = because of","explanation":"\u0027Owing to a lack of funds\u0027 = because of the lack.\u0027"},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything happened ___ such short notice that we panicked.","hint":"___ short notice","explanation":"\u0027at short notice\u0027 = with little warning."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."}]}