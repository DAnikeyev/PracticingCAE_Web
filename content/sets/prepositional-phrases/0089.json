{"id":"prepositional-phrases-0089","taskId":"prepositional-phrases","title":"Drill set 89","text":null,"source":"drill","gaps":[{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"beyond","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded ___ of all expectations.","hint":"further than expected","explanation":"\u0027beyond all expectations\u0027 = better than anyone predicted."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The tickets sold out ___ a matter of hours.","hint":"within a short period","explanation":"\u0027in a matter of hours\u0027 = within only a few hours."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."}]}