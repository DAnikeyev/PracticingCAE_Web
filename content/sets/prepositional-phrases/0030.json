{"id":"prepositional-phrases-0030","taskId":"prepositional-phrases","title":"Drill set 30","text":null,"source":"drill","gaps":[{"answer":"charge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s in ___ of the marketing team of twelve.","hint":"responsible for","explanation":"\u0027In charge of\u0027 = responsible for controlling."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first glance, the deal looks generous.","hint":"on quick inspection","explanation":"\u0027At first glance\u0027 = when first looked at quickly."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"accounts","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By all ___ , the festival was a triumph this year.","hint":"by all ___ = everyone says","explanation":"\u0027By all accounts\u0027 = according to what people say."},{"answer":"To","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ his credit, he apologised immediately.","hint":"to his credit = in his favour","explanation":"\u0027to somebody\u0027s credit\u0027 \u2014 something in their favour."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees were admitted ___ the country on humanitarian grounds.","hint":"admitted ___ a place","explanation":"admitted INTO a place/country."}]}