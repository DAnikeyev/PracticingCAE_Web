{"id":"prepositional-phrases-0018","taskId":"prepositional-phrases","title":"Drill set 18","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We finished the report ___ time for the meeting.","hint":"___ time for = early enough","explanation":"\u0027in time for\u0027 = early enough; \u0027on time\u0027 = punctual."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He denied everything ___ the face of the evidence.","hint":"___ the face of = when confronted with","explanation":"\u0027in the face of\u0027 = despite / when confronted by."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."}]}