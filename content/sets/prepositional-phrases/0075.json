{"id":"prepositional-phrases-0075","taskId":"prepositional-phrases","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The smell was ___ this world \u2014 absolutely incredible.","hint":"___ this world = amazing","explanation":"\u0027out of this world\u0027 = extraordinary (idiom: with \u0027of\u0027)."},{"answer":"back","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The castle dates ___ to the fourteenth century.","hint":"___ to = originate in","explanation":"\u0027date back to\u0027 = have existed since."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ charge of the whole marketing department.","hint":"responsible for","explanation":"\u0027in charge of\u0027 = responsible for managing."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The tickets sold out ___ a matter of hours.","hint":"within a short period","explanation":"\u0027in a matter of hours\u0027 = within only a few hours."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new policy was introduced ___ response to rising demand.","hint":"___ response to","explanation":"\u0027in response to\u0027 = as a reaction to."}]}