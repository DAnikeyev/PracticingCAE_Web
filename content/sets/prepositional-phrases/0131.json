{"id":"prepositional-phrases-0131","taskId":"prepositional-phrases","title":"Drill set 131","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new hall is ___ far the largest building on campus.","hint":"___ far = definitely","explanation":"\u0027By far\u0027 strengthens a superlative: by far the largest."},{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The amendments take effect ___ 1 January.","hint":"starting at (a date)","explanation":"\u0027from 1 January\u0027 = beginning on that date (also \u0027with effect from\u0027)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"Under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ no circumstances should you share this password.","hint":"formal prohibition phrase","explanation":"\u0027Under no circumstances\u0027 \u2014 formal emphatic prohibition."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."}]}