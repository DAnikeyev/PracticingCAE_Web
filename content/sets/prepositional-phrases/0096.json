{"id":"prepositional-phrases-0096","taskId":"prepositional-phrases","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"out of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He completed the marathon despite being ___ breath.","hint":"not able to breathe properly","explanation":"\u0027out of breath\u0027 = breathing fast from effort."},{"answer":"In","accept":["Under"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the circumstances, the committee chose leniency.","hint":"considering the situation","explanation":"\u0027in the circumstances\u0027 = given the situation (also \u0027under\u0027)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The old theatre is ___ threat of demolition.","hint":"in danger of","explanation":"\u0027Under threat of\u0027 = at risk of."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first, the plan sounded ridiculous \u2014 then it grew on us.","hint":"___ first = initially","explanation":"\u0027At first\u0027 = in the beginning (contrast with \u0027first\u0027 = before anything else)."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The proposal is still ___ the table \u2014 nothing has been decided.","hint":"___ the table = under discussion","explanation":"\u0027On the table\u0027 = offered and still being considered."}]}