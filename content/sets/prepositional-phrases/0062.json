{"id":"prepositional-phrases-0062","taskId":"prepositional-phrases","title":"Drill set 62","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"By","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ comparison with last year, sales have doubled.","hint":"when compared","explanation":"\u0027By comparison with\u0027 = compared to."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ terms of quality, the cheaper model wins.","hint":"regarding","explanation":"\u0027in terms of\u0027 = with regard to."},{"answer":"accordance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The decisions were taken in ___ with company policy.","hint":"in ___ with = following the rules","explanation":"\u0027In accordance with\u0027 = in agreement with a rule or request."},{"answer":"charge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s in ___ of the marketing team of twelve.","hint":"responsible for","explanation":"\u0027In charge of\u0027 = responsible for controlling."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ second thoughts, maybe we should postpone.","hint":"reconsidering","explanation":"\u0027On second thoughts\u0027 = having reconsidered (BrE)."},{"answer":"last","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is at ___ open to traffic after three years of works.","hint":"finally","explanation":"\u0027At last\u0027 = after a long wait."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee met ___ private before making its announcement.","hint":"___ 