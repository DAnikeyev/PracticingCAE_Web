{"id":"prepositional-phrases-0062","taskId":"prepositional-phrases","title":"Drill set 62","text":null,"source":"drill","gaps":[{"answer":"Through","accept":["By"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ good fortune, nobody was hurt in the collapse.","hint":"thanks to / because of (chance)","explanation":"\u0027through good fortune\u0027 = by means of luck."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The original manuscript is ___ permanent display in Vienna.","hint":"___ display","explanation":"\u0027on display\u0027 = being shown to the public."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The refugees were admitted ___ the country on humanitarian grounds.","hint":"admitted ___ a place","explanation":"admitted INTO a place/country."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The party is ___ the 14th, not the 21st.","hint":"dates take this preposition","explanation":"\u0027On the 14th\u0027 \u2014 \u0027on\u0027 for dates.\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."}]}