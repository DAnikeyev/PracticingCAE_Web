{"id":"prepositional-phrases-0144","taskId":"prepositional-phrases","title":"Drill set 144","text":null,"source":"drill","gaps":[{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first, the plan sounded ridiculous \u2014 then it grew on us.","hint":"___ first = initially","explanation":"\u0027At first\u0027 = in the beginning (contrast with \u0027first\u0027 = before anything else)."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The flat is ___ sale, but only to cash buyers.","hint":"___ sale = offered to buy","explanation":"\u0027For sale\u0027 = available to be bought."},{"answer":"hurry","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m in no ___ \u2014 take your time deciding.","hint":"in no ___ = not rushed","explanation":"\u0027In no hurry\u0027 = willing to wait."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Payments must be made ___ advance; invoices cannot be accepted.","hint":"___ advance = beforehand","explanation":"\u0027In advance\u0027 = before the event or deadline."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"end","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme paid off in the ___ \u2014 we recouped every euro.","hint":"finally","explanation":"\u0027In the end\u0027 = eventually, after everything."},{"answer":"charge","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s in ___ of the marketing team of twelve.","hint":"responsible for","explanation":"\u0027In charge of\u0027 = responsible for controlling."}]}