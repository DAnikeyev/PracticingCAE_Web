{"id":"prepositional-phrases-0144","taskId":"prepositional-phrases","title":"Drill set 144","text":null,"source":"drill","gaps":[{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the long run, the cheaper option costs more.","hint":"eventually","explanation":"\u0027In the long run\u0027 = over a long period."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"respects","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two versions differ in several ___ ; the ending is the biggest.","hint":"in several ___ = in several ways","explanation":"\u0027In several respects\u0027 = in several aspects."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ the phone all morning with suppliers.","hint":"using the phone","explanation":"\u0027On the phone\u0027 = using it for a call."},{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee met ___ private before making its announcement.","hint":"___ private = not publicly","explanation":"\u0027In private\u0027 = without the public present.\u0027"}]}