{"id":"prepositional-phrases-0166","taskId":"prepositional-phrases","title":"Drill set 166","text":null,"source":"drill","gaps":[{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The missing files are still ___ investigation.","hint":"being examined","explanation":"\u0027Under investigation\u0027 = being officially examined."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was left ___ the care of the neighbours.","hint":"entrusted to","explanation":"\u0027in the care of\u0027 = looked after by."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We finished the report ___ time for the meeting.","hint":"___ time for = early enough","explanation":"\u0027in time for\u0027 = early enough; \u0027on time\u0027 = punctual."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new hall is ___ far the largest building on campus.","hint":"___ far = definitely","explanation":"\u0027By far\u0027 strengthens a superlative: by far the largest."}]}