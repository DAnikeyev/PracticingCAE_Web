{"id":"prepositional-phrases-0166","taskId":"prepositional-phrases","title":"Drill set 166","text":null,"source":"drill","gaps":[{"answer":"With","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the exception of the organ, every instrument in the chapel is original.","hint":"fixed phrase: ___ the exception of","explanation":"\u0027With the exception of\u0027 = apart from."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"up","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The library stays open ___ to midnight during the exam period.","hint":"___ to midnight = as late as","explanation":"\u0027Up to midnight\u0027 = until as late as midnight."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m afraid we\u0027re ___ of options at this point.","hint":"have none remaining","explanation":"\u0027out of options\u0027 = no options remaining."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The two reports differ ___ several important respects.","hint":"___ respects = aspects","explanation":"\u0027in several respects\u0027 = in several aspects."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first glance, the deal looks generous.","hint":"on quick inspection","explanation":"\u0027At first glance\u0027 = when first looked at quickly."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The goalkeeper was ___ no way at fault for the second goal.","hint":"___ no way = definitely not","explanation":"\u0027In no way\u0027 = not at all, used for emphasis."}]}