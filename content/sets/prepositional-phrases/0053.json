{"id":"prepositional-phrases-0053","taskId":"prepositional-phrases","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ contrast to her sister, she loves publicity.","hint":"opposite to","explanation":"\u0027in contrast to\u0027 = when compared oppositely."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The lifeguard pulled the swimmer ___ the water just in time.","hint":"pulled ___ the water","explanation":"\u0027Pull somebody from the water\u0027 = rescue them out of it."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The play closed after three nights ___ account of poor ticket sales.","hint":"___ account of = because of","explanation":"\u0027On account of\u0027 = because of, in a formal register."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She opened the letter ___ trembling hands.","hint":"means or manner","explanation":"\u0027With trembling hands\u0027 \u2014 \u0027with\u0027 describes the instrument/manner.\u0027"},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, not by accident.","hint":"intentionally","explanation":"\u0027On purpose\u0027 = deliberately."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"}]}