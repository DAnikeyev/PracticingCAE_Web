{"id":"prepositional-phrases-0095","taskId":"prepositional-phrases","title":"Drill set 95","text":null,"source":"drill","gaps":[{"answer":"about","accept":["over"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point arguing ___ it now \u2014 the contract is signed.","hint":"argue ___ sth","explanation":"\u0027argue about something\u0027 \u2014 also \u0027over\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The 8:15 train left ___ time, to the second.","hint":"punctual = ___ time","explanation":"\u0027on time\u0027 = exactly as scheduled."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re ___ the impression that the offer had expired.","hint":"___ the impression = believing","explanation":"\u0027under the impression that\u2026\u0027 = believing, often wrongly."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum is open to the public ___ appointment only.","hint":"arranged in advance","explanation":"\u0027by appointment\u0027 = only if arranged beforehand."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the feedback was positive.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = considering everything."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letter arrived ___ due course \u2014 three weeks later.","hint":"___ due course = at the expected time","explanation":"\u0027in due course\u0027 = at the proper time eventually."}]}