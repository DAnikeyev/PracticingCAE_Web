{"id":"prepositional-phrases-0185","taskId":"prepositional-phrases","title":"Drill set 185","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We spoke ___ the phone for an hour.","hint":"communication medium","explanation":"\u0027on the phone\u0027, \u0027on television\u0027, \u0027on the radio\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He did it ___ purpose, just to annoy her.","hint":"intentionally","explanation":"\u0027on purpose\u0027 = deliberately."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ any rate, we still have enough time.","hint":"in any case","explanation":"\u0027At any rate\u0027 = whatever else is true."},{"answer":"advance","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Everything was packed ready in ___ of the movers\u0027 arrival.","hint":"in ___ of = before","explanation":"\u0027In advance of\u0027 = before something happens."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The firm was put ___ liquidation by the end of March.","hint":"formal insolvency phrase","explanation":"\u0027Put into liquidation\u0027 \u2014 the formal process of closing a company.\u0027"},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The neighbours complained ___ the noise until dawn.","hint":"complain ___ sth (first gap)","explanation":"complain ABOUT something; \u0027in the small hours\u0027 = after midnight. Only the first gap is checked."}]}