{"id":"prepositional-phrases-0043","taskId":"prepositional-phrases","title":"Drill set 43","text":null,"source":"drill","gaps":[{"answer":"spite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She succeeded in ___ of repeated setbacks.","hint":"in ___ of = although","explanation":"\u0027In spite of\u0027 = despite."},{"answer":"ahead","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were well ___ of schedule by midday.","hint":"___ of schedule = earlier than planned","explanation":"\u0027Ahead of schedule\u0027 = earlier than planned.\u0027"},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The decision was taken ___ my behalf while I was away.","hint":"for someone, in their place","explanation":"\u0027on somebody\u0027s behalf\u0027 = in their interest or place."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re ___ the impression that the offer had expired.","hint":"___ the impression = believing","explanation":"\u0027under the impression that\u2026\u0027 = believing, often wrongly."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company is ___ serious financial difficulties.","hint":"experiencing (a state)","explanation":"\u0027in difficulties/trouble/debt\u0027 \u2014 \u0027in \u002B difficult state\u0027."},{"answer":"out of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He completed the marathon despite being ___ breath.","hint":"not able to breathe properly","explanation":"\u0027out of breath\u0027 = breathing fast from effort."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."}]}