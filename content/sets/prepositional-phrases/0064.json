{"id":"prepositional-phrases-0064","taskId":"prepositional-phrases","title":"Drill set 64","text":null,"source":"drill","gaps":[{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the long run, the cheaper option costs more.","hint":"eventually","explanation":"\u0027In the long run\u0027 = over a long period."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The file was deleted ___ accident.","hint":"___ accident = unintentionally","explanation":"\u0027by accident\u0027 = accidentally (opposite: on purpose)."},{"answer":"At","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ first glance, the deal looks generous.","hint":"on quick inspection","explanation":"\u0027At first glance\u0027 = when first looked at quickly."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The firm was put ___ liquidation by the end of March.","hint":"formal insolvency phrase","explanation":"\u0027Put into liquidation\u0027 \u2014 the formal process of closing a company.\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s ___ no means certain to win, but she\u0027s the favourite.","hint":"___ no means = definitely not","explanation":"\u0027by no means\u0027 = definitely not."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bus was so crowded that we travelled ___ discomfort.","hint":"___ discomfort = experiencing it","explanation":"\u0027in discomfort/silence/agreement\u0027 \u2014 \u0027in \u002B abstract noun\u0027 for states."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He stayed ___ touch with every colleague he\u0027d ever had.","hint":"___ touch = in contact","explanation":"\u0027in touch with\u0027 = maintaining contact."},{"answer":"hurry","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m in no ___ \u2014 take your time deciding.","hint":"in no ___ = not rushed","explanation":"\u0027In no hurry\u0027 = willing to wait."}]}