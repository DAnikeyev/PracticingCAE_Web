{"id":"phrasal-verbs-0015","taskId":"phrasal-verbs","title":"Drill set 15","text":null,"source":"drill","gaps":[{"answer":"up","accept":[],"options":["up","on","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"The new manager wants to back ___ the sales team\u0027s proposal.","hint":"support","explanation":"back up = support (a person, plan); also make a copy of data."},{"answer":"with","accept":[],"options":["with","in","out","over"],"base":null,"keyword":null,"lead":null,"sentence":"Who is going to deal ___ the angry customer?","hint":"handle","explanation":"deal with = handle; deal in = trade."},{"answer":"off","accept":[],"options":["off","up","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"The match kicks ___ at three o\u0027clock.","hint":"start (a match)","explanation":"kick off = (of a match) start."},{"answer":"out","accept":[],"options":["out","off","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ within an hour.","hint":"all bought","explanation":"sell out = all tickets/goods are sold."},{"answer":"down","accept":[],"options":["down","up","in","off"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."},{"answer":"out","accept":[],"options":["out","off","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"We found ___ that the flight had been cancelled.","hint":"discover","explanation":"find out = discover information."},{"answer":"up","accept":[],"options":["up","on","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"Hurry ___ or we\u0027ll miss the ferry!","hint":"be quick","explanation":"hurry up = do something faster."},{"answer":"out","accept":[],"options":["out","off","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."}]}