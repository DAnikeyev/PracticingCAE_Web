{"id":"phrasal-verbs-0002","taskId":"phrasal-verbs","title":"Drill set 2","text":null,"source":"drill","gaps":[{"answer":"run","accept":[],"options":["gone","taken","used","run"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve ___ out of milk \u2014 could you get some more?","hint":"have none left","explanation":"\u0027Run out of\u0027 = exhaust the supply."},{"answer":"ahead","accept":[],"options":["under","ahead","along","off"],"base":null,"keyword":null,"lead":null,"sentence":"If the strike goes ___, deliveries will stop nationwide.","hint":"go ___ = proceed","explanation":"\u0027Go ahead\u0027 = proceed as planned."},{"answer":"across","accept":[],"options":["off","up","across","over"],"base":null,"keyword":null,"lead":null,"sentence":"She put her ideas ___ clearly and confidently.","hint":"communicate successfully","explanation":"put across = communicate an idea successfully."},{"answer":"for","accept":[],"options":["to","for","on","up"],"base":null,"keyword":null,"lead":null,"sentence":"Many consumers now opt ___ cheaper brands.","hint":"choose","explanation":"opt for something = choose it."},{"answer":"out","accept":[],"options":["away","off","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"up","accept":[],"options":["off","out","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"Her honesty more than makes ___ for her lack of experience.","hint":"make ___ for = compensate for","explanation":"\u0027Make up for\u0027 = compensate for a shortcoming."},{"answer":"up","accept":[],"options":["out","on","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"ahead","accept":[],"options":["over","out","ahead","up"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s wise to look ___ before making a career move.","hint":"plan for the future","explanation":"look ahead = think about and plan for the future."}]}