{"id":"phrasal-verbs-0145","taskId":"phrasal-verbs","title":"Drill set 145","text":null,"source":"drill","gaps":[{"answer":"up","accept":[],"options":["up","out","on","off"],"base":null,"keyword":null,"lead":null,"sentence":"An accident held ___ the traffic for two hours.","hint":"delay","explanation":"hold up = delay."},{"answer":"out","accept":[],"options":["up","out","over","off"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t figure ___ how this app works.","hint":"understand after thinking","explanation":"figure out = understand after thinking."},{"answer":"setting","accept":[],"options":["putting","setting","standing","sitting"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ up a new office in the old warehouse district.","hint":"establish","explanation":"\u0027Set up\u0027 = create or establish."},{"answer":"for","accept":[],"options":["up","in","for","by"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"up","accept":[],"options":["off","in","up","down"],"base":null,"keyword":null,"lead":null,"sentence":"They broke ___ after only two years of marriage.","hint":"end a relationship","explanation":"break up = end a relationship."},{"answer":"in","accept":[],"options":["up","out","on","in"],"base":null,"keyword":null,"lead":null,"sentence":"She keyed ___ the password and logged on.","hint":"type (a password)","explanation":"key in = type in (a password, code)."},{"answer":"for","accept":[],"options":["for","up","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"When the alarm sounded, everyone made ___ the nearest exit.","hint":"make ___ = head towards","explanation":"\u0027Make for\u0027 = move towards, usually in haste."},{"answer":"off","accept":["on"],"options":["off","on","up","by"],"base":null,"keyword":null,"lead":null,"sentence":"They live ___ their pension and a small rent.","hint":"have as income/food","explanation":"live off = have as income/food; live on = have as income (money)."}]}