{"id":"phrasal-verbs-0142","taskId":"phrasal-verbs","title":"Drill set 142","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["on","in","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."},{"answer":"over","accept":[],"options":["up","in","off","over"],"base":null,"keyword":null,"lead":null,"sentence":"Who will take ___ from the current director?","hint":"assume control","explanation":"take over = take control of a job/company."},{"answer":"up","accept":[],"options":["on","out","up","in"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s hard to keep ___ with the latest slang.","hint":"stay level with","explanation":"keep up with = stay level with somebody/something changing."},{"answer":"for","accept":[],"options":["by","up","for","in"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"out","accept":[],"options":["up","out","away","off"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"after","accept":[],"options":["over","up","after","on"],"base":null,"keyword":null,"lead":null,"sentence":"Everyone says she takes ___ her grandmother.","hint":"resemble a relative","explanation":"take after a relative = resemble them in character/looks."},{"answer":"away","accept":[],"options":["up","away","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"to","accept":[],"options":["with","to","up","for"],"base":null,"keyword":null,"lead":null,"sentence":"The film didn\u0027t live up ___ my expectations.","hint":"be as good as expected","explanation":"live up TO something = be as good as expected."}]}