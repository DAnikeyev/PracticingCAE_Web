{"id":"phrasal-verbs-0043","taskId":"phrasal-verbs","title":"Drill set 43","text":null,"source":"drill","gaps":[{"answer":"down","accept":[],"options":["down","up","about","off"],"base":null,"keyword":null,"lead":null,"sentence":"The scandal brought ___ the government.","hint":"cause to lose power","explanation":"bring down = cause a government/person to lose power; reduce (prices)."},{"answer":"up","accept":[],"options":["up","down","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"They broke ___ after only two years of marriage.","hint":"end a relationship","explanation":"break up = end a relationship."},{"answer":"away","accept":[],"options":["away","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"out","accept":[],"options":["out","up","off","over"],"base":null,"keyword":null,"lead":null,"sentence":"It took all morning to sort ___ the garage.","hint":"organize, solve","explanation":"sort out = organize/put in order, or solve (a problem)."},{"answer":"up","accept":[],"options":["up","on","over","in"],"base":null,"keyword":null,"lead":null,"sentence":"A sales rep will follow ___ your enquiry next week.","hint":"take further action","explanation":"follow up = take further action after something."},{"answer":"off","accept":[],"options":["off","up","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"We had to call ___ the order because the kitchen had closed.","hint":"cancel","explanation":"call off = cancel."},{"answer":"up","accept":[],"options":["up","in","over","on"],"base":null,"keyword":null,"lead":null,"sentence":"He ended ___ selling insurance, though he\u0027d trained as a chef.","hint":"finish somewhere unplanned","explanation":"end up = finally be in a place/situation/state."},{"answer":"on","accept":[],"options":["on","up","in","out"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."}]}