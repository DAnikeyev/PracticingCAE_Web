{"id":"phrasal-verbs-0091","taskId":"phrasal-verbs","title":"Drill set 91","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["over","up","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"ahead","accept":[],"options":["under","ahead","along","off"],"base":null,"keyword":null,"lead":null,"sentence":"If the strike goes ___, deliveries will stop nationwide.","hint":"go ___ = proceed","explanation":"\u0027Go ahead\u0027 = proceed as planned."},{"answer":"off","accept":[],"options":["down","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Our street was cut ___ for three hours after the storm.","hint":"disconnected","explanation":"cut off = disconnected (power, phone); isolate (a village cut off by snow)."},{"answer":"out","accept":[],"options":["off","over","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."},{"answer":"across","accept":[],"options":["over","across","into","up"],"base":null,"keyword":null,"lead":null,"sentence":"I came ___ an old letter while clearing the attic.","hint":"find by chance","explanation":"come across = find/meet by chance."},{"answer":"up","accept":[],"options":["on","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"up","accept":[],"options":["down","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"They broke ___ after only two years of marriage.","hint":"end a relationship","explanation":"break up = end a relationship."},{"answer":"off","accept":[],"options":["down","up","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"The factory laid ___ two hundred workers.","hint":"dismiss (no fault)","explanation":"lay off = dismiss workers because there is not enough work."}]}