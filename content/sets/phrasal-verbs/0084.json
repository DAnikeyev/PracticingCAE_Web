{"id":"phrasal-verbs-0084","taskId":"phrasal-verbs","title":"Drill set 84","text":null,"source":"drill","gaps":[{"answer":"into","accept":[],"options":["on","into","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"I bumped ___ my neighbour at the dentist\u0027s.","hint":"meet by chance","explanation":"bump into somebody = meet by chance."},{"answer":"up","accept":[],"options":["on","in","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s hard to keep ___ with the latest slang.","hint":"stay level with","explanation":"keep up with = stay level with somebody/something changing."},{"answer":"off","accept":[],"options":["off","down","up","in"],"base":null,"keyword":null,"lead":null,"sentence":"The band broke ___ in the middle of the song.","hint":"stop suddenly","explanation":"break off = stop suddenly (speaking, engagement)."},{"answer":"kicked","accept":[],"options":["kicked","knocked","punched","hammered"],"base":null,"keyword":null,"lead":null,"sentence":"The evening ___ off with a quiz and ended with dancing.","hint":"kick ___ = begin","explanation":"\u0027Kick off\u0027 = start, informally."},{"answer":"out","accept":[],"options":["out","over","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"ahead","accept":[],"options":["off","ahead","under","along"],"base":null,"keyword":null,"lead":null,"sentence":"If the strike goes ___, deliveries will stop nationwide.","hint":"go ___ = proceed","explanation":"\u0027Go ahead\u0027 = proceed as planned."},{"answer":"across","accept":[],"options":["into","up","over","across"],"base":null,"keyword":null,"lead":null,"sentence":"I came ___ an old letter while clearing the attic.","hint":"find by chance","explanation":"come across = find/meet by chance."},{"answer":"over","accept":[],"options":["up","in","over","off"],"base":null,"keyword":null,"lead":null,"sentence":"Who will take ___ from the current director?","hint":"assume control","explanation":"take over = take control of a job/company."}]}