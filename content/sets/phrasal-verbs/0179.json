{"id":"phrasal-verbs-0179","taskId":"phrasal-verbs","title":"Drill set 179","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["up","away","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"out","accept":[],"options":["over","out","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"We found ___ that the flight had been cancelled.","hint":"discover","explanation":"find out = discover information."},{"answer":"broke","accept":[],"options":["let","fell","broke","cut"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."},{"answer":"out","accept":[],"options":["out","off","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"up","accept":[],"options":["out","in","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"The subject cropped ___ again at dinner.","hint":"appear unexpectedly","explanation":"crop up = appear or happen unexpectedly."},{"answer":"through","accept":[],"options":["over","through","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been going ___ a difficult time at work.","hint":"experience sth unpleasant","explanation":"go through = experience something difficult."},{"answer":"up","accept":[],"options":["in","away","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"After twenty years of smoking, he finally managed to give it ___.","hint":"quit a habit","explanation":"give up = stop/quit (a habit or attempt)."},{"answer":"up","accept":[],"options":["on","up","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"Hurry ___ or we\u0027ll miss the ferry!","hint":"be quick","explanation":"hurry up = do something faster."}]}