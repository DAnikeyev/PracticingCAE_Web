{"id":"phrasal-verbs-0107","taskId":"phrasal-verbs","title":"Drill set 107","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["up","out","on","in"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."},{"answer":"off","accept":[],"options":["in","off","up","down"],"base":null,"keyword":null,"lead":null,"sentence":"The band broke ___ in the middle of the song.","hint":"stop suddenly","explanation":"break off = stop suddenly (speaking, engagement)."},{"answer":"off","accept":["on"],"options":["off","on","by","up"],"base":null,"keyword":null,"lead":null,"sentence":"They live ___ their pension and a small rent.","hint":"have as income/food","explanation":"live off = have as income/food; live on = have as income (money)."},{"answer":"across","accept":[],"options":["over","up","into","across"],"base":null,"keyword":null,"lead":null,"sentence":"I came ___ an old letter while clearing the attic.","hint":"find by chance","explanation":"come across = find/meet by chance."},{"answer":"through","accept":[],"options":["down","out","through","behind"],"base":null,"keyword":null,"lead":null,"sentence":"The talks fell ___ when neither side would compromise on fishing rights.","hint":"fall ___ = fail to happen","explanation":"\u0027Fall through\u0027 = (a plan or deal) fail to be completed."},{"answer":"on","accept":["along"],"options":["on","by","over","through"],"base":null,"keyword":null,"lead":null,"sentence":"Do you get ___ well with your new colleagues?","hint":"have a good relationship","explanation":"get on (with) = have a good relationship; also get along with (AmE)."},{"answer":"for","accept":[],"options":["up","by","for","in"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"down","accept":[],"options":["down","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."}]}