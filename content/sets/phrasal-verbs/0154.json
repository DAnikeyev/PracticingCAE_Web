{"id":"phrasal-verbs-0154","taskId":"phrasal-verbs","title":"Drill set 154","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["off","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"up","accept":[],"options":["on","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"out","accept":[],"options":["up","out","on","over"],"base":null,"keyword":null,"lead":null,"sentence":"They want to try ___ the new software before buying.","hint":"test (a product/method)","explanation":"try out = test something to see if it works."},{"answer":"on","accept":[],"options":["for","in","on","up"],"base":null,"keyword":null,"lead":null,"sentence":"You can count ___ me if you need help.","hint":"rely on","explanation":"count on somebody = rely on them."},{"answer":"out","accept":[],"options":["over","off","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."},{"answer":"broke","accept":[],"options":["fell","cut","broke","let"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."},{"answer":"with","accept":[],"options":["with","against","to","for"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."},{"answer":"up","accept":[],"options":["on","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"Hurry ___ or we\u0027ll miss the ferry!","hint":"be quick","explanation":"hurry up = do something faster."}]}