{"id":"phrasal-verbs-0194","taskId":"phrasal-verbs","title":"Drill set 194","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["for","in","by","up"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"up","accept":[],"options":["out","on","in","up"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s hard to keep ___ with the latest slang.","hint":"stay level with","explanation":"keep up with = stay level with somebody/something changing."},{"answer":"down","accept":[],"options":["up","about","off","down"],"base":null,"keyword":null,"lead":null,"sentence":"The scandal brought ___ the government.","hint":"cause to lose power","explanation":"bring down = cause a government/person to lose power; reduce (prices)."},{"answer":"off","accept":[],"options":["up","down","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"The band broke ___ in the middle of the song.","hint":"stop suddenly","explanation":"break off = stop suddenly (speaking, engagement)."},{"answer":"out","accept":[],"options":["up","off","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."},{"answer":"up","accept":[],"options":["over","on","in","up"],"base":null,"keyword":null,"lead":null,"sentence":"You go ahead; I\u0027ll catch ___ with you later.","hint":"reach the same level","explanation":"catch up (with) = reach the same point/level as somebody."},{"answer":"for","accept":[],"options":["out","for","up","on"],"base":null,"keyword":null,"lead":null,"sentence":"This job calls ___ someone with patience.","hint":"require, need","explanation":"call for = require, demand (circumstances call for action)."},{"answer":"turned","accept":[],"options":["put","let","turned","taken"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ down an offer from a rival university.","hint":"refuse","explanation":"\u0027Turn down an offer\u0027 = refuse it."}]}