{"id":"phrasal-verbs-0086","taskId":"phrasal-verbs","title":"Drill set 86","text":null,"source":"drill","gaps":[{"answer":"up","accept":[],"options":["on","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"Their son grew ___ and moved abroad.","hint":"become adult","explanation":"grow up = become an adult."},{"answer":"of","accept":[],"options":["off","of","up","from"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve run out ___ coffee again.","hint":"have none left","explanation":"run out OF something = have none left."},{"answer":"turned","accept":[],"options":["turned","taken","let","put"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ down an offer from a rival university.","hint":"refuse","explanation":"\u0027Turn down an offer\u0027 = refuse it."},{"answer":"up","accept":[],"options":["in","up","over","on"],"base":null,"keyword":null,"lead":null,"sentence":"He ended ___ selling insurance, though he\u0027d trained as a chef.","hint":"finish somewhere unplanned","explanation":"end up = finally be in a place/situation/state."},{"answer":"out","accept":[],"options":["up","over","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"to","accept":[],"options":["for","on","with","to"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s time you faced up ___ your responsibilities.","hint":"accept sth difficult","explanation":"face up TO something = accept and deal with something difficult."},{"answer":"through","accept":[],"options":["out","over","through","off"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been going ___ a difficult time at work.","hint":"experience sth unpleasant","explanation":"go through = experience something difficult."},{"answer":"ahead","accept":[],"options":["along","under","off","ahead"],"base":null,"keyword":null,"lead":null,"sentence":"If the strike goes ___, deliveries will stop nationwide.","hint":"go ___ = proceed","explanation":"\u0027Go ahead\u0027 = proceed as planned."}]}