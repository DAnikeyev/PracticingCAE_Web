{"id":"phrasal-verbs-0003","taskId":"phrasal-verbs","title":"Drill set 3","text":null,"source":"drill","gaps":[{"answer":"use","accept":[],"options":["use","give","put","take"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t ___ up all the milk \u2014 we need some for breakfast.","hint":"finish the supply","explanation":"use up = finish the whole supply of something."},{"answer":"down","accept":[],"options":["up","out","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"Calm ___ \u2014 everything is under control.","hint":"stop being angry","explanation":"calm down = become less angry/upset."},{"answer":"with","accept":[],"options":["to","against","for","with"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."},{"answer":"down","accept":[],"options":["down","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."},{"answer":"about","accept":[],"options":["on","up","about","out"],"base":null,"keyword":null,"lead":null,"sentence":"The strike brought ___ major changes in the law.","hint":"cause to happen","explanation":"bring about = cause to happen."},{"answer":"out","accept":[],"options":["over","off","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"out","accept":[],"options":["out","off","down","up"],"base":null,"keyword":null,"lead":null,"sentence":"The old buses are being phased ___ next year.","hint":"remove gradually","explanation":"phase out = stop using something gradually."},{"answer":"after","accept":[],"options":["after","for","into","up"],"base":null,"keyword":null,"lead":null,"sentence":"Could you look ___ my suitcase while I buy the tickets?","hint":"take care of","explanation":"look after = take care of; look for = search; look up = check in a reference."}]}