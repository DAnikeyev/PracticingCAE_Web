{"id":"phrasal-verbs-0071","taskId":"phrasal-verbs","title":"Drill set 71","text":null,"source":"drill","gaps":[{"answer":"looked","accept":[],"options":["searched","sought","looked","hunted"],"base":null,"keyword":null,"lead":null,"sentence":"He ___ up the word in an online dictionary.","hint":"find in a reference book","explanation":"\u0027Look a word up\u0027 = check its meaning."},{"answer":"down","accept":[],"options":["out","up","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"Calm ___ \u2014 everything is under control.","hint":"stop being angry","explanation":"calm down = become less angry/upset."},{"answer":"up","accept":[],"options":["on","over","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"out","accept":[],"options":["on","away","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"The scientists carried ___ a series of experiments.","hint":"perform, conduct","explanation":"carry out = perform, conduct (research, a plan, an order)."},{"answer":"into","accept":[],"options":["for","after","into","up"],"base":null,"keyword":null,"lead":null,"sentence":"Police are looking ___ the cause of the crash.","hint":"investigate","explanation":"look into = investigate."},{"answer":"up","accept":[],"options":["after","out","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"If you don\u0027t know the word, look it ___ in a dictionary.","hint":"find information","explanation":"look a word up = find it in a dictionary/reference."},{"answer":"across","accept":[],"options":["over","up","into","across"],"base":null,"keyword":null,"lead":null,"sentence":"I came ___ an old letter while clearing the attic.","hint":"find by chance","explanation":"come across = find/meet by chance."},{"answer":"out","accept":[],"options":["over","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."}]}