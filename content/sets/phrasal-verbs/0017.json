{"id":"phrasal-verbs-0017","taskId":"phrasal-verbs","title":"Drill set 17","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["out","over","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ within an hour.","hint":"all bought","explanation":"sell out = all tickets/goods are sold."},{"answer":"away","accept":[],"options":["away","off","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"out","accept":[],"options":["off","up","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t figure ___ how this app works.","hint":"understand after thinking","explanation":"figure out = understand after thinking."},{"answer":"through","accept":[],"options":["out","through","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"The deal fell ___ at the last minute.","hint":"fail to happen","explanation":"fall through = (a plan/deal) fail to happen."},{"answer":"out","accept":[],"options":["up","out","away","off"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"up","accept":[],"options":["up","on","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"across","accept":[],"options":["up","off","over","across"],"base":null,"keyword":null,"lead":null,"sentence":"She put her ideas ___ clearly and confidently.","hint":"communicate successfully","explanation":"put across = communicate an idea successfully."},{"answer":"in","accept":[],"options":["up","on","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel was full, so we couldn\u0027t check ___.","hint":"register at hotel/airport","explanation":"check in = register; check out = leave and pay."}]}