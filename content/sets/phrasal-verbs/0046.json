{"id":"phrasal-verbs-0046","taskId":"phrasal-verbs","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":["on","in","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."},{"answer":"for","accept":[],"options":["by","in","for","up"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"in","accept":[],"options":["out","up","in","over"],"base":null,"keyword":null,"lead":null,"sentence":"Please hand ___ your essays by Friday.","hint":"give to a person in authority","explanation":"hand in = give work/documents to somebody in authority."},{"answer":"out","accept":[],"options":["out","over","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"We found ___ that the flight had been cancelled.","hint":"discover","explanation":"find out = discover information."},{"answer":"up","accept":[],"options":["out","on","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"An accident held ___ the traffic for two hours.","hint":"delay","explanation":"hold up = delay."},{"answer":"in","accept":[],"options":["out","on","in","up"],"base":null,"keyword":null,"lead":null,"sentence":"The hotel was full, so we couldn\u0027t check ___.","hint":"register at hotel/airport","explanation":"check in = register; check out = leave and pay."},{"answer":"out","accept":[],"options":["over","off","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ within an hour.","hint":"all bought","explanation":"sell out = all tickets/goods are sold."},{"answer":"up","accept":[],"options":["out","over","up","on"],"base":null,"keyword":null,"lead":null,"sentence":"Their son grew ___ and moved abroad.","hint":"become adult","explanation":"grow up = become an adult."}]}