{"id":"phrasal-verbs-0162","taskId":"phrasal-verbs","title":"Drill set 162","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["off","over","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."},{"answer":"off","accept":[],"options":["over","off","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"We saw our guests ___ at the station.","hint":"say goodbye to a traveller","explanation":"see somebody off = go with a traveller to say goodbye."},{"answer":"out","accept":[],"options":["up","out","off","over"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."},{"answer":"off","accept":[],"options":["out","off","on","up"],"base":null,"keyword":null,"lead":null,"sentence":"They put ___ the meeting until everyone could attend.","hint":"postpone","explanation":"put off = postpone."},{"answer":"away","accept":[],"options":["out","away","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"out","accept":[],"options":["off","over","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"out","accept":[],"options":["off","out","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t figure ___ how this app works.","hint":"understand after thinking","explanation":"figure out = understand after thinking."},{"answer":"out","accept":[],"options":["out","up","at","off"],"base":null,"keyword":null,"lead":null,"sentence":"During the tour she pointed ___ the oldest house in town.","hint":"draw attention to","explanation":"point out = mention/draw attention to a fact."}]}