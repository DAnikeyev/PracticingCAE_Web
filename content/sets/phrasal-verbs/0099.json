{"id":"phrasal-verbs-0099","taskId":"phrasal-verbs","title":"Drill set 99","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["out","over","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"These old boots are completely worn ___.","hint":"old and unusable","explanation":"wear out = become thin/unusable through use."},{"answer":"down","accept":[],"options":["off","down","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Calm ___ \u2014 everything is under control.","hint":"stop being angry","explanation":"calm down = become less angry/upset."},{"answer":"turned","accept":[],"options":["put","turned","taken","let"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ down an offer from a rival university.","hint":"refuse","explanation":"\u0027Turn down an offer\u0027 = refuse it."},{"answer":"out","accept":[],"options":["out","up","at","off"],"base":null,"keyword":null,"lead":null,"sentence":"During the tour she pointed ___ the oldest house in town.","hint":"draw attention to","explanation":"point out = mention/draw attention to a fact."},{"answer":"into","accept":[],"options":["after","for","into","up"],"base":null,"keyword":null,"lead":null,"sentence":"Police are looking ___ the cause of the crash.","hint":"investigate","explanation":"look into = investigate."},{"answer":"setting","accept":[],"options":["putting","standing","sitting","setting"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ up a new office in the old warehouse district.","hint":"establish","explanation":"\u0027Set up\u0027 = create or establish."},{"answer":"off","accept":[],"options":["in","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Sales figures have tailed ___ since the summer.","hint":"gradually decrease","explanation":"tail off = gradually become less."},{"answer":"off","accept":[],"options":["down","out","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"The factory laid ___ two hundred workers.","hint":"dismiss (no fault)","explanation":"lay off = dismiss workers because there is not enough work."}]}