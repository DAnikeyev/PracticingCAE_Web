{"id":"phrasal-verbs-0052","taskId":"phrasal-verbs","title":"Drill set 52","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":["off","up","in","out"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027ve just moved ___ to their new flat.","hint":"start living somewhere","explanation":"move in = start living in a new home."},{"answer":"over","accept":[],"options":["out","over","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"Let\u0027s start ___ \u2014 the first version had too many errors.","hint":"begin again","explanation":"start over = begin again from the beginning."},{"answer":"out","accept":[],"options":["off","up","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"The store decided to branch ___ into online sales.","hint":"expand into new areas","explanation":"branch out = start doing something new and different."},{"answer":"on","accept":[],"options":["up","in","on","out"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."},{"answer":"out","accept":[],"options":["up","over","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"We need to iron ___ a few details before signing.","hint":"remove (problems)","explanation":"iron out = remove small problems/differences."},{"answer":"about","accept":[],"options":["on","up","out","about"],"base":null,"keyword":null,"lead":null,"sentence":"The strike brought ___ major changes in the law.","hint":"cause to happen","explanation":"bring about = cause to happen."},{"answer":"up","accept":[],"options":["off","up","out","on"],"base":null,"keyword":null,"lead":null,"sentence":"An accident held ___ the traffic for two hours.","hint":"delay","explanation":"hold up = delay."},{"answer":"run","accept":[],"options":["used","gone","taken","run"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve ___ out of milk \u2014 could you get some more?","hint":"have none left","explanation":"\u0027Run out of\u0027 = exhaust the supply."}]}