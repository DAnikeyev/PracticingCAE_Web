{"id":"phrasal-verbs-0186","taskId":"phrasal-verbs","title":"Drill set 186","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["out","off","away","on"],"base":null,"keyword":null,"lead":null,"sentence":"The scientists carried ___ a series of experiments.","hint":"perform, conduct","explanation":"carry out = perform, conduct (research, a plan, an order)."},{"answer":"turned","accept":[],"options":["let","taken","turned","put"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ down an offer from a rival university.","hint":"refuse","explanation":"\u0027Turn down an offer\u0027 = refuse it."},{"answer":"without","accept":[],"options":["out","off","away","without"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve decided to do ___ a holiday this year.","hint":"live without sth","explanation":"do without = manage without having something."},{"answer":"broke","accept":[],"options":["broke","cut","fell","let"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."},{"answer":"through","accept":[],"options":["off","over","out","through"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been going ___ a difficult time at work.","hint":"experience sth unpleasant","explanation":"go through = experience something difficult."},{"answer":"off","accept":[],"options":["in","up","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"The two founders hit it ___ immediately.","hint":"like each other at once","explanation":"hit it off = like each other and become friendly quickly."},{"answer":"setting","accept":[],"options":["putting","sitting","setting","standing"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ up a new office in the old warehouse district.","hint":"establish","explanation":"\u0027Set up\u0027 = create or establish."},{"answer":"up","accept":[],"options":["over","out","up","on"],"base":null,"keyword":null,"lead":null,"sentence":"Hurry ___ or we\u0027ll miss the ferry!","hint":"be quick","explanation":"hurry up = do something faster."}]}