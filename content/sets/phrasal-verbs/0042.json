{"id":"phrasal-verbs-0042","taskId":"phrasal-verbs","title":"Drill set 42","text":null,"source":"drill","gaps":[{"answer":"up","accept":[],"options":["up","with","out","over"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve mixed ___ the twins\u0027 names again.","hint":"confuse two things","explanation":"mix up = confuse one thing/person with another."},{"answer":"down","accept":[],"options":["in","down","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."},{"answer":"off","accept":[],"options":["down","up","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"The judge let him ___ with a warning.","hint":"not punish","explanation":"let somebody off = not punish them, or give a light punishment."},{"answer":"off","accept":[],"options":["up","off","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"Sales figures have tailed ___ since the summer.","hint":"gradually decrease","explanation":"tail off = gradually become less."},{"answer":"run","accept":[],"options":["gone","run","taken","used"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve ___ out of milk \u2014 could you get some more?","hint":"have none left","explanation":"\u0027Run out of\u0027 = exhaust the supply."},{"answer":"with","accept":[],"options":["with","against","for","to"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."},{"answer":"setting","accept":[],"options":["setting","sitting","putting","standing"],"base":null,"keyword":null,"lead":null,"sentence":"They\u0027re ___ up a new office in the old warehouse district.","hint":"establish","explanation":"\u0027Set up\u0027 = create or establish."},{"answer":"up","accept":[],"options":["up","on","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s hard to keep ___ with the latest slang.","hint":"stay level with","explanation":"keep up with = stay level with somebody/something changing."}]}