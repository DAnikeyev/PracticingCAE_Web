{"id":"phrasal-verbs-0054","taskId":"phrasal-verbs","title":"Drill set 54","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":["out","up","away","off"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"through","accept":[],"options":["over","into","through","across"],"base":null,"keyword":null,"lead":null,"sentence":"It took the committee weeks to wade ___ the paperwork.","hint":"wade ___ = plod through a lot of","explanation":"\u0027Wade through\u0027 = work slowly through a large amount of tedious material."},{"answer":"away","accept":[],"options":["off","up","away","out"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"up","accept":[],"options":["up","out","off","down"],"base":null,"keyword":null,"lead":null,"sentence":"She waited at the restaurant for an hour, but he had stood her ___ again.","hint":"stand sb ___ = fail to appear","explanation":"\u0027Stand somebody up\u0027 = fail to keep an arranged meeting."},{"answer":"out","accept":[],"options":["over","up","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."},{"answer":"seeing","accept":[],"options":["be seeing","seeing","have seen","see"],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m really looking forward to ___ you again soon.","hint":"look forward to \u002B noun/-ing","explanation":"look forward TO \u002B -ing: \u0027to\u0027 is a preposition here."},{"answer":"down","accept":[],"options":["up","out","off","down"],"base":null,"keyword":null,"lead":null,"sentence":"Calm ___ \u2014 everything is under control.","hint":"stop being angry","explanation":"calm down = become less angry/upset."},{"answer":"after","accept":[],"options":["up","into","after","for"],"base":null,"keyword":null,"lead":null,"sentence":"Please could you look ___ my plants while I\u0027m away?","hint":"care for","explanation":"\u0027Look after\u0027 = take care of."}]}