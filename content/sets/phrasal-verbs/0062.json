{"id":"phrasal-verbs-0062","taskId":"phrasal-verbs","title":"Drill set 62","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["by","in","up","for"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"broke","accept":[],"options":["cut","let","fell","broke"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."},{"answer":"up","accept":[],"options":["on","over","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"down","accept":[],"options":["down","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"The ministry tried to play ___ the incident.","hint":"make sth seem less serious","explanation":"play down = make something seem less important (opposite: play up)."},{"answer":"up","accept":[],"options":["up","out","on","over"],"base":null,"keyword":null,"lead":null,"sentence":"Their son grew ___ and moved abroad.","hint":"become adult","explanation":"grow up = become an adult."},{"answer":"up","accept":[],"options":["out","after","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"If you don\u0027t know the word, look it ___ in a dictionary.","hint":"find information","explanation":"look a word up = find it in a dictionary/reference."},{"answer":"through","accept":[],"options":["off","through","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been going ___ a difficult time at work.","hint":"experience sth unpleasant","explanation":"go through = experience something difficult."},{"answer":"up","accept":[],"options":["up","over","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"The evidence finally backed ___ his version of events.","hint":"supported, confirmed","explanation":"back up = support with evidence (a claim backs up a story)."}]}