{"id":"phrasal-verbs-0011","taskId":"phrasal-verbs","title":"Drill set 11","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["up","for","in","by"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"off","accept":[],"options":["out","up","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"The match was called ___ because of the storm.","hint":"cancel","explanation":"call off = cancel an event."},{"answer":"for","accept":[],"options":["on","up","to","for"],"base":null,"keyword":null,"lead":null,"sentence":"Many consumers now opt ___ cheaper brands.","hint":"choose","explanation":"opt for something = choose it."},{"answer":"out","accept":[],"options":["away","up","off","out"],"base":null,"keyword":null,"lead":null,"sentence":"Several runners passed ___ in the heat.","hint":"faint","explanation":"pass out = faint."},{"answer":"out","accept":[],"options":["out","up","off","over"],"base":null,"keyword":null,"lead":null,"sentence":"The flood wiped ___ the entire harvest.","hint":"destroy completely","explanation":"wipe out = destroy completely."},{"answer":"up","accept":[],"options":["up","off","out","over"],"base":null,"keyword":null,"lead":null,"sentence":"This old house needs doing ___ before winter.","hint":"repair and decorate","explanation":"do up = repair and decorate a building. (British usage)"},{"answer":"without","accept":[],"options":["away","out","without","off"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve decided to do ___ a holiday this year.","hint":"live without sth","explanation":"do without = manage without having something."},{"answer":"down","accept":[],"options":["up","out","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"The team was let ___ by its own supporters.","hint":"disappoint","explanation":"let somebody down = disappoint them by failing to help."}]}