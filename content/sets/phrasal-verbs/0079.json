{"id":"phrasal-verbs-0079","taskId":"phrasal-verbs","title":"Drill set 79","text":null,"source":"drill","gaps":[{"answer":"off","accept":[],"options":["over","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"The plane will drop ___ the parcels at the next farm.","hint":"deliver sb/sth","explanation":"drop off = deliver somebody/something; also become less (sales dropped off)."},{"answer":"down","accept":[],"options":["up","in","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."},{"answer":"out","accept":[],"options":["up","over","out","off"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t figure ___ how this app works.","hint":"understand after thinking","explanation":"figure out = understand after thinking."},{"answer":"out","accept":[],"options":["off","out","over","up"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."},{"answer":"for","accept":[],"options":["up","by","for","in"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"off","accept":[],"options":["off","down","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"The factory laid ___ two hundred workers.","hint":"dismiss (no fault)","explanation":"lay off = dismiss workers because there is not enough work."},{"answer":"on","accept":["along"],"options":["through","on","by","over"],"base":null,"keyword":null,"lead":null,"sentence":"Do you get ___ well with your new colleagues?","hint":"have a good relationship","explanation":"get on (with) = have a good relationship; also get along with (AmE)."},{"answer":"off","accept":[],"options":["out","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"The match kicks ___ at three o\u0027clock.","hint":"start (a match)","explanation":"kick off = (of a match) start."}]}