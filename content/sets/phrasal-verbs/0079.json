{"id":"phrasal-verbs-0079","taskId":"phrasal-verbs","title":"Drill set 79","text":null,"source":"drill","gaps":[{"answer":"down","accept":[],"options":["down","up","about","off"],"base":null,"keyword":null,"lead":null,"sentence":"The scandal brought ___ the government.","hint":"cause to lose power","explanation":"bring down = cause a government/person to lose power; reduce (prices)."},{"answer":"in","accept":[],"options":["in","up","off","away"],"base":null,"keyword":null,"lead":null,"sentence":"The negotiators refused to give ___ to the hijackers\u0027 demands.","hint":"stop resisting","explanation":"give in (to) = stop arguing and accept; give up = quit."},{"answer":"away","accept":[],"options":["away","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"up","accept":[],"options":["up","off","in","out"],"base":null,"keyword":null,"lead":null,"sentence":"The subject cropped ___ again at dinner.","hint":"appear unexpectedly","explanation":"crop up = appear or happen unexpectedly."},{"answer":"up","accept":[],"options":["up","on","over","in"],"base":null,"keyword":null,"lead":null,"sentence":"A sales rep will follow ___ your enquiry next week.","hint":"take further action","explanation":"follow up = take further action after something."},{"answer":"up","accept":[],"options":["up","on","out","over"],"base":null,"keyword":null,"lead":null,"sentence":"Wake ___ \u2014 you\u0027ll be late for school!","hint":"stop sleeping","explanation":"wake up = stop sleeping."},{"answer":"off","accept":[],"options":["off","in","up","down"],"base":null,"keyword":null,"lead":null,"sentence":"The band broke ___ in the middle of the song.","hint":"stop suddenly","explanation":"break off = stop suddenly (speaking, engagement)."},{"answer":"with","accept":[],"options":["with","for","to","against"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."}]}