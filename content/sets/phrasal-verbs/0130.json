{"id":"phrasal-verbs-0130","taskId":"phrasal-verbs","title":"Drill set 130","text":null,"source":"drill","gaps":[{"answer":"away","accept":[],"options":["off","up","out","away"],"base":null,"keyword":null,"lead":null,"sentence":"Her grandfather passed ___ last spring.","hint":"die (polite)","explanation":"pass away = die (a polite expression)."},{"answer":"for","accept":[],"options":["on","for","to","up"],"base":null,"keyword":null,"lead":null,"sentence":"Many consumers now opt ___ cheaper brands.","hint":"choose","explanation":"opt for something = choose it."},{"answer":"about","accept":[],"options":["out","about","up","on"],"base":null,"keyword":null,"lead":null,"sentence":"The strike brought ___ major changes in the law.","hint":"cause to happen","explanation":"bring about = cause to happen."},{"answer":"for","accept":[],"options":["by","up","for","in"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"off","accept":[],"options":["off","down","in","up"],"base":null,"keyword":null,"lead":null,"sentence":"The band broke ___ in the middle of the song.","hint":"stop suddenly","explanation":"break off = stop suddenly (speaking, engagement)."},{"answer":"on","accept":[],"options":["up","on","at","to"],"base":null,"keyword":null,"lead":null,"sentence":"Looking back ___ it, the risk was worth taking.","hint":"remember, reconsider","explanation":"look back ON something = remember and think about the past."},{"answer":"through","accept":[],"options":["through","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"The doctors pulled him ___ after a difficult night.","hint":"survive illness","explanation":"pull through = recover from a serious illness."},{"answer":"on","accept":[],"options":["up","off","away","on"],"base":null,"keyword":null,"lead":null,"sentence":"Put ___ your coat \u2014 it\u0027s freezing outside.","hint":"dress in","explanation":"put on = dress in; put off = postpone."}]}