{"id":"phrasal-verbs-0036","taskId":"phrasal-verbs","title":"Drill set 36","text":null,"source":"drill","gaps":[{"answer":"turned","accept":[],"options":["taken","put","turned","let"],"base":null,"keyword":null,"lead":null,"sentence":"She ___ down an offer from a rival university.","hint":"refuse","explanation":"\u0027Turn down an offer\u0027 = refuse it."},{"answer":"on","accept":["up"],"options":["out","on","up","in"],"base":null,"keyword":null,"lead":null,"sentence":"Hold ___ a moment \u2014 I\u0027ll check if he\u0027s in.","hint":"wait (phone)","explanation":"hold on = wait (especially on the phone)."},{"answer":"out","accept":[],"options":["over","off","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"We found ___ that the flight had been cancelled.","hint":"discover","explanation":"find out = discover information."},{"answer":"broke","accept":[],"options":["cut","fell","let","broke"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."},{"answer":"down","accept":[],"options":["off","down","up","about"],"base":null,"keyword":null,"lead":null,"sentence":"The scandal brought ___ the government.","hint":"cause to lose power","explanation":"bring down = cause a government/person to lose power; reduce (prices)."},{"answer":"for","accept":[],"options":["in","up","by","for"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"in","accept":[],"options":["on","in","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"She keyed ___ the password and logged on.","hint":"type (a password)","explanation":"key in = type in (a password, code)."},{"answer":"down","accept":[],"options":["over","up","down","off"],"base":null,"keyword":null,"lead":null,"sentence":"I had to turn ___ their invitation because I was ill.","hint":"reject","explanation":"turn down = reject an offer/invitation; turn up = appear."}]}