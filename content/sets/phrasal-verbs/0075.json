{"id":"phrasal-verbs-0075","taskId":"phrasal-verbs","title":"Drill set 75","text":null,"source":"drill","gaps":[{"answer":"up","accept":[],"options":["up","off","down","in"],"base":null,"keyword":null,"lead":null,"sentence":"They broke ___ after only two years of marriage.","hint":"end a relationship","explanation":"break up = end a relationship."},{"answer":"for","accept":[],"options":["on","up","to","for"],"base":null,"keyword":null,"lead":null,"sentence":"Many consumers now opt ___ cheaper brands.","hint":"choose","explanation":"opt for something = choose it."},{"answer":"with","accept":[],"options":["to","for","with","against"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."},{"answer":"out","accept":[],"options":["up","out","in","off"],"base":null,"keyword":null,"lead":null,"sentence":"The store decided to branch ___ into online sales.","hint":"expand into new areas","explanation":"branch out = start doing something new and different."},{"answer":"ahead","accept":[],"options":["off","along","ahead","under"],"base":null,"keyword":null,"lead":null,"sentence":"If the strike goes ___, deliveries will stop nationwide.","hint":"go ___ = proceed","explanation":"\u0027Go ahead\u0027 = proceed as planned."},{"answer":"for","accept":[],"options":["up","out","for","over"],"base":null,"keyword":null,"lead":null,"sentence":"The new stadium made ___ an impressive sight.","hint":"produce a result","explanation":"make for = produce a particular result (make for a good atmosphere); also move towards."},{"answer":"down","accept":[],"options":["down","about","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"The scandal brought ___ the government.","hint":"cause to lose power","explanation":"bring down = cause a government/person to lose power; reduce (prices)."},{"answer":"broke","accept":[],"options":["cut","let","broke","fell"],"base":null,"keyword":null,"lead":null,"sentence":"The car ___ down on the motorway and had to be towed.","hint":"stop working","explanation":"\u0027Break down\u0027 = stop functioning (vehicle or machine)."}]}