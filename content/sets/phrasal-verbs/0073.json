{"id":"phrasal-verbs-0073","taskId":"phrasal-verbs","title":"Drill set 73","text":null,"source":"drill","gaps":[{"answer":"of","accept":[],"options":["of","off","from","up"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve run out ___ coffee again.","hint":"have none left","explanation":"run out OF something = have none left."},{"answer":"out","accept":[],"options":["out","off","up","over"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."},{"answer":"down","accept":[],"options":["off","up","down","in"],"base":null,"keyword":null,"lead":null,"sentence":"The car broke ___ on the motorway.","hint":"stop working (vehicle)","explanation":"break down = stop working (machines/vehicles)."},{"answer":"run","accept":[],"options":["gone","used","run","taken"],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ve ___ out of milk \u2014 could you get some more?","hint":"have none left","explanation":"\u0027Run out of\u0027 = exhaust the supply."},{"answer":"for","accept":[],"options":["by","in","up","for"],"base":null,"keyword":null,"lead":null,"sentence":"What does UNESCO stand ___?","hint":"represent, mean","explanation":"stand for = represent (letters, initials, principles)."},{"answer":"off","accept":[],"options":["down","out","off","up"],"base":null,"keyword":null,"lead":null,"sentence":"Our street was cut ___ for three hours after the storm.","hint":"disconnected","explanation":"cut off = disconnected (power, phone); isolate (a village cut off by snow)."},{"answer":"with","accept":[],"options":["to","for","with","against"],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t put up ___ this noise any longer.","hint":"tolerate","explanation":"put up with = tolerate, endure."},{"answer":"in","accept":["out"],"options":["over","up","out","in"],"base":null,"keyword":null,"lead":null,"sentence":"Please fill ___ this form and sign at the bottom.","hint":"complete a document","explanation":"fill in/out a form (British prefers in)."}]}