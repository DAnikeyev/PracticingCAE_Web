{"id":"phrasal-verbs-0025","taskId":"phrasal-verbs","title":"Drill set 25","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":["to","for","up","on"],"base":null,"keyword":null,"lead":null,"sentence":"Many consumers now opt ___ cheaper brands.","hint":"choose","explanation":"opt for something = choose it."},{"answer":"up","accept":[],"options":["on","up","over","out"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t worry \u2014 he always turns ___ late.","hint":"arrive, appear","explanation":"turn up = arrive, often unexpectedly or late."},{"answer":"down","accept":[],"options":["down","off","out","up"],"base":null,"keyword":null,"lead":null,"sentence":"Calm ___ \u2014 everything is under control.","hint":"stop being angry","explanation":"calm down = become less angry/upset."},{"answer":"up","accept":[],"options":["off","in","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"Lawyers are drawing ___ the contract now.","hint":"prepare a document","explanation":"draw up = prepare and write (a contract, list, plan)."},{"answer":"on","accept":[],"options":["on","in","up","out"],"base":null,"keyword":null,"lead":null,"sentence":"Hang ___ \u2014 this won\u0027t take long.","hint":"wait","explanation":"hang on = wait a moment."},{"answer":"up","accept":[],"options":["down","up","off","in"],"base":null,"keyword":null,"lead":null,"sentence":"They broke ___ after only two years of marriage.","hint":"end a relationship","explanation":"break up = end a relationship."},{"answer":"on","accept":["along"],"options":["through","on","over","by"],"base":null,"keyword":null,"lead":null,"sentence":"Do you get ___ well with your new colleagues?","hint":"have a good relationship","explanation":"get on (with) = have a good relationship; also get along with (AmE)."},{"answer":"out","accept":[],"options":["over","out","up","off"],"base":null,"keyword":null,"lead":null,"sentence":"Don\u0027t leave ___ any details in your report.","hint":"omit","explanation":"leave out = not include, omit."}]}