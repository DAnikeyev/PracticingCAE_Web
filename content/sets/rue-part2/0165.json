{"id":"rue-part2-0165","taskId":"rue-part2","title":"Drill set 165","text":null,"source":"drill","gaps":[{"answer":"start","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better ___ going \u2014 it\u0027s nearly midnight.","hint":"had better \u002B bare inf","explanation":"\u0027had better \u002B infinitive without to\u0027."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"to get","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ to the station from here?","hint":"question word \u002B ?","explanation":"\u0027question word \u002B to-infinitive\u0027: how to get."},{"answer":"miss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re going to ___ our flight if we don\u0027t hurry.","hint":"be too late for a plane","explanation":"\u0027miss a flight/train/bus\u0027 = arrive too late for it."},{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."}]}