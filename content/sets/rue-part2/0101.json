{"id":"rue-part2-0101","taskId":"rue-part2","title":"Drill set 101","text":null,"source":"drill","gaps":[{"answer":"miss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re going to ___ our flight if we don\u0027t hurry.","hint":"be too late for a plane","explanation":"\u0027miss a flight/train/bus\u0027 = arrive too late for it."},{"answer":"should","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You ___ have seen a doctor sooner.","hint":"past advice","explanation":"\u0027should have \u002B participle\u0027 criticises a past decision."},{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people as subject."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"is","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Neither of the answers ___ correct.","hint":"neither \u002B singular verb","explanation":"\u0027Neither of \u002B plural noun \u002B singular verb\u0027 (formal English)."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"delicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence