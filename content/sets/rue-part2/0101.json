{"id":"rue-part2-0101","taskId":"rue-part2","title":"Drill set 101","text":null,"source":"drill","gaps":[{"answer":"such","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ a good film that we saw it twice.","hint":"such \u002B a \u002B adj \u002B noun","explanation":"\u0027such (\u002Ba) \u002B adjective \u002B noun \u002B that\u2026\u0027"},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly ___ sat down when the phone rang.","hint":"inversion after hardly","explanation":"\u0027Hardly had \u002B subject \u002B participle\u2026 when\u2026\u0027"},{"answer":"painted","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We had the walls ___ last month.","hint":"causative have","explanation":"\u0027have something done\u0027 = arrange for it to be done: had the walls painted."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."}]}