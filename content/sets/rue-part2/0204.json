{"id":"rue-part2-0204","taskId":"rue-part2","title":"Drill set 204","text":null,"source":"drill","gaps":[{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"since","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s lived here ___ 2015.","hint":"point in time","explanation":"\u0027since \u002B point in time\u0027; \u0027for \u002B period\u0027."},{"answer":"herself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She should be ashamed of ___ for saying that.","hint":"reflexive: she \u2192 ?","explanation":"ashamed of \u002B reflexive: herself."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new law comes ___ force next month.","hint":"come ___ force","explanation":"\u0027come into force\u0027 = officially start to apply."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There was so ___ confusion that the event was abandoned.","hint":"uncountable","explanation":"so much \u002B uncountable noun (confusion)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is ___ repair, so traffic uses the bypass.","hint":"being fixed","explanation":"\u0027Under repair\u0027 = being repaired."}]}