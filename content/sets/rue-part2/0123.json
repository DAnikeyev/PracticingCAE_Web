{"id":"rue-part2-0123","taskId":"rue-part2","title":"Drill set 123","text":null,"source":"drill","gaps":[{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027need \u002B -ing\u0027 = need to be \u002B participle: needs cleaning."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"miss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re going to ___ our flight if we don\u0027t hurry.","hint":"be too late for a plane","explanation":"\u0027miss a flight/train/bus\u0027 = arrive too late for it."},{"answer":"was","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge ___ built in 1892.","hint":"past passive","explanation":"Past simple passive: was \u002B participle."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"start","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better ___ going \u2014 it\u0027s nearly midnight.","hint":"had better \u002B bare inf","explanation":"\u0027had better \u002B infinitive without to\u0027."},{"answer":"sight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He ran so fast that we lost ___ of him.","hint":"lose ___ of somebody","explanation":"\u0027lose sight of somebody\u0027 = no longer see them."}]}