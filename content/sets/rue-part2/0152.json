{"id":"rue-part2-0152","taskId":"rue-part2","title":"Drill set 152","text":null,"source":"drill","gaps":[{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By the time we arrived, the film ___ already started.","hint":"earlier past action","explanation":"Past perfect for the earlier of two past events."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We ran out ___ petrol on the motorway.","hint":"run out ___ sth","explanation":"\u0027run out OF something\u0027 = have none left."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"watching","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ TV all morning.","hint":"action all morning","explanation":"Present perfect continuous for duration up to now: has been watching."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He prefers cycling ___ driving to work.","hint":"prefer A ___ B","explanation":"\u0027prefer A TO B\u0027."},{"answer":"off","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane took ___ despite the thick fog.","hint":"leave the ground","explanation":"\u0027Take off\u0027 = leave the ground."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."}]}