{"id":"rue-part2-0047","taskId":"rue-part2","title":"Drill set 47","text":null,"source":"drill","gaps":[{"answer":"at the moment","accept":["currently","right now","now"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s not in the office ___ \u2014 try her mobile.","hint":"now, temporarily","explanation":"\u0027at the moment\u0027 = right now (temporary)."},{"answer":"working","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s used to ___ long hours.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = accustomed to."},{"answer":"are","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letters ___ delivered every morning at eight.","hint":"present passive","explanation":"Present simple passive: are \u002B participle."},{"answer":"herself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She should be ashamed of ___ for saying that.","hint":"reflexive: she \u2192 ?","explanation":"ashamed of \u002B reflexive: herself."},{"answer":"will have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By this time next year, she ___ finished her degree.","hint":"future perfect","explanation":"Future perfect: will have \u002B participle by a future point."},{"answer":"delicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup tastes ___ \u2014 did you use fresh herbs?","hint":"taste \u002B adjective","explanation":"\u0027taste/smell/feel \u002B adjective\u0027: tastes delicious."},{"answer":"talking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He kept ___ even though everyone had left.","hint":"keep \u002B -ing","explanation":"\u0027keep \u002B -ing\u0027 = continue doing."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj