{"id":"rue-part2-0147","taskId":"rue-part2","title":"Drill set 147","text":null,"source":"drill","gaps":[{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people as subject."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was accused ___ stealing the confidential documents.","hint":"accused ___ doing something","explanation":"\u0027Accuse somebody of doing something\u0027 \u2014 the preposition is fixed."},{"answer":"didn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"\u0027would rather \u002B subject \u002B past simple\u0027."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"arrived","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The parcel ___ yesterday, but we weren\u0027t home.","hint":"past event","explanation":"Past simple for a finished past event."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is ___ repair, so traffic uses the bypass.","hint":"being fixed","explanation":"\u0027Under repair\u0027 = being repaired."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s recovering ___ a knee operation.","hint":"recover ___ sth","explanation":"\u0027recover FROM an illness/operation\u0027."}]}