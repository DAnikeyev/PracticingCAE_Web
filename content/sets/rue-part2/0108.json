{"id":"rue-part2-0108","taskId":"rue-part2","title":"Drill set 108","text":null,"source":"drill","gaps":[{"answer":"help","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t ___ laughing at his accent.","hint":"can\u0027t help \u002B -ing","explanation":"\u0027can\u0027t help \u002B -ing\u0027 = can\u0027t stop yourself."},{"answer":"eating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not used to ___ such spicy food.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = be accustomed to."},{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"whose","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the man ___ car was stolen.","hint":"possessive relative","explanation":"\u0027whose\u0027 shows possession: the man whose car\u2026"},{"answer":"when","accept":["once","after"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ll start the meeting ___ everyone arrives.","hint":"time conjunction","explanation":"\u0027when/once/until\u0027 \u2014 here \u0027when everyone arrives\u0027 starts the event."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."}]}