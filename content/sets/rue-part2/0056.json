{"id":"rue-part2-0056","taskId":"rue-part2","title":"Drill set 56","text":null,"source":"drill","gaps":[{"answer":"do","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She made me ___ my homework before dinner.","hint":"make \u002B bare infinitive","explanation":"\u0027make somebody do\u0027 \u2014 bare infinitive after the object."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier past event","explanation":"Past perfect for the earlier of two past moments."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was held ___ strict secrecy.","hint":"held ___ secrecy","explanation":"\u0027in secrecy/in private\u0027 \u2014 fixed preposition use."},{"answer":"breathtaking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The view from the top was ___ .","hint":"extremely impressive","explanation":"\u0027breathtaking\u0027 = so beautiful it takes your breath away."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was sacked ___ repeatedly arriving late.","hint":"sacked ___ doing sth","explanation":"\u0027be sacked/fired FOR doing something\u0027."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He asked me where I ___ bought the shoes.","hint":"backshift to past perfect","explanation":"Reported speech: \u0027Where did you buy\u2026?\u0027 \u2192 asked where I had bought."},{"answer":"taking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ the last piece of cake.","hint":"deny \u002B g