{"id":"rue-part2-0030","taskId":"rue-part2","title":"Drill set 30","text":null,"source":"drill","gaps":[{"answer":"breaking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the vase, though the camera saw him.","hint":"deny \u002B -ing","explanation":"\u0027deny \u002B -ing\u0027."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"taller","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the ___ of the two brothers.","hint":"comparative for two","explanation":"With two items, use the comparative with \u0027the\u0027: the taller of the two."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."},{"answer":"miss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re going to ___ our flight if we don\u0027t hurry.","hint":"be too late for a plane","explanation":"\u0027miss a flight/train/bus\u0027 = arrive too late for it."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something