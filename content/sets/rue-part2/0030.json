{"id":"rue-part2-0030","taskId":"rue-part2","title":"Drill set 30","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I wish I ___ told him the truth at the time.","hint":"past regret","explanation":"\u0027wish \u002B past perfect\u0027 for regret about the past."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"taller","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the ___ of the two brothers.","hint":"comparative for two","explanation":"With two items, use the comparative with \u0027the\u0027: the taller of the two."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"created","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has ___ several new jobs in the area.","hint":"bring new jobs into existence","explanation":"\u0027Create jobs\u0027 is the natural collocation."},{"answer":"despite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She got the job ___ of her lack of experience.","hint":"despite \u002B noun","explanation":"\u0027despite/in spite of \u002B noun\u0027 \u2014 not \u0027despite of\u0027."},{"answer":"sight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He ran so fast that we lost ___ of him.","hint":"lose ___ of somebody","explanation":"\u0027lose