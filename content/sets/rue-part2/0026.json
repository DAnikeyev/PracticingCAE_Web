{"id":"rue-part2-0026","taskId":"rue-part2","title":"Drill set 26","text":null,"source":"drill","gaps":[{"answer":"were","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"If I ___ you, I\u0027d apologise immediately.","hint":"unreal second conditional","explanation":"\u0027If I were you\u0027 \u2014 subjunctive \u0027were\u0027 for unreal situations."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"Despite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ being nervous, she delivered a flawless speech.","hint":"although she was","explanation":"\u0027Despite being nervous\u0027 \u2014 concession \u002B gerund."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The athlete was banned ___ competing for two years.","hint":"ban somebody ___ doing","explanation":"\u0027Ban somebody from doing something\u0027 is the fixed pattern."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ Lisbon at dawn.","hint":"arrive ___ city","explanation":"\u0027arrive IN\u0027 cities and countries."},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of jou