{"id":"rue-part2-0053","taskId":"rue-part2","title":"Drill set 53","text":null,"source":"drill","gaps":[{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"if","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He walked in as ___ nothing had happened.","hint":"as if \u002B unreal past","explanation":"\u0027as if \u002B past\u0027 for unreal comparison."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the trip was a great success.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = mostly, in general."},{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."},{"answer":"no","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t reach the shelf, ___ how tall I am.","hint":"no matter how \u2026","explanation":"\u0027No matter how tall\u0027 = however tall."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"where","accept":["in which"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This is the village ___ my grandmother was born.","hint":"place relative","explanation":"\u0027where\u0027 = in which (place)."},{"answer":"were","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Not only ___ the tickets overpriced, but the seating was appalling.","hint":"inversion after Not only (plural subject)","explanation":"\u0027Not only\u0027 at the front inverts the verb: Not only were the tickets\u2026 but\u2026"}]}