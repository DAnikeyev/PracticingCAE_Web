{"id":"rue-part2-0097","taskId":"rue-part2","title":"Drill set 97","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He prefers cycling ___ driving to work.","hint":"prefer A ___ B","explanation":"\u0027prefer A TO B\u0027."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"when","accept":["once","after"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ll start the meeting ___ everyone arrives.","hint":"time conjunction","explanation":"\u0027when/once/until\u0027 \u2014 here \u0027when everyone arrives\u0027 starts the event."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We arrived ___ Lisbon at dawn.","hint":"arrive ___ city","explanation":"\u0027arrive IN\u0027 cities and countries."},{"answer":"will have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By this time next year, she ___ finished her degree.","hint":"future perfect","explanation":"Future perfect: will have \u002B participle by a future point."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"will be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The roof ___ repaired next week.","hint":"future passive","explanation":"Future passive: will be \u002B participle."},{"answer":"than","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"No sooner had he arrived ___ it started to rain.","hint":"no sooner \u2026 ?","explanation":"\u0027No sooner \u2026 than\u2026\u0027 \u2014 fixed pair."}]}