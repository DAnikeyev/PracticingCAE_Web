{"id":"rue-part2-0022","taskId":"rue-part2","title":"Drill set 22","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He asked me where I ___ bought the shoes.","hint":"backshift to past perfect","explanation":"Reported speech: \u0027Where did you buy\u2026?\u0027 \u2192 asked where I had bought."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"whose","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the man ___ car was stolen.","hint":"possessive relative","explanation":"\u0027whose\u0027 shows possession: the man whose car\u2026"},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"to wait","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was made ___ for three hours at the airport.","hint":"passive of make","explanation":"Passive \u0027be made\u0027 takes to-infinitive: was made to wait."},{"answer":"such","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ a good film that we saw it twice.","hint":"such \u002B