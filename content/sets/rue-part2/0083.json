{"id":"rue-part2-0083","taskId":"rue-part2","title":"Drill set 83","text":null,"source":"drill","gaps":[{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"Neither","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ of my parents speaks French, so I translate for them.","hint":"not one, not the other","explanation":"\u0027Neither of\u0027 = not one and not the other (two people)."},{"answer":"will","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like to know when the results ___ be published.","hint":"reported future","explanation":"Future in a noun clause: when the results will be published."},{"answer":"too","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ many customers for the staff to serve properly.","hint":"more than enough","explanation":"\u0027Too many \u2026 to \u2026\u0027 \u2014 excess preventing an outcome."},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the trip was a great success.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = mostly, in general."},{"answer":"was","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge ___ built in 1892.","hint":"past passive","explanation"