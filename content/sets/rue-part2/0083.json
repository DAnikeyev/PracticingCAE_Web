{"id":"rue-part2-0083","taskId":"rue-part2","title":"Drill set 83","text":null,"source":"drill","gaps":[{"answer":"into","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The new law comes ___ force next month.","hint":"come ___ force","explanation":"\u0027come into force\u0027 = officially start to apply."},{"answer":"will have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By this time next year, she ___ finished her degree.","hint":"future perfect","explanation":"Future perfect: will have \u002B participle by a future point."},{"answer":"interrupt","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d better not ___ you \u2014 you look busy.","hint":"had better not \u002B bare inf","explanation":"\u0027had better \u002B not \u002B infinitive without to\u0027."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s recovering ___ a knee operation.","hint":"recover ___ sth","explanation":"\u0027recover FROM an illness/operation\u0027."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."},{"answer":"eaten","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s the first time I\u0027ve ___ this dish.","hint":"present perfect \u002B past participle","explanation":"\u0027It\u0027s the first time \u002B present perfect\u0027: have eaten."}]}