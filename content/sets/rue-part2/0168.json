{"id":"rue-part2-0168","taskId":"rue-part2","title":"Drill set 168","text":null,"source":"drill","gaps":[{"answer":"so","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ dull a lecture that people walked out.","hint":"so \u002B adjective \u002B a\u2026","explanation":"so \u002B adjective (\u002Ba \u002B noun) \u002B that\u2026 \u2014 the alternative emphatic pattern."},{"answer":"sight","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He ran so fast that we lost ___ of him.","hint":"lose ___ of somebody","explanation":"\u0027lose sight of somebody\u0027 = no longer see them."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"couldn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"No matter how hard he pulled, he ___ open the drawer.","hint":"unable in the past","explanation":"\u0027Couldn\u0027t open it\u0027 \u2014 past inability."},{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She prides herself ___ her punctuality.","hint":"pride oneself ___ sth","explanation":"\u0027Pride oneself on something\u0027 is the reflexive collocation (formal \u0027upon\u0027 is also possible)."}]}