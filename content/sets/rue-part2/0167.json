{"id":"rue-part2-0167","taskId":"rue-part2","title":"Drill set 167","text":null,"source":"drill","gaps":[{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people as subject."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier past event","explanation":"Past perfect for the earlier of two past moments."},{"answer":"gave","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s time we ___ this room a good clean.","hint":"it\u0027s time \u002B past","explanation":"\u0027It\u0027s time \u002B subject \u002B past simple\u0027 (unreal past)."},{"answer":"since","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s lived here ___ 2015.","hint":"point in time","explanation":"\u0027since \u002B point in time\u0027; \u0027for \u002B period\u0027."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was sacked ___ repeatedly arriving late.","hint":"sacked ___ doing sth","explanation":"\u0027be sacked/fired FOR doing something\u0027."},{"answer":"interrupt","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u