{"id":"rue-part2-0077","taskId":"rue-part2","title":"Drill set 77","text":null,"source":"drill","gaps":[{"answer":"are","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letters ___ delivered every morning at eight.","hint":"present passive","explanation":"Present simple passive: are \u002B participle."},{"answer":"to have been caused","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The fire is believed ___ by faulty wiring.","hint":"passive reporting, past passive infinitive","explanation":"\u0027believed to have been \u002B participle\u0027 \u2014 the cause was earlier."},{"answer":"at","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s very good ___ explaining difficult ideas.","hint":"good ___ doing","explanation":"\u0027good AT \u002B -ing\u0027."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."},{"answer":"taking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ the money.","hint":"deny \u002B -ing","explanation":"\u0027deny \u002B -ing\u0027 (or having \u002B participle)."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"My brother works ___ a hospital in Leeds.","hint":"building (BrE: not as a patient)","explanation":"\u0027in a hospital\u0027 = inside the building; \u0027at hospital\u0027 would mean as a patient (BrE)."}]}