{"id":"rue-part2-0054","taskId":"rue-part2","title":"Drill set 54","text":null,"source":"drill","gaps":[{"answer":"when","accept":["once","after"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ll start the meeting ___ everyone arrives.","hint":"time conjunction","explanation":"\u0027when/once/until\u0027 \u2014 here \u0027when everyone arrives\u0027 starts the event."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather walk than ___ the bus.","hint":"would rather A than B","explanation":"\u0027would rather do A than do B\u0027 \u2014 both bare infinitives."},{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."},{"answer":"shut","accept":["closed"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She ___ the door quietly behind her.","hint":"close (single word)","explanation":"\u0027shut the door\u0027 = close it."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"such","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ a good film that we saw it twice.","hint":"such \u002B a \u002B adj \u002B noun","explanation":"\u0027such (\u002Ba) \u002B adjective \u002B noun \u002B that\u2026\u0027"},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027