{"id":"rue-part2-0112","taskId":"rue-part2","title":"Drill set 112","text":null,"source":"drill","gaps":[{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"were","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"If I ___ you, I\u0027d apologise immediately.","hint":"unreal second conditional","explanation":"\u0027If I were you\u0027 \u2014 subjunctive \u0027were\u0027 for unreal situations."},{"answer":"working","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s used to ___ long hours.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = accustomed to."},{"answer":"to know","accept":["to have"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you happen ___ her mobile number?","hint":"happen \u002B ? (by chance)","explanation":"\u0027happen to \u002B infinitive\u0027 = do something by chance."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"arguing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There\u0027s no point ___ about it now.","hint":"no point \u002B -ing","explanation":"\u0027there\u0027s no point \u002B -ing\u0027."},{"answer":"to get","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"D