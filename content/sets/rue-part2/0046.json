{"id":"rue-part2-0046","taskId":"rue-part2","title":"Drill set 46","text":null,"source":"drill","gaps":[{"answer":"when","accept":["once","after"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027ll start the meeting ___ everyone arrives.","hint":"time conjunction","explanation":"\u0027when/once/until\u0027 \u2014 here \u0027when everyone arrives\u0027 starts the event."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"best","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s far the ___ player in the team.","hint":"superlative after \u0027by far\u0027","explanation":"\u0027by far the best\u0027 \u2014 superlative with emphasiser."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier past event","explanation":"Past perfect for the earlier of two past moments."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly ___ sat down when the phone rang.","hint":"inversion after hardly","explanation":"\u0027Hardly had \u002B subject \u002B participle\u2026 when\u2026\u0027"},{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027need \u002B -ing\u0027 = need to be \u002B participle: needs cleaning."}]}