{"id":"rue-part2-0098","taskId":"rue-part2","title":"Drill set 98","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"such","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ a boring lecture that people walked out.","hint":"___ a \u002B adjective \u002B noun","explanation":"such (\u002Ba) \u002B adjective \u002B noun \u002B that\u2026 \u2014 emphasis structure."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"didn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"\u0027would rather \u002B subject \u002B past simple\u0027."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"interrupt","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d better not ___ you \u2014 you look busy.","hint":"had better not \u002B bare inf","explanation":"\u0027had better \u002B not \u002B infinitive without to\u0027."},{"answer":"to have been caused","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The fire is believed ___ by faulty wiring.","hint":"passive reporting, past passive infinitive","explanation":"\u0027believed to have been \u002B participle\u0027 \u2014 the cause was earlier."},{"answer":"herself","accept":[],"o