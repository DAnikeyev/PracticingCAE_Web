{"id":"rue-part2-0120","taskId":"rue-part2","title":"Drill set 120","text":null,"source":"drill","gaps":[{"answer":"to take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ some photos on the way.","hint":"stop in order to do","explanation":"\u0027stop to do\u0027 = pause in order to do something."},{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s the first time I\u0027ve ___ eaten oysters.","hint":"experience up to now","explanation":"\u0027The first time \u002B present perfect \u002B ever\u0027 emphasises novelty."},{"answer":"must","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You ___ be tired after such a long flight.","hint":"strong deduction","explanation":"\u0027must \u002B infinitive\u0027 = certain deduction about the present."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \