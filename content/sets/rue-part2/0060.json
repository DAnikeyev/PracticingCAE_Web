{"id":"rue-part2-0060","taskId":"rue-part2","title":"Drill set 60","text":null,"source":"drill","gaps":[{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By the time we arrived, the film ___ already started.","hint":"earlier past action","explanation":"Past perfect for the earlier of two past events."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"will be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The roof ___ repaired next week.","hint":"future passive","explanation":"Future passive: will be \u002B participle."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you mind opening the window?","hint":"polite request","explanation":"\u0027Would you mind \u002B -ing?\u0027 \u2014 polite request."},{"answer":"rains","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Unless it ___ , the match will go ahead.","hint":"unless \u002B present simple","explanation":"\u0027unless\u0027 = if\u2026not; present simple after time/condition words."},{"answer":"complaining","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay now.","hint":"not worth \u002B -ing","explanation":"\u0027be worth \u002B -ing\u0027."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."}]}