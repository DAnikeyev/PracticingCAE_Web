{"id":"rue-part2-0060","taskId":"rue-part2","title":"Drill set 60","text":null,"source":"drill","gaps":[{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve been waiting ___ half an hour.","hint":"period of time","explanation":"\u0027for \u002B period\u0027; \u0027since \u002B starting point\u0027."},{"answer":"collection","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s got a ___ of stamps from every country he\u0027s visited.","hint":"collect \u2192 ?","explanation":"Noun form: collection (a group of collected items)."},{"answer":"talk","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather not ___ about it over the phone.","hint":"would rather not \u002B bare inf","explanation":"\u0027would rather \u002B not \u002B infinitive without to\u0027."},{"answer":"Far","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ from being annoyed, she was delighted.","hint":"far from \u002B adjective","explanation":"\u0027far from \u002B adjective\u0027 = not at all: Far from being annoyed\u2026"},{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the most generous person I\u0027ve ___ met.","hint":"superlative \u002B present perfect","explanation":"\u0027the best\u2026 I\u0027ve ever seen/met\u0027 \u2014 \u0027ever\u0027 with superlatives."},{"answer":