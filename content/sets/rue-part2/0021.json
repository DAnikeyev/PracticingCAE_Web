{"id":"rue-part2-0021","taskId":"rue-part2","title":"Drill set 21","text":null,"source":"drill","gaps":[{"answer":"complaining","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay now.","hint":"not worth \u002B -ing","explanation":"\u0027be worth \u002B -ing\u0027."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"do","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She made me ___ my homework before dinner.","hint":"make \u002B bare infinitive","explanation":"\u0027make somebody do\u0027 \u2014 bare infinitive after the object."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"came","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The first edition of the book ___ out in 1998.","hint":"be published","explanation":"\u0027come out\u0027 = be published/released."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the most generous person I\u0027ve ___ met.","hint":"superlative \u002B present perfect","explanation":"\u0027the best\u2026 I\u0027ve ever seen/met\u0027 \u2014 \u0027ever\u0027 with superlatives."},{"answer":"such","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ a good film that we saw it twice.","hint":"such \u002B a \u002B adj \u002B noun","explanation":"\u0027such (\u002Ba) \u002B adjective \u002B noun \u002B that\u2026\u0027"}]}