{"id":"rue-part2-0113","taskId":"rue-part2","title":"Drill set 113","text":null,"source":"drill","gaps":[{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"to have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief is believed ___ entered through the roof.","hint":"passive reporting \u002B past infinitive","explanation":"\u0027is believed to have \u002B participle\u0027 for a past event."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"off","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was put ___ until Thursday.","hint":"postpone","explanation":"\u0027put off\u0027 = postpone."},{"answer":"off","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane took ___ despite the thick fog.","hint":"leave the ground","explanation":"\u0027Take off\u0027 = leave the ground."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By the time we arrived, the film ___ already started.","hint":"