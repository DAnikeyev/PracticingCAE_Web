{"id":"rue-part2-0113","taskId":"rue-part2","title":"Drill set 113","text":null,"source":"drill","gaps":[{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s recovering ___ a knee operation.","hint":"recover ___ sth","explanation":"\u0027recover FROM an illness/operation\u0027."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house ___ is lovely, but the garden is tiny.","hint":"emphatic: the house ___","explanation":"Noun \u002B itself emphasises the noun: the house itself."},{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By the time we arrived, the film ___ already started.","hint":"earlier past action","explanation":"Past perfect for the earlier of two past events."},{"answer":"didn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"\u0027would rather \u002B subject \u002B past simple\u0027."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."}]}