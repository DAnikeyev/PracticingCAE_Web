{"id":"rue-part2-0038","taskId":"rue-part2","title":"Drill set 38","text":null,"source":"drill","gaps":[{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"Neither","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ of the two passwords works \u2014 try the other one.","hint":"not one and not the other","explanation":"\u0027Neither of the two\u0027 = not either of them."},{"answer":"every","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The committee meets ___ other month, always on a Tuesday.","hint":"every other = alternate","explanation":"\u0027Every other month\u0027 = one month yes, one month no."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s not as tall ___ her sister.","hint":"as \u2026 as comparison","explanation":"\u0027not as \u002B adjective \u002B as\u0027 for negative comparison."},{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"complaining","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay now.","h