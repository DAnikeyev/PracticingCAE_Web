{"id":"rue-part2-0042","taskId":"rue-part2","title":"Drill set 42","text":null,"source":"drill","gaps":[{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"Neither","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ of my parents speaks French, so I translate for them.","hint":"not one, not the other","explanation":"\u0027Neither of\u0027 = not one and not the other (two people)."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the trip.","hint":"excited ___ sth","explanation":"\u0027excited ABOUT something\u0027."},{"answer":"do","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She made me ___ my homework before dinner.","hint":"make \u002B bare infinitive","explanation":"\u0027make somebody do\u0027 \u2014 bare infinitive after the object."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you mind opening the window?","hint":"polite request","explanation":"\u0027Would you mind \u002B -ing?\u0027 \u2014 polite request."},{"answer":"despite","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She got the job ___ of her lack of experience.","hint":"despite \u002B noun","explanation":"\u0027despite/in spite of \u002B noun\u0027 \u2014 not \u0027despite of\u0027."},{"answer":"whose","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the man ___ car was stolen.","hint":"possessive relative","explanation":"\u0027whose\u0027 shows possession: the man whose car\u2026"},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner