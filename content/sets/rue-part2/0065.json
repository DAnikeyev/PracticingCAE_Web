{"id":"rue-part2-0065","taskId":"rue-part2","title":"Drill set 65","text":null,"source":"drill","gaps":[{"answer":"when","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly had we sat down ___ the lights went out.","hint":"hardly \u2026 ?","explanation":"\u0027Hardly \u2026 when\u0027 is the fixed pair; \u0027than\u0027 belongs to \u0027no sooner\u0027."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"off","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The plane took ___ despite the thick fog.","hint":"leave the ground","explanation":"\u0027Take off\u0027 = leave the ground."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The climbers were ___ no danger once the storm had passed.","hint":"be ___ no danger","explanation":"\u0027Be in no danger\u0027 is the fixed phrase with \u0027in\u0027."},{"answer":"herself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She should be ashamed of ___ for saying that.","hint":"reflexive: she \u2192 ?","explanation":"ashamed of \u002B reflexive: herself."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"the","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The more you practise, ___ easier it becomes.","hint":"the \u002B comparative, the \u002B comparative","explanation":"\u0027The more \u2026 the easier \u2026\u0027 \u2014 both halves take \u0027the\u0027."}]}