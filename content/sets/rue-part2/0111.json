{"id":"rue-part2-0111","taskId":"rue-part2","title":"Drill set 111","text":null,"source":"drill","gaps":[{"answer":"watching","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ TV all morning.","hint":"action all morning","explanation":"Present perfect continuous for duration up to now: has been watching."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"another","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The witnesses gave accounts that contradicted one ___.","hint":"one ___ = each other (3\u002B people)","explanation":"\u0027Contradict one another\u0027 is the reciprocal form used for more than two people."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house ___ is lovely, but the garden is tiny.","hint":"emphatic: the house ___","explanation":"Noun \u002B itself emphasises the noun: the house itself."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"couldn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"No matter how hard he pulled, he ___ open the drawer.","hint":"unable in the past","explanation":"\u0027Couldn\u0027t open it\u0027 \u2014 past inability."}]}