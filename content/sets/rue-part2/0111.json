{"id":"rue-part2-0111","taskId":"rue-part2","title":"Drill set 111","text":null,"source":"drill","gaps":[{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"will","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like to know when the results ___ be published.","hint":"reported future","explanation":"Future in a noun clause: when the results will be published."},{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"whose","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the man ___ car was stolen.","hint":"possessive relative","explanation":"\u0027whose\u0027 shows possession: the man whose car\u2026"},{"answer":"help","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t ___ laughing at his accent.","hint":"can\u0027t help \u002B -ing","explanation":"\u0027can\u0027t help \u002B -ing\u0027 = can\u0027t stop yourself."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s recovering ___ a knee operation.","hint":"recover ___ sth","explanation":"\u0027recover FROM an illness/operation\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"to have been caused","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The fire is believed ___ by faulty wiring.","hint":"passive reporting, past pas