{"id":"rue-part2-0177","taskId":"rue-part2","title":"Drill set 177","text":null,"source":"drill","gaps":[{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I wish I ___ told him the truth at the time.","hint":"past regret","explanation":"\u0027wish \u002B past perfect\u0027 for regret about the past."},{"answer":"being","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude.","hint":"apologise for \u002B -ing","explanation":"preposition \u002B -ing: for being."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"however","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum charges for entry; ___, under-twenties visit free.","hint":"contrast after a semicolon","explanation":"\u0027However\u0027 marks the contrast between paying and free."},{"answer":"as","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll call you as soon ___ I land.","hint":"as soon as","explanation":"\u0027as soon as\u0027 = immediately after."},{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."}]}