{"id":"rue-part2-0128","taskId":"rue-part2","title":"Drill set 128","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude.","hint":"apologise for \u002B -ing","explanation":"preposition \u002B -ing: for being."},{"answer":"no","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t reach the shelf, ___ how tall I am.","hint":"no matter how \u2026","explanation":"\u0027No matter how tall\u0027 = however tall."},{"answer":"to have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief is believed ___ entered through the roof.","hint":"passive reporting \u002B past infinitive","explanation":"\u0027is believed to have \u002B participle\u0027 for a past event."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"taking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ the last piece of cake.","hint":"deny \u002B gerund","explanation":"\u0027Deny doing something\u0027 \u2014 the gerund follows \u0027deny\u0027."},{"answer":"caught","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He ___ the flu last week and missed the finals.","hint":"become ill with","explanation":"\u0027catch the flu/a cold\u0027 = become ill with it."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"on","accept":["upon"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She prides herself ___ her punctuality.","hint":"pri