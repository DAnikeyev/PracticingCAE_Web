{"id":"rue-part2-0102","taskId":"rue-part2","title":"Drill set 102","text":null,"source":"drill","gaps":[{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."},{"answer":"than","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"No sooner had he arrived ___ it started to rain.","hint":"no sooner \u2026 ?","explanation":"\u0027No sooner \u2026 than\u2026\u0027 \u2014 fixed pair."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"taller","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the ___ of the two brothers.","hint":"comparative for two","explanation":"With two items, use the comparative with \u0027the\u0027: the taller of the two."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We ran out ___ petrol on the motorway.","hint":"run out ___ sth","explanation":"\u0027run out OF something\u0027 = have none left."},{"answer":"from","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s recovering ___ a knee operation.","hint":"recover ___ sth","explanation":"\u0027recover FROM an illness/operation\u0027."},{"answer":"remarkably","accept":["surprisingly","amazingly"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks ___ English for a beginner.","hint":"surprisingly (adverb)","explanation":"Adverb modifying \u0027