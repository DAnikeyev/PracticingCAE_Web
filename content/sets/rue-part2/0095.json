{"id":"rue-part2-0095","taskId":"rue-part2","title":"Drill set 95","text":null,"source":"drill","gaps":[{"answer":"for","accept":["to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like two tickets ___ tonight\u0027s performance.","hint":"tickets ___ an event","explanation":"\u0027tickets FOR tonight\u0027s show\u0027 (also \u0027to\u0027)."},{"answer":"to have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief is believed ___ entered through the roof.","hint":"passive reporting \u002B past infinitive","explanation":"\u0027is believed to have \u002B participle\u0027 for a past event."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"being","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude.","hint":"apologise for \u002B -ing","explanation":"preposition \u002B -ing: for being."},{"answer":"were","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"If I ___ you, I\u0027d apologise immediately.","hint":"unreal second conditional","explanation":"\u0027If I were you\u0027 \u2014 subjunctive \u0027were\u0027 for unreal situations."},{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The concert tickets sold ___ in an hour.","hint":"sell ___ = all bought","explanation":"\u0027sell out\u0027 = all tickets sold."},{"answer":"where","accept":["in which"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"This is the village ___ my grandmother was born.","hint":"place relative","explanation":"\u0027where\u0027 = in which (place)."},{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027need \u002B -ing\u0027 = need to be \u002B participle: needs cleaning."}]}