{"id":"rue-part2-0187","taskId":"rue-part2","title":"Drill set 187","text":null,"source":"drill","gaps":[{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people as subject."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was held ___ strict secrecy.","hint":"held ___ secrecy","explanation":"\u0027in secrecy/in private\u0027 \u2014 fixed preposition use."},{"answer":"to have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief is believed ___ entered through the roof.","hint":"passive reporting \u002B past infinitive","explanation":"\u0027is believed to have \u002B participle\u0027 for a past event."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"no","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t reach the shelf, ___ how tall I am.","hint":"no matter how \u2026","explanation":"\u0027No matter how tall\u0027 = however tall."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letter must ___ signed by both directors before it is valid.","hint":"must \u002B passive","explanation":"\u0027Must\u0027 is followed by the bare infinitive \u0027be\u0027 \u002B past participle for the passive."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"help","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I couldn\u0027t ___ laughing at his accent.","hint":"can\u0027t help \u002B -ing","explanation":"\u0027can\u0027t help \u002B -ing\u0027 = can\u0027t stop yourself."}]}