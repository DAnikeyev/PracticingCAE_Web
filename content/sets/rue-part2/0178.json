{"id":"rue-part2-0178","taskId":"rue-part2","title":"Drill set 178","text":null,"source":"drill","gaps":[{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"left","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He ___ his keys on the bus this morning.","hint":"leave sth somewhere","explanation":"\u0027leave something somewhere\u0027 = forget to take it: left his keys on the bus."},{"answer":"breathtaking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The view from the top was ___ .","hint":"extremely impressive","explanation":"\u0027breathtaking\u0027 = so beautiful it takes your breath away."},{"answer":"talking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He kept ___ even though everyone had left.","hint":"keep \u002B -ing","explanation":"\u0027keep \u002B -ing\u0027 = continue doing."},{"answer":"seeing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ you next week.","hint":"look forward to \u002B -ing","explanation":"\u0027to\u0027 is a preposition here, so -ing follows."},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."}]}