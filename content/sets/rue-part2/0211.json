{"id":"rue-part2-0211","taskId":"rue-part2","title":"Drill set 211","text":null,"source":"drill","gaps":[{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"breaking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He denied ___ the vase, though the camera saw him.","hint":"deny \u002B -ing","explanation":"\u0027deny \u002B -ing\u0027."},{"answer":"most","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We should make the ___ of the good weather.","hint":"make the ___ of","explanation":"\u0027make the most of\u0027 = get the maximum benefit from."},{"answer":"came","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The first edition of the book ___ out in 1998.","hint":"be published","explanation":"\u0027come out\u0027 = be published/released."},{"answer":"start","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better ___ going \u2014 it\u0027s nearly midnight.","hint":"had better \u002B bare inf","explanation":"\u0027had better \u002B infinitive without to\u0027."},{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the most generous person I\u0027ve ___ met.","hint":"superlative \u002B present perfect","explanation":"\u0027the best\u2026 I\u0027ve ever seen/met\u0027 \u2014 \u0027ever\u0027 with superlatives."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027