{"id":"rue-part2-0045","taskId":"rue-part2","title":"Drill set 45","text":null,"source":"drill","gaps":[{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."},{"answer":"remarkably","accept":["surprisingly","amazingly"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks ___ English for a beginner.","hint":"surprisingly (adverb)","explanation":"Adverb modifying \u0027good English\u0027: remarkably good."},{"answer":"bestselling","accept":["best-selling"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the author of several ___ novels.","hint":"selling very well","explanation":"\u0027bestselling novel\u0027 \u2014 compound adjective."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"fully","accept":["well","completely"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ aware of the risks.","hint":"completely (adverb)","explanation":"\u0027fully aware\u0027 \u2014 fixed adverb collocation."},{"answer":"best","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s far the ___ player in the team.","hint":"superlative after \u0027by far\u0027","explanation":"\u0027by far the best\u0027 \u2014 superlative with emphasiser."},{"answer":"will have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By this time next year, she ___ finished her degree.","hint":"future perfect","explanation":"Future perfect: will have \u002B participle by a future point."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"My brother works ___ a hospital in Leeds.","hint":"building (BrE: not as a patient)","explanation":"\u0027in a hospital\u0027 = inside the building; \u0027at hospital\u0027 would mean as a patient (BrE)."}]}