{"id":"rue-part2-0096","taskId":"rue-part2","title":"Drill set 96","text":null,"source":"drill","gaps":[{"answer":"so","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ dull a lecture that people walked out.","hint":"so \u002B adjective \u002B a\u2026","explanation":"so \u002B adjective (\u002Ba \u002B noun) \u002B that\u2026 \u2014 the alternative emphatic pattern."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"talking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He kept ___ even though everyone had left.","hint":"keep \u002B -ing","explanation":"\u0027keep \u002B -ing\u0027 = continue doing."},{"answer":"eating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not used to ___ such spicy food.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = be accustomed to."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"down","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her success was largely ___ to her coach.","hint":"be ___ to = caused by","explanation":"\u0027be down to somebody/something\u0027 = be caused by."},{"answer":"Far","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ from being annoyed, she was delighted.","hint":"far from \