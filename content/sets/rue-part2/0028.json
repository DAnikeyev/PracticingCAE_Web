{"id":"rue-part2-0028","taskId":"rue-part2","title":"Drill set 28","text":null,"source":"drill","gaps":[{"answer":"seeing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ you next week.","hint":"look forward to \u002B -ing","explanation":"\u0027to\u0027 is a preposition here, so -ing follows."},{"answer":"had been","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"All the tickets ___ sold out by noon.","hint":"earlier past, passive","explanation":"Past perfect passive: had been \u002B participle (before the stated past moment)."},{"answer":"until","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was not ___ midnight that the results were announced.","hint":"not \u2026 until","explanation":"\u0027Not until midnight\u0027 = only then."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"since","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s lived here ___ 2015.","hint":"point in time","explanation":"\u0027since \u002B point in time\u0027; \u0027for \u002B period\u0027."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"wouldn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d rather cook at home tonight, ___ he?","hint":"question tag for would rather","explanation":"The tag repeats the auxiliary: would \u2192 wouldn\u0027t."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."}]}