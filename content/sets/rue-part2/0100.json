{"id":"rue-part2-0100","taskId":"rue-part2","title":"Drill set 100","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"eating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not used to ___ such spicy food.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = be accustomed to."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"most","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We should make the ___ of the good weather.","hint":"make the ___ of","explanation":"\u0027make the most of\u0027 = get the maximum benefit from."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"must","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You ___ be tired after such a long flight.","hint":"strong deduction","explanation":"\u0027must \u002B infinitive\u0027 = certain deduction about the present."}]}