{"id":"rue-part2-0141","taskId":"rue-part2","title":"Drill set 141","text":null,"source":"drill","gaps":[{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"working","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s used to ___ long hours.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = accustomed to."},{"answer":"of","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We ran out ___ petrol on the motorway.","hint":"run out ___ sth","explanation":"\u0027run out OF something\u0027 = have none left."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"whose","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the man ___ car was stolen.","hint":"possessive relative","explanation":"\u0027whose\u0027 shows possession: the man whose car\u2026"},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."}]}