{"id":"rue-part2-0080","taskId":"rue-part2","title":"Drill set 80","text":null,"source":"drill","gaps":[{"answer":"delicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup tastes ___ \u2014 did you use fresh herbs?","hint":"taste \u002B adjective","explanation":"\u0027taste/smell/feel \u002B adjective\u0027: tastes delicious."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"do","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She made me ___ my homework before dinner.","hint":"make \u002B bare infinitive","explanation":"\u0027make somebody do\u0027 \u2014 bare infinitive after the object."},{"answer":"will be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The roof ___ repaired next week.","hint":"future passive","explanation":"Future passive: will be \u002B participle."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"if","accept":["provided","as long as","provided that","so long as"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You can borrow it ___ you give it back by Friday.","hint":"condition","explanation":"\u0027if\u0027 introduces the condition."},{"answer":"absent","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ from school three times this term.","hint":"not present (formal)","explanation":"\u0027be absent from school\u0027 \u2014 formal way to say not present."},{"answer":"rains","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Unless it ___ , the match will go ahead.","hint":"unless \u002B pre