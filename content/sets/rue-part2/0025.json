{"id":"rue-part2-0025","taskId":"rue-part2","title":"Drill set 25","text":null,"source":"drill","gaps":[{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."},{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was held ___ strict secrecy.","hint":"held ___ secrecy","explanation":"\u0027in secrecy/in private\u0027 \u2014 fixed preposition use."},{"answer":"start","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027d better ___ going \u2014 it\u0027s nearly midnight.","hint":"had better \u002B bare inf","explanation":"\u0027had better \u002B infinitive without to\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"miss","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We\u0027re going to ___ our flight if we don\u0027t hurry.","hint":"be too late for a plane","explanation":"\u0027miss a flight/train/bus\u0027 = arrive too late for it."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve been waiting ___ half an hour.","hint":"period of time","explanation":"\u0027for \u002B period\u0027; \u0027since \u002B starting point\u0027."},{"answer":"were","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"If I ___ you, I\u0027d apologise immediately.","hint":"unreal second conditional","explanation":"\u0027If I were you\u0027 \u2014 subjunctive \u0027were\u0027 for unreal situations."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u