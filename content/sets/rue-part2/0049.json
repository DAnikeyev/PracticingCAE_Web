{"id":"rue-part2-0049","taskId":"rue-part2","title":"Drill set 49","text":null,"source":"drill","gaps":[{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"Without","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ further delay, the doors opened and we went in.","hint":"with no \u2026","explanation":"\u0027Without further delay\u0027 = immediately."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By the time we arrived, the film ___ already started.","hint":"earlier past action","explanation":"Past perfect for the earlier of two past events."},{"answer":"when","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly had we sat down ___ the lights went out.","hint":"hardly \u2026 ?","explanation":"\u0027Hardly \u2026 when\u0027 is the fixed pair; \u0027than\u0027 belongs to \u0027no sooner\u0027."},{"answer":"until","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was not ___ midnight that the results were announced.","hint":"not \u2026 until","explanation":"\u0027Not until midnight\u0027 = only then."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you mind opening the window?","hint":"polite request","explanation":"\u0027Would you mind \u002B -ing?\u0027 \u2014 polite request."},{"answer":"didn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"\u0027would rather \u002B subject \u002B past simple\u0027."},{"answer":"taking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ the money.","hint