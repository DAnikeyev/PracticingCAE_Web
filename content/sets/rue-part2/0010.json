{"id":"rue-part2-0010","taskId":"rue-part2","title":"Drill set 10","text":null,"source":"drill","gaps":[{"answer":"being","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He apologised for ___ so rude.","hint":"apologise for \u002B -ing","explanation":"preposition \u002B -ing: for being."},{"answer":"to have been caused","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The fire is believed ___ by faulty wiring.","hint":"passive reporting, past passive infinitive","explanation":"\u0027believed to have been \u002B participle\u0027 \u2014 the cause was earlier."},{"answer":"seeing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ you next week.","hint":"look forward to \u002B -ing","explanation":"\u0027to\u0027 is a preposition here, so -ing follows."},{"answer":"enough","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The hotel room wasn\u0027t big ___ for three people.","hint":"adjective \u002B ?","explanation":"\u0027adjective \u002B enough \u002B to-infinitive/for phrase\u0027."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"absent","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ from school three times this term.","hint":"not present (formal)","explanation":"\u0027be absent from school\u0027 \u2014 formal way to say not present."},{"answer":"for","accept":[],"options":[],"base":null,"keyw