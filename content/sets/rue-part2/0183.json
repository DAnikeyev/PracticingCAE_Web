{"id":"rue-part2-0183","taskId":"rue-part2","title":"Drill set 183","text":null,"source":"drill","gaps":[{"answer":"guilty","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He denied the charge, but the jury found him ___ after only an hour.","hint":"the opposite of his claim","explanation":"\u0027But\u0027 signals a contrast with his denial: the jury found him guilty."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"too","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ many customers for the staff to serve properly.","hint":"more than enough","explanation":"\u0027Too many \u2026 to \u2026\u0027 \u2014 excess preventing an outcome."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve been waiting ___ half an hour.","hint":"period of time","explanation":"\u0027for \u002B period\u0027; \u0027since \u002B starting point\u0027."},{"answer":"since","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s lived here ___ 2015.","hint":"point in time","explanation":"\u0027since \u002B point in time\u0027; \u0027for \u002B period\u0027."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"where","accept":["in which"],"options":[],"b