{"id":"rue-part2-0081","taskId":"rue-part2","title":"Drill set 81","text":null,"source":"drill","gaps":[{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly ___ sat down when the phone rang.","hint":"inversion after hardly","explanation":"\u0027Hardly had \u002B subject \u002B participle\u2026 when\u2026\u0027"},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"taller","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027s the ___ of the two brothers.","hint":"comparative for two","explanation":"With two items, use the comparative with \u0027the\u0027: the taller of the two."},{"answer":"about","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The children were excited ___ the trip.","hint":"excited ___ sth","explanation":"\u0027excited ABOUT something\u0027."},{"answer":"eaten","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s the first time I\u0027ve ___ this dish.","hint":"present perfect \u002B past participle","explanation":"\u0027It\u0027s the first time \u002B present perfect\u0027: have eaten."}]}