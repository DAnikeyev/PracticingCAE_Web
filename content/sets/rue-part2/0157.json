{"id":"rue-part2-0157","taskId":"rue-part2","title":"Drill set 157","text":null,"source":"drill","gaps":[{"answer":"off","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was put ___ until Thursday.","hint":"postpone","explanation":"\u0027put off\u0027 = postpone."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The cat cleans ___ after every meal.","hint":"reflexive pronoun","explanation":"Reflexive: the cat cleans ITSELF (the object is the same as the subject)."},{"answer":"enough","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The hotel room wasn\u0027t big ___ for three people.","hint":"adjective \u002B ?","explanation":"\u0027adjective \u002B enough \u002B to-infinitive/for phrase\u0027."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"until","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was not ___ midnight that the results were announced.","hint":"not \u2026 until","explanation":"\u0027Not until midnight\u0027 = only then."},{"answer":"seeing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m looking forward to ___ you next week.","hint":"look forward to \u002B -ing","explanation":"\u0027to\u0027 is a preposition here, so -ing follows."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."}]}