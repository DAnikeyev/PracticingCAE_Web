{"id":"rue-part2-0088","taskId":"rue-part2","title":"Drill set 88","text":null,"source":"drill","gaps":[{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There was so ___ confusion that the event was abandoned.","hint":"uncountable","explanation":"so much \u002B uncountable noun (confusion)."},{"answer":"finishing","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The report needs ___ before Friday, doesn\u0027t it?","hint":"need \u002B gerund (passive meaning)","explanation":"\u0027Needs finishing\u0027 = needs to be finished."},{"answer":"working","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s used to ___ long hours.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = accustomed to."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"however","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The museum charges for entry; ___, under-twenties visit free.","hint":"contrast after a semicolon","explanation":"\u0027However\u0027 marks the contrast between paying and free."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"if","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He walked in as ___ nothing had happened