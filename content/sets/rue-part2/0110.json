{"id":"rue-part2-0110","taskId":"rue-part2","title":"Drill set 110","text":null,"source":"drill","gaps":[{"answer":"in","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting was held ___ strict secrecy.","hint":"held ___ secrecy","explanation":"\u0027in secrecy/in private\u0027 \u2014 fixed preposition use."},{"answer":"painted","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We had the walls ___ last month.","hint":"causative have","explanation":"\u0027have something done\u0027 = arrange for it to be done: had the walls painted."},{"answer":"by","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ll have finished the report ___ Friday.","hint":"deadline (not later than)","explanation":"\u0027by \u002B time\u0027 = not later than."},{"answer":"didn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather you ___ smoke in here.","hint":"would rather \u002B sb \u002B past","explanation":"\u0027would rather \u002B subject \u002B past simple\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"will have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By this time next year, she ___ finished her degree.","hint":"future perfect","explanation":"Future perfect: will have \u002B participle by a future point."},{"answer":"interrupt","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d better not ___ you \u2014 you look busy.","hint":"had better not \u002B bare inf","explanation":"\u0027had better \u002B not \u002B infinitive without to\u0027."},{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."}]}