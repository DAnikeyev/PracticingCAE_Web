{"id":"rue-part2-0074","taskId":"rue-part2","title":"Drill set 74","text":null,"source":"drill","gaps":[{"answer":"due","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The findings will be published in ___ course.","hint":"in ___ course = at the right time","explanation":"\u0027In due course\u0027 = eventually, when the time is right."},{"answer":"was","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge ___ built in 1892.","hint":"past passive","explanation":"Past simple passive: was \u002B participle."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The restaurant is famous ___ its seafood.","hint":"famous ___ sth","explanation":"\u0027famous FOR something\u0027."},{"answer":"too","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ many customers for the staff to serve properly.","hint":"more than enough","explanation":"\u0027Too many \u2026 to \u2026\u0027 \u2014 excess preventing an outcome."},{"answer":"until","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was not ___ midnight that the results were announced.","hint":"not \u2026 until","explanation":"\u0027Not until midnight\u0027 = only then."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"wouldn\u0027t","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He\u0027d rather cook at home tonight, ___ he?","hint":"question tag for would rather","explanation":"The tag repeats the auxiliary: would \u2192 wouldn\u0027t."},{"answer":"came","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The first edition of the book ___ out in 1998.","hint":"be published","explanation":"\u0027co