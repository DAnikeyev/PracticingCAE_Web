{"id":"rue-part2-0041","taskId":"rue-part2","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"most honest","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the ___ person I know \u2014 she never lies.","hint":"superlative of honest","explanation":"\u0027honest\u0027 is two syllables: most honest."},{"answer":"eating","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027m not used to ___ such spicy food.","hint":"be used to \u002B -ing","explanation":"\u0027be used to \u002B -ing\u0027 = be accustomed to."},{"answer":"must","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You ___ be tired after such a long flight.","hint":"strong deduction","explanation":"\u0027must \u002B infinitive\u0027 = certain deduction about the present."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier past event","explanation":"Past perfect for the earlier of two past moments."},{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027need \u002B -ing\u0027 = need to be \u002B participle: needs cleaning."},{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"down","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her success was largely ___ to her coach.","hint":"be ___ to = caused by","explanation":"\u0027be down to somebody/something\u0027 = be caused by."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They insisted ___ paying for everything.","hint":"insist ___ \u002B -ing","explanation":"\u0027insist ON \u002B -ing\u0027."}]}