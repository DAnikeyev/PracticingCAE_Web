{"id":"rue-part2-0041","taskId":"rue-part2","title":"Drill set 41","text":null,"source":"drill","gaps":[{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the most generous person I\u0027ve ___ met.","hint":"superlative \u002B present perfect","explanation":"\u0027the best\u2026 I\u0027ve ever seen/met\u0027 \u2014 \u0027ever\u0027 with superlatives."},{"answer":"to take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ some photos on the way.","hint":"stop in order to do","explanation":"\u0027stop to do\u0027 = pause in order to do something."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."}]}