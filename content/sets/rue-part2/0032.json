{"id":"rue-part2-0032","taskId":"rue-part2","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."},{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)","explanation":"\u0027need \u002B -ing\u0027 = need to be \u002B participle: needs cleaning."},{"answer":"will","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like to know when the results ___ be published.","hint":"reported future","explanation":"Future in a noun clause: when the results will be published."},{"answer":"created","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The company has ___ several new jobs in the area.","hint":"bring new jobs into existence","explanation":"\u0027Create jobs\u0027 is the natural collocation."},{"answer":"must","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You ___ be tired after such a long flight.","hint":"strong deduction","explanation":"\u0027must \u002B infinitive\u0027 = certain deduction about the present."},{"answer":"eat","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d sooner ___ at home than go to the party.","hint":"would sooner \u002B bare inf","explanation":"\u0027would sooner \u002B infinitive without to\u0027."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."}]}