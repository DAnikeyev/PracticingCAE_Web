{"id":"rue-part2-0032","taskId":"rue-part2","title":"Drill set 32","text":null,"source":"drill","gaps":[{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"since","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s lived here ___ 2015.","hint":"point in time","explanation":"\u0027since \u002B point in time\u0027; \u0027for \u002B period\u0027."},{"answer":"fewer","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ people at the concert than last year.","hint":"countable comparison","explanation":"\u0027fewer\u0027 with countable nouns; \u0027less\u0027 with uncountables."},{"answer":"brought","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The meeting has been ___ forward to Monday.","hint":"move earlier","explanation":"\u0027bring forward\u0027 = move to an earlier time (opposite of put off)."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier past event","explanation":"Past perfect for the earlier of two past moments."},{"answer":"prevented","accept":["stopped"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The demonstrators were ___ from entering the building.","hint":"be prevented ___ -ing","explanation":"\u0027prevent somebody FROM doing\u0027 \u2014 passive: were prevented from entering."},{"answer":"if","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He walked in as ___ nothing had happened.","hint":"as if \u002B unreal past","explanation":"\u0027as if \u002B past\u0027 for unreal comparison."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based _