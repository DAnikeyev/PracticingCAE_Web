{"id":"rue-part2-0061","taskId":"rue-part2","title":"Drill set 61","text":null,"source":"drill","gaps":[{"answer":"out","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The project ran ___ of money halfway through.","hint":"run ___ of = have no more","explanation":"\u0027Run out of\u0027 = use up the supply."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He prefers cycling ___ driving to work.","hint":"prefer A ___ B","explanation":"\u0027prefer A TO B\u0027."},{"answer":"itself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The house ___ is lovely, but the garden is tiny.","hint":"emphatic: the house ___","explanation":"Noun \u002B itself emphasises the noun: the house itself."},{"answer":"take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How long does the flight ___ ?","hint":"duration of journey","explanation":"\u0027How long does X take?\u0027 \u2014 duration."},{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."},{"answer":"many","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were so ___ complaints that the scheme was dropped.","hint":"countable plural","explanation":"so many \u002B countable plural noun (complaints)."},{"answer":"Would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ you like some more cake?","hint":"polite offer","explanation":"\u0027Would you like\u2026?\u0027 is the polite offer; \u0027Do you like\u0027 asks about a general preference."},{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people