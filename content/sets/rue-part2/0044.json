{"id":"rue-part2-0044","taskId":"rue-part2","title":"Drill set 44","text":null,"source":"drill","gaps":[{"answer":"are","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letters ___ delivered every morning at eight.","hint":"present passive","explanation":"Present simple passive: are \u002B participle."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Hardly ___ sat down when the phone rang.","hint":"inversion after hardly","explanation":"\u0027Hardly had \u002B subject \u002B participle\u2026 when\u2026\u0027"},{"answer":"was","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge ___ built in 1892.","hint":"past passive","explanation":"Past simple passive: was \u002B participle."},{"answer":"will","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d like to know when the results ___ be published.","hint":"reported future","explanation":"Future in a noun clause: when the results will be published."},{"answer":"delicious","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The soup tastes ___ \u2014 did you use fresh herbs?","hint":"taste \u002B adjective","explanation":"\u0027taste/smell/feel \u002B adjective\u0027: tastes delicious."},{"answer":"anywhere","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I can\u0027t find my glasses ___ .","hint":"negative sentence place word","explanation":"\u0027anywhere\u0027 in negative sentences (not \u0027everywhere\u0027)."},{"answer":"to have","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The thief is believed ___ entered through the roof.","hint":"passive reporting \u002B past infinitive","explanation":"\u0027is believed to have \u002B participle\u0027 for a past event."},{"answer":"painted","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We had the walls ___ last month.","hint":"