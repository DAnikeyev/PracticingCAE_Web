{"id":"rue-part2-0044","taskId":"rue-part2","title":"Drill set 44","text":null,"source":"drill","gaps":[{"answer":"ourselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We organised the trip ___.","hint":"reflexive: we \u2192 ?","explanation":"we \u2192 ourselves (no outside help implied)."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She was ___ the impression that the interview was today.","hint":"under the ___ = wrongly believing","explanation":"\u0027Under the impression that \u2026\u0027 = believing, perhaps wrongly."},{"answer":"complaining","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It\u0027s not worth ___ about the delay now.","hint":"not worth \u002B -ing","explanation":"\u0027be worth \u002B -ing\u0027."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"to get","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Do you know how ___ to the station from here?","hint":"question word \u002B ?","explanation":"\u0027question word \u002B to-infinitive\u0027: how to get."},{"answer":"to take","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We stopped ___ some photos on the way.","hint":"stop in order to do","explanation":"\u0027stop to do\u0027 = pause in order to do something."},{"answer":"although","accept":["though"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We went out ___ it was raining heavily.","hint":"contrast concession","explanation":"\u0027although/though\u0027 introduce a contrast clause."},{"answer":"so","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"It was ___ dull a lecture that people walked out.","hint":"so \u002B adjective \u002B a\u2026","explanation":"so \u002B adjective