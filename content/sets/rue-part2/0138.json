{"id":"rue-part2-0138","taskId":"rue-part2","title":"Drill set 138","text":null,"source":"drill","gaps":[{"answer":"ever","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the most generous person I\u0027ve ___ met.","hint":"superlative \u002B present perfect","explanation":"\u0027the best\u2026 I\u0027ve ever seen/met\u0027 \u2014 \u0027ever\u0027 with superlatives."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"an","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s such ___ interesting person.","hint":"such \u002B a/an \u002B adj \u002B noun","explanation":"\u0027such an \u002B adjective \u002B singular noun\u0027 \u2014 \u0027interesting\u0027 starts with a vowel sound."},{"answer":"would","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I wish it ___ stop raining.","hint":"wish about an annoying habit","explanation":"\u0027Wish \u002B would\u0027 complains about something you want to stop or change."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"How ___ bread do we need for the recipe?","hint":"uncountable quantity","explanation":"\u0027much\u0027 with uncountable nouns; \u0027many\u0027 with countables."},{"answer":"On","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ the whole, the trip was a great success.","hint":"generally speaking","explanation":"\u0027On the whole\u0027 = mostly, in general."},{"answer":"taking","accept":[],"options":[],"base":null,"k