{"id":"rue-part2-0173","taskId":"rue-part2","title":"Drill set 173","text":null,"source":"drill","gaps":[{"answer":"taking","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She denied ___ the money.","hint":"deny \u002B -ing","explanation":"\u0027deny \u002B -ing\u0027 (or having \u002B participle)."},{"answer":"which","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The scheme, ___ was announced yesterday, will cost the city millions.","hint":"non-defining relative (thing)","explanation":"Non-defining clauses about things take \u0027which\u0027; \u0027that\u0027 is impossible after a comma."},{"answer":"choice","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They had no ___ but to call the police.","hint":"have no ___ but to","explanation":"\u0027have no choice/alternative but to do\u0027."},{"answer":"down","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Her success was largely ___ to her coach.","hint":"be ___ to = caused by","explanation":"\u0027be down to somebody/something\u0027 = be caused by."},{"answer":"who","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the woman ___ helped me find the station.","hint":"person relative pronoun (subject)","explanation":"\u0027who\u0027 refers to people as subject."},{"answer":"herself","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She should be ashamed of ___ for saying that.","hint":"reflexive: she \u2192 ?","explanation":"ashamed of \u002B reflexive: herself."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"had","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"By midnight, everyone ___ gone home.","hint":"earlier