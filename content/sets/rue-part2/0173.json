{"id":"rue-part2-0173","taskId":"rue-part2","title":"Drill set 173","text":null,"source":"drill","gaps":[{"answer":"too","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There were ___ many customers for the staff to serve properly.","hint":"more than enough","explanation":"\u0027Too many \u2026 to \u2026\u0027 \u2014 excess preventing an outcome."},{"answer":"to","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s allergic ___ cats.","hint":"allergic ___ sth","explanation":"\u0027allergic TO something\u0027."},{"answer":"under","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The bridge is ___ repair, so traffic uses the bypass.","hint":"being fixed","explanation":"\u0027Under repair\u0027 = being repaired."},{"answer":"too","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s far ___ to understand the joke.","hint":"excess","explanation":"\u0027too \u002B adjective/adverb \u002B to-infinitive\u0027."},{"answer":"to","accept":["in order to","so as to"],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She went to university ___ study law.","hint":"infinitive of purpose","explanation":"\u0027to \u002B infinitive\u0027 expresses purpose."},{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027ve been waiting ___ half an hour.","hint":"period of time","explanation":"\u0027for \u002B period\u0027; \u0027since \u002B starting point\u0027."},{"answer":"be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"You needn\u0027t ___ worried \u2014 everything is fine.","hint":"needn\u0027t \u002B bare infinitive","explanation":"\u0027needn\u0027t \u002B infinitive without to\u0027: needn\u0027t be."},{"answer":"cleaning","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The car needs ___ before we leave.","hint":"need \u002B -ing (passive meaning)",