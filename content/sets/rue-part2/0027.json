{"id":"rue-part2-0027","taskId":"rue-part2","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"for","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was sacked ___ repeatedly arriving late.","hint":"sacked ___ doing sth","explanation":"\u0027be sacked/fired FOR doing something\u0027."},{"answer":"bigger","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The garden is ___ than I expected \u2014 it\u0027s huge!","hint":"comparative","explanation":"Comparative of \u0027big\u0027 is \u0027bigger\u0027 (double consonant)."},{"answer":"absent","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s been ___ from school three times this term.","hint":"not present (formal)","explanation":"\u0027be absent from school\u0027 \u2014 formal way to say not present."},{"answer":"stay","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"I\u0027d rather ___ at home tonight.","hint":"would rather \u002B bare inf","explanation":"\u0027would rather\u0027 \u002B infinitive without \u0027to\u0027."},{"answer":"are","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The letters ___ delivered every morning at eight.","hint":"present passive","explanation":"Present simple passive: are \u002B participle."},{"answer":"In","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"___ spite of the traffic, we arrived on time.","hint":"fixed phrase: ___ spite of","explanation":"\u0027In spite of\u0027 \u002B noun/-ing = despite."},{"answer":"painted","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"We had the walls ___ last month.","hint":"causative have","explanation":"\u0027have something done\u0027 = arrange for it to be done: had the walls painted."},{"answer":"on","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The film is based ___ a true story.","hint":"be based ___ sth","explanation":"\u0027based ON something\u0027."}]}