{"id":"rue-part2-0027","taskId":"rue-part2","title":"Drill set 27","text":null,"source":"drill","gaps":[{"answer":"rains","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"Unless it ___ , the match will go ahead.","hint":"unless \u002B present simple","explanation":"\u0027unless\u0027 = if\u2026not; present simple after time/condition words."},{"answer":"will be","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"The roof ___ repaired next week.","hint":"future passive","explanation":"Future passive: will be \u002B participle."},{"answer":"most honest","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She\u0027s the ___ person I know \u2014 she never lies.","hint":"superlative of honest","explanation":"\u0027honest\u0027 is two syllables: most honest."},{"answer":"with","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He was charged ___ dangerous driving.","hint":"charge sb ___ sth","explanation":"\u0027charge somebody WITH a crime\u0027."},{"answer":"much","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"There was so ___ confusion that the event was abandoned.","hint":"uncountable","explanation":"so much \u002B uncountable noun (confusion)."},{"answer":"better","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"She speaks English ___ than her brother.","hint":"comparative adverb of well","explanation":"Comparative of \u0027well\u0027 is \u0027better\u0027."},{"answer":"not","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"He told me ___ touch that switch.","hint":"reported negative command","explanation":"\u0027tell somebody NOT to do\u0027."},{"answer":"themselves","accept":[],"options":[],"base":null,"keyword":null,"lead":null,"sentence":"They built the cabin ___.","hint":"reflexive: they \u2192 ?","explanation":"they \u2192 themselves (without professional help)."}]}