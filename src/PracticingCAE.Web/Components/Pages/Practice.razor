@page "/practice/{TaskId}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using PracticingCAE.Web.Services
@inject ContentRepository Content
@inject SetSelector Selector
@inject ProgressService ProgressSvc
@inject OwnerResolver Owner
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_task?.Title ?? "Practice") — CAE Practice</PageTitle>

@if (_loading)
{
    <div class="page-shell practice-loading"><p class="muted">Loading a set…</p></div>
}
else if (_task is null)
{
    <div class="page-shell">
        <h1>Task not found</h1>
        <p>No task with id “@TaskId”. <a href="/">Back to the overview.</a></p>
    </div>
}
else if (_set is null || _gaps.Count == 0)
{
    <div class="page-shell">
        <h1>@_task.Title</h1>
        <p class="muted">No content available for this task yet.</p>
        <p><a class="btn btn-outline-primary" href="/">← All tasks</a></p>
    </div>
}
else
{
    <div class="page-shell practice-page">
        <div class="practice-head">
            <div>
                <h1>@_task.Title</h1>
                <p class="muted practice-sub">
                    @_task.Subtitle · set @_set.Id ·
                    <span class="badge @(IsExamStyle ? "badge-exam" : "badge-drill")">@_set.Source</span>
                </p>
            </div>
            <div class="practice-actions">
                @if (ShowTypeToggle)
                {
                    <label class="mode-toggle" title="Type your answers instead of clicking the options">
                        <input type="checkbox" checked="@_typeMode" @onchange="ToggleTypeMode" />
                        Type answers
                    </label>
                }
                @if (_checked)
                {
                    @if (IsRuePart)
                    {
                        <a class="btn btn-accent" href="@NextPartUrl">Next part →</a>
                    }
                    <button class="btn btn-soft" @onclick="NextSet">Next set</button>
                }
                else
                {
                    <button class="btn btn-soft" @onclick="RevealAllHints" title="Show a hint for every question (counts as hint use)">Hint all</button>
                    <button class="btn btn-primary" @onclick="Check">Check</button>
                }
            </div>
        </div>

        @if (IsRuePart)
        {
            <div class="rue-part-nav">
                <a class="rue-nav-arrow" href="@PrevPartUrl" title="Previous part">←</a>
                <div class="rue-nav-parts">
                    @for (var p = 0; p < RuePartIds.Length; p++)
                    {
                        var pIdx = p;
                        var run = RueRunFor(RuePartIds[pIdx]);
                        <a class="rue-nav-part @(pIdx == RuePartIndex ? "current" : "") @(run is not null ? "done" : "")"
                           href="/practice/@RuePartIds[pIdx]" title="@RuePartNavTitle(pIdx)">
                            @RuePartShort(pIdx)@(run is not null ? " ✓" : "")
                        </a>
                    }
                </div>
                <a class="rue-nav-arrow" href="@NextPartUrl" title="Next part">→</a>
                @if (RueRunSummary is { } summary)
                {
                    <span class="rue-nav-run">@summary</span>
                }
            </div>
        }

        @_task.Description

        @if (_checked && _result is not null)
        {
            var pct = 100 * _result.CorrectCount / Math.Max(1, _result.Total);
            <div class="score-banner @(pct == 100 ? "score-perfect" : pct >= 60 ? "score-good" : "score-weak")">
                <strong>@_result.CorrectCount / @_result.Total correct</strong>
                <span>@(pct == 100 ? "Perfect score!" : pct >= 60 ? "Good — check the gaps below." : "Keep going — review the explanations below.")</span>
                <button class="btn btn-primary btn-sm" @onclick="NextSet">Next set</button>
            </div>
            @if (IsRuePart && _task.Id == RuePartIds[^1] && RueRunTotal is { } runTotal)
            {
                <div class="rue-run-banner">
                    <strong>Reading & Use of English run: @runTotal.correct / @runTotal.total</strong>
                    <span>@RueRunSummary</span>
                </div>
            }
        }

        @if (IsCloze && !string.IsNullOrEmpty(_set.Text))
        {
            <div class="cloze-text">
                @foreach (var seg in ContentRepository.ParseCloze(_set.Text))
                {
                    if (seg.Gap is { } n && TaskIsRue2)
                    {
                        var gi = n - 1;
                        <span class="cloze-gap-wrap" @key="@($"{_set!.Id}:g{n}")">
                            <input class="gap-input cloze-gap @(FeedbackClass(gi))" type="text"
                                   style="width:@(Rue2GapCh)ch"
                                   aria-label="Answer for gap @(n)"
                                   disabled="@_checked"
                                   @oninput="@(e => SetAnswer(gi, e.Value?.ToString()))" />
                            <button type="button" class="cloze-lamp @(_hints[gi] ? "on" : "")" title="Hint"
                                    disabled="@_checked" @onmousedown:preventDefault
                                    @onclick="() => ToggleHint(gi)">&#128161;</button>
                            @if (_hints[gi] && !_checked)
                            {
                                <span class="cloze-hint-pop">@_gaps[gi].Hint</span>
                            }
                            @if (_checked && _result is not null && !_result.Gaps[gi].IsCorrect)
                            {
                                <span class="cloze-gap-answer">@_gaps[gi].Answer</span>
                            }
                        </span>
                    }
                    else if (seg.Gap is { } m)
                    {
                        <span class="gap-marker" data-gap="@m">@m</span>
                    }
                    else
                    {
                        <span>@seg.Text</span>
                    }
                }
            </div>
        }

        <div class="gap-list">
            @for (var i = 0; i < _gaps.Count; i++)
            {
                var idx = i;
                var gap = _gaps[i];
                // Part 2 types inside the text; its rows only appear after the
                // check, as verdicts and explanations (hints live on the lamp)
                @if (TaskIsRue2 && !_checked)
                {
                    continue;
                }
                <div class="gap-row @(FeedbackClass(idx))" @key="@($"{_set!.Id}:{idx}")">
                    <div class="gap-num">@(idx + 1)</div>
                    <div class="gap-body">
                        @if (gap.Lead is not null)
                        {
                            <p class="gap-lead">@gap.Lead</p>
                        }
                        @if (gap.Sentence is not null)
                        {
                            var parts = ContentRepository.SplitSentence(gap.Sentence);
                            <div class="gap-answerline">
                                @if (parts is not null)
                                {
                                    <span class="sentence">@parts.Value.before</span>
                                    if (gap.Options.Count > 0 && !TypedMode)
                                    {
                                        <div class="option-row" role="radiogroup" aria-label="Question @(idx + 1)">
                                            @foreach (var opt in gap.Options)
                                            {
                                                var o = opt;
                                                <label class="opt-pill @OptionFeedback(idx, o)"
                                                       @onclick="() => SelectOption(idx, o)">
                                                <input type="radio" name="q@(idx)-@(_set!.Id)" value="@o"
                                                       checked="@(_answers[idx] == o)" disabled="@_checked"
                                                       @onchange="@(e => SelectOption(idx, o))" />
                                                <span>@o</span>
                                            </label>
                                            }
                                        </div>
                                    }
                                    else if (_checked)
                                    {
                                        <span class="typed-answer">@DisplayAnswer(_answers[idx])</span>
                                    }
                                    else
                                    {
                                        <input class="gap-input gap-input-wide" @oninput="@(e => SetAnswer(idx, e.Value?.ToString()))"
                                               placeholder="your answer"
                                               aria-label="Answer for question @(idx + 1)" />
                                    }
                                    <span class="sentence">@parts.Value.after</span>
                                }
                                else
                                {
                                    <span class="sentence">@gap.Sentence</span>
                                }
                                @if (gap.Base is not null)
                                {
                                    <span class="base-badge" title="Base word">@gap.Base</span>
                                }
                                @if (gap.Keyword is not null)
                                {
                                    <span class="base-badge" title="Use this word">@gap.Keyword</span>
                                }
                                <button type="button" class="hint-btn" title="Show hint" disabled="@(_hints[idx] || _checked)"
                                        @onclick="() => ShowHint(idx)">Hint</button>
                            </div>
                        }
                        else if (IsCloze)
                        {
                            <div class="gap-answerline">
                                <span class="gap-marker-static">@idx1(idx)</span>
                                @if (!TaskIsRue2)
                                {
                                    @if (gap.Base is not null)
                                    {
                                        <span class="base-badge">@gap.Base</span>
                                    }
                                    @if (gap.Options.Count > 0 && !TypedMode)
                                    {
                                        <div class="option-row" role="radiogroup" aria-label="Question @(idx + 1)">
                                            @foreach (var opt in gap.Options)
                                            {
                                                var o = opt;
                                                <label class="opt-pill @OptionFeedback(idx, o)"
                                                       @onclick="() => SelectOption(idx, o)">
                                                    <input type="radio" name="q@(idx)-@(_set!.Id)" value="@o"
                                                           checked="@(_answers[idx] == o)" disabled="@_checked"
                                                           @onchange="@(e => SelectOption(idx, o))" />
                                                    <span>@o</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else if (_checked)
                                    {
                                        <span class="typed-answer">@DisplayAnswer(_answers[idx])</span>
                                    }
                                    else
                                    {
                                        <input class="gap-input" @oninput="@(e => SetAnswer(idx, e.Value?.ToString()))"
                                               placeholder="your answer"
                                               aria-label="Answer for question @(idx + 1)" />
                                    }
                                }
                                @if (!TaskIsRue2)
                                {
                                    <button type="button" class="hint-btn" title="Show hint" disabled="@(_hints[idx] || _checked)"
                                            @onclick="() => ShowHint(idx)">Hint</button>
                                }
                            </div>
                        }
                        @if (_hints[idx] && !TaskIsRue2 && !string.IsNullOrWhiteSpace(gap.Hint))
                        {
                            <p class="hint-text">Hint: @gap.Hint</p>
                        }
                        @if (_checked)
                        {
                            var r = _result!.Gaps[idx];
                            @if (_task.Kind == SetKind.Rue4 && !AnswerChecker.WordCountValid(_answers[idx], 3, 6))
                            {
                                <p class="hint-text">CAE rule: 3–6 words including the key word (yours: @AnswerChecker.WordCount(_answers[idx])).</p>
                            }
                            <p class="feedback-text @(r.IsCorrect ? "fb-ok" : "fb-bad")">
                                @if (r.IsCorrect)
                                {
                                    <text>Correct.</text>
                                }
                                else
                                {
                                    <text>Answer: <strong>@gap.Answer</strong>
                                    @if (gap.Accept.Count > 0)
                                    {
                                        <text> (also accepted: @string.Join(", ", gap.Accept))</text>
                                    }
                                    </text>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(gap.Explanation))
                            {
                                <p class="explanation">@gap.Explanation</p>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="practice-actions practice-actions-bottom">
            @if (_checked)
            {
                @if (IsRuePart)
                {
                    <a class="btn btn-accent" href="@NextPartUrl">Next part →</a>
                }
                <button class="btn btn-soft" @onclick="NextSet">Next set →</button>
            }
            else
            {
                @if (ShowTypeToggle)
                {
                    <label class="mode-toggle" title="Type your answers instead of clicking the options">
                        <input type="checkbox" checked="@_typeMode" @onchange="ToggleTypeMode" />
                        Type
                    </label>
                }
                <button class="btn btn-soft" @onclick="RevealAllHints" title="Show a hint for every question (counts as hint use)">Hint all</button>
                <button class="btn btn-primary" @onclick="Check">Check</button>
            }
        </div>

        <div class="practice-foot">
            <a href="/">← All tasks</a>
            @if (_task.Id.StartsWith("rue"))
            {
                <span class="muted">Exam format: @ExamFormatNote</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string TaskId { get; set; } = "";

    private TaskDef? _task;
    private PracticeSet? _set;
    private List<PracticeGap> _gaps = new();
    private string[] _answers = Array.Empty<string>();
    private bool[] _hints = Array.Empty<bool>();
    private bool _checked;
    private bool _loading = true;
    private SetResult? _result;
    private string? _ownerId;
    private bool _typeMode;
    private bool _typeResolved;

    private bool IsCloze => _task is { Kind: SetKind.Rue1 or SetKind.Rue2 or SetKind.Rue3 };
    private bool IsExamStyle => _set?.Source == "exam-style";
    private bool _hasOptions => _gaps.Any(g => g.Options.Count > 0);

    // Part 1 (multiple-choice cloze): the answer is not inferable without the
    // options, so selection is the only mode. Word formation (Part 3) is the
    // opposite: the base word plus context is enough, so typing is the default.
    private bool TypingAllowed => _task?.Kind is not SetKind.Rue1;
    private bool TypingDefault => _task?.Kind == SetKind.Rue3;
    private bool ShowTypeToggle => TypingAllowed && _hasOptions;
    private bool TypedMode => !TypingAllowed ? false : !_hasOptions ? true : _typeMode;

    // separate memories: word-formation tasks default on, MCQ tasks default off
    private string TypePrefKey => TypingDefault ? "typeModeWf" : "typeModeMcq";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_typeResolved) return;
        _typeResolved = true;
        try
        {
            _typeMode = ShowTypeToggle
                ? await JS.InvokeAsync<bool>("caeUi.getPref", TypePrefKey, TypingDefault)
                : TypingDefault;
            if (IsRuePart)
                _rueRun = await JS.InvokeAsync<Dictionary<string, RueRunEntry>>("caeUi.getRueRun");
            StateHasChanged();
            if (_typeMode) await JS.InvokeVoidAsync("caeUi.focusFirstGap");
        }
        catch (Exception)
        {
            // interop is best-effort (circuit reconnecting)
        }
    }

    private async Task ToggleTypeMode(ChangeEventArgs e)
    {
        _typeMode = e.Value is true;
        try
        {
            await JS.InvokeVoidAsync("caeUi.setPref", TypePrefKey, _typeMode);
            StateHasChanged();
            if (_typeMode)
                await JS.InvokeVoidAsync("caeUi.fillGapInputs", _answers);
        }
        catch (Exception)
        {
            // interop is best-effort
        }
    }

    private static string idx1(int i) => (i + 1).ToString();

    private string ExamFormatNote => _task?.Kind switch
    {
        SetKind.Rue1 => "8 gaps, choose A–D",
        SetKind.Rue2 => "8 gaps, one word each",
        SetKind.Rue3 => "8 gaps, use the base word",
        SetKind.Rue4 => "6 items, 3–6 words including the key word",
        _ => ""
    } ?? "";

    protected override async Task OnParametersSetAsync()
    {
        var task = Content.FindTask(TaskId);
        if (task != _task)
        {
            _task = task;
            // new task: start from its default until the stored pref resolves again
            _typeMode = TypingDefault;
            _typeResolved = false;
            await LoadSet();
        }
        _loading = false;
    }

    private async Task LoadSet()
    {
        _loading = true;
        _ownerId = await Owner.GetOwnerIdAsync();
        if (_task is null) { _loading = false; return; }

        // A connection blink or page reload must not throw away the set the user
        // is working on: restore the in-progress session if the page came back
        // (reload / reconnected circuit), otherwise start a fresh one.
        PracticeSessionDto? saved = null;
        try
        {
            if (await JS.InvokeAsync<bool>("caeUi.shouldRestorePractice", _task.Id))
                saved = await JS.InvokeAsync<PracticeSessionDto?>("caeUi.getPracticeSession", _task.Id);
            else
                await JS.InvokeVoidAsync("caeUi.clearPracticeSession", _task.Id);
        }
        catch (Exception)
        {
            // interop is best-effort (circuit reconnecting)
        }

        var set = saved is null || string.IsNullOrEmpty(saved.SetId)
            ? null
            : Content.FindSet(saved.SetId) is { } found && found.TaskId == _task.Id ? found : null;

        if (set is not null && saved!.Answers.Length == set.Gaps.Count)
        {
            ApplySet(set);
            _answers = saved.Answers;
            _hints = saved.Hints.Length == set.Gaps.Count ? saved.Hints : new bool[set.Gaps.Count];
            _checked = saved.Checked;
            if (_checked && saved.Result is not null) _result = saved.Result;
        }
        else
        {
            set = await Selector.NextSetAsync(_ownerId, _task.Id);
            ApplySet(set);
            await SaveSessionAsync();
        }
        _loading = false;

        if (!_checked && _answers.Any(a => !string.IsNullOrEmpty(a)))
        {
            try { await JS.InvokeVoidAsync("caeUi.fillGapInputs", _answers); }
            catch (Exception) { }
        }
    }

    private async Task SaveSessionAsync()
    {
        if (_set is null || _gaps.Count == 0 || _task is null) return;
        try
        {
            await JS.InvokeVoidAsync("caeUi.savePracticeSession", _task.Id, new PracticeSessionDto
            {
                SetId = _set.Id,
                Answers = _answers.Select(a => a ?? "").ToArray(),
                Hints = _hints.ToArray(),
                Checked = _checked,
                Result = _result,
                SavedUtc = DateTime.UtcNow
            });
        }
        catch (Exception)
        {
            // interop is best-effort
        }
    }

    /// <summary>In-progress set state kept in localStorage across reconnects and reloads.</summary>
    private sealed class PracticeSessionDto
    {
        public string SetId { get; set; } = "";
        public string[] Answers { get; set; } = Array.Empty<string>();
        public bool[] Hints { get; set; } = Array.Empty<bool>();
        public bool Checked { get; set; }
        public SetResult? Result { get; set; }
        public string? PageInstance { get; set; }
        public DateTime SavedUtc { get; set; }
    }

    private void ApplySet(PracticeSet? set)
    {
        _set = set;
        _gaps = set?.Gaps ?? new List<PracticeGap>();
        _answers = new string[_gaps.Count];
        _hints = new bool[_gaps.Count];
        _checked = false;
        _result = null;
    }

    private void SelectOption(int idx, string option)
    {
        if (_checked) return;
        _answers[idx] = option;
        _ = SaveSessionAsync();
    }

    private void ShowHint(int idx)
    {
        _hints[idx] = true;
        _ = SaveSessionAsync();
    }

    // Part 2 inline fields: the lamp toggles the hint overlay on/off
    private void ToggleHint(int idx)
    {
        _hints[idx] = !_hints[idx];
        _ = SaveSessionAsync();
    }

    private void RevealAllHints()
    {
        for (var i = 0; i < _hints.Length; i++) _hints[i] = true;
        _ = SaveSessionAsync();
    }

    private static string RuePartShort(int i) => $"Part {i + 1}";

    private string RuePartNavTitle(int i)
    {
        var run = RueRunFor(RuePartIds[i]);
        return run is null ? RuePartTitle(i) : $"{RuePartTitle(i)} — {run.C}/{run.T}";
    }

    private static string RuePartTitle(int i) => RuePartIds[i] switch
    {
        "rue-part1" => "Part 1 — Multiple-choice cloze",
        "rue-part2" => "Part 2 — Open cloze",
        "rue-part3" => "Part 3 — Word formation",
        _ => "Part 4 — Key word transformations",
    };

    // uniform inline gap width for Part 2: sized to the longest answer in the
    // whole Part 2 bank so a field's width never hints at its own answer
    private int Rue2GapCh => Math.Clamp(Content.Rue2MaxAnswerLength() + 2, 8, 24);

    // ---------- R&UE part navigation and run totals ----------
    private static readonly string[] RuePartIds = ["rue-part1", "rue-part2", "rue-part3", "rue-part4"];

    private bool IsRuePart => _task is not null && Array.IndexOf(RuePartIds, _task.Id) >= 0;
    private bool TaskIsRue2 => _task?.Kind == SetKind.Rue2;

    private int RuePartIndex => _task is null ? 0 : Math.Max(0, Array.IndexOf(RuePartIds, _task.Id));
    private string NextPartUrl => $"/practice/{RuePartIds[(RuePartIndex + 1) % RuePartIds.Length]}";
    private string PrevPartUrl => $"/practice/{RuePartIds[(RuePartIndex + RuePartIds.Length - 1) % RuePartIds.Length]}";

    private sealed record RueRunEntry(int C, int T, long Ts);

    private Dictionary<string, RueRunEntry>? _rueRun;

    private static bool IsFresh(RueRunEntry e) =>
        DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - e.Ts <= TimeSpan.FromHours(12).TotalMilliseconds;

    private RueRunEntry? RueRunFor(string taskId) =>
        _rueRun is not null && _rueRun.TryGetValue(taskId, out var e) && IsFresh(e) ? e : null;

    private string? RueRunSummary
    {
        get
        {
            var parts = RuePartIds.Select(RueRunFor).ToList();
            if (parts.All(p => p is null)) return null;
            return string.Join(" · ", RuePartIds.Zip(parts, (id, p) =>
                p is null ? $"P{id[^1]} —" : $"P{id[^1]} {p.C}/{p.T}"));
        }
    }

    private (int correct, int total)? RueRunTotal
    {
        get
        {
            var parts = RuePartIds.Select(RueRunFor).ToList();
            if (parts.Any(p => p is null)) return null;
            return (parts.Sum(p => p!.C), parts.Sum(p => p!.T));
        }
    }

    private async Task RecordRueResultAsync()
    {
        if (!IsRuePart || _result is null || _task is null) return;
        try
        {
            await JS.InvokeVoidAsync("caeUi.setRuePartResult", _task.Id, _result.CorrectCount, _result.Total);
            _rueRun = await JS.InvokeAsync<Dictionary<string, RueRunEntry>>("caeUi.getRueRun");
        }
        catch (Exception)
        {
            // interop is best-effort
        }
    }

    private async Task Check()
    {
        if (_set is null || _checked) return;
        var results = new List<GapResult>();
        for (var i = 0; i < _gaps.Count; i++)
        {
            var gap = _gaps[i];
            var ok = AnswerChecker.IsCorrect(_answers[i], gap);
            // CAE rule for Part 4: 3-6 words including the key word
            if (ok && _task!.Kind == SetKind.Rue4 && !AnswerChecker.WordCountValid(_answers[i], 3, 6))
                ok = false;
            results.Add(new GapResult(i, _answers[i] ?? "", ok, _hints[i], gap.Answer, gap.Explanation));
        }
        var result = new SetResult(results.All(r => r.IsCorrect), _hints.Any(h => h), results);
        _result = result;
        _checked = true;
        try
        {
            var owner = await Owner.GetOwnerIdAsync();
            await ProgressSvc.SaveAttemptAsync(owner, _set, result);
        }
        catch (Exception)
        {
            // progress is best-effort; never block practice
        }
        await SaveSessionAsync();
        if (IsRuePart) await RecordRueResultAsync();
    }

    private async Task NextSet()
    {
        // an explicit "next" always starts a fresh set
        try { await JS.InvokeVoidAsync("caeUi.clearPracticeSession", _task!.Id); }
        catch (Exception) { }
        await LoadSet();
    }

    private void SetAnswer(int idx, string? value)
    {
        _answers[idx] = value ?? "";
        _ = SaveSessionAsync();
    }

    private static string DisplayAnswer(string? answer) =>
        string.IsNullOrWhiteSpace(answer) ? "—" : answer;

    private string FeedbackClass(int idx)
    {
        if (!_checked || _result is null) return "";
        return _result.Gaps[idx].IsCorrect ? "row-ok" : "row-bad";
    }

    private string OptionFeedback(int idx, string option)
    {
        if (!_checked || _result is null) return "";
        var gap = _gaps[idx];
        if (option == gap.Answer) return "opt-correct";
        if (_answers[idx] == option) return "opt-wrong";
        return "";
    }
}
