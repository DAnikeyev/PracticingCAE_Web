@page "/progress"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using PracticingCAE.Web.Services
@inject ContentRepository Content
@inject ProgressService ProgressSvc
@inject OwnerResolver Owner

<PageTitle>My progress — CAE Practice</PageTitle>

<div class="page-shell">
    <div class="progress-head">
        <h1>My progress</h1>
        @if (_overview is not null && _overview.TotalAttempts > 0)
        {
            @if (_confirmReset)
            {
                <span class="reset-confirm">
                    Delete all your history?
                    <button class="btn btn-danger btn-sm" @onclick="ResetStats">Yes, reset everything</button>
                    <button class="btn btn-ghost btn-sm" @onclick="() => _confirmReset = false">Cancel</button>
                </span>
            }
            else
            {
                <button class="btn btn-soft btn-sm" @onclick="() => _confirmReset = true">Reset my statistics</button>
            }
        }
    </div>

    @if (_overview is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (_overview.TotalAttempts == 0)
    {
        <p class="muted">No practice recorded yet. Pick a task on the <a href="/">home page</a> and complete a set.</p>
    }
    else
    {
        <div class="progress-top">
            <div class="stat-cards">
                <div class="stat-card"><div class="stat-num">@_overview.TotalAttempts</div><div class="stat-label">sets completed</div></div>
                <div class="stat-card"><div class="stat-num">@_overview.TotalItems</div><div class="stat-label">questions answered</div></div>
                <div class="stat-card"><div class="stat-num">@_overview.SetsStarted</div><div class="stat-label">distinct sets seen</div></div>
                <div class="stat-card"><div class="stat-num">@_streak</div><div class="stat-label">day streak</div></div>
            </div>
            <div class="accuracy-ring" title="Overall accuracy">
                <svg viewBox="0 0 110 110" role="img" aria-label="Overall accuracy ring">
                    <circle cx="55" cy="55" r="46" class="ring-bg" />
                    <circle cx="55" cy="55" r="46" class="ring-fill"
                            stroke-dasharray="@(_overview.OverallAccuracy / 100.0 * 289.0) 289.0" />
                    <text x="55" y="52" text-anchor="middle" class="ring-num">@_overview.OverallAccuracy.ToString("0")%</text>
                    <text x="55" y="68" text-anchor="middle" class="ring-label">accuracy</text>
                </svg>
            </div>
        </div>

        <h2>Accuracy over time</h2>
        <div class="panel">
            <div class="chart-controls">
                <label>
                    Task:
                    <select @bind="_chartTask" @bind:after="ReloadSeriesAsync">
                        <option value="">All tasks</option>
                        @foreach (var t in Content.Tasks.Where(t => _taskStats.Any(s => s.TaskId == t.Id)))
                        {
                            <option value="@t.Id">@t.Title</option>
                        }
                    </select>
                </label>
                <label>
                    Period:
                    <select @bind="_chartDays" @bind:after="ReloadSeriesAsync">
                        <option value="7">last 7 days</option>
                        <option value="30">last 30 days</option>
                        <option value="90">last 90 days</option>
                    </select>
                </label>
            </div>
            <LineChart Points="_series" Height="240" />
        </div>

        <h2>By task</h2>
        <div class="panel table-wrap">
            <table class="stats-table">
                <thead>
                    <tr><th>Task</th><th>Sets</th><th>Questions</th><th>Accuracy</th><th>Trend</th><th>Hint use</th><th>Last practiced</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _taskStats)
                    {
                        var def = Content.FindTask(s.TaskId);
                        var trend = _trends.GetValueOrDefault(s.TaskId);
                        <tr>
                            <td>@(def?.Title ?? s.TaskId)</td>
                            <td>@s.Attempts</td>
                            <td>@s.ItemsCorrect/@s.ItemsAttempted</td>
                            <td>
                                <div class="acc-cell">
                                    <div class="acc-bar"><div class="acc-fill" style="width:@s.Accuracy.ToString("0")%"></div></div>
                                    <span>@s.Accuracy.ToString("0")%</span>
                                </div>
                            </td>
                            <td>
                                @if (s.Attempts < 4)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <span class="trend @(trend >= 5 ? "trend-up" : trend <= -5 ? "trend-down" : "trend-flat")">
                                        @(trend >= 5 ? "↑" : trend <= -5 ? "↓" : "→") @Math.Abs(trend).ToString("0")
                                    </span>
                                }
                            </td>
                            <td>@s.HintRate.ToString("0")%</td>
                            <td class="muted">@LocalTime(s.LastPracticedUtc)</td>
                            <td><a href="/practice/@s.TaskId">practise →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_mistakes.Count > 0)
        {
            <h2>Most frequent mistakes</h2>
            <div class="panel">
                <ul class="mistake-list">
                    @foreach (var m in _mistakes)
                    {
                        <li>
                            <code>@m.Expected</code>
                            <span class="muted">missed ×@m.Times in @(Content.FindTask(m.TaskId)?.Title ?? m.TaskId)</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <h2>Recent history</h2>
        <div class="panel table-wrap">
            <div class="chart-controls">
                <label>
                    Task:
                    <select @bind="_historyTask">
                        <option value="">All tasks</option>
                        @foreach (var id in _history.Select(h => h.TaskId).Distinct())
                        {
                            var def = Content.FindTask(id);
                            <option value="@id">@(def?.Title ?? id)</option>
                        }
                    </select>
                </label>
            </div>
            <table class="stats-table">
                <thead>
                    <tr><th>When</th><th>Task</th><th>Set</th><th>Score</th><th>Notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var h in _history.Where(h => _historyTask == "" || h.TaskId == _historyTask))
                    {
                        var def = Content.FindTask(h.TaskId);
                        <tr>
                            <td class="muted">@LocalTime(h.TimestampUtc)</td>
                            <td>@(def is null ? h.TaskId : def.Title)</td>
                            <td class="muted">@h.SetId</td>
                            <td>@h.CorrectCount/@h.ItemCount</td>
                            <td>@(h.HintUsed ? "hints" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private ProgressOverview? _overview;
    private List<TaskStat> _taskStats = new();
    private List<DailyPoint> _series = new();
    private List<ProgressService.HistoryRow> _history = new();
    private List<(string Expected, int Times, string TaskId)> _mistakes = new();
    private Dictionary<string, double> _trends = new();
    private string _chartTask = "";
    private int _chartDays = 30;
    private string _historyTask = "";
    private string? _ownerId;
    private bool _confirmReset;
    private int _streak;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ownerId = await Owner.GetOwnerIdAsync();
            await ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        if (_ownerId is null) return;
        _overview = await ProgressSvc.GetOverviewAsync(_ownerId);
        _taskStats = await ProgressSvc.GetTaskStatsAsync(_ownerId);
        _history = await ProgressSvc.GetHistoryAsync(_ownerId);
        _mistakes = await ProgressSvc.GetTopMistakesAsync(_ownerId);
        _trends = await ProgressSvc.GetTaskTrendsAsync(_ownerId);
        // streak: consecutive days (ending today or yesterday) with at least one attempt
        var allDays = await ProgressSvc.GetDailySeriesAsync(_ownerId, null, 90);
        _streak = 0;
        for (var day = DateTime.UtcNow.Date; day >= DateTime.UtcNow.Date.AddDays(-90); day = day.AddDays(-1))
        {
            if (allDays.Any(p => p.Day == day && p.Attempts > 0))
                _streak++;
            else if (day != DateTime.UtcNow.Date)
                break;
        }
        await ReloadSeriesAsync();
    }

    private async Task ReloadSeriesAsync()
    {
        if (_ownerId is null) return;
        _series = await ProgressSvc.GetDailySeriesAsync(_ownerId, string.IsNullOrEmpty(_chartTask) ? null : _chartTask, _chartDays);
        StateHasChanged();
    }

    private async Task ResetStats()
    {
        if (_ownerId is null) return;
        await ProgressSvc.ResetStatsAsync(_ownerId);
        _confirmReset = false;
        await ReloadAsync();
    }

    private static string LocalTime(DateTime? utc) => utc is null
        ? "—"
        : utc.Value.ToLocalTime().ToString("g");
}
