@page "/guide"
@page "/guide/{Slug}"
@using PracticingCAE.Web.Components.Pages.GuideContent

<PageTitle>@(Current is null ? "Exam guide — CAE Practice" : $"{Current.Title} — Exam guide — CAE Practice")</PageTitle>

<div class="page-shell guide-page">
    @if (Current is null)
    {
        <header class="guide-header">
            <h1>Exam guide</h1>
            <p class="muted guide-lead">
                Strategy and timing for every part of the Reading &amp; Use of English paper —
                and how to train it on this site.
            </p>
        </header>

        @if (UnknownSlug)
        {
            <div class="callout callout-warn">
                <p><strong>Unknown section.</strong> There is no guide page called “@Slug”. Pick one below.</p>
            </div>
        }

        <div class="guide-toc">
            @for (var i = 0; i < GuideLibrary.Sections.Count; i++)
            {
                var s = GuideLibrary.Sections[i];
                <a class="guide-toc-card" href="@Href(s.Slug)">
                    <span class="guide-toc-num">@(i + 1)</span>
                    <span class="guide-toc-title">@s.Title</span>
                    <span class="guide-toc-sum">@s.Summary</span>
                </a>
            }
        </div>
    }
    else
    {
        <nav class="guide-chips" aria-label="Guide sections">
            @foreach (var s in GuideLibrary.Sections)
            {
                <NavLink class="guide-chip" ActiveClass="guide-chip-active" href="@Href(s.Slug)" Match="NavLinkMatch.All">@s.Title</NavLink>
            }
        </nav>

        @switch (Current.Slug)
        {
            case "overview":
                @Overview
                break;
            case "timing":
                @Timing
                break;
            case "part-1":
                @Part1
                break;
            case "part-2":
                @Part2
                break;
            case "part-3":
                @Part3
                break;
            case "part-4":
                @Part4
                break;
            case "common-traps":
                @CommonTraps
                break;
            case "preparation":
                @Preparation
                break;
        }

        <nav class="guide-pager" aria-label="Previous and next guide sections">
            @if (Prev is not null)
            {
                <a class="guide-pager-link" href="@Href(Prev.Slug)"><small>Previous</small><strong>@Prev.Title</strong></a>
            }
            else
            {
                <span></span>
            }
            @if (Next is not null)
            {
                <a class="guide-pager-link guide-pager-next" href="@Href(Next.Slug)"><small>Next</small><strong>@Next.Title</strong></a>
            }
        </nav>
    }
</div>

@code {
    [Parameter] public string? Slug { get; set; }

    private GuideLibrary.Section? Current => Slug is null ? null : GuideLibrary.Find(Slug);

    private bool UnknownSlug => Slug is not null && Current is null;

    private GuideLibrary.Section? Prev
    {
        get
        {
            if (Current is null) return null;
            var i = GuideLibrary.IndexOf(Current);
            return i > 0 ? GuideLibrary.Sections[i - 1] : null;
        }
    }

    private GuideLibrary.Section? Next
    {
        get
        {
            if (Current is null) return null;
            var i = GuideLibrary.IndexOf(Current);
            return i >= 0 && i < GuideLibrary.Sections.Count - 1 ? GuideLibrary.Sections[i + 1] : null;
        }
    }

    private static string Href(string slug) => $"guide/{slug}";

    private RenderFragment Overview => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Exam overview")</h2>
        <p class="guide-lead">
            The Reading &amp; Use of English paper lasts <strong>1 hour 30 minutes</strong> and has
            <strong>8 parts</strong> and <strong>56 questions</strong>. It is worth <strong>40% of your
            overall grade</strong> — the single largest paper of the exam. Parts 1–3 give 1 mark per
            question, Parts 4–7 give 2, and Part 8 gives 1 again.
        </p>

        <h3>The whole exam</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Paper</th><th>Length</th><th>Weight</th></tr>
                </thead>
                <tbody>
                    <tr class="guide-row-ue"><td>Reading &amp; Use of English</td><td>1 h 30 min — 8 parts, 56 questions</td><td>40%</td></tr>
                    <tr><td>Writing</td><td>1 h 30 min — 2 parts</td><td>20%</td></tr>
                    <tr><td>Listening</td><td>About 40 min — 4 parts</td><td>20%</td></tr>
                    <tr><td>Speaking</td><td>15 min — 4 parts, with a partner</td><td>20%</td></tr>
                </tbody>
            </table>
        </div>

        <h3>The eight parts of Reading &amp; Use of English</h3>
        <p class="muted">Parts 1–4 are the Use of English half (shaded). Parts 5–8 are the Reading half.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Task</th><th>Questions</th><th>Marks each</th><th>What it tests</th></tr>
                </thead>
                <tbody>
                    <tr class="guide-row-ue"><td>1</td><td>Multiple-choice cloze</td><td>8</td><td>1</td><td>Vocabulary: collocation, phrasal verbs, fixed phrases</td></tr>
                    <tr class="guide-row-ue"><td>2</td><td>Open cloze</td><td>8</td><td>1</td><td>Grammar: function words in context</td></tr>
                    <tr class="guide-row-ue"><td>3</td><td>Word formation</td><td>8</td><td>1</td><td>Vocabulary: word families, affixes, spelling</td></tr>
                    <tr class="guide-row-ue"><td>4</td><td>Key word transformations</td><td>6</td><td>2</td><td>Grammar and vocabulary: paraphrase, control of structures</td></tr>
                    <tr><td>5</td><td>Reading — multiple choice</td><td>6</td><td>2</td><td>Detail, opinion, gist, main idea of a long text</td></tr>
                    <tr><td>6</td><td>Cross-text multiple matching</td><td>4</td><td>2</td><td>Opinion and agreement across four short texts</td></tr>
                    <tr><td>7</td><td>Gapped text</td><td>6</td><td>2</td><td>Rebuilding a text: six removed sentences, put back in order</td></tr>
                    <tr><td>8</td><td>Multiple matching</td><td>10</td><td>1</td><td>Detail and opinion across several short texts</td></tr>
                </tbody>
            </table>
        </div>
        <div class="callout callout-info">
            <p><strong>Parts 1–4 carry 36 of the paper’s 78 marks.</strong> Thirty questions — roughly half
            the questions and nearly half the marks — and exactly what this site drills. They are also the
            only 36 marks in the paper that respond to <em>drilling</em> rather than years of reading.</p>
        </div>

        <h3>Where the marks are cheapest</h3>
        <p>Not all marks cost the same effort. The table below combines the standard timing budget (see
        <a href="@Href("timing")">Time management</a>) with how quickly each part responds to practice.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Marks</th><th>Marks per minute at budget</th><th>How fast drilling moves it</th></tr>
                </thead>
                <tbody>
                    <tr class="guide-row-ue"><td>2 — open cloze</td><td>8</td><td>0.8</td><td><strong>Fastest.</strong> Answers come from a closed set of function words; grammar rules are finite</td></tr>
                    <tr class="guide-row-ue"><td>3 — word formation</td><td>8</td><td>0.8</td><td><strong>Fast.</strong> A finite affix system plus a learnable irregular list; pure method</td></tr>
                    <tr class="guide-row-ue"><td>4 — transformations</td><td>12</td><td>1.0</td><td><strong>Fast.</strong> Roughly a dozen patterns cover most papers — and each question is worth 2 marks</td></tr>
                    <tr class="guide-row-ue"><td>1 — multiple-choice cloze</td><td>8</td><td>0.8</td><td><strong>Steady.</strong> Needs collocation breadth, which grows with exposure — drill the families</td></tr>
                    <tr><td>5–8 — reading</td><td>40</td><td>0.8–1.2</td><td><strong>Slow.</strong> Reading skill is built over months; timed practice sharpens, but does not replace it</td></tr>
                </tbody>
            </table>
        </div>
        <p>The practical conclusion: <strong>Parts 2, 3 and 4 are where an hour of practice buys the most
        marks</strong>, and they all sit in the first 42 minutes of the paper, where time pressure is
        lowest. That is why this site drills exactly those parts.</p>

        <h3>What C1 means in each part — practically</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>What “C1 level” actually means here</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>You do not just recognise words — you know which words <em>keep company</em>: you take a decision but make an effort, and you feel that “powerful coffee” is wrong without needing a rule.</td></tr>
                    <tr><td>2</td><td>You produce the small structural words automatically: the article appears before the noun, the auxiliary before the participle, the linker between the clauses — without a prompt.</td></tr>
                    <tr><td>3</td><td>You can build a whole family from one stem and pick the right member: <em>succeed → success → successful → successfully → unsuccessful</em>.</td></tr>
                    <tr><td>4</td><td>You can say the same thing two grammatically different ways and keep the meaning identical — passive for active, <em>despite</em> for <em>although</em>, reported for direct.</td></tr>
                    <tr><td>5–8</td><td>You read for purpose and attitude, not word by word; you can locate and compare information faster than you can translate it.</td></tr>
                </tbody>
            </table>
        </div>

        <h3>How this site maps to the exam</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Site task</th><th>Exam part</th><th>Format</th><th>How to train it here</th></tr>
                </thead>
                <tbody>
                    <tr><td>Reading &amp; Use of English — Part 1</td><td>Part 1</td><td>Multiple-choice cloze, 8 questions per set — same as the exam</td><td>Sets untimed while learning, then within the 10-minute budget; classify every wrong pick by distractor type</td></tr>
                    <tr><td>Reading &amp; Use of English — Part 2</td><td>Part 2</td><td>Open cloze, 8 questions, one word per gap — same as the exam</td><td>Answers are typed with no options, exactly like the paper; review the explanation after every set</td></tr>
                    <tr><td>Reading &amp; Use of English — Part 3</td><td>Part 3</td><td>Word formation, 8 questions — same as the exam</td><td>Typed; after checking, write out the full word family for every stem you missed</td></tr>
                    <tr><td>Reading &amp; Use of English — Part 4</td><td>Part 4</td><td>Key word transformations, 6 questions — same as the exam</td><td>The 3–6-word rule is enforced on screen; hand-count words before checking</td></tr>
                    <tr><td>Topic drills (collocations, prepositions, verb patterns, …)</td><td>—</td><td>No exam equivalent</td><td>Use them to repair the exact weaknesses listed on the Progress page</td></tr>
                </tbody>
            </table>
        </div>

        <h3>The one fact that matters most in each part</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Remember this</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>Most options are grammatically correct. The question is which word the sentence <em>collocates</em> with — not which word is “more correct”.</td></tr>
                    <tr><td>2</td><td>One word only, and it is almost always a grammar word: article, auxiliary, preposition, pronoun, quantifier.</td></tr>
                    <tr><td>3</td><td>Decide the part of speech first. Forming the right word in the wrong class still scores zero.</td></tr>
                    <tr><td>4</td><td>Two marks per sentence — one for each half. A correct structure with one slip elsewhere can still earn 1 mark, so always write something.</td></tr>
                </tbody>
            </table>
        </div>
        <p><a href="@Href("timing")">Next: how to spend the 90 minutes.</a></p>
    </div>;

    private RenderFragment Timing => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Time management")</h2>
        <p class="guide-lead">
            You have <strong>90 minutes</strong> for 8 parts. Running out of time reliably costs more
            marks than a hard question does — so follow a budget, not a feeling.
        </p>

        <h3>The 90-minute budget with running-clock checkpoints</h3>
        <p>The allocation sums exactly to 90. The “clock” column is what you should see on your watch
        <em>when you finish</em> that part — glance at it at every part boundary, and nowhere else.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Task</th><th>Budget</th><th>Hard cap per question</th><th>Clock when you finish</th></tr>
                </thead>
                <tbody>
                    <tr class="guide-row-ue"><td>1</td><td>Multiple-choice cloze</td><td>10 min</td><td>75 s</td><td>0:10</td></tr>
                    <tr class="guide-row-ue"><td>2</td><td>Open cloze</td><td>10 min</td><td>75 s</td><td>0:20</td></tr>
                    <tr class="guide-row-ue"><td>3</td><td>Word formation</td><td>10 min</td><td>75 s</td><td>0:30</td></tr>
                    <tr class="guide-row-ue"><td>4</td><td>Key word transformations</td><td>12 min</td><td>2 min</td><td>0:42</td></tr>
                    <tr><td>5</td><td>Reading, multiple choice</td><td>15 min</td><td>2.5 min</td><td>0:57</td></tr>
                    <tr><td>6</td><td>Cross-text multiple matching</td><td>10 min</td><td>2.5 min</td><td>1:07</td></tr>
                    <tr><td>7</td><td>Gapped text</td><td>10 min</td><td>100 s</td><td>1:17</td></tr>
                    <tr><td>8</td><td>Multiple matching</td><td>10 min</td><td>1 min</td><td>1:27</td></tr>
                    <tr><td>—</td><td>Final check of flagged answers</td><td>3 min</td><td>—</td><td>1:30</td></tr>
                </tbody>
            </table>
        </div>
        <div class="callout callout-info">
            <p><strong>Part 4 gets more time per question — for a reason.</strong> Six questions carry
            12 marks, more than any other part, and every one of those marks is trainable because the
            patterns are finite (see <a href="@Href("part-4")">Part 4 strategy</a>). It must never be
            the part you rush.</p>
        </div>

        <h3>Time-boxing rules</h3>
        <ul class="guide-list">
            <li><strong>Two passes per part.</strong> Pass one: answer only what is obvious in under
            15 seconds — this banks the easy marks. Pass two: work the rest with the time that is left.
            Never polish question 1 while questions 6–8 are blank.</li>
            <li><strong>The cap is absolute.</strong> When a question hits its cap, write your best guess,
            circle the number, move on. A guess can score; a blank cannot.</li>
            <li><strong>Borrowing is a loan with interest.</strong> Ten minutes “found” in Part 1 must be
            repaid with marks from the last part. If you borrow, borrow consciously and recover it (below).</li>
            <li><strong>Check the clock only at part boundaries.</strong> Checking mid-part invites panic;
            the boundary number tells you everything you need.</li>
        </ul>

        <h3>The triage protocol: bank, then solve, then guess</h3>
        <p>Triage is not about skipping whole parts — it is about the order you spend thought inside a
        part, and about knowing in advance what “stuck” looks like:</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Trigger to stop thinking</th><th>What to write before moving on</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>Two options still plausible after testing both against the words around the gap</td><td>The option that collocates with the more common partner word</td></tr>
                    <tr><td>2</td><td>Every candidate word breaks the grammar after two attempts</td><td>The most likely preposition or auxiliary for that slot</td></tr>
                    <tr><td>3</td><td>You cannot decide the part of speech from the sentence</td><td>The most common form of the stem in its most common class (usually the noun)</td></tr>
                    <tr><td>4</td><td>The key word names a structure you do not recognise within 2 minutes</td><td>A minimal correct frame using the key word untouched — partial credit is real</td></tr>
                </tbody>
            </table>
        </div>
        <p>Every guess gets circled and revisited in the 3-minute final check — sometimes the answer
        surfaces once the pressure is off.</p>

        <h3>When you are stuck: the 30-second rule</h3>
        <ol class="guide-steps">
            <li>Give the question <strong>30 seconds</strong> of real thought.</li>
            <li>If nothing lands, <strong>write your best guess now</strong> — a blank scores zero, a guess sometimes scores one.</li>
            <li><strong>Mark it</strong> (circle the number on the question paper) and move on.</li>
            <li><strong>Return</strong> to marked questions in the 3-minute check at the end.</li>
        </ol>

        <h3>Recovery plan when the clock says you are behind</h3>
        <p>Diagnose at the boundary into Part 5 (0:42). That is the one place where being behind is
        normal and fixable — the second half of the paper has flexible per-question budgets. Match your
        overshoot to a plan:</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Behind by</th><th>Plan for Parts 5–8 + check</th></tr>
                </thead>
                <tbody>
                    <tr><td>Up to 5 min</td><td>Hold the original plan; recover by shaving 1–2 minutes from Parts 7 and 8. No other change.</td></tr>
                    <tr><td>6–10 min</td><td>Cut Part 5 to 12 min (questions first, then scan), Part 6 to 8, Part 7 to 8, Part 8 to 8, check 2 min. Guess-mark the hardest Part 6 item.</td></tr>
                    <tr><td>11–20 min</td><td><strong>The 28-minute panic plan below.</strong> One careful pass, no second pass, questions before texts.</td></tr>
                    <tr><td>More than 20 min</td><td>Same panic plan, and accept that Part 5 becomes skim-and-match: read the questions first, hunt the answers, never read the full text.</td></tr>
                </tbody>
            </table>
        </div>
        <p><strong>The 28-minute panic plan</strong> (20 minutes behind at 0:42 → 28 minutes left):</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Part</th><th>Budget</th><th>How</th></tr>
                </thead>
                <tbody>
                    <tr><td>5 — multiple choice</td><td>8 min</td><td>Read the questions first; then locate each answer in its paragraph. No full reading pass.</td></tr>
                    <tr><td>6 — cross-text matching</td><td>5 min</td><td>Answer the two clearest statements; best-guess the rest now, do not return.</td></tr>
                    <tr><td>7 — gapped text</td><td>6 min</td><td>First pass only: plug in the easiest links (pronouns, repeated nouns); guess the leftovers.</td></tr>
                    <tr><td>8 — multiple matching</td><td>8 min</td><td>Strictly one minute per question; it is 1 mark each, so speed beats perfection.</td></tr>
                    <tr><td>Check</td><td>1 min</td><td>Blanks only: nothing left empty anywhere on the answer sheet.</td></tr>
                </tbody>
            </table>
        </div>

        <h3>Time traps</h3>
        <ul class="guide-list">
            <li><strong>Perfecting Part 1, rushing Part 4.</strong> Twenty-five comfortable minutes on Part 1
            starve the part worth the most marks per question. Hold the 10-minute line.</li>
            <li><strong>Re-reading the whole text for every gap.</strong> Read the sentence before and after
            each gap, not the entire text again.</li>
            <li><strong>Polishing easy answers.</strong> If the first word you wrote in Part 2 was simple and
            grammatical, it is probably right. Spend saved time on Part 4, not on Part 2.</li>
            <li><strong>Copying answers at the end (paper-based exam).</strong> Write each answer straight
            onto the answer sheet as you go; leaving transfer to the last minute is how blanks happen.</li>
            <li><strong>Ignoring the clock column.</strong> If you are more than 2–3 minutes behind at any
            boundary, take your best guesses on the hardest remaining questions and switch to the matching
            recovery plan above.</li>
        </ul>

        <div class="callout callout-tip">
            <p><strong>Train the clock here.</strong> When you run a timed set on this site, hold the same
            budgets: 10 minutes for Parts 1–3, 12 for Part 4. Use a stopwatch, not a feeling — and run the
            full four-part sequence to rehearse the boundary checks (see
            <a href="@Href("preparation")">Prepare with this site</a>).</p>
        </div>
        <p><a href="@Href("part-1")">Next: Part 1 strategy.</a></p>
    </div>;

    private RenderFragment Part1 => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Part 1: Multiple-choice cloze")</h2>
        <p class="guide-lead">
            8 gaps in one text, four options each, 1 mark per gap. The options usually all fit the
            grammar — this part tests <strong>which word naturally goes with the words around it</strong>.
        </p>

        <h3>The method, step by step</h3>
        <ol class="guide-steps">
            <li><strong>Read the sentence before and after the gap first.</strong> The clue is often one
            sentence away, and you cannot spot a collocation if you have not read far enough.</li>
            <li><strong>Decide the word class</strong> the slot needs: verb, noun, adjective, linker.
            This alone sometimes kills two options.</li>
            <li><strong>Predict your own word</strong> before looking at A–D. Any close synonym confirms
            you understand the sentence; confusion here means re-read, don’t guess.</li>
            <li><strong>Test the options as collocations</strong>, not as meanings: cover the gap and say
            the whole phrase with each option. Check what comes <em>after</em> the gap — a preposition or
            -ing form there eliminates verbs that demand something else.</li>
            <li><strong>Re-read the finished sentence</strong> with your choice in place before moving on.</li>
        </ol>

        <h3>A worked example</h3>
        <div class="callout callout-info">
            <p>“The board refused to <strong>____</strong> the committee’s objections into consideration
            and approved the plan unchanged.”<br />
            A&nbsp;&nbsp;bring&nbsp;&nbsp;&nbsp;B&nbsp;&nbsp;take&nbsp;&nbsp;&nbsp;C&nbsp;&nbsp;put&nbsp;&nbsp;&nbsp;D&nbsp;&nbsp;look</p>
        </div>
        <ol class="guide-steps">
            <li><strong>Word class:</strong> after “to”, a base verb is needed. All four options are verbs —
            grammar alone decides nothing here, which is typical of Part 1.</li>
            <li><strong>Find the partner:</strong> the phrase ends in “… into consideration”. Which verb
            forms a fixed expression with that ending?</li>
            <li><strong>Predict:</strong> the standard phrase is <span class="guide-word">take</span>
            something into consideration.</li>
            <li><strong>Eliminate:</strong> <em>look</em> pairs with “into” directly (look <strong>into</strong>
            the matter = investigate) and cannot take a noun between; <em>put</em> pairs with “into
            practice / into effect”; <em>bring</em> partners with “up” (bring up an objection). Only
            <span class="guide-word">take</span> completes the fixed phrase.</li>
            <li><strong>Verify:</strong> re-read the whole sentence with B in place — it reads naturally
            and the meaning is complete.</li>
        </ol>
        <p>Notice the shape of the reasoning: <em>class → partner phrase → predict → eliminate → verify</em>.
        The same five moves solve almost every Part 1 item.</p>

        <h3>Distractor taxonomy — and the defence for each type</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Distractor type</th><th>What it looks like</th><th>Defence</th></tr>
                </thead>
                <tbody>
                    <tr><td>Right meaning, wrong collocate</td><td>“powerful coffee” — the meaning is fine, English says <em>strong</em></td><td>Check the partner word, not the dictionary definition</td></tr>
                    <tr><td>Wrong pattern</td><td>a verb that cannot take the preposition, -ing or to-infinitive that follows the gap</td><td>Inspect the two or three words <em>after</em> the gap before choosing</td></tr>
                    <tr><td>Confusable pair</td><td>remember / remind, borrow / lend, say / tell</td><td>Check who does what to whom in the sentence</td></tr>
                    <tr><td>Same word, other meaning</td><td><em>give notice</em> (= announce you are leaving) vs <em>take notice</em> (= pay attention)</td><td>Match the meaning the sentence actually needs, not the first meaning you recall</td></tr>
                    <tr><td>Too general</td><td><em>get, do, put</em> — they fit almost anywhere and add no precise meaning</td><td>Prefer the most specific option that fits</td></tr>
                    <tr><td>L1 translation trap</td><td>the word your language would use in the same sentence</td><td>Distrust any option that feels right “because that’s what I’d say at home”</td></tr>
                </tbody>
            </table>
        </div>

        <h3>The 25 collocation families that dominate Part 1</h3>
        <p>Almost every Part 1 answer is a member of one of these families. Learn them as whole phrases,
        never as single words.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>#</th><th>Family</th><th>Members to know</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td><span class="guide-word">take</span> + noun</td><td>take place, take part in, take responsibility for, take notice of, take advantage of, take care of</td></tr>
                    <tr><td>2</td><td><span class="guide-word">make</span> + noun</td><td>make a decision, make a mistake, make an effort, make progress, make sense of, make a difference to</td></tr>
                    <tr><td>3</td><td><span class="guide-word">do</span> + noun</td><td>do research into, do someone a favour, do harm, do good, do business with, do your best</td></tr>
                    <tr><td>4</td><td><span class="guide-word">pay</span> + noun</td><td>pay attention to, pay a compliment, pay tribute to, pay the price for, pay a visit to</td></tr>
                    <tr><td>5</td><td><span class="guide-word">have</span> + noun</td><td>have an effect on, have an impact on, have difficulty (in) -ing, have no intention of -ing</td></tr>
                    <tr><td>6</td><td><span class="guide-word">give</span> + noun</td><td>give rise to, give way to, give priority to, give the impression that</td></tr>
                    <tr><td>7</td><td><span class="guide-word">gain</span> + noun</td><td>gain access to, gain an advantage over, gain experience, gain weight</td></tr>
                    <tr><td>8</td><td><span class="guide-word">keep</span> + noun</td><td>keep pace with, keep track of, keep a promise, keep calm, keep records</td></tr>
                    <tr><td>9</td><td><span class="guide-word">break</span> + noun</td><td>break the law, break a promise, break the news to, break a record, break a habit</td></tr>
                    <tr><td>10</td><td><span class="guide-word">come / reach</span> + noun</td><td>come to a conclusion, come to terms with, reach an agreement, reach a decision</td></tr>
                    <tr><td>11</td><td><span class="guide-word">strong</span> + noun</td><td>a strong argument, strong evidence, a strong feeling that, strong coffee</td></tr>
                    <tr><td>12</td><td><span class="guide-word">heavy</span> + noun</td><td>heavy rain, heavy traffic, heavy investment, a heavy workload</td></tr>
                    <tr><td>13</td><td><span class="guide-word">deep</span> + noun</td><td>a deep sleep, a deep breath, in deep trouble</td></tr>
                    <tr><td>14</td><td><span class="guide-word">close</span> + noun</td><td>a close friend, a close relative, a close race, a close look at</td></tr>
                    <tr><td>15</td><td><span class="guide-word">wide / broad</span> + noun</td><td>a wide range of, broad agreement, wide awake</td></tr>
                    <tr><td>16</td><td>intensifier + adjective</td><td>bitterly disappointed, bitterly cold; highly successful, highly unlikely; fully aware, fully committed</td></tr>
                    <tr><td>17</td><td><span class="guide-word">strictly / vitally</span></td><td>strictly forbidden, strictly speaking, vitally important</td></tr>
                    <tr><td>18</td><td>verb + <span class="guide-word">on</span></td><td>depend on, rely on, insist on, concentrate on, blame something on someone</td></tr>
                    <tr><td>19</td><td>verb + <span class="guide-word">for</span></td><td>apologise for, blame someone for, account for, be responsible for</td></tr>
                    <tr><td>20</td><td>verb + <span class="guide-word">with / from</span></td><td>cope with, deal with, comply with, interfere with; suffer from, benefit from, recover from</td></tr>
                    <tr><td>21</td><td>verb + <span class="guide-word">in / to</span></td><td>be involved in, succeed in, result in; contribute to, lead to, refer to, object to</td></tr>
                    <tr><td>22</td><td>noun + <span class="guide-word">of / for / to</span></td><td>cause of, risk of, reason for, solution to, key to, answer to</td></tr>
                    <tr><td>23</td><td>change noun + <span class="guide-word">in</span></td><td>an increase in, a rise in, a fall in, a drop in prices</td></tr>
                    <tr><td>24</td><td>quantity + <span class="guide-word">of</span></td><td>a great deal of, a large amount of, a number of, the majority of</td></tr>
                    <tr><td>25</td><td>fixed sentence phrases</td><td>on the whole, on average, in particular, by accident, have … in common, on behalf of, in spite of</td></tr>
                </tbody>
            </table>
        </div>

        <div class="callout callout-tip">
            <p><strong>Eliminate first.</strong> Two of the four options are usually clearly wrong on meaning
            or pattern. Cross them out; choose between the survivors. One deliberate comparison beats four
            vague ones.</p>
        </div>
        <div class="callout callout-warn">
            <p><strong>Do not pick the word your language would use.</strong> A direct translation often breaks
            an English collocation — exactly what this part is built to catch.</p>
        </div>
        <p><a href="@Href("part-2")">Next: Part 2 strategy.</a></p>
    </div>;

    private RenderFragment Part2 => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Part 2: Open cloze")</h2>
        <p class="guide-lead">
            8 gaps, no options. You write <strong>one word</strong> per gap — and it is almost always a
            <strong>function word</strong>: article, auxiliary, preposition, pronoun, quantifier, linker.
            1 mark per gap.
        </p>

        <h3>The 12 categories behind nearly every answer</h3>
        <p>Virtually all Part 2 answers come from twelve grammatical jobs. Read the words on <em>both
        sides</em> of the gap, identify the job, then choose the word.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>#</th><th>Category</th><th>Cue around the gap</th><th>Usual answers</th><th>Example</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>Article</td><td>singular countable noun with nothing before it; or a noun mentioned for the second time</td><td>a, an, the</td><td>She runs <span class="guide-word">a</span> small hotel.</td></tr>
                    <tr><td>2</td><td>Fixed preposition</td><td>a verb, adjective or noun whose partner word is missing; time and place phrases</td><td>in, on, at, for, with, from, about</td><td>She’s very good <span class="guide-word">at</span> chess.</td></tr>
                    <tr><td>3</td><td><em>of</em></td><td>quantity or portion word, superlative, or “a lot / kind / sort” needing its group</td><td>of</td><td>the majority <span class="guide-word">of</span> voters</td></tr>
                    <tr><td>4</td><td>Auxiliary</td><td>subject + ___ + past participle; questions and negatives needing do-support</td><td>have, has, had, is, was, were, been, do, does, did</td><td>By midnight they <span class="guide-word">had</span> finished.</td></tr>
                    <tr><td>5</td><td>Modal</td><td>___ + bare infinitive: ability, obligation, possibility, advice</td><td>can, could, may, might, must, should, will, would</td><td>You <span class="guide-word">must</span> be tired.</td></tr>
                    <tr><td>6</td><td>Relative pronoun</td><td>noun + ___ + clause missing its subject or object; often after a comma</td><td>who, which, that, whose, whom, where, when</td><td>the film <span class="guide-word">that</span> won the prize</td></tr>
                    <tr><td>7</td><td>Pronoun / determiner</td><td>a subject or object slot with no noun anywhere nearby</td><td>it, they, them, one, his, its, their</td><td>The storm tore <span class="guide-word">its</span> roof off.</td></tr>
                    <tr><td>8</td><td>Quantifier</td><td>___ + of + noun, or ___ + a plural or uncountable noun</td><td>most, all, both, some, any, few, little, much, many, none</td><td><span class="guide-word">Some</span> of the guests left early.</td></tr>
                    <tr><td>9</td><td>Comparative gear</td><td>___ + adjective/adverb before <em>than</em>; or the second half of <em>as … as</em></td><td>more, less, as</td><td>far <span class="guide-word">less</span> interesting than I expected</td></tr>
                    <tr><td>10</td><td>Linker</td><td>two complete clauses; the missing word is their logical connection (contrast, cause, condition)</td><td>although, though, because, since, if, unless, while, whereas, however</td><td><span class="guide-word">Although</span> it was raining, we walked.</td></tr>
                    <tr><td>11</td><td><em>there</em></td><td>___ + is/was/will be + noun naming something new</td><td>there</td><td><span class="guide-word">There</span> is little time left.</td></tr>
                    <tr><td>12</td><td><em>so / such / not / no</em></td><td>___ + adjective + noun + <em>that</em>; or ___ + <em>do</em> (substitute); or fixing a negative</td><td>so, such, not, no</td><td>It was <span class="guide-word">such</span> a dull film that we left.</td></tr>
                </tbody>
            </table>
        </div>

        <h3>A worked example</h3>
        <div class="callout callout-info">
            <p>“By the time we reached the stadium, the match <strong>____</strong> already started.”</p>
        </div>
        <ol class="guide-steps">
            <li><strong>Read the full sentence plus the one before it.</strong> “By the time + past simple”
            signals two past events, one earlier than the other.</li>
            <li><strong>Identify the job:</strong> the slot sits between the subject (“the match”) and
            “already started” (past participle). A main verb is impossible — an <em>auxiliary</em> is
            missing (category 4).</li>
            <li><strong>Choose the tense:</strong> the earlier of two past events takes the past perfect
            → <span class="guide-word">had</span>.</li>
            <li><strong>Reject the near misses:</strong> <em>was</em> (“was already started” is not
            English), <em>has</em> (breaks the past frame), <em>is</em> (same problem).</li>
            <li><strong>Re-read:</strong> “By the time we reached the stadium, the match
            <span class="guide-word">had</span> already started.” Unremarkable grammar — which is exactly
            what a correct Part 2 answer sounds like.</li>
        </ol>

        <h3>Method and grammar-first checklist</h3>
        <ol class="guide-steps">
            <li><strong>Read the whole sentence</strong> — and the one before it. Decide the word’s
            <em>function</em> (which of the 12 categories) before picking the exact word.</li>
            <li><strong>Write the word.</strong> If several fit, choose the one that matches the style:
            formal texts want formal linkers.</li>
            <li><strong>Re-read the completed sentence.</strong> If it does not read naturally, the word is wrong.</li>
        </ol>
        <ul class="guide-list">
            <li>Did I name the function (which category) before choosing the word?</li>
            <li>Does the word work with <strong>both</strong> sides of the gap, not just one?</li>
            <li>Agreement checked: <em>has/have</em>, <em>was/were</em>, <em>is/are</em>, <em>much/many</em>?</li>
            <li>Is my answer a function word? If you wrote a noun or a full verb, suspect it.</li>
            <li>Exactly one word? (Contractions such as <em>don’t</em> count as one word here and are fine
            where natural speech would use them.)</li>
        </ul>

        <h3>Spelling traps — even function words can be misspelled</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Wrong</th><th>Right</th><th>Why it happens</th></tr>
                </thead>
                <tbody>
                    <tr><td><span class="guide-bad">becouse</span></td><td><span class="guide-good">because</span></td><td>sound-alike spelling; say it as “be-cause”</td></tr>
                    <tr><td><span class="guide-bad">althought</span></td><td><span class="guide-good">although</span></td><td>contaminated by “thought”; <em>although/though</em> have no -t</td></tr>
                    <tr><td><span class="guide-bad">wich / wath</span></td><td><span class="guide-good">which</span></td><td>unstressed first syllable; remember “wh-” question words</td></tr>
                    <tr><td><span class="guide-bad">then</span> (comparing)</td><td><span class="guide-good">than</span></td><td><em>than</em> compares, <em>then</em> means “next”</td></tr>
                    <tr><td><span class="guide-bad">weather</span> (meaning “if”)</td><td><span class="guide-good">whether</span></td><td>homophones; “whether … or not” introduces alternatives</td></tr>
                    <tr><td><span class="guide-bad">thru / thought</span> (preposition)</td><td><span class="guide-word">through</span></td><td>the through/though/thought trio differs by one letter each</td></tr>
                    <tr><td><span class="guide-bad">it’s</span> (possessive)</td><td><span class="guide-word">its</span></td><td><em>it’s</em> = “it is”; the possessive has no apostrophe</td></tr>
                    <tr><td><span class="guide-bad">untill</span></td><td><span class="guide-good">until</span></td><td>one <em>l</em>, unlike <em>still, till</em></td></tr>
                </tbody>
            </table>
        </div>

        <div class="callout callout-warn">
            <p><strong>One word only.</strong> Two words score zero even when one of them is optional.
            And a misspelled function word also scores zero — if you are unsure of a spelling, choose a
            word you can spell.</p>
        </div>
        <div class="callout callout-tip">
            <p><strong>No blanks.</strong> Write the most plausible function word and move on — guesses are
            free, blanks are permanent. Parts 2–4 on this site are answered in typed mode, so spelling
            pressure is part of training (see <a href="@Href("preparation")">Prepare with this site</a>).</p>
        </div>
        <p><a href="@Href("part-3")">Next: Part 3 strategy.</a></p>
    </div>;

    private RenderFragment Part3 => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Part 3: Word formation")</h2>
        <p class="guide-lead">
            8 gaps. Each line ends with a <strong>stem word in CAPITALS</strong>; you form a new word from
            it to fill the gap. 1 mark per gap — and spelling must be exact.
        </p>

        <h3>Step 1 — decide the part of speech from the sentence position</h3>
        <p>Scan the two or three words <em>before</em> the gap first, then the words after. The position
        tells you the class; only then do you form the word.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>What you see around the gap</th><th>You need</th><th>Example</th></tr>
                </thead>
                <tbody>
                    <tr><td>a / an / the / my / this / some + ___</td><td>noun</td><td>his sudden <span class="guide-word">death</span> (DIE)</td></tr>
                    <tr><td>adjective + ___</td><td>noun</td><td>a remarkable <span class="guide-word">achievement</span> (ACHIEVE)</td></tr>
                    <tr><td>subject + ___ + rest of the predicate</td><td>verb</td><td>Sales <span class="guide-word">strengthened</span> every winter (STRONG)</td></tr>
                    <tr><td>preposition + ___</td><td>noun or -ing form</td><td>without further <span class="guide-word">delay</span> (DELAY)</td></tr>
                    <tr><td>___ + noun (nothing before it)</td><td>adjective</td><td><span class="guide-word">remarkable</span> progress (REMARK)</td></tr>
                    <tr><td>be / seem / become / remain / look + ___</td><td>adjective</td><td>the results are <span class="guide-word">encouraging</span> (ENCOURAGE)</td></tr>
                    <tr><td>action verb + ___ (how?)</td><td>adverb</td><td>she spoke <span class="guide-word">confidently</span> (CONFIDENT)</td></tr>
                    <tr><td>___ + adjective / adverb / whole clause</td><td>adverb</td><td><span class="guide-word">highly</span> successful (HIGH)</td></tr>
                </tbody>
            </table>
        </div>
        <p>The classic loss this table prevents: <em>“a very ___ (SUCCEED) plan”</em> — the cue
        <em>“a very ___ plan”</em> demands an adjective, so <span class="guide-word">successful</span>,
        not the noun <em>success</em>. Right family, wrong member, zero marks.</p>

        <h3>Step 2 — affix quick-reference</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Class</th><th>Endings (meaning)</th><th>Watch out for</th></tr>
                </thead>
                <tbody>
                    <tr><td>Noun</td><td>-ment (result), -ion/-tion/-sion (act or result), -ance/-ence, -ity (state), -ness (quality), -ship, -hood, -er/-or (agent), -ee (person the action happens <em>to</em>: employee), -ist / -ism</td><td>many nouns are irregular: <em>death, growth, choice</em> — see the trap list below</td></tr>
                    <tr><td>Adjective</td><td>-ful (full of), -less (without), -able/-ible, -ive, -ous, -al, -ic, -y, -ed/-ing participles</td><td>-ful and -less are suffixes, not always opposites: <em>priceless ≠ worthless</em></td></tr>
                    <tr><td>Adverb</td><td>-ly</td><td><em>friendly, lovely, lonely, silly</em> are adjectives; <em>hard, fast, late</em> are adverbs with no -ly; <em>hardly</em> = “almost not”</td></tr>
                    <tr><td>Verb</td><td>-ise / -ize, -ify, -en</td><td><em>widen, strengthen</em> — note the noun of STRONG is the irregular <em>strength</em></td></tr>
                    <tr><td>Negative / opposite</td><td>un-, in-, dis-, mis-</td><td>in- becomes <strong>im-</strong> before p, b, m (<em>impossible</em>); <strong>il-</strong> before l (<em>illogical</em>); <strong>ir-</strong> before r (<em>irregular</em>)</td></tr>
                    <tr><td>Also common</td><td>re- (again), over- / under- (too much / too little), pre- / post-, anti-</td><td>only add a prefix when the sentence really states the opposite</td></tr>
                </tbody>
            </table>
        </div>

        <h3>A worked example</h3>
        <div class="callout callout-info">
            <p>“His sudden <strong>____</strong> (DIE) shocked the entire country.”</p>
        </div>
        <ol class="guide-steps">
            <li><strong>Position:</strong> possessive (<em>his</em>) + adjective (<em>sudden</em>) + gap →
            a <strong>noun</strong> is missing.</li>
            <li><strong>Build the family:</strong> die (verb), dead (adjective), death (noun), deadly
            (adjective). No suffix applies — the noun is irregular.</li>
            <li><strong>Answer:</strong> <span class="guide-word">death</span>.</li>
            <li><strong>Plural check:</strong> a single event (“his sudden death”) → no -s. ✓</li>
        </ol>
        <div class="callout callout-info">
            <p>“Unfortunately, the first attempt was completely <strong>____</strong> (SUCCESS).”</p>
        </div>
        <ol class="guide-steps">
            <li><strong>Position:</strong> <em>was</em> + adverb (<em>completely</em>) + gap → an
            <strong>adjective</strong>.</li>
            <li><strong>Negative?</strong> <em>Unfortunately</em> signals the opposite of the stem →
            un-.</li>
            <li><strong>Family:</strong> succeed (v) → success (n) → successful (adj) → unsuccessfully /
            unsuccessful.</li>
            <li><strong>Answer:</strong> <span class="guide-word">unsuccessful</span> — spelling keeps the
            double <em>c</em> of <em>success</em>.</li>
        </ol>

        <h3>Step 3 — checks after forming</h3>
        <ul class="guide-list">
            <li><strong>Negative or not?</strong> Add <em>un-/in-/dis-</em> only if the sentence really
            says the opposite. Signals of a negative: <em>unfortunately, hardly, fail to, rarely,
            despite, but, however, not</em>. An unneeded prefix loses the mark — and a missing one does too.</li>
            <li><strong>Plural signals:</strong> <em>one of the, few, several, many, a number of, among
            the greatest</em> — all demand a plural noun: <em>“one of the greatest ___ (ACHIEVE)”</em> →
            <strong>achievements</strong>. Singular signals: <em>a, one, each, every, this, that</em>.</li>
            <li><strong>If the answer is a verb:</strong> check tense and agreement — third-person -s,
            past forms, irregular pasts (<em>strengthen → strengthened</em>).</li>
            <li><strong>Spelling shifts:</strong> argue → <strong>argument</strong> (e drops),
            happy → <strong>happiness</strong> (y → i), succeed → <strong>successful</strong>,
            industry → <strong>industrial</strong>.</li>
        </ul>

        <h3>The irregular-forms trap list</h3>
        <p>These stems have no predictable suffix. Each one is a known exam answer — learn them as pairs.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Stem</th><th>The answer they want</th><th>Trap</th></tr>
                </thead>
                <tbody>
                    <tr><td>HIGH</td><td><span class="guide-word">height</span></td><td>not “highness”</td></tr>
                    <tr><td>LONG</td><td><span class="guide-word">length</span></td><td>spelling: length, not lenght</td></tr>
                    <tr><td>STRONG</td><td><span class="guide-word">strength</span></td><td>also <em>strengthen</em> (v), <em>strengthened</em></td></tr>
                    <tr><td>DEEP</td><td><span class="guide-word">depth</span></td><td>plural <em>depths</em></td></tr>
                    <tr><td>WIDE</td><td><span class="guide-word">width</span></td><td>-dth pattern like <em>length, depth</em></td></tr>
                    <tr><td>GROW</td><td><span class="guide-word">growth</span></td><td>no -th drop; pronounced differently from <em>grow</em></td></tr>
                    <tr><td>KNOW</td><td><span class="guide-word">knowledge</span></td><td>silent letters; adjective <em>knowledgeable</em></td></tr>
                    <tr><td>DIE</td><td><span class="guide-word">death</span></td><td>dead (adj), dying (v -ing), deadly (fatal) — four words, one stem</td></tr>
                    <tr><td>SUCCEED</td><td><span class="guide-word">success</span></td><td>double c + double s all the way to <em>successful</em></td></tr>
                    <tr><td>CHOOSE</td><td><span class="guide-word">choice</span></td><td>not “choise”; <em>chose</em> is a past form</td></tr>
                    <tr><td>BELIEVE</td><td><span class="guide-word">belief</span></td><td>the noun drops the e (believe → belief)</td></tr>
                    <tr><td>PROVE</td><td><span class="guide-word">proof</span></td><td>spelling shift, no suffix</td></tr>
                    <tr><td>THINK</td><td><span class="guide-word">thought</span></td><td>also <em>thoughtful, thoughtless</em></td></tr>
                    <tr><td>WEIGH</td><td><span class="guide-word">weight</span></td><td>same ei as the verb</td></tr>
                    <tr><td>FLY</td><td><span class="guide-word">flight</span></td><td>not “flyment”; also <em>flightless</em></td></tr>
                    <tr><td>SEE</td><td><span class="guide-word">sight</span></td><td>also <em>eyesight, insight, hindsight</em></td></tr>
                    <tr><td>MAINTAIN</td><td><span class="guide-word">maintenance</span></td><td>not “maintainance”</td></tr>
                    <tr><td>EXPLAIN</td><td><span class="guide-word">explanation</span></td><td>not “explaination” — the <em>i</em> disappears</td></tr>
                    <tr><td>PRONOUNCE</td><td><span class="guide-word">pronunciation</span></td><td>the spoken <em>o</em> vanishes in spelling too</td></tr>
                    <tr><td>DESTROY</td><td><span class="guide-word">destruction</span></td><td>-oy → -uc- shift</td></tr>
                    <tr><td>PERMIT</td><td><span class="guide-word">permission</span></td><td>-it → -iss- shift (admit → admission)</td></tr>
                    <tr><td>ANALYSE</td><td><span class="guide-word">analysis</span></td><td>plural <em>analyses</em>; also <em>analytical</em></td></tr>
                    <tr><td>LOSE</td><td><span class="guide-word">loss</span></td><td>lose / loss / lost; a <em>loser</em> is a person</td></tr>
                    <tr><td>ADVISE</td><td><span class="guide-word">advice</span></td><td>verb with -s, noun with -c; uncountable — no “advices”</td></tr>
                    <tr><td>PRACTISE</td><td><span class="guide-word">practice</span></td><td>British spelling: practise (v), practice (n)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="callout callout-warn">
            <p><strong>The stem never stays unchanged.</strong> Every answer modifies the CAPITALS word in
            some way. If your answer is exactly the stem, re-check the part of speech.</p>
        </div>
        <p><a href="@Href("part-4")">Next: Part 4 strategy.</a></p>
    </div>;

    private RenderFragment Part4 => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Part 4: Key word transformations")</h2>
        <p class="guide-lead">
            6 items, <strong>2 marks each</strong> — the most valuable questions in the paper. Complete the
            second sentence so it means the same as the first, using the given
            <strong>key word</strong>. Your answer must be <strong>3–6 words, including the key word</strong>.
        </p>

        <h3>The hard rules</h3>
        <ul class="guide-list">
            <li><strong>Never change the key word</strong> in any way — no tense change, no plural, no
            repositioning, no adding -s or -ing.</li>
            <li><strong>3–6 words including the key word.</strong> Contractions count as <em>two</em> words
            (<em>don’t</em> = do + not); hyphenated words count as one.</li>
            <li><strong>Keep the meaning identical.</strong> No added or dropped information, however small —
            an extra <em>very</em> or a missing <em>only</em> changes the sentence.</li>
            <li><strong>Contract wisely.</strong> Contractions are legal, but every apostrophe must be
            correct; if unsure, write the full form and count.</li>
        </ul>

        <h3>How the two marks work</h3>
        <p>Each sentence contains <strong>two markable points</strong>, and each half is marked separately.
        A correct structure with one slip elsewhere usually earns 1 of the 2 marks. An empty line always
        earns 0.</p>
        <div class="callout callout-info">
            <p><em>“‘I’ll return the money tomorrow,’ Dan said.” → Dan …………… the next day.
            (PROMISED)</em></p>
            <p><strong>Full credit:</strong> <span class="guide-good">promised to return the money</span> —
            promise + to-infinitive (half 1) and tomorrow → the next day (half 2).</p>
            <p><strong>Half credit:</strong> “promised to return the money <em>tomorrow</em>” — the pattern
            is right, but the time expression was not shifted. 1 of 2 marks. Write the structure even when
            you are unsure of the second point.</p>
        </div>

        <h3>The 12 highest-frequency patterns — with a worked example each</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>#</th><th>Pattern</th><th>Lead sentence → gapped sentence (KEY)</th><th>Answer (words)</th></tr>
                </thead>
                <tbody>
                    <tr><td>1</td><td>Comparison: as … as</td><td><em>Everest is higher than K2.</em><br />K2 …………… Everest. (AS)</td><td><span class="guide-good">is not as high as</span> (5)</td></tr>
                    <tr><td>2</td><td>Present perfect passive</td><td><em>Someone has stolen my bicycle.</em><br />My bicycle …………… (HAS)</td><td><span class="guide-good">has been stolen</span> (3)</td></tr>
                    <tr><td>3</td><td>Reported statement</td><td><em>“I’ll be back tomorrow,” Anna told me.</em><br />Anna …………… back the next day. (SAID)</td><td><span class="guide-good">said she would be</span> (4)</td></tr>
                    <tr><td>4</td><td>Modal of deduction</td><td><em>I’m sure he isn’t aware of the problem.</em><br />He …………… of the problem. (CAN’T)</td><td><span class="guide-good">can’t be aware</span> (3)</td></tr>
                    <tr><td>5</td><td>Third conditional</td><td><em>Because she missed the bus, she was late for work.</em><br />If she hadn’t ……………, she wouldn’t have been late for work. (MISSED)</td><td><span class="guide-good">missed the bus</span> (3)</td></tr>
                    <tr><td>6</td><td>Condition with unless</td><td><em>You’ll fail the course if you don’t submit the essay.</em><br />You’ll fail the course …………… the essay. (UNLESS)</td><td><span class="guide-good">unless you submit</span> (3)</td></tr>
                    <tr><td>7</td><td>Concession → noun phrase</td><td><em>Although she was inexperienced, she got the job.</em><br />…………… any experience, she got the job. (DESPITE)</td><td><span class="guide-good">Despite her lack of</span> (4)</td></tr>
                    <tr><td>8</td><td>Causative</td><td><em>A specialist repaired her laptop.</em><br />She …………… by a specialist. (HAD)</td><td><span class="guide-good">had her laptop repaired</span> (4)</td></tr>
                    <tr><td>9</td><td>Wish / regret</td><td><em>I regret selling my vinyl collection.</em><br />I …………… my vinyl collection. (WISH)</td><td><span class="guide-good">wish I hadn’t sold</span> (5 — the contraction counts as two)</td></tr>
                    <tr><td>10</td><td>Would you mind + -ing</td><td><em>Can you open the window, please?</em><br />Would …………… the window, please? (MIND)</td><td><span class="guide-good">you mind opening</span> (3)</td></tr>
                    <tr><td>11</td><td>Passive reporting</td><td><em>People say the castle is haunted.</em><br />The castle …………… haunted. (SAID)</td><td><span class="guide-good">is said to be</span> (5)</td></tr>
                    <tr><td>12</td><td>Purpose: so that</td><td><em>He spoke slowly because he wanted the tourists to understand.</em><br />He spoke slowly …………… understand. (SO)</td><td><span class="guide-good">so that the tourists would</span> (5)</td></tr>
                </tbody>
            </table>
        </div>
        <p>Notice how pattern 7 forces a grammar shift, not just a word swap: <em>although + clause</em>
        becomes <em>despite + noun phrase</em>. The key word names the target structure — always ask “what
        does this word demand around it?”</p>

        <h3>Method</h3>
        <ol class="guide-steps">
            <li><strong>Compare the two sentences.</strong> Find exactly which information moved or is missing.</li>
            <li><strong>Let the key word name the structure.</strong> <em>despite</em> → linking device;
            <em>had</em> → causative; <em>as</em> → comparison. Decide the pattern before writing.</li>
            <li><strong>Draft around the key word</strong>, keeping it untouched and in grammatical position.</li>
            <li><strong>Count the words</strong> — 3 to 6, contractions as two. Count physically; “it feels
            short” is not a check.</li>
            <li><strong>Check the second sentence’s grammar:</strong> tense shift, agreement, word order —
            especially in reported questions (<em>where it was</em>, not <em>where was it</em>).</li>
            <li><strong>Check the meaning is identical</strong> to sentence one — no added <em>very</em>,
            no dropped <em>only</em>.</li>
        </ol>

        <div class="callout callout-warn">
            <p><strong>Most common total loss:</strong> the right structure in the wrong tense —
            <em>she said she will come</em> instead of <em>would come</em>. After a reporting verb in the
            past, shift the tense.</p>
        </div>
        <div class="callout callout-tip">
            <p><strong>Drill the patterns, not the sentences.</strong> This site’s Part 4 sets enforce the
            3–6-word rule and count for you — but count by hand first, then let the tool confirm. On this
            site’s practice pages the rule is shown under every Part 4 answer line.</p>
        </div>
        <p><a href="@Href("common-traps")">Next: the mistakes that cost the most marks.</a></p>
    </div>;

    private RenderFragment CommonTraps => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Common traps")</h2>
        <p class="guide-lead">
            The highest-frequency mistakes in each part, as wrong → right pairs. Every one of them is
            catchable with a two-second check — build the checks into your routine.
        </p>

        <h3>Part 1 — multiple-choice cloze</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Trap</th><th>Wrong → right</th></tr>
                </thead>
                <tbody>
                    <tr><td>L1 transfer: do/make</td><td><span class="guide-bad">do a mistake / do a decision</span> → <span class="guide-good">make a mistake / make a decision</span></td></tr>
                    <tr><td>L1 transfer: make/take</td><td><span class="guide-bad">make a photo / make a bus</span> → <span class="guide-good">take a photo / take a bus</span></td></tr>
                    <tr><td>say vs tell</td><td><span class="guide-bad">say the truth / said me</span> → <span class="guide-good">tell the truth / told me (say something TO someone)</span></td></tr>
                    <tr><td>win vs beat</td><td><span class="guide-bad">win somebody (at chess)</span> → <span class="guide-good">beat somebody; win the match</span></td></tr>
                    <tr><td>lose vs miss</td><td><span class="guide-bad">lose the bus / lose a lesson</span> → <span class="guide-good">miss the bus / miss a lesson (lose = no longer have)</span></td></tr>
                    <tr><td>borrow vs lend</td><td><span class="guide-bad">borrow someone money</span> → <span class="guide-good">lend someone money; borrow money FROM someone</span></td></tr>
                    <tr><td>strong vs heavy</td><td><span class="guide-bad">strong rain / strong traffic</span> → <span class="guide-good">heavy rain / heavy traffic</span></td></tr>
                    <tr><td>explain to</td><td><span class="guide-bad">explain me the plan</span> → <span class="guide-good">explain the plan to me</span></td></tr>
                    <tr><td>depend on</td><td><span class="guide-bad">depend of / depending of</span> → <span class="guide-good">depend on</span></td></tr>
                    <tr><td>discuss (no preposition)</td><td><span class="guide-bad">discuss about the plan</span> → <span class="guide-good">discuss the plan</span></td></tr>
                    <tr><td>reach (no preposition)</td><td><span class="guide-bad">reach to a decision</span> → <span class="guide-good">reach a decision / come to a decision</span></td></tr>
                </tbody>
            </table>
        </div>

        <h3>Part 2 — open cloze</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Trap</th><th>Wrong → right</th></tr>
                </thead>
                <tbody>
                    <tr><td><em>despite of</em></td><td><span class="guide-bad">despite of the rain</span> → <span class="guide-good">despite the rain / in spite of the rain</span></td></tr>
                    <tr><td><em>for to</em> + infinitive</td><td><span class="guide-bad">I came here for to study</span> → <span class="guide-good">I came here to study</span></td></tr>
                    <tr><td>want + object + to-infinitive</td><td><span class="guide-bad">I want that you help me</span> → <span class="guide-good">I want you to help me</span></td></tr>
                    <tr><td>no <em>will</em> in the if-clause</td><td><span class="guide-bad">If I will see him</span> → <span class="guide-good">If I see him</span></td></tr>
                    <tr><td>unless is already negative</td><td><span class="guide-bad">unless you don’t hurry</span> → <span class="guide-good">unless you hurry</span></td></tr>
                    <tr><td>most without the</td><td><span class="guide-bad">the most of people</span> → <span class="guide-good">most people</span></td></tr>
                    <tr><td>on the other hand</td><td><span class="guide-bad">in the other hand</span> → <span class="guide-good">on the other hand</span></td></tr>
                    <tr><td>duration: for, not during</td><td><span class="guide-bad">during three years / since three years</span> → <span class="guide-good">for three years (during + event: during the meeting)</span></td></tr>
                    <tr><td>opinions are not “according to”</td><td><span class="guide-bad">according to me</span> → <span class="guide-good">in my opinion (according to + source of information)</span></td></tr>
                    <tr><td>agree is a verb</td><td><span class="guide-bad">I am agree</span> → <span class="guide-good">I agree</span></td></tr>
                    <tr><td>Dropping the article</td><td><span class="guide-bad">went to cinema</span> → <span class="guide-good">went to the cinema</span></td></tr>
                    <tr><td>Two words where one is required</td><td>re-read the instruction: one word only, every time — a second word voids the answer</td></tr>
                </tbody>
            </table>
        </div>

        <h3>Part 3 — word formation</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Trap</th><th>Wrong → right</th></tr>
                </thead>
                <tbody>
                    <tr><td>Noun where an adjective is needed</td><td><span class="guide-bad">a success plan</span> → <span class="guide-good">a successful plan</span></td></tr>
                    <tr><td>Negative prefix with the wrong shape</td><td><span class="guide-bad">unpossible / unregular</span> → <span class="guide-good">impossible / irregular (im- before p/b/m, ir- before r)</span></td></tr>
                    <tr><td>Pluralising an uncountable</td><td><span class="guide-bad">informations / advices / furnitures</span> → <span class="guide-good">information / advice / furniture</span></td></tr>
                    <tr><td>Spelling shift missed</td><td><span class="guide-bad">arguement</span> → <span class="guide-good">argument</span>; <span class="guide-bad">sucessful</span> → <span class="guide-good">successful</span></td></tr>
                    <tr><td>-ance vs -ence</td><td><span class="guide-bad">independance</span> → <span class="guide-good">independence (performance, difference, reference)</span></td></tr>
                    <tr><td>-tion added where it shifts</td><td><span class="guide-bad">explaination / pronounciation</span> → <span class="guide-good">explanation / pronunciation</span></td></tr>
                    <tr><td>Stem left unchanged</td><td><span class="guide-bad">IMPORTANT as the answer</span> → <span class="guide-good">importance — the answer is never exactly the CAPITALS word</span></td></tr>
                    <tr><td>Already-plural nouns</td><td><span class="guide-bad">the childrens / peoples</span> → <span class="guide-good">the children / people</span></td></tr>
                    <tr><td>Unjustified negative prefix</td><td>check the sentence really states the opposite before adding <em>un-/in-/dis-</em> — “one of the most ___ (HONEST) people” is usually <em>honest</em>, not <em>dishonest</em></td></tr>
                    <tr><td>Verb left uninflected</td><td><span class="guide-bad">the number of visitors increase every year</span> → <span class="guide-good">increases (third-person -s)</span></td></tr>
                </tbody>
            </table>
        </div>

        <h3>Part 4 — key word transformations</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Trap</th><th>Wrong → right</th></tr>
                </thead>
                <tbody>
                    <tr><td>Changing the key word</td><td><span class="guide-bad">has (key word: had)</span> → the key word must appear exactly as given — same form, same spelling</td></tr>
                    <tr><td>Outside 3–6 words</td><td>count every word including the key word; 2-word and 7-word answers score zero</td></tr>
                    <tr><td>Contractions counted as one</td><td><span class="guide-bad">don’t = 1 word</span> → <span class="guide-good">don’t = 2 words (do + not)</span></td></tr>
                    <tr><td>Right structure, wrong tense</td><td><span class="guide-bad">she said she will come</span> → <span class="guide-good">she said she would come</span></td></tr>
                    <tr><td>Question order in reported questions</td><td><span class="guide-bad">asked where was it</span> → <span class="guide-good">asked where it was</span></td></tr>
                    <tr><td>Dropping <em>not</em></td><td><span class="guide-bad">told him to wait (original: “Don’t wait”)</span> → <span class="guide-good">told him not to wait — a meaning flip loses both halves</span></td></tr>
                    <tr><td><em>despite of</em> inside a transformation</td><td><span class="guide-bad">despite of the rain</span> → <span class="guide-good">despite the rain / despite the fact that it rained</span></td></tr>
                    <tr><td>Meaning drift</td><td>dropping <em>only</em>, adding <em>very</em>, turning <em>may</em> into <em>must</em> — same structure, different meaning, lost marks</td></tr>
                    <tr><td>used to vs be used to</td><td><span class="guide-bad">I am used to get up early</span> → <span class="guide-good">I used to get up early (past habit) / I am used to getting up (accustomed)</span></td></tr>
                    <tr><td>wish without backshift</td><td><span class="guide-bad">I wish I have more time</span> → <span class="guide-good">I wish I had more time (past form for present unreality)</span></td></tr>
                    <tr><td>Leaving the line blank</td><td>a blank earns 0; a correct structure with one slip can earn 1 — always write your best attempt</td></tr>
                </tbody>
            </table>
        </div>

        <h3>The 60-second end-of-paper check</h3>
        <p>Reserve the last minute of your final check for this fixed routine — four scans, one per part:</p>
        <ol class="guide-steps">
            <li><strong>0–15 s, Part 4:</strong> all six key words untouched? Count the words on any line you
            are not certain about.</li>
            <li><strong>15–30 s, Part 3:</strong> every word spelled out fully; plural -s added where the
            context demands; every prefix justified by the sentence.</li>
            <li><strong>30–45 s, Part 2:</strong> exactly one word per gap, all eight answered, spelling
            clean.</li>
            <li><strong>45–60 s:</strong> no blanks anywhere — and on the paper-based exam, confirm the
            answer-sheet numbering still lines up (one slipped line moves every answer onto the wrong
            question).</li>
        </ol>
        <p><a href="@Href("preparation")">Next: how to prepare with this site.</a></p>
    </div>;

    private RenderFragment Preparation => @<div class="guide-section">
        <h2>@(Current?.Title ?? "Prepare with this site")</h2>
        <p class="guide-lead">
            This site exists to train Parts 1–4. Use it like a gym — short, regular, honest sessions —
            with an accuracy gate before every step up in difficulty.
        </p>

        <h3>A four-week plan</h3>
        <p>Four sessions of 20–30 minutes beat one long session. Each week ends with a re-drill of the
        week’s mistakes; each week has one “move on” condition.</p>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Week</th><th>Focus</th><th>Sessions</th><th>Move on when</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Grammar spine — Parts 2 and 3</td>
                        <td><strong>Mon:</strong> one Part 2 set untimed, review every explanation.<br />
                            <strong>Wed:</strong> one Part 3 set untimed; write out the full word family for each stem.<br />
                            <strong>Fri:</strong> one topic drill (prepositions or verb patterns) chosen from your mistakes list.<br />
                            <strong>Sun:</strong> re-drill every miss of the week — no new sets.</td>
                        <td>Two consecutive sets of each part at ≥ 5/8 untimed</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Vocabulary and patterns — Parts 1 and 4</td>
                        <td><strong>Mon:</strong> one Part 1 set untimed; classify every wrong pick by distractor type.<br />
                            <strong>Wed:</strong> one Part 4 set; hand-count words before checking; name each item’s pattern.<br />
                            <strong>Fri:</strong> second Part 1 set + review the 25 collocation families.<br />
                            <strong>Sun:</strong> timed Part 1 (10 min) + Part 4 (12 min) with a stopwatch.</td>
                        <td>Part 1 ≥ 5/8 twice; Part 4 ≥ 7/12 twice</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Speed and weak spots</td>
                        <td><strong>Mon:</strong> two sets of your lowest-trend task (Progress page).<br />
                            <strong>Wed:</strong> Parts 2 + 3 inside 10 minutes each.<br />
                            <strong>Fri:</strong> topic drill on your most frequent mistakes.<br />
                            <strong>Sun:</strong> full four-part lap, budgets 10 / 10 / 10 / 12, no hints.</td>
                        <td>Weakest part ≥ 75% untimed; the Sunday lap ≥ 65%</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Exam simulation</td>
                        <td><strong>Mon:</strong> half-lap Parts 1 + 2 within budgets.<br />
                            <strong>Wed:</strong> half-lap Parts 3 + 4 within budgets.<br />
                            <strong>Fri:</strong> light topic drill only — rest matters the day before a simulation.<br />
                            <strong>Sun:</strong> full lap + the 60-second check, then review every mistake.</td>
                        <td>Lap ≥ 70% within budget: exam-ready signal. 60–70%: repeat week 3. Below 60%: week 1 work on the weakest part</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h3>Accuracy targets — when to move on</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>From</th><th>To</th><th>Gate</th></tr>
                </thead>
                <tbody>
                    <tr><td>Untimed single part</td><td>Timed single part</td><td>two consecutive sets at ≥ 80%</td></tr>
                    <tr><td>Timed single part</td><td>Mixed four-part laps</td><td>≥ 75% within the exam budget, twice</td></tr>
                    <tr><td>Mixed laps</td><td>Exam-ready signal</td><td>≥ 70% overall, no part below 60%</td></tr>
                    <tr><td>Plateau (no gate hit for 2 weeks)</td><td>Topic drills</td><td>stop adding timed sets; drill the error types behind that part’s misses and rebuild from the guide tables first</td></tr>
                </tbody>
            </table>
        </div>
        <p>Speed built on sloppy accuracy just makes mistakes faster — accuracy is always the gate.</p>

        <h3>Using the site’s tools deliberately</h3>
        <div class="guide-table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>Feature</th><th>Where</th><th>How to use it</th></tr>
                </thead>
                <tbody>
                    <tr><td>Typed answers</td><td>Parts 2–4 are typed with no options; option-based tasks have a “Type answers” toggle</td><td>Keep typing on for everything. Recognition is not recall: picking from four options inflates your score and hides spelling gaps</td></tr>
                    <tr><td>Part 4 word counter</td><td>under each Part 4 answer line (“CAE rule: 3–6 words including the key word”)</td><td>count by hand first, then let the counter confirm — the habit, not the tool, is what you take into the exam</td></tr>
                    <tr><td>Hints</td><td>lamp icon per question (counts as hint use, tracked on Progress)</td><td>in untimed sets allow one hint per question after a genuine 60-second attempt; in timed sets, never</td></tr>
                    <tr><td>Trend arrows</td><td>Progress page, per-task table (↑ / → / ↓, moving ±5 points)</td><td>read weekly, not daily. A ↓ task becomes next Monday’s session; a → for two weeks means change the method, not the effort</td></tr>
                    <tr><td>Most frequent mistakes</td><td>Progress page — the exact expected answers you keep missing, with their task</td><td>each entry earns one re-drill set within the week; the list should shorten week on week</td></tr>
                    <tr><td>Accuracy ring and chart</td><td>top of the Progress page</td><td>your only global number. If it climbs while the mistakes list shrinks, the plan is working</td></tr>
                </tbody>
            </table>
        </div>

        <h3>Simulating exam conditions on the site</h3>
        <ul class="guide-list">
            <li><strong>One sitting, four parts, in order.</strong> Start at Part 1 and use the
            “Next part →” button after each check to chain Parts 1–4 back to back — the run banner at the
            top tracks your totals across the four parts.</li>
            <li><strong>Hold the budgets with a real stopwatch:</strong> 10 / 10 / 10 / 12 minutes, no
            hints, no returning to an earlier part. At the end, run the
            <a href="@Href("common-traps")">60-second check</a> before checking anything.</li>
            <li><strong>Lap behaviour:</strong> the site stores a four-part run; once all four parts have
            been checked (within 12 hours), the next visit to Part 1 starts a <em>new lap</em> with fresh
            sets. One lap = one simulated paper: finish the review of the old lap before starting the new
            one, or the lesson is lost.</li>
            <li><strong>Review immediately after checking</strong> each part, while the reasoning is fresh:
            read the explanations, log any new trap in your notebook, then continue to the next part — the
            review is part of the simulation, not an afterthought.</li>
        </ul>

        <div class="callout callout-tip">
            <p><strong>Track two numbers only:</strong> your overall accuracy ring on the Progress page, and
            the length of your frequent-mistakes list. The first should climb; the second should shorten.</p>
        </div>
        <p><a href="@Href("overview")">Back to the exam overview.</a></p>
    </div>;
}
