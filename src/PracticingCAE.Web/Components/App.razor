<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/cae.css?v=6" />
    <link rel="stylesheet" href="css/learn.css" />
    <link rel="stylesheet" href="css/guide.css" />
    <link rel="stylesheet" href="PracticingCAE.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/owner.js"></script>
    <script src="js/site.js?v=4"></script>
    <script>
        // Keep retrying a dropped circuit for ~2 minutes instead of the default few
        // seconds: a successful reconnect re-attaches to the same circuit with all
        // component state (answers, hints, results) intact.
        Blazor.start({
            reconnectionOptions: {
                maxRetries: 60,
                retryIntervalMilliseconds: 2000
            }
        });
    </script>
</body>

</html>
